# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/app.json
name: jasa_proyek
version: 1.0.0
title: {id: Jasa proyek, en: Project services}
label: {id: Rangka Jasa Proyek, en: Rangka Project Services}
summary:
  id: Dari penawaran dan penugasan tenaga kerja sampai faktur, pembayaran dan piutang, untuk satu atau beberapa PT.
category: operations
icon: briefcase-line
rangka: '>=0.5'
modules:
  accounting: ^1.0
  contacts: ^1.0
  catalogue: ^1.0
  users: ^1.0
  outlets: ^1.0
  tax_id: ^1.0
  currency: ^1.0
  invoicing: ^1.0
  coretax: ^1.0
  quotation: ^1.0
  orders: ^1.0
  workforce: ^1.0
  projects: ^1.0
  payments: ^1.0
  bank_statement: ^1.0
  procurement: ^1.0
  payroll: ^1.0
dashboards: [jasa_overview, ar_aging, project_margin, absen_saya, rekap_absen]
# field_worker and site_supervisor (field attendance, A2) have their role files in the projects module.
roles: [sales_manager, finance_manager, purchasing_manager, project_admin, field_worker, site_supervisor]
home: {dashboard: jasa_overview}
menu:
  - group: {id: Penjualan}
    items: [quotation, customer_order, sales_invoice]
  - group: {id: Proyek}
    items: [project, billing_milestone, assignment, timesheet, project_expense, acceptance, project_ledger]
  - group: {id: Absen lapangan}
    items: [attendance_log, attendance_close, work_site]
  - group: {id: Tenaga kerja}
    items: [worker]
  - group: {id: Penggajian}
    items: [payroll_run, payslip, payroll_close, payroll_profile]
  - group: {id: Keuangan}
    items: [payment, bank_transaction, invoice_reminder, withholding, vendor_bill, bank_account]
  - group: {id: Pembelian}
    items: [purchase_request, purchase_order]
  - group: {id: Pembukuan}
    items: [financial_report, gl_entry, opening_balance, period_close]
  - group: {id: Pajak}
    items: [tax_period]
  - group: {id: Data induk}
    items: [customer, vendor, item, uom, price_list, tax_code, currency]
# Answers set the first defaults of a new installation (PKP decides tax_rate, the business line the sample items and terms).
onboarding:
  # tax.pkp is a boolean: the answers are its values (schema 0.5 options are strings, so they are quoted).
  - ask: {id: 'Apakah perusahaan kamu PKP? (true = ya, false = tidak)'}
    options: ['true', 'false']
    sets: tax.pkp
  - ask: {id: 'Apa bidang usaha kamu?'}
    options: [manpower, inspeksi, rental, training, konsultan]
    sets: settings.business_line
  - ask: {id: 'Berapa PT yang kamu kelola?'}
    sets: seed.orgs
