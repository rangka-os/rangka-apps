# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/dashboard.json
name: jasa_overview
label: {id: Ringkasan jasa proyek, en: Project services overview}
default_period: 30
cache: 5m
widgets:
  # Money first (P7, owner on a phone): receivables, overdue, ready to bill and billed, then what is overdue by name.
  # List columns lead with who and how much, so the first two fit a 375px screen without scrolling sideways.
  - name: outstanding_ar
    type: number
    label: {id: Piutang berjalan}
    description: {id: Sisa tagihan semua faktur yang belum lunas}
    model: sales_invoice
    aggregate: sum
    field: outstanding
    filter: docstatus == 1 && outstanding > 0
    good_when: down
    compact: true
    span: 3
  - name: overdue_count
    type: number
    label: {id: Faktur lewat jatuh tempo}
    model: sales_invoice
    filter: docstatus == 1 && outstanding > 0 && due_date < today()
    good_when: down
    span: 3
  # Billing schedule (billing_milestone): what can be billed now, and what is due by date.
  - name: ready_to_bill
    type: number
    label: {id: Siap ditagih}
    description: {id: 'Termin yang berita acaranya sudah ada, belum ada fakturnya'}
    model: billing_milestone
    aggregate: sum
    field: amount
    filter: state == 'ready'
    compact: true
    span: 3
  - name: invoices_issued
    type: number
    label: {id: Faktur terbit}
    description: {id: 'Total faktur yang sudah diajukan pada periode ini'}
    model: sales_invoice
    aggregate: sum
    field: grand_total
    filter: docstatus == 1
    period: posting_date
    compact: true
    span: 3
  - name: overdue_invoices
    type: list
    label: {id: Faktur lewat jatuh tempo}
    model: sales_invoice
    filter: docstatus == 1 && outstanding > 0 && due_date < today()
    sort: due_date
    limit: 10
    columns: [customer, outstanding, due_date, name, amount_due]
    span: 12
  - name: milestones_due
    type: list
    label: {id: Termin jatuh tempo}
    model: billing_milestone
    filter: state == 'ready' || (state == 'planned' && trigger == 'date' && due_date <= today())
    sort: due_date
    limit: 10
    columns: [project, amount, due_date, title, state]
    span: 12
  - name: open_quotations
    type: number
    label: {id: Penawaran terbuka}
    description: {id: 'Sudah dikirim, belum ada hasil'}
    model: quotation
    filter: docstatus == 1 && outcome == 'open'
    span: 3
  - name: quotations_won
    type: number
    label: {id: Penawaran menang}
    model: quotation
    filter: docstatus == 1 && outcome == 'accepted'
    period: quotation_date
    span: 3
  - name: quotations_lost
    type: number
    label: {id: Penawaran kalah}
    model: quotation
    filter: docstatus == 1 && outcome == 'lost'
    period: quotation_date
    good_when: down
    span: 3
  - name: active_projects
    type: number
    label: {id: Proyek aktif}
    description: {id: Direncanakan atau berjalan}
    model: project
    filter: state == 'planned' || state == 'running'
    span: 3
  - name: active_workers
    # worker carries pay: only roles that may read it (audit L1)
    if: "'owner' in user.roles || 'finance_manager' in user.roles || 'project_admin' in user.roles"
    type: number
    label: {id: Tenaga kerja aktif}
    model: worker
    filter: active
    span: 3
  - name: quotation_outcomes
    type: chart
    chart: donut
    label: {id: Hasil penawaran}
    model: quotation
    group_by: outcome
    filter: docstatus == 1
    period: quotation_date
    span: 4
  - name: invoices_by_week
    type: chart
    chart: line
    label: {id: Faktur terbit per minggu}
    model: sales_invoice
    group_by: posting_date
    grain: week
    aggregate: sum
    field: grand_total
    filter: docstatus == 1
    period: posting_date
    span: 8
  - name: running_projects
    type: list
    label: {id: Proyek aktif}
    model: project
    filter: state == 'planned' || state == 'running'
    sort: start_date
    limit: 10
    columns: [name, project_name, customer, site, state, end_date]
    span: 7
  # Certification expiry cannot be a widget: `expired` lives on child rows (certification) and is a stored compute that goes
  # stale once expires_on passes. The closest honest view is the list of active workers; open one to see its certifications.
  - name: workers_certifications
    # worker carries pay: only roles that may read it (audit L1)
    if: "'owner' in user.roles || 'finance_manager' in user.roles || 'project_admin' in user.roles"
    type: list
    label: {id: Tenaga kerja aktif}
    description: {id: Buka satu untuk melihat masa berlaku sertifikasinya}
    model: worker
    filter: active
    sort: worker_name
    limit: 10
    columns: [name, worker_name, role_title, day_rate]
    span: 5
