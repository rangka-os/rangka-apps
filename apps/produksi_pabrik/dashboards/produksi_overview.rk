# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/dashboard.json
name: produksi_overview
label: {id: Ringkasan produksi, en: Production overview}
default_period: 30
cache: 5m
# The owner's questions: how much did we make, what did it really cost, how much went to waste, what expires soon.
widgets:
  # riset desain K-A2: "perlu_" lists open the home as "Perlu diurus" rows (P2); batch qty is left out (units differ)
  - name: perlu_kedaluwarsa
    type: list
    label: {id: Batch mendekati kedaluwarsa}
    description: {id: Kedaluwarsa dalam 30 hari}
    model: production_batch
    filter: "docstatus == 1 && expiry_date != '' && expiry_date <= today() + duration('30d')"
    sort: expiry_date
    limit: 10
    columns: [item, expiry_date, name]
    span: 12
  - name: batches
    type: number
    label: {id: Batch selesai}
    model: production_batch
    aggregate: count
    filter: docstatus == 1
    period: production_date
    span: 3
  # G10 (gladi 6 Nov): jumlah good_qty menjumlah pak + kg + batch setengah jadi, jadi angkanya tidak bermakna.
  # Diganti rendemen rata-rata (persen, tanpa satuan); jumlah per produk ada di grafik di bawah.
  - name: yield_avg
    type: number
    label: {id: Rendemen rata-rata (%)}
    description: {id: 'Hasil baik dibanding rencana'}
    model: production_batch
    aggregate: avg
    field: yield_percent
    filter: docstatus == 1
    period: production_date
    span: 3
  - name: hpp_total
    type: number
    label: {id: HPP produksi}
    description: {id: 'Bahan, upah borongan dan overhead'}
    model: production_batch
    aggregate: sum
    field: hpp_total
    filter: docstatus == 1
    period: production_date
    compact: true
    span: 3
  # Reject juga beda satuan per produk: yang dihitung batchnya, rinciannya di daftar batch
  - name: reject_batches
    type: number
    label: {id: Batch ada reject}
    model: production_batch
    aggregate: count
    filter: docstatus == 1 && reject_qty > 0
    period: production_date
    good_when: down
    span: 3
  - name: hpp_by_product
    type: chart
    chart: bar
    label: {id: HPP per produk}
    model: production_batch
    group_by: item
    aggregate: sum
    field: hpp_total
    filter: docstatus == 1
    period: production_date
    span: 6
  - name: output_by_product
    type: chart
    chart: bar
    label: {id: Hasil baik per produk jadi}
    description: {id: 'Dalam satuan masing-masing produk; bahan setengah jadi tidak dihitung'}
    model: production_batch
    group_by: item
    aggregate: sum
    field: good_qty
    filter: docstatus == 1 && item.kind == 'product'
    period: production_date
    span: 6
  - name: recent_batches
    type: list
    label: {id: Batch terakhir}
    description: {id: 'HPP aktual per satuan dibanding standar resep'}
    model: production_batch
    filter: docstatus == 1
    sort: -production_date
    limit: 10
    columns: [name, item, good_qty, hpp_per_unit, standard_unit_cost, expiry_date]
    span: 12
  - name: open_work_orders
    type: list
    label: {id: SPK berjalan}
    model: work_order
    filter: docstatus == 1
    sort: due_date
    limit: 10
    columns: [name, item, qty, due_date]
    span: 12
