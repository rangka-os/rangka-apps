# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/dashboard.json
name: fnb_overview
label: {id: Ringkasan outlet, en: Outlet overview}
default_period: 30
cache: 5m
widgets:
  # riset desain K-A2: "perlu_" lists open the home as "Perlu diurus" rows (display only)
  - name: perlu_belum_diajukan
    type: list
    label: {id: Penjualan belum diajukan}
    model: outlet_sales
    filter: docstatus == 0
    sort: date
    limit: 10
    columns: [outlet, date, net_total]
    span: 12
  - name: perlu_stok_minus
    type: list
    label: {id: Stok minus}
    model: stock_balance
    filter: negative == true
    sort: qty
    limit: 10
    columns: [item, outlet, qty]
    span: 12
  - name: net_period
    type: number
    label: {id: Penjualan bersih}
    description: {id: Pada periode yang dipilih}
    model: outlet_sales
    aggregate: sum
    field: net_total
    filter: docstatus == 1
    period: date
    compact: true
    span: 4
  - name: margin_period
    type: number
    label: {id: Margin}
    description: {id: Penjualan bersih dikurangi harga pokok bahan}
    model: outlet_sales
    aggregate: sum
    field: margin
    filter: docstatus == 1
    period: date
    compact: true
    span: 4
  - name: negative_count
    type: number
    label: {id: Stok minus}
    description: {id: Saldo stok di bawah nol}
    model: stock_balance
    filter: negative == true
    good_when: down
    span: 4
  - name: net_by_outlet
    type: chart
    chart: bar
    label: {id: Penjualan bersih per outlet}
    model: outlet_sales
    group_by: outlet
    aggregate: sum
    field: net_total
    filter: docstatus == 1
    period: date
    sort: -value
    span: 6
  - name: net_by_day
    type: chart
    chart: bar
    label: {id: Penjualan bersih per hari}
    model: outlet_sales
    group_by: date
    grain: day
    aggregate: sum
    field: net_total
    filter: docstatus == 1
    period: date
    span: 6
