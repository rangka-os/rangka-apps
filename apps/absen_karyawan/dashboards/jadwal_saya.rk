# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/dashboard.json
name: jadwal_saya
label: {id: Jadwal saya, en: My schedule}
description: {id: 'Shift kamu hari ini dan 13 hari ke depan, dan permintaan tukar shift yang belum diputuskan'}
# Every widget filters on the member's own employee record and published days, so head office and outlet supervisors
# (who read more assignments) also see only their own schedule here. Staff read only their own published days anyway
# (shift_assignment read if:).
periods: [1]
default_period: 1
roles: [member]
cache: 1m
widgets:
  - {name: today, type: list, label: {id: Hari ini}, model: shift_assignment, filter: "employee == user.name && published && work_date == today()", columns: [shift_label, outlet, outcome], limit: 1, span: 12}
  - {name: next, type: list, label: {id: 14 hari ke depan}, model: shift_assignment, filter: "employee == user.name && published && work_date > today() && days_between(today(), work_date) <= 13", columns: [work_date, shift_label, outlet], sort: work_date, limit: 14, span: 12}
  - {name: swaps, type: list, label: {id: Tukar shift menunggu}, model: shift_swap, filter: "requested_by == user.name && docstatus == 0", columns: [work_date, my_shift_name, with_note], sort: work_date, limit: 10, span: 12}
