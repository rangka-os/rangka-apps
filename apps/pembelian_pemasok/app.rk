# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/app.json
name: pembelian_pemasok
version: 1.0.0
title: {id: Pembelian ke pemasok, en: Purchasing}
label: {id: Rangka Pembelian, en: Rangka Purchasing}
summary:
  id: Permintaan dan pesanan pembelian, barang datang (menambah stok), dan tagihan pemasok.
category: purchasing
icon: shopping-bag-line
rangka: '>=0.5'
# A piece (riset/desain/11-susunan-kepingan.md). With stok_outlet, goods received add to stock; without it, it records
# purchases and supplier bills only (stock is optional for procurement).
modules:
  users: ^1.0
  contacts: ^1.0
  catalogue: ^1.0
  procurement: ^1.0
roles: [head_office, outlet_staff]
menu:
  - group: {id: Pembelian}
    items: [purchase_request, purchase_order, goods_receipt, vendor_bill]
  - group: {id: Pemasok}
    items: [vendor]
onboarding:
# Approval presets are opt-in (docs/presets/approvals/README.md): the answer 'ya' makes Raka copy the preset to custom/.
  - ask: {id: 'Mau pasang Persetujuan PO di atas batas? Pesanan pembelian di atas Rp 5.000.000 menunggu persetujuan dulu.'}
    options: ['ya', 'tidak']
    sets: approvals.po_threshold
  - ask: {id: 'Mau pasang Persetujuan pengeluaran? Pembayaran keluar dan tagihan pemasok tanpa PO di atas Rp 5.000.000 menunggu persetujuan dulu.'}
    options: ['ya', 'tidak']
    sets: approvals.spending
