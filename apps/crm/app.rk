name: crm
version: 1.0.0
title: {id: CRM, en: CRM}
requires: {rangka: '>=0.4', contacts: ^1.0, catalogue: ^1.0, pipeline: ^1.0, invoicing: ^1.0, outlets: ^1.0, users: ^1.0}
