# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/dashboard.json
name: saya
label: {id: Saya, en: Me}
description: {id: 'Slip gaji, absen, kasbon, klaim, dan jadwal kamu di satu tempat'}
# The employee app (rangka-os#261): every employee, whatever their role, opens it from the phone (Lainnya, or the
# "Slip gaji" shortcut of the installed app). Every widget filters on the person's own employee record, and the member
# grants (rangka-os contract 0074) let them read only their own rows: payslips once released (submitted, run closed or
# pay day reached), attendance logs, kasbon, claims and published shifts.
default_period: 31
roles: [member]
cache: 1m
widgets:
  - {name: pay, type: number, label: {id: Gaji bersih diterima}, description: {id: 'Jumlah slip gaji yang periodenya berakhir di rentang ini'}, model: payslip, aggregate: sum, field: net_pay, filter: "employee == user.name && docstatus == 1", period: run_period_to, compact: true, span: 4}
  - {name: days_present, type: number, label: {id: Hari hadir}, model: staff_attendance, filter: "employee == user.name && docstatus == 1", period: work_date, compact: true, span: 4}
  - {name: late_min, type: number, label: {id: Menit terlambat}, model: staff_attendance, aggregate: sum, field: late_min, filter: "employee == user.name && docstatus == 1", period: work_date, compact: true, span: 4, good_when: down}
  - {name: slips, type: list, label: {id: Slip gaji saya}, description: {id: 'Slip muncul setelah gaji periode itu dibayar. Buka slip untuk mencetak atau menyimpan PDF.'}, model: payslip, filter: "employee == user.name && docstatus == 1", columns: [run_period_from, net_pay, run_period_to], sort: -run_period_to, limit: 12, span: 12}
  - {name: next_shifts, type: list, label: {id: Jadwal 7 hari ke depan}, model: shift_assignment, filter: "employee == user.name && published && work_date >= today() && days_between(today(), work_date) <= 6", columns: [work_date, shift_label, outlet], sort: work_date, limit: 7, span: 12, if: "app_installed('shifts')"}
  - {name: kasbon_left, type: number, label: {id: Sisa kasbon}, model: cash_advance_balance, aggregate: sum, field: remaining, filter: "employee == user.name && !cancelled", compact: true, span: 6, good_when: down}
  - {name: claims_due, type: number, label: {id: Klaim menunggu dibayar}, model: claim_settlement, aggregate: sum, field: amount, filter: "employee == user.name && !paid && !cancelled", compact: true, span: 6}
  - {name: attendance, type: list, label: {id: Absen terakhir}, model: staff_attendance, filter: "employee == user.name && docstatus != 2", period: work_date, columns: [work_date, status], sort: -work_date, limit: 7, span: 12}
