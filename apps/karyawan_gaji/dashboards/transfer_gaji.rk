# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/dashboard.json
name: transfer_gaji
label: {id: Transfer gaji, en: Salary transfers}
description: {id: 'Gaji bersih per rekening dari slip yang sudah diajukan, untuk ditransfer lewat bank'}
# bank_transfer_csv (docs/payroll.md): the salary transfer list. The list download of payslip with the transfer columns
# (contract 0024, GET /api/v1/export/r/payslip?filter=payroll_run == '<run>' && docstatus == 1&columns=...&format=xlsx)
# is the file a bank's bulk transfer takes (up to 50 000 rows); this dashboard shows the first 50 rows by pay date.
# Generic columns, no bank API and no bank-specific layout. Slips without an account number are left out here and
# counted on gaji_ringkas.
default_period: 31
periods: [31, 92]
roles: [finance_manager]
cache: 1m
widgets:
  - {name: total, type: number, label: {id: Total ditransfer}, model: payslip, aggregate: sum, field: net_pay, filter: "docstatus == 1 && bank_account != '' && net_pay > 0", period: pay_date, compact: true, span: 6}
  - {name: count, type: number, label: {id: Jumlah transfer}, model: payslip, filter: "docstatus == 1 && bank_account != '' && net_pay > 0", period: pay_date, span: 6}
  - {name: transfers, type: list, label: {id: Daftar transfer gaji}, model: payslip, filter: "docstatus == 1 && bank_account != '' && net_pay > 0", period: pay_date, columns: [bank_account, account_holder, bank_name, net_pay, transfer_note, payroll_run], sort: account_holder, limit: 50, span: 12}
