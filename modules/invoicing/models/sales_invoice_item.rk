# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: sales_invoice_item
is_child: true
fields:
  - name: item
    type: link
    to: item
    label: {id: Barang/jasa}
    required: true
  - name: description
    type: text
    label: {id: Uraian}
    default: item.item_name
  - name: qty
    type: float
    label: {id: Qty}
    default: '1'
  - name: uom
    type: link
    to: uom
    label: {id: Satuan}
    default: "item.sales_uom != '' ? item.sales_uom : item.stock_uom"
  # the unit's name for the printed faktur and nota (a print reads only top-level links)
  - {name: uom_name, type: data, label: {id: Nama satuan}, hidden: true, compute: "uom != '' ? uom.uom_name : ''"}
  - name: rate
    type: currency
    label: {id: Harga}
    default: item.rate
  - name: discount
    type: percent
    label: {id: Diskon %}
    default: '0'
  - name: amount
    type: currency
    label: {id: Jumlah}
    compute: round(qty * rate * (1 - discount / 100))
  # PPh 23 is withheld on the fee for a service, not on what the firm passes through: the workers' wages billed on their
  # own line (jasa tenaga kerja, PMK 141/2015) or a reimbursed cost. Ticked lines stay out of the invoice's PPh 23 base.
  # The flag says "excluded" so that a line written before the field existed (NULL after migrate, read as false) keeps
  # the old behaviour: part of the base.
  - name: pph23_exclude
    type: check
    label: {id: Bukan dasar PPh 23}
    help: {id: 'Centang untuk baris gaji tenaga kerja yang dirinci terpisah atau penggantian biaya'}
    default: 'false'

  - {name: rate_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Harga (valas)}, default: '0'}
  - {name: amount_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Jumlah (valas)}, compute: "round(qty * rate_fx * (1 - discount / 100), 2)"}
  # e-Faktur line (module coretax): A goods / B services, the 6-digit Coretax code (000000 = none) and the unit code
  # (UM.0033 Lainnya when the unit has none), from the item and unit while the invoice is a draft.
  - {name: coretax_opt, type: data, label: {id: Barang/jasa (Coretax)}, hidden: true, compute: "item.kind == 'service' ? 'B' : 'A'"}
  - {name: coretax_code, type: data, label: {id: Kode barang/jasa Coretax}, hidden: true, compute: "item.coretax_code != '' ? item.coretax_code : '000000'"}
  - {name: coretax_unit, type: data, label: {id: Satuan Coretax}, hidden: true, compute: "uom.coretax_unit != '' ? uom.coretax_unit : 'UM.0033'"}
