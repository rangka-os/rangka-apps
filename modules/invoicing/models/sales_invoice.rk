# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: sales_invoice
label: {id: Faktur penjualan}
icon: invoice
is_submittable: true
naming: {series: invoice, pattern: "INV-{YYYY}-{#####}"}
title_field: customer
on_submit: [ledger.post_receivable]
on_cancel: [invoicing.reverse_receivable]
fields:
  - name: kind
    type: select
    label: {id: Jenis faktur}
    default: "'regular'"
    in_list: true
    chip: true
    options:
      - {value: regular, label: {id: Reguler}}
      - {value: down_payment, label: {id: Uang muka (DP)}}
      - {value: retention, label: {id: Retensi}}
  - name: customer
    type: link
    to: customer
    label: {id: Pelanggan}
    required: true
    in_list: true
    peek: [outstanding, payment_days, npwp]
  - name: customer_order
    type: link
    to: customer_order
    label: {id: Pesanan pelanggan}
  - name: project
    type: link
    to: project
    label: {id: Proyek}
  - name: acceptance
    type: link
    to: acceptance
    label: {id: Berita acara}
  - name: po_number
    type: data
    label: {id: No. PO pelanggan}
    default: customer_order.po_number
  - name: outlet
    type: link
    to: outlet
    label: {id: Outlet}
  - name: posting_date
    type: date
    label: {id: Tanggal faktur}
    default: today()
    required: true
    in_list: true
  - name: due_date
    type: date
    label: {id: Jatuh tempo}
    default: posting_date + duration(customer.payment_days)
    relative_to: posting_date
  - name: items
    type: table
    of: sales_invoice_item
    label: {id: Barang/jasa}
    min_rows: 1
  - name: subtotal
    type: currency
    label: {id: Subtotal}
    # Foreign-currency document (currency is not IDR): the rupiah subtotal is the IDR twin of subtotal_fx (contract 0013),
    # so dpp_base, PPN (assessed in rupiah), grand_total, retention, PPh 23 and amount_due stay IDR computes from it.
    # Lines are entered with rate_fx; the IDR line `amount` (qty x rate) cannot see the parent's currency, so the header ignores it.
    compute: "currency != '' && currency != 'IDR' ? subtotal_fx_idr : items.map(i, i.amount).sum()"
  - name: discount_amount
    type: currency
    label: {id: Diskon}
    default: '0'
  - name: dp_invoice
    type: link
    to: sales_invoice
    label: {id: Faktur uang muka}
    depends_on: kind == 'regular'
  - name: dp_deduction
    type: currency
    label: {id: Potongan uang muka}
    default: '0'
  - name: dpp_base
    type: currency
    label: {id: DPP}
    compute: subtotal - discount_amount - dp_deduction
  - name: ppn_applies
    type: check
    label: {id: Kena PPN}
    default: 'true'
  - name: tax_rate
    type: percent
    label: {id: Tarif PPN}
    default: '12'
  - name: ppn
    type: currency
    label: {id: PPN (tarif x DPP nilai lain 11/12)}
    compute: "ppn_applies ? round(dpp_base * 11 / 12 * tax_rate / 100) : 0"
  - name: grand_total
    type: currency
    label: {id: Total}
    compute: dpp_base + ppn
    in_list: true
  - name: retention_percent
    type: percent
    label: {id: Retensi %}
    default: '0'
  - name: retention_amount
    type: currency
    label: {id: Retensi ditahan}
    compute: round(dpp_base * retention_percent / 100)
  - name: retention_of
    type: link
    to: sales_invoice
    label: {id: Retensi untuk faktur}
    depends_on: kind == 'retention'
  - name: pph23_applies
    type: check
    label: {id: Dipotong PPh 23}
    default: 'false'
  - name: pph23_rate
    type: percent
    label: {id: Tarif PPh 23}
    default: '2'
  - name: pph23_amount
    type: currency
    label: {id: PPh 23 dipotong pelanggan}
    compute: "pph23_applies ? round(dpp_base * pph23_rate / 100) : 0"
  - name: amount_due
    type: currency
    label: {id: Tagihan bersih}
    compute: grand_total - retention_amount - pph23_amount
    in_list: true
  - name: paid_amount
    type: currency
    label: {id: Sudah dibayar}
    read_only: true
  - name: outstanding
    type: currency
    label: {id: Sisa tagihan}
    compute: amount_due - paid_amount
    in_list: true
  - name: notes
    type: text
    label: {id: Catatan untuk pelanggan}
  - {name: currency, type: data, label: {id: Mata uang}, default: "'IDR'"}
  - {name: exchange_rate, type: float, label: {id: Kurs}, default: '1'}   # IDR per 1 unit of the foreign currency; line `rate` stays the unit price
  - {name: subtotal_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Subtotal (valas)}, compute: "sum(items.map(i, i.amount_fx))"}
  - {name: discount_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Diskon (valas)}, default: '0'}
  - {name: dp_deduction_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Potongan uang muka (valas)}, default: '0'}
  - {name: dpp_base_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: DPP (valas)}, compute: "subtotal_fx - discount_fx - dp_deduction_fx"}
  - {name: ppn_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: PPN (valas)}, compute: "ppn_applies ? round(dpp_base_fx * 11 / 12 * tax_rate / 100, 2) : 0"}
  - {name: grand_total_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Total (valas)}, compute: "dpp_base_fx + ppn_fx"}
  - {name: retention_amount_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Retensi ditahan (valas)}, compute: "round(dpp_base_fx * retention_percent / 100, 2)"}
  - {name: pph23_amount_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: PPh 23 dipotong (valas)}, compute: "pph23_applies ? round(dpp_base_fx * pph23_rate / 100, 2) : 0"}
  - {name: amount_due_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Tagihan bersih (valas)}, compute: "grand_total_fx - retention_amount_fx - pph23_amount_fx"}
rules:
  - name: due_after_posting
    on: save
    check: due_date >= posting_date
    message: {id: Jatuh tempo tidak boleh sebelum tanggal faktur}
  - name: credit_limit
    on: submit
    level: warn
    check: customer.outstanding + amount_due <= customer.credit_limit
    message: {id: Melebihi batas kredit pelanggan}
  - name: discount_within_subtotal
    on: save
    check: discount_amount <= subtotal
    message: {id: Diskon tidak boleh melebihi subtotal}
  - name: dp_deduction_within_dp
    on: save
    check: dp_invoice == '' || dp_deduction <= dp_invoice.dpp_base
    message: {id: Potongan uang muka melebihi nilai DPP faktur uang muka}
  - name: dp_needs_invoice
    on: save
    check: dp_deduction == 0 || dp_invoice != ''
    message: {id: Pilih faktur uang muka yang dipotong}
  - name: dp_invoice_is_dp
    on: save
    check: dp_invoice == '' || (dp_invoice.kind == 'down_payment' && dp_invoice.docstatus == 1)
    message: {id: Faktur uang muka harus berjenis uang muka dan sudah disubmit}
  - name: dp_not_on_dp
    on: save
    check: kind != 'down_payment' || dp_deduction == 0
    message: {id: Faktur uang muka tidak boleh memotong uang muka}
  - name: retention_needs_origin
    on: save
    check: kind != 'retention' || retention_of != ''
    message: {id: Faktur retensi harus menunjuk faktur asalnya}
  - name: retention_origin_submitted
    on: save
    check: retention_of == '' || retention_of.docstatus == 1
    message: {id: Faktur asal retensi harus sudah disubmit dan tidak dibatalkan}
  - name: retention_range
    on: save
    check: retention_percent >= 0 && retention_percent <= 20
    message: {id: Retensi antara 0 dan 20 persen}
  - name: dpp_not_negative
    on: save
    check: dpp_base >= 0
    message: {id: DPP tidak boleh negatif; kurangi potongan atau diskon}
approvals:
  - name: big_invoice
    on: submit
    when: grand_total > 100000000
    approvers: [finance_manager]
    label: {id: Persetujuan keuangan untuk faktur besar, en: Finance approval for large invoices}

views:
  list:
    columns: [name, customer, kind, posting_date, status, grand_total, outstanding]
    sort: -posting_date
  form:
    layout:
      - section: {id: Pelanggan}
        columns:
          - [kind, customer, po_number, customer_order, project]
          - [posting_date, due_date, outlet, acceptance]
      - section: {id: Barang/jasa}
        fields: [items]
      - section: {id: Pajak & potongan}
        columns:
          - [discount_amount, dp_invoice, dp_deduction, ppn_applies, tax_rate, ppn]
          - [pph23_applies, pph23_rate, pph23_amount, retention_percent, retention_of, retention_amount]
      - section: {id: Ringkasan}
        columns:
          - [subtotal, dpp_base, grand_total]
          - [amount_due, paid_amount, outstanding]
      - section: {id: Catatan}
        fields: [notes]
      - section: {id: Mata uang asing}
        columns:
          - [currency, exchange_rate, subtotal_fx]
          - [grand_total_fx, amount_due_fx]
