# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: sales_invoice
label: {id: Faktur penjualan}
icon: invoice
is_submittable: true
naming: {series: invoice, pattern: "INV-{YYYY}-{#####}"}
title_field: customer
on_submit: [ledger.post_receivable]
on_cancel: [invoicing.reverse_receivable]
permissions:
  - {role: finance_manager, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, export: true, print: true}
  - {role: sales_manager, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, export: true, print: true}
  - {role: sales_rep, read: true}
  - {role: field_sales, read: true, print: true}
  # head office (ritel, produksi) downloads the Coretax faktur file of its tax periods, an export of these invoices
  - {role: head_office, read: true, print: true, export: true}
  # project admins read invoices: the project flows that freeze contract terms read them as the project admin
  - {role: project_admin, read: true}
fields:
  - name: kind
    type: select
    label: {id: Jenis faktur}
    default: "'regular'"
    in_list: true
    chip: true
    options:
      - {value: regular, label: {id: Reguler}}
      - {value: down_payment, label: {id: Uang muka (DP)}}
      - {value: retention, label: {id: Retensi}}
  - name: customer
    type: link
    to: customer
    label: {id: Pelanggan}
    required: true
    in_list: true
    peek: [outstanding, payment_days, npwp]
    default: billing_milestone.customer
  - name: customer_order
    type: link
    to: customer_order
    label: {id: Pesanan pelanggan}
  # The salesman whose customer this is (module distribution), for AR and collections per salesman.
  - name: salesman
    type: link
    to: user
    label: {id: Salesman}
    default: "customer_order != '' && customer_order.salesman != '' ? customer_order.salesman : customer.salesman"
    in_list: true
    depends_on: app_installed('distribution')
  - name: project
    type: link
    to: project
    label: {id: Proyek}
    default: billing_milestone.project
  # The billing milestone this invoice bills (projects module); flows mark it invoiced on submit, ready on cancel.
  # milestone_claim (unique) = milestone:<its bill_token> from the invoice's first save: one invoice per milestone, draft
  # or submitted, and the database refuses a second one even when both are made at the same moment (an amendment
  # re-pointed at the milestone included). A cancelled invoice keeps its claim (the kernel does not recompute on
  # cancel); the cancel flow sets the milestone's bill_token to that invoice, so the next invoice claims a new key.
  - name: billing_milestone
    type: link
    to: billing_milestone
    label: {id: Termin tagihan}
  - name: milestone_claim
    type: data
    label: {id: Faktur untuk termin ini}
    hidden: true
    unique: true
    compute: "billing_milestone == '' ? '' : billing_milestone + ':' + billing_milestone.bill_token"
  - name: acceptance
    type: link
    to: acceptance
    label: {id: Berita acara}
    default: billing_milestone.acceptance
  - name: po_number
    type: data
    label: {id: No. PO pelanggan}
    default: customer_order.po_number
  - name: outlet
    type: link
    to: outlet
    label: {id: Outlet}
  - name: posting_date
    type: date
    label: {id: Tanggal faktur}
    default: today()
    required: true
    in_list: true
  - name: due_date
    type: date
    label: {id: Jatuh tempo}
    default: posting_date + duration(customer.payment_days)
    relative_to: posting_date
  - name: items
    type: table
    of: sales_invoice_item
    label: {id: Barang/jasa}
    min_rows: 1
  - name: subtotal
    type: currency
    label: {id: Subtotal}
    # Foreign-currency document (currency is not IDR): the rupiah subtotal is the IDR twin of subtotal_fx (contract 0013),
    # so dpp, PPN (assessed in rupiah), grand_total, retention, PPh 23 and amount_due stay IDR computes from it.
    # Lines are entered with rate_fx; the IDR line `amount` (qty x rate) cannot see the parent's currency, so the header ignores it.
    compute: "currency != '' && currency != 'IDR' ? subtotal_fx_idr : items.map(i, i.amount).sum()"
  - name: discount_amount
    type: currency
    label: {id: Diskon}
    default: '0'
  - name: dp_invoice
    type: link
    to: sales_invoice
    label: {id: Faktur uang muka}
    depends_on: kind == 'regular'
  - name: down_payment
    type: currency
    label: {id: Potongan uang muka}
    default: '0'
  - name: dpp
    type: currency
    label: {id: DPP}
    compute: subtotal - discount_amount - down_payment
  - name: tax_rate
    type: percent
    label: {id: Tarif PPN}
    help: {id: 'Dari config tax.ppn_rate; 0 bila perusahaan bukan PKP atau faktur retensi (PPN sudah ditagih di faktur asal). Tersimpan di dokumen.'}
    default: "kind == 'retention' ? 0 : (tax.pkp ? tax.ppn_rate : 0)"
  # Not read_only: a generic amend zeroes read-only fields, and a zero dpp_den would break ppn (kernel follow-up).
  - {name: dpp_num, type: int, label: {id: DPP nilai lain (pembilang)}, default: 'tax.dpp_num'}
  - {name: dpp_den, type: int, label: {id: DPP nilai lain (penyebut)}, default: 'tax.dpp_den'}
  # The PPN base: the DPP, or with config tax.ppn_fee_only (kernel contract 0010 §8, default off) the DPP x the share
  # of lines not marked ppn_exclude: a manpower firm that bills the workers' wages on their own line charges PPN on
  # its fee only (DPP nilai lain, PMK 83/2012 art. 4). Foreign documents take the share from the lines' rupiah twins.
  # Frozen at submit with the setting of that day; the ratio below (11/12) and the rate still apply.
  - name: ppn_base
    type: currency
    label: {id: Dasar PPN}
    compute: >-
      !tax.ppn_fee_only ? dpp :
      (currency != '' && currency != 'IDR'
        ? (items.map(i, i.amount_fx_idr).sum() == 0 ? 0 : round(dpp * 1.0 * items.map(i, i.ppn_exclude ? 0 : i.amount_fx_idr).sum() / items.map(i, i.amount_fx_idr).sum()))
        : (subtotal == 0 ? 0 : round(dpp * 1.0 * items.map(i, i.ppn_exclude ? 0 : i.amount).sum() / subtotal)))
  - name: ppn
    type: currency
    label: {id: PPN (dasar PPN x rasio DPP nilai lain x tarif)}
    compute: "round(ppn_base * dpp_num / dpp_den * tax_rate / 100)"
  - name: grand_total
    type: currency
    label: {id: Total}
    compute: dpp + ppn
    in_list: true
  - name: retention_percent
    type: percent
    label: {id: Retensi %}
    default: '0'
  - name: retention_amount
    type: currency
    label: {id: Retensi ditahan}
    compute: round(dpp * retention_percent / 100)
  - name: retention_of
    type: link
    to: sales_invoice
    label: {id: Retensi untuk faktur}
    depends_on: kind == 'retention'
  - name: pph23_applies
    type: check
    label: {id: Dipotong PPh 23}
    default: 'false'
  - name: pph23_rate
    type: percent
    label: {id: Tarif PPh 23}
    default: '2'
  # The PPh 23 base: (subtotal - header discount) x the share of lines not marked pph23_exclude, minus the base already
  # taken on the down-payment invoice this one deducts (that invoice's line base in proportion to down_payment). Equal
  # to dpp when no line is excluded and the DP invoice had none either. Foreign-currency documents take the share from
  # the lines' rupiah twins (amount_fx_idr). "* 1.0" keeps the products in float, clear of int64 overflow. Foreign
  # amounts (money) are Decimal, capped by the kernel at 16 whole digits (an overflow is stored as 0), so a product of a
  # money field and a rupiah amount is never formed: the share is taken from the twins, and pph23_amount_fx multiplies
  # dpp_fx by a ratio below 1.
  - name: pph23_lines_base
    type: currency
    label: {id: Dasar PPh 23 baris}
    hidden: true
    compute: "currency != '' && currency != 'IDR' ? (items.map(i, i.amount_fx_idr).sum() == 0 ? 0 : round((subtotal - discount_amount) * 1.0 * items.map(i, i.pph23_exclude ? 0 : i.amount_fx_idr).sum() / items.map(i, i.amount_fx_idr).sum())) : (subtotal == 0 ? 0 : round((subtotal - discount_amount) * 1.0 * items.map(i, i.pph23_exclude ? 0 : i.amount).sum() / subtotal))"
  - name: pph23_dp_base
    type: currency
    label: {id: Dasar PPh 23 di faktur uang muka}
    hidden: true
    # Recomputed from the DP invoice's own lines with the formula of pph23_lines_base (never its stored pph23_dpp), so a
    # DP invoiced before pph23_dpp existed, in rupiah or in a foreign currency, is deducted like a new one: its lines
    # have no pph23_exclude, so the whole DP is base, as before the upgrade. A foreign DP takes the share from its twins.
    compute: >-
      dp_invoice == '' || dp_invoice.dpp == 0 ? 0 :
      round((dp_invoice.currency != '' && dp_invoice.currency != 'IDR'
        ? (dp_invoice.items.map(i, i.amount_fx_idr).sum() == 0 ? 0 : (dp_invoice.subtotal - dp_invoice.discount_amount) * 1.0 * dp_invoice.items.map(i, i.pph23_exclude ? 0 : i.amount_fx_idr).sum() / dp_invoice.items.map(i, i.amount_fx_idr).sum())
        : (dp_invoice.subtotal == 0 ? 0 : (dp_invoice.subtotal - dp_invoice.discount_amount) * 1.0 * dp_invoice.items.map(i, i.pph23_exclude ? 0 : i.amount).sum() / dp_invoice.subtotal))
        * down_payment / dp_invoice.dpp)
  - name: pph23_dpp
    type: currency
    label: {id: Dasar PPh 23}
    compute: "pph23_lines_base > pph23_dp_base ? pph23_lines_base - pph23_dp_base : 0"
  - name: pph23_amount
    type: currency
    label: {id: PPh 23 dipotong pelanggan}
    compute: "pph23_applies ? round(pph23_dpp * pph23_rate / 100) : 0"
  - name: amount_due
    type: currency
    label: {id: Tagihan bersih}
    compute: grand_total - retention_amount - pph23_amount
    in_list: true
  - name: paid_amount
    type: currency
    label: {id: Sudah dibayar}
    read_only: true
  - name: outstanding
    type: currency
    label: {id: Sisa tagihan}
    compute: amount_due - paid_amount
    in_list: true
  - name: notes
    type: text
    label: {id: Catatan untuk pelanggan}
  - {name: currency, type: data, label: {id: Mata uang}, default: "'IDR'"}
  - {name: exchange_rate, type: float, label: {id: Kurs}, default: '1'}   # IDR per 1 unit of the foreign currency; line `rate` stays the unit price
  - {name: subtotal_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Subtotal (valas)}, compute: "sum(items.map(i, i.amount_fx))"}
  # Adjustments (discount_amount, down_payment) are entered in rupiah only, also on a foreign document: the ledger, the DP checks
  # and PPN read the IDR fields. Their foreign twins are derived here (IDR / exchange_rate), never entered.
  - {name: dpp_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: DPP (valas)}, compute: "currency != '' && currency != 'IDR' ? round(subtotal_fx - (discount_amount + down_payment) / exchange_rate, 2) : 0"}
  - {name: ppn_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: PPN (valas)}, compute: "dpp == 0 ? 0 : round(dpp_fx * (ppn_base * 1.0 / dpp) * dpp_num / dpp_den * tax_rate / 100, 2)"}
  - {name: grand_total_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Total (valas)}, compute: "dpp_fx + ppn_fx"}
  - {name: retention_amount_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Retensi ditahan (valas)}, compute: "round(dpp_fx * retention_percent / 100, 2)"}
  - {name: pph23_amount_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: PPh 23 dipotong (valas)}, compute: "pph23_applies && dpp != 0 ? round(dpp_fx * (pph23_dpp * 1.0 / dpp * pph23_rate / 100), 2) : 0"}
  - {name: amount_due_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Tagihan bersih (valas)}, compute: "grand_total_fx - retention_amount_fx - pph23_amount_fx"}
  # e-Faktur (module coretax, contract 0029): the buyer's tax identity and the transaction code, computed from the
  # customer while the invoice is a draft and frozen when it is submitted, so the Coretax file of its period carries
  # the identity the invoice was issued to. TIN = NPWP + NITKU (head office: NPWP + 000000); National ID = NIK with
  # sixteen zeros as TIN and 000000 as ID TKU; Passport likewise (template Faktur PK v1.6.1, sheet Keterangan).
  # Code: 02/03 for a VAT collector, else 04 with DPP nilai lain (PMK 131/2024: 11/12), 01 when the DPP factor is 1/1.
  - name: buyer_id_type
    type: data
    label: {id: Jenis ID pembeli}
    hidden: true
    depends_on: app_installed('coretax')
    compute: "customer.npwp != '' ? 'TIN' : (customer.nik != '' ? 'National ID' : (customer.passport_no != '' ? 'Passport' : ''))"
  - name: buyer_tin
    type: data
    label: {id: NPWP pembeli}
    hidden: true
    depends_on: app_installed('coretax')
    compute: "customer.npwp != '' ? customer.npwp : '00000000' + '00000000'"
  - name: buyer_doc_no
    type: data
    label: {id: Nomor dokumen pembeli}
    hidden: true
    depends_on: app_installed('coretax')
    compute: "customer.npwp != '' ? '-' : (customer.nik != '' ? customer.nik : customer.passport_no)"
  - name: buyer_idtku
    type: data
    label: {id: NITKU pembeli}
    hidden: true
    depends_on: app_installed('coretax')
    compute: "customer.npwp == '' ? '000000' : (customer.nitku != '' ? customer.nitku : customer.npwp + '000000')"
  - name: buyer_name
    type: data
    label: {id: Nama pembeli}
    hidden: true
    depends_on: app_installed('coretax')
    compute: customer.customer_name
  - name: buyer_address
    type: data
    label: {id: Alamat pembeli}
    hidden: true
    depends_on: app_installed('coretax')
    compute: "customer.city != '' && customer.address != '' ? customer.address + ', ' + customer.city : customer.address"
  - name: buyer_email
    type: data
    label: {id: Email pembeli}
    hidden: true
    depends_on: app_installed('coretax')
    compute: customer.email
  - name: buyer_country
    type: data
    label: {id: Negara pembeli}
    hidden: true
    depends_on: app_installed('coretax')
    compute: "customer.country != '' ? customer.country : 'IDN'"
  - name: efaktur_code
    type: data
    label: {id: Kode transaksi e-Faktur}
    depends_on: app_installed('coretax') && tax_rate > 0
    compute: "tax_rate == 0 ? '' : (customer.vat_collector == 'government' ? '02' : (customer.vat_collector == 'other' ? '03' : (dpp_num == dpp_den ? '01' : '04')))"
  # The invoice this one amends (kernel amended_from as a link), so the Coretax export can refuse a replacement of
  # an invoice of an earlier period: that one is a Faktur Pengganti made in Coretax.
  - name: replaces
    type: link
    to: sales_invoice
    label: {id: Mengganti faktur}
    hidden: true
    compute: amended_from
  # The posting date of the first invoice of the amend chain (A -> B -> C keeps A's date), frozen at submit: an
  # invoice whose chain started in an earlier period is a Faktur Pengganti in Coretax, however many amends later. Empty
  # when the invoice it amends froze before the coretax module and was itself an amend (its origin is unknown).
  - name: origin_posting_date
    type: data
    label: {id: Tanggal faktur asal}
    hidden: true
    compute: "replaces == '' ? posting_date : (replaces.origin_posting_date != '' ? replaces.origin_posting_date : (replaces.replaces == '' ? replaces.posting_date : ''))"
  # Whether rule credit_limit warned on this submit (the same expression, computed in the same step from the same
  # customer row). The rule runs before any flow lock (contract 0025 §5); flow sales_invoice_credit_recheck reads the customer
  # again after the ledger hook has locked and updated it, and refuses an invoice that is over the limit only because
  # another one was submitted at the same moment, so nobody passes the limit without having seen the warning.
  - name: credit_warned
    type: check
    label: {id: Peringatan batas kredit saat diajukan}
    hidden: true
    compute: "customer != '' && customer.outstanding + amount_due > customer.credit_limit"
rules:
  # A distributor bills what was delivered (module delivery): per item, no more than delivered, less returns and
  # earlier invoices of the order (order_fulfilment). The flow invoice_qty_from_deliveries sets the draft that way.
  - name: invoice_within_delivered
    on: submit
    check: "!app_installed('delivery') || customer_order == '' || customer_order.fulfilment == '' || items.map(l, items.map(x, x.item == l.item ? x.qty : 0).sum() <= customer_order.fulfilment.items.map(b, b.item == l.item ? b.delivered_qty - b.invoiced_qty : 0).sum() + 0.0005 ? 0 : 1).sum() == 0"
    message: {id: Jumlah ditagih melebihi barang yang sudah dikirim dan belum ditagih}
  - name: qty_positive
    on: save
    check: "items.map(i, i.qty <= 0 ? 1 : 0).sum() == 0"
    message: {id: Jumlah barang harus lebih dari 0}
  - name: rate_not_negative
    on: save
    check: "items.map(i, i.rate < 0 || i.rate_fx < 0 ? 1 : 0).sum() == 0"
    message: {id: Harga tidak boleh negatif}
  - name: line_discount_range
    on: save
    check: "items.map(i, i.discount < 0 || i.discount > 100 ? 1 : 0).sum() == 0"
    message: {id: Diskon baris antara 0 dan 100 persen}
  - name: foreign_needs_rate
    on: save
    check: currency == '' || currency == 'IDR' || exchange_rate > 1
    message: {id: Dokumen valas wajib diisi kursnya (rupiah per 1 unit mata uang asing)}
  # Every document this invoice points at belongs to the same customer (the idiom of project.rk order_same_customer).
  - name: dp_invoice_same_customer
    on: save
    check: dp_invoice == '' || dp_invoice.customer == customer
    message: {id: Faktur uang muka harus milik pelanggan yang sama}
  - name: retention_of_same_customer
    on: save
    check: retention_of == '' || retention_of.customer == customer
    message: {id: Faktur asal retensi harus milik pelanggan yang sama}
  - name: order_same_customer
    on: save
    check: customer_order == '' || customer_order.customer == customer
    message: {id: Pesanan pelanggan harus milik pelanggan yang sama}
  - name: project_same_customer
    on: save
    check: project == '' || project.customer == customer
    message: {id: Proyek harus milik pelanggan yang sama}
  - name: milestone_same_project
    on: save
    check: billing_milestone == '' || billing_milestone.project == project
    message: {id: Termin harus milik proyek yang sama}
  - name: milestone_same_customer
    on: save
    check: billing_milestone == '' || billing_milestone.customer == customer
    message: {id: Termin harus milik pelanggan yang sama}
  - name: milestone_amount_cap
    on: save
    check: billing_milestone == '' || dpp <= billing_milestone.amount
    message: {id: DPP faktur tidak boleh melebihi nilai termin}
  - name: retainer_invoice_via_milestone
    on: save
    check: project == '' || project.billing_model != 'retainer' || billing_milestone != '' || kind == 'retention'
    message: {id: 'Faktur proyek retainer dibuat dari termin bulanannya (satu termin, satu faktur per bulan)'}
  - name: retainer_invoice_monthly
    on: save
    check: project == '' || project.billing_model != 'retainer' || billing_milestone == '' || billing_milestone.kind == 'retainer'
    message: {id: 'Faktur proyek retainer hanya dari termin jenis Retainer (satu per bulan)'}
  - name: retention_same_project
    on: save
    check: retention_of == '' || retention_of.project == project
    message: {id: Faktur retensi harus untuk proyek yang sama dengan faktur asalnya}
  - name: retainer_invoice_within_fee
    on: save
    check: project == '' || project.billing_model != 'retainer' || project.contract_value == 0 || dpp <= project.contract_value
    message: {id: Faktur retainer tidak boleh melebihi fee bulanan (nilai kontrak)}
  - name: milestone_ready_to_bill
    on: save
    check: billing_milestone == '' || billing_milestone.trigger != 'acceptance' || billing_milestone.state == 'ready' || (billing_milestone.sales_invoice != '' && billing_milestone.sales_invoice == name)
    message: {id: Termin ini belum siap ditagih (berita acaranya belum ada atau sudah dibatalkan)}
  - name: milestone_not_invoiced
    on: save
    check: billing_milestone == '' || billing_milestone.state != 'invoiced' || billing_milestone.sales_invoice == name
    message: {id: Termin ini sudah ditagih di faktur lain}
  - name: dp_base_above_lines
    on: save
    level: warn
    check: "!pph23_applies || pph23_dp_base <= pph23_lines_base"
    message: {id: 'Dasar PPh 23 di faktur uang muka lebih besar dari dasar baris faktur ini; pisahkan baris gaji di faktur DP juga'}
  - name: acceptance_same_customer
    on: save
    check: acceptance == '' || acceptance.project.customer == customer
    message: {id: Berita acara harus untuk proyek pelanggan yang sama}
  - name: tax_valid
    on: save
    check: dpp_den > 0 && dpp_num > 0 && dpp_num <= dpp_den && tax_rate >= 0 && tax_rate <= 100
    message: {id: Tarif PPN atau faktor DPP tidak valid}
  - name: ppn_needs_pkp
    on: save
    check: tax.pkp || tax_rate == 0
    message: {id: Perusahaan bukan PKP tidak boleh memungut PPN (tarif PPN harus 0)}
  - name: due_after_posting
    on: save
    check: due_date >= posting_date
    message: {id: Jatuh tempo tidak boleh sebelum tanggal faktur}
  - name: credit_limit
    on: submit
    level: warn
    check: customer.outstanding + amount_due <= customer.credit_limit
    message: {id: Melebihi batas kredit pelanggan}
  - name: discount_within_subtotal
    on: save
    check: discount_amount <= subtotal
    message: {id: Diskon tidak boleh melebihi subtotal}
  - name: down_payment_within_dp
    on: save
    check: dp_invoice == '' || down_payment <= dp_invoice.dpp
    message: {id: Potongan uang muka melebihi nilai DPP faktur uang muka}
  - name: dp_needs_invoice
    on: save
    check: down_payment == 0 || dp_invoice != ''
    message: {id: Pilih faktur uang muka yang dipotong}
  - name: dp_invoice_is_dp
    on: save
    check: dp_invoice == '' || (dp_invoice.kind == 'down_payment' && dp_invoice.docstatus == 1)
    message: {id: Faktur uang muka harus berjenis uang muka dan sudah disubmit}
  - name: dp_not_on_dp
    on: save
    check: kind != 'down_payment' || down_payment == 0
    message: {id: Faktur uang muka tidak boleh memotong uang muka}
  - name: retention_needs_origin
    on: save
    check: kind != 'retention' || retention_of != ''
    message: {id: Faktur retensi harus menunjuk faktur asalnya}
  - name: retention_origin_submitted
    on: save
    check: retention_of == '' || retention_of.docstatus == 1
    message: {id: Faktur asal retensi harus sudah disubmit dan tidak dibatalkan}
  # The retained amount was taxed on the original invoice: releasing it charges no PPN again and cannot exceed what was retained.
  - name: retention_within_origin
    on: save
    check: kind != 'retention' || retention_of == '' || (tax_rate == 0 && dpp <= retention_of.retention_amount)
    message: {id: Faktur retensi tanpa PPN dan DPP-nya tidak boleh melebihi retensi yang ditahan di faktur asal}
  - name: retention_range
    on: save
    check: retention_percent >= 0 && retention_percent <= 20
    message: {id: Retensi antara 0 dan 20 persen}
  - name: dpp_not_negative
    on: save
    check: dpp >= 0
    message: {id: DPP tidak boleh negatif; kurangi potongan atau diskon}
approvals:
  - name: big_invoice
    on: submit
    when: grand_total > 100000000
    approvers: [finance_manager]
    label: {id: Persetujuan keuangan untuk faktur besar, en: Finance approval for large invoices}

views:
  list:
    # who, how much is left, when it is due first: the first three fit a phone screen (P7)
    columns: [name, customer, outstanding, due_date, status, grand_total, posting_date, kind]
    sort: -posting_date
  form:
    layout:
      - section: {id: Pelanggan}
        columns:
          - [kind, customer, po_number, customer_order, project, billing_milestone, salesman]
          - [posting_date, due_date, outlet, acceptance]
      - section: {id: Barang/jasa}
        fields: [items]
      - section: {id: Pajak & potongan}
        columns:
          - [discount_amount, dp_invoice, down_payment, tax_rate, dpp_num, dpp_den, ppn_base, ppn]
          - [pph23_applies, pph23_rate, pph23_amount, retention_percent, retention_of, retention_amount]
      - section: {id: Ringkasan}
        columns:
          - [subtotal, dpp, grand_total]
          - [amount_due, paid_amount, outstanding]
      - section: {id: Catatan}
        fields: [notes, efaktur_code]
      - section: {id: Mata uang asing}
        columns:
          - [currency, exchange_rate, subtotal_fx]
          - [grand_total_fx, amount_due_fx]
