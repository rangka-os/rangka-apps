# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.4/app.json
name: invoicing
version: 1.1.0
title: {id: Faktur, en: Invoicing}
requires: {rangka: '>=0.4', contacts: ^1.0, catalogue: ^1.0}
optional: {outlets: ^1.0, tax_id: ^1.0, currency: ^1.0}
# ledger.post_receivable is a core hook; these two are semantics fixed in docs/kernel-hooks.md.
hooks: [invoicing.reverse_receivable, invoicing.from_order]
