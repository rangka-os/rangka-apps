# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: project_billed_on_cancel
label: {id: Tagihan proyek dihitung ulang saat batal}
# Inside the invoice's cancel. billed_amount is recomputed from the project's submitted invoices (retention releases excluded), so invoices
# from before billed_amount existed count too; the project's rule billing_within_contract then refuses the save that
# would bill the project above its contract.
on: sales_invoice.cancelled
if: event.project != ''
steps:
  - find_all: sales_invoice
    where: project == event.project && docstatus == 1 && kind != 'retention'
    as: invs
  - {find: project, where: name == event.project, as: prj}
  - update: prj
    set:
      billed_amount: "size(invs) == 0 ? 0 : invs.map(i, i.dpp).sum()"
