# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: project_billed_on_cancel
label: {id: Tagihan proyek berkurang}
# Inside the invoice's cancel: takes its DPP off project.billed_amount, only for an invoice counted at its submit
# (project_counted, true for every invoice saved since billed_amount exists; empty on invoices submitted before).
on: sales_invoice.cancelled
if: event.project != '' && event.kind != 'retention' && event.project_counted == true
steps:
  - {find: project, where: name == event.project, as: prj}
  - update: prj
    set:
      billed_amount: prj.billed_amount - event.dpp
