# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: milestone_invoiced
label: {id: Termin ditandai sudah ditagih}
# Runs inside the invoice's submit, as the person submitting it: the milestone the invoice bills becomes invoiced and
# points at the invoice, so the schedule shows what is billed and milestone_not_invoiced refuses a second invoice.
on: sales_invoice.submitted
if: event.billing_milestone != ''
steps:
  - {find: billing_milestone, where: name == event.billing_milestone, as: ms}
  - if: ms != null
    update: ms
    set:
      state: "'invoiced'"
      sales_invoice: event.name
