# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: milestone_reopened
label: {id: Termin dibuka lagi saat faktur dibatalkan}
# A cancelled invoice gives its milestone back: ready to bill again when nothing else holds it (a dated milestone, or
# an acceptance milestone whose report is still live), planned when its report was cancelled too.
on: sales_invoice.cancelled
if: event.billing_milestone != ''
steps:
  - {find: billing_milestone, where: name == event.billing_milestone && sales_invoice == event.name, as: ms}
  - if: ms != null && ms.acceptance != ''
    find: acceptance
    where: name == ms.acceptance
    as: ba
  - if: ms != null
    update: ms
    set:
      state: "ms.trigger == 'acceptance' && (ms.acceptance == '' || ba == null || ba.docstatus != 1) ? 'planned' : 'ready'"
      sales_invoice: "''"
