# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: milestone_reopened
label: {id: Termin dibuka lagi saat faktur dibatalkan}
# A cancelled invoice gives its milestone back: ready to bill again (cancel + amend makes the corrected invoice).
on: sales_invoice.cancelled
if: event.billing_milestone != ''
steps:
  - {find: billing_milestone, where: name == event.billing_milestone && sales_invoice == event.name, as: ms}
  - if: ms != null
    update: ms
    set:
      state: "'ready'"
      sales_invoice: "''"
