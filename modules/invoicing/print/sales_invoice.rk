# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/print.json
name: sales_invoice
model: sales_invoice
label: {id: Faktur, en: Invoice}
paper: A4
template: sales_invoice.html
default: true
# "Cara bayar" copied when the invoice was submitted (payment_instruction); empty for an older invoice or one
# submitted without a default account, which then shows the letterhead's bank accounts.
related:
  cara_bayar:
    model: payment_instruction
    match: {sales_invoice: name}
    limit: 1
