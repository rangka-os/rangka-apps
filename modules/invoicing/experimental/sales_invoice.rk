# Sidecar for sales_invoice: the one thing that still waits for a kernel stream (checked by scripts/check_experimental.py).
model: sales_invoice
stream: [S5]

defaults:
  # S5: CEL has no `org` variable yet, so the org's `pkp` (config.rk `org.pkp` / `orgs.<id>.config.org.pkp`) cannot
  # decide. Until then the model's own default is the constant 'true'; a site with a non-PKP org unticks the box or
  # uses an overlay default.
  ppn_applies: org.pkp
