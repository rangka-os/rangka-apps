# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/print.json
# e-Faktur keluaran of the period as Coretax imports it (TaxInvoiceBulk, DJP sample "Faktur PK Template v1.4").
# Every submitted invoice dated in the period that charges PPN; retention invoices (no PPN) and cancelled ones are out.
# require refuses the download while an invoice cannot be imported as it is.
name: coretax_faktur
model: tax_period
label: {id: XML Faktur Keluaran (Coretax)}
output: xml
template: coretax_faktur.xml
related:
  invoices:
    model: sales_invoice
    range: {posting_date: [period_start, period_end]}
    # 07/08 (tidak dipungut, dibebaskan): a faktur pajak with PPN stated but not collected (card t_611be720); export
    # (PEB is its faktur) and Pasal 4A (no faktur) stay out
    filter: "docstatus == 1 && kind != 'retention' && ((tax_rate > 0 && ppn > 0) || efaktur_code == '07' || efaktur_code == '08')"
    sort: name
    children: true
    limit: 1000
    # An invoice submitted before this module froze without its Coretax fields (efaktur_code, buyer_*): the
    # efaktur_code check below names it once, the other checks skip it (audit pajak 7 Nov #8).
    require:
      - check: efaktur_code == '' || buyer_id_type != ''
        message: {id: 'Pelanggan belum punya NPWP, NIK, atau nomor paspor: lengkapi Data pajak pelanggan. Penjualan eceran tanpa identitas dilaporkan sebagai digunggung, bukan lewat file ini'}
      - check: "efaktur_code == '' || buyer_id_type != 'TIN' || (size(buyer_tin) == 16 && size(buyer_idtku) == 22 && buyer_idtku.startsWith(buyer_tin))"
        message: {id: 'NPWP (16 angka) atau NITKU (22 angka) pelanggan belum benar'}
      - check: "efaktur_code == '' || buyer_id_type != 'National ID' || (size(buyer_doc_no) == 16 && buyer_doc_no.matches('^[0-9]+$'))"
        message: {id: 'NIK pelanggan harus 16 angka'}
      - check: efaktur_code == '' || (buyer_name != '' && buyer_address != '')
        message: {id: 'Nama dan alamat pelanggan wajib diisi untuk faktur pajak'}
      - check: "efaktur_code != '' && items.map(i, i.coretax_unit == '' ? 1 : 0).sum() == 0"
        message: {id: 'Faktur ini diajukan sebelum ekspor Coretax dipasang: buat faktur pajaknya langsung di Coretax'}
      # an amend chain whose middle invoice froze before this module (its origin unknown): audit pajak 7 Nov D2
      - check: efaktur_code == '' || origin_posting_date != ''
        message: {id: 'Faktur ini mengganti faktur yang diajukan sebelum ekspor Coretax dipasang: buat faktur pajaknya langsung di Coretax'}
      - check: origin_posting_date == '' || origin_posting_date >= doc.period_start
        message: {id: 'Faktur ini mengganti faktur masa sebelumnya: buat Faktur Pengganti di Coretax, jangan diimpor'}
      - check: "efaktur_code == '' || items.map(i, i.qty * 100 - round(i.qty * 100) > 0.000001 || round(i.qty * 100) - i.qty * 100 > 0.000001 ? 1 : 0).sum() == 0"
        message: {id: 'Jumlah barang di faktur pajak maksimal 2 desimal: pakai satuan yang lebih kecil (misalnya gram)'}
      - check: efaktur_code == '' || buyer_id_type != 'Passport' || buyer_country != 'IDN'
        message: {id: 'Pembeli dengan paspor harus punya kode negara selain IDN di Data pajak pelanggan'}
      # Keterangan Tambahan and Cap Fasilitas are validated by DJP for 07/08 (template v1.6.1, sheet Keterangan)
      - check: "(efaktur_code != '07' && efaktur_code != '08') || (coretax_add_info != '' && coretax_stamp != '')"
        message: {id: 'Faktur PPN dibebaskan atau tidak dipungut belum punya fasilitas PPN: pilih fasilitasnya di faktur'}
