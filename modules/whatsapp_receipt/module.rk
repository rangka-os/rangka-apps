# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/module.json
name: whatsapp_receipt
version: 1.0.0
title: {id: Struk digital lewat WhatsApp, en: WhatsApp receipts}
summary:
  id: Struk dikirim ke WhatsApp pembeli setelah dibayar di kasir, kalau pembeli memberi nomor dan setuju.
  en: The receipt goes to the buyer's WhatsApp after paying at the kasir, when the buyer gives a number and agrees.
category: sales
icon: send-plane-line
# One message type of the WhatsApp service (module whatsapp): installing this module is switching "Struk digital" on,
# removing it switches it off, each through a change set the owner approves. The cashier asks "Kirim struk ke
# WhatsApp?" and ticks wa_receipt with the buyer's number (pos_sale.wa_phone): nothing is sent without the tick.
requires: {rangka: '>=0.5', users: ^1.2, outlets: ^1.2, pos: ^1.3, whatsapp: ^1.0}
