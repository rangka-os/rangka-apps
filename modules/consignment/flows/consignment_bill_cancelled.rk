# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: consignment_bill_cancelled
label: {id: Setoran titipan dibatalkan}
# A cancelled settlement leaves its bill alone (a flow cannot cancel a document); head office is told which bill to
# check, cancel or amend, so the payable follows the settlement.
on: consignment_settlement.cancelled
steps:
  - {find: vendor_bill, where: "vendor == event.consignor && bill_no == event.bill_ref && docstatus != 2", as: bill}
  - notify: head_office
    if: bill != null
    channel: in_app
    template: {id: 'Setoran titipan {event.name} dibatalkan. Cek tagihan {bill.name}: batalkan kalau sudah diajukan, atau ubah drafnya'}
