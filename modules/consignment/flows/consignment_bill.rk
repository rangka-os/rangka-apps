# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: consignment_bill
label: {id: Tagihan setoran titipan}
# Runs in the submitter's transaction (rangka-os #34): the submitted settlement becomes a draft vendor_bill for the
# consignor with one line per item sold (qty_sold x rate), bill_no = the settlement number, so head office pays it
# like any supplier bill and the payable starts only when that bill is submitted.
on: consignment_settlement.submitted
if: event.total > 0
steps:
  - create: vendor_bill
    set:
      vendor: event.consignor
      bill_no: event.name
      bill_date: event.period_end
      items: "event.items.filter(i, i.qty_sold > 0).map(i, {'item': i.item, 'qty': i.qty_sold, 'rate': i.rate})"
    as: bill
  - notify: head_office
    channel: in_app
    template: {id: 'Setoran titipan {event.name} jadi draf tagihan {bill.name}, cek lalu ajukan'}
