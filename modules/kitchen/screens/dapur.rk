# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/screen.json
# The station screen (kitchen 2.0, rangka-apps#131, rangka-os contract 0077): today's open tickets of the member's
# outlet (row scope), oldest first, one card per ticket. A tap on a line moves that line (the station's own verbs:
# Proses, then Siap; "Kemas", "Siap kirim" at a packing station); "Semua siap" readies every line of the card. A line
# the cashier held waits greyed until the pass fires it; a notice from the cashier (Batal, Diubah) waits for "Oke".
# A card leaves when every line not held is ready; "Baru selesai" brings one back. "Total item" counts what is still
# to make per menu (held apart). No link to the receipt: the kitchen sees no money.
name: dapur
type: queue
label: {id: Dapur, en: Kitchen}
description: {id: 'Pesanan dari kasir masuk per stasiun; ketuk item untuk Proses, lalu Siap.'}
icon: list
roles: [kitchen, cashier, head_office]
device: tablet
theme: dark
needs: [print]
queue:
  source: {model: kitchen_ticket, filter: "date == today() && (status == 'new' || status == 'cooking' || held_count > 0)", sort: sent_at}
  card:
    title: heading
    subtitle: station
    lines: items
    line: [description, qty, note]
    age_from: sent_at
    line_show: "status == 'new' || status == 'in_progress' || held || (kind != 'normal' && !seen)"
    line_muted: held
    line_badge: badge
  # a station's own tablet shows its station only (Bar, Dapur); the device remembers the choice
  choose: station
  line_steps:
    - {when: "kind != 'normal' && !seen", label: {id: Oke}, set: {seen: true}}
    - {when: "kind == 'normal' && !held && status == 'new'", label: {id: Proses}, label_field: start_label, set: {status: in_progress}}
    - {when: "kind == 'normal' && !held && status == 'in_progress'", label: {id: Siap}, label_field: ready_label, set: {status: ready, ready_at: "now()"}}
  bulk_steps:
    - {when: "kind == 'normal' && !held && (status == 'new' || status == 'in_progress')", label: {id: Semua siap}, min: 2, set: {status: ready, ready_at: "now()"}}
  totals: {by: description, qty: qty, when: "kind == 'normal' && (status == 'new' || status == 'in_progress')", held: held, split: note}
  recall: {filter: "date == today() && status == 'ready'", sort: -ready_at, limit: 20, label: {id: Kembalikan}, when: "kind == 'normal' && status == 'ready'", set: {status: in_progress}}
  refresh: 5
  alert: new
