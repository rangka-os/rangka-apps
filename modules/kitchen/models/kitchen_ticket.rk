# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# Tiket dapur: the lines of one receipt (or open table bill) that one station prepares. Made only by the kitchen flows
# (kitchen_ticket_on_sale at payment, kitchen_ticket_on_draft on "Kirim ke dapur"), so its receipt, outlet, station
# and the lines' menu, quantity and note are read-only. Kitchen 2.0 (rangka-apps#131, rangka-os contract 0077): each
# line has its own state; staff move lines (Baru -> Diproses -> Siap -> Diambil), and the ticket's status follows its
# lines: Siap when every line not held is ready, Diambil when every line is handed over. Batal comes only from the
# receipt being voided (voided). Each status change is stamped by flow kitchen_ticket_on_update. Not submittable: a
# ticket is a work card, nothing is booked from it (no stock, no money; the receipt did that).
# Fields follow the queue slot of kernel contract 0030 §2: source (status, date, sent_at), card (heading, station,
# lines items with description, qty, note), steps (set status), columns by status.
name: kitchen_ticket
label: {id: Tiket dapur, en: Kitchen ticket}
icon: list
naming: TKD-{outlet.code}-{YY}{MM}-{#####}
title_field: heading
permissions:
  # the flow makes the tickets as whoever took the payment (cashier, or head office on any outlet), and voids them as
  # whoever voids the receipt; a ticket typed by hand has no lines (read-only) and is refused (min_rows);
  # the cashier (or the waiter on the cashier's login) marks a ready ticket picked up
  - {role: head_office, read: true, create: true, write: true, export: true, print: true}
  - {role: cashier, read: true, create: true, write: true, print: true}
  - {role: kitchen, read: true, write: true, print: true}
  - {role: outlet_staff, read: true}
fields:
  - {name: sale, type: link, to: pos_sale, label: {id: Struk}, read_only: true, in_list: true}
  - {name: outlet, type: link, to: outlet, label: {id: Outlet}, read_only: true, in_list: true}
  - {name: station, type: link, to: kitchen_station, label: {id: Stasiun}, read_only: true, in_list: true}
  - {name: date, type: date, label: {id: Tanggal}, read_only: true, default: today(), in_list: true}
  - {name: buyer, type: data, label: {id: Pembeli atau meja}, read_only: true}
  # a corrected receipt (void, then amend) sends its lines again: the kitchen sees it is a revision of the earlier one
  - {name: revision_of, type: link, to: pos_sale, label: {id: Revisi dari struk}, read_only: true}
  # the card's title: the table or buyer when the cashier typed one, else the receipt number; REVISI first for a
  # corrected receipt
  - name: heading
    type: data
    label: {id: Pesanan}
    compute: "(revision_of != '' ? 'REVISI ' : '') + (buyer != '' ? buyer : sale)"
    in_list: true
  # staff write only the lines' state (status, held, seen, stamps); their menu, quantity and note stay read-only
  - {name: items, type: table, of: kitchen_ticket_item, label: {id: Menu}, min_rows: 1}
  # the station's own verbs, copied when the ticket is made: "Kemas" and "Siap kirim" at a packing station
  - {name: start_label, type: data, label: {id: Tombol mulai}, read_only: true, hidden: true}
  - {name: ready_label, type: data, label: {id: Tombol siap}, read_only: true, hidden: true}
  - {name: held_count, type: int, label: {id: Item ditahan}, compute: "items.filter(l, l.kind == 'normal' && l.held).size()"}
  # notice lines (Batal, Diubah) are not portions
  - {name: item_count, type: float, label: {id: Jumlah porsi}, compute: "items.filter(l, l.kind == 'normal').map(l, l.qty).sum()"}
  # the lines handed over, as a list a flow can read (a flow's find does not load table rows): a revision of the receipt
  # does not make again what already went out (flow kitchen_ticket_on_sale). Per line, so a partly handed-over ticket
  # counts what left; notice lines (Batal, Diubah) never count
  - {name: served, type: json, label: {id: Menu (data)}, hidden: true, compute: "items.filter(l, l.kind == 'normal' && l.status == 'done').map(l, {'item': l.item, 'qty': l.qty})"}
  # set by flow kitchen_ticket_on_void on a ticket already picked up when its receipt is voided: it stays Diambil
  - {name: sale_void, type: check, label: {id: Struk dibatalkan}, read_only: true}
  # set by flow kitchen_ticket_on_void when the receipt is voided before the food went out
  - {name: voided, type: check, label: {id: Batal}, read_only: true}
  - name: status
    type: select
    label: {id: Status}
    in_list: true
    chip: true
    compute: >-
      voided ? 'void' :
      (items.filter(l, l.kind == 'normal').all(l, l.status == 'done') && items.filter(l, l.kind != 'normal').all(l, l.seen) ? 'picked_up' :
      (items.filter(l, l.kind == 'normal' && !l.held).size() > 0 && items.filter(l, l.kind == 'normal' && !l.held).all(l, l.status == 'ready' || l.status == 'done') ? 'ready' :
      (items.exists(l, l.kind == 'normal' && l.status != 'new') ? 'cooking' : 'new')))
    options:
      - {value: new, label: {id: Baru}, tone: neutral}
      - {value: cooking, label: {id: Diproses}, tone: info}
      - {value: ready, label: {id: Siap}, tone: ok}
      - {value: picked_up, label: {id: Diambil}, tone: muted}
      - {value: void, label: {id: Batal}, tone: bad}
  # what a guest reads on the board: the table or buyer, else the receipt's last three digits ("No. 005")
  - {name: board_title, type: data, label: {id: Nomor di layar tamu}, compute: "buyer != '' ? buyer : (size(sale) > 3 ? 'No. ' + sale.replace(truncate(sale, size(sale) - 3), '') : sale)"}
  # the guest board's two columns (screen siap_ambil)
  - name: board
    type: select
    label: {id: Papan tamu}
    compute: "status == 'ready' ? 'ready' : 'preparing'"
    options:
      - {value: preparing, label: {id: Sedang disiapkan}}
      - {value: ready, label: {id: Siap diambil}}
  # when each step happened (flow kitchen_ticket_on_update); sent_at is the moment the receipt was paid
  - {name: sent_at, type: datetime, label: {id: Masuk dapur}, read_only: true, default: now()}
  - {name: cooking_at, type: datetime, label: {id: Mulai diproses}, read_only: true}
  - {name: ready_at, type: datetime, label: {id: Siap}, read_only: true}
  - {name: picked_up_at, type: datetime, label: {id: Diambil}, read_only: true}
  - {name: void_at, type: datetime, label: {id: Dibatalkan}, read_only: true}
views:
  list:
    columns: [name, heading, station, status, sent_at, item_count, outlet]
    filters: [outlet, station, status, date]
    sort: -sent_at
  kanban:
    group_by: status
    title: heading
    card: [station, item_count, sent_at]
  form:
    layout:
      - section: {id: Tiket}
        columns:
          - [heading, station, status]
          - [sale, outlet, date, buyer, revision_of]
      - section: {id: Menu}
        fields: [items]
      - section: {id: Waktu}
        columns:
          - [sent_at, cooking_at, ready_at]
          - [picked_up_at, void_at]
