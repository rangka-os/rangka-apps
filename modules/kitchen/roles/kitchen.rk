# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/role.json
name: kitchen
label: {id: Dapur}
description: {id: 'Melihat tiket dapur outlet tempatnya bekerja dan menandai tiap item diproses dan siap'}
# a kitchen TV or wall tablet runs the work shell (contract 0030 §3): the kitchen screen full width with its rail, the
# lists under Lainnya (rangka-apps#131)
desk: false
# Contract 0010 §5: only the tickets and stations of the member's outlets. No money: a ticket carries no price.
scope: {field: outlet, from: user.outlets}
