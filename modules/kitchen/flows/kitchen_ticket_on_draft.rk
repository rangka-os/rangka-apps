# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# "Kirim ke dapur" on an open table bill (rangka-apps#122, contract 0048 Open 3). The counter sets send_kitchen on the draft;
# this flow runs inside that write, as the cashier: one ticket per active station with the routed lines the kitchen was
# not sent yet (line_key not in sent_to_kitchen), then it records them and clears send_kitchen. Each ticket line keeps
# the bill line's key and whether the cashier held it (kitchen_hold: the line waits at the station until the pass
# fires it, rangka-apps#131). Notices for lines the kitchen already got (kitchen 2.0): a line the cashier removed makes
# a line of kind void ("Batal") at its station, and a line whose quantity went down or whose note changed makes a line
# of kind change ("Diubah", with what it was), so the kitchen stops or adjusts. The station taps "Oke" on a notice.
# Lines without a line_key are never sent from here (the payment flow handles them). At payment flow
# kitchen_ticket_on_sale skips every recorded line, so each line reaches the kitchen once. An amended copy (a receipt
# paid again) never sends from here: its tickets come from kitchen_ticket_on_sale, which knows what the voided
# receipt's kitchen already served.
name: kitchen_ticket_on_draft
label: {id: 'Kirim pesanan meja ke dapur sebelum dibayar'}
description: {id: 'Barang baru di tagihan meja dikirim ke stasiun dapur; barang yang dihapus atau diubah setelah terkirim dikirim sebagai Batal atau Diubah'}
on: pos_sale.updated
if: "event.docstatus == 0 && event.table != '' && event.send_kitchen && !event.merged && (!has(event.amended_from) || event.amended_from == '')"
steps:
  - {find: pos_sale, where: "name == event.name", as: src}
  - {find: dining_table, where: "name == event.table", as: tbl}
  - {find_all: kitchen_station, where: outlet == event.outlet && active, as: stations}
  - {find_all: kitchen_route, where: outlet == event.outlet, as: routes}
  - for_each: stations
    as: st
    do:
      - if: "event.items.filter(l, l.line_key != '' && !(l.line_key in event.sent_to_kitchen.map(s, s.key)) && routes.filter(r, r.station == st.name && r.category == l.category).size() > 0).size() > 0"
        create: kitchen_ticket
        set:
          sale: event.name
          outlet: event.outlet
          station: st.name
          date: event.date
          buyer: tbl.table_name
          start_label: st.start_label
          ready_label: st.ready_label
          items: "event.items.filter(l, l.line_key != '' && !(l.line_key in event.sent_to_kitchen.map(s, s.key)) && routes.filter(r, r.station == st.name && r.category == l.category).size() > 0).map(l, {'item': l.item, 'description': l.description, 'qty': l.qty, 'uom': l.uom, 'note': l.note, 'line_key': l.line_key, 'held': l.kitchen_hold})"
      - if: "event.sent_to_kitchen.filter(s, !(s.key in event.items.map(l, l.line_key)) && routes.filter(r, r.station == st.name && r.category == s.category).size() > 0).size() > 0"
        create: kitchen_ticket
        set:
          sale: event.name
          outlet: event.outlet
          station: st.name
          date: event.date
          buyer: tbl.table_name
          start_label: st.start_label
          ready_label: st.ready_label
          items: "event.sent_to_kitchen.filter(s, !(s.key in event.items.map(l, l.line_key)) && routes.filter(r, r.station == st.name && r.category == s.category).size() > 0).map(s, {'item': s.item, 'description': s.description, 'qty': s.qty, 'uom': s.uom, 'note': s.note, 'line_key': s.key, 'kind': 'void'})"
      - if: "event.items.filter(l, l.line_key != '' && event.sent_to_kitchen.exists(s, s.key == l.line_key && (s.qty != l.qty || s.note != l.note)) && routes.filter(r, r.station == st.name && r.category == l.category).size() > 0).size() > 0"
        create: kitchen_ticket
        set:
          sale: event.name
          outlet: event.outlet
          station: st.name
          date: event.date
          buyer: tbl.table_name
          start_label: st.start_label
          ready_label: st.ready_label
          items: "event.items.filter(l, l.line_key != '' && event.sent_to_kitchen.exists(s, s.key == l.line_key && (s.qty != l.qty || s.note != l.note)) && routes.filter(r, r.station == st.name && r.category == l.category).size() > 0).map(l, {'item': l.item, 'description': l.description, 'qty': l.qty, 'uom': l.uom, 'note': (l.note != '' ? l.note + ' ' : '') + '(tadi ' + event.sent_to_kitchen.filter(s, s.key == l.line_key).map(s, string(s.qty) + '×' + (s.note != '' ? ', ' + s.note : ''))[0] + ')', 'line_key': l.line_key, 'kind': 'change'})"
  # every keyed line is now known to the kitchen, with its current quantity and note (a later change is compared with it)
  - update: src
    set:
      sent_to_kitchen: "event.items.filter(l, l.line_key != '').map(l, {'key': l.line_key, 'item': l.item, 'packing': l.packing, 'description': l.description, 'qty': l.qty, 'uom': l.uom, 'note': l.note, 'category': l.category})"
      send_kitchen: "false"
