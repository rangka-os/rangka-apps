# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Kitchen 2.0 (rangka-apps#131): staff move a ticket's lines (status, held, seen, stamps); the ticket's status follows
# its lines (kitchen_ticket.status compute). This flow runs inside every staff write, as the writer, and refuses through
# kitchen_guard what a screen never does: changing a voided ticket, removing a line, moving a held line (fire it first:
# "Lepas", then move it in a later write), moving
# a notice line (Batal, Diubah), holding a line that is already being made, or un-reading a notice. Each change of the
# ticket's status is stamped with its time; a step back clears the stamps after it. Writes by flows start no flow, so
# the kitchen flows that make and void tickets are not checked here.
name: kitchen_ticket_on_update
label: {id: 'Tiket dapur diubah: periksa per item, catat waktunya'}
on: kitchen_ticket.updated
if: event.before != null
steps:
  - if: event.before.voided
    create: kitchen_guard
    set: {reason: "'ticket_void'", document: event.name}
  # a picked-up ticket of a voided receipt stays picked up: its receipt no longer exists to prepare for
  - if: event.before.status == 'picked_up' && event.sale_void && event.status != 'picked_up'
    create: kitchen_guard
    set: {reason: "'sale_void'", document: event.name}
  # a line left out of the write would be deleted: staff never remove lines (the cashier's notices do that)
  - if: "event.before.items.exists(b, !event.items.exists(l, l.name == b.name))"
    create: kitchen_guard
    set: {reason: "'line_removed'", document: event.name}
  # a held line does not move, not even in the write that fires it (Lepas sets held false and nothing else)
  - if: "event.items.exists(l, event.before.items.exists(b, b.name == l.name && b.held && b.status != l.status))"
    create: kitchen_guard
    set: {reason: "'held_line'", document: event.name}
  - if: "event.items.exists(l, l.kind != 'normal' && event.before.items.exists(b, b.name == l.name && (b.status != l.status || b.held != l.held || (b.seen && !l.seen))))"
    create: kitchen_guard
    set: {reason: "'notice_line'", document: event.name}
  - if: "event.items.exists(l, l.held && event.before.items.exists(b, b.name == l.name && !b.held && b.status != 'new'))"
    create: kitchen_guard
    set: {reason: "'hold_started'", document: event.name}
  - if: event.before.status != event.status
    then:
      - {find: kitchen_ticket, where: name == event.name, as: t}
      - update: t
        set:
          cooking_at: "event.status == 'new' ? null : (event.status == 'cooking' && t.cooking_at == null ? now() : t.cooking_at)"
          ready_at: "event.status == 'new' || event.status == 'cooking' ? null : (event.status == 'ready' && t.ready_at == null ? now() : t.ready_at)"
          picked_up_at: "event.status == 'picked_up' ? now() : null"
