# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# A ticket's status moves one step at a time, forward or back (Baru -> Dimasak -> Siap -> Diambil; back is the work
# screen's "Urungkan"), and each step is stamped with its time; a step back clears the stamp of the step undone. Batal
# is set only by flow kitchen_ticket_on_void (writes by flows start no flow), so a person cannot void a ticket, and a
# void ticket does not come back, nor does a picked-up ticket of a voided receipt (sale_void). Runs inside the write, as the writer; kitchen_guard refuses the write.
name: kitchen_ticket_on_update
label: {id: 'Tiket dapur diubah: satu langkah, catat waktunya'}
on: kitchen_ticket.updated
if: event.before != null && event.before.status != event.status
steps:
  - if: event.before.status == 'void'
    create: kitchen_guard
    set: {reason: "'ticket_void'", document: event.name}
  - if: event.status == 'void'
    create: kitchen_guard
    set: {reason: "'void_by_receipt'", document: event.name}
  # a picked-up ticket of a voided receipt stays picked up: its receipt no longer exists to cook for
  - if: event.before.status == 'picked_up' && event.sale_void
    create: kitchen_guard
    set: {reason: "'sale_void'", document: event.name}
  # positions 0..3; a jump of more than one step is refused
  - if: "event.status != 'void' && event.before.status != 'void' && ({'new': 0, 'cooking': 1, 'ready': 2, 'picked_up': 3}[event.status] - {'new': 0, 'cooking': 1, 'ready': 2, 'picked_up': 3}[event.before.status]) * ({'new': 0, 'cooking': 1, 'ready': 2, 'picked_up': 3}[event.status] - {'new': 0, 'cooking': 1, 'ready': 2, 'picked_up': 3}[event.before.status]) > 1"
    create: kitchen_guard
    set: {reason: "'one_step'", document: event.name}
  - {find: kitchen_ticket, where: name == event.name, as: t}
  - update: t
    set:
      cooking_at: "event.status == 'new' ? null : (event.status == 'cooking' && event.before.status == 'new' ? now() : t.cooking_at)"
      ready_at: "event.status == 'new' || event.status == 'cooking' ? null : (event.status == 'ready' && event.before.status == 'cooking' ? now() : t.ready_at)"
      picked_up_at: "event.status == 'picked_up' ? now() : null"
