# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/screen.json
name: catat_tagih
type: entry
label: {id: Catat uang tertagih, en: Record cash collected}
icon: wallet
# Cash taken at the subscriber's place (contract 0030 §2 entry): one field_collection. Opened from rute_tagih the
# subscription is filled (stop); opened alone the collector picks it. The flows field_collection_cap_* refuse more
# than what the subscription still owes and a subscriber of another area; the cash reaches the books through the
# collector's deposit (collector_deposit), checked by finance.
roles: [collector]
device: phone
offline: queue
entry:
  model: field_collection
  fields: [subscription, amount, notes]
  set: {subscription: stop.name, collector: user.name}
  submit: false
  again: false
