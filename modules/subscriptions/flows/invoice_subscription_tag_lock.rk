# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: invoice_subscription_tag_lock
label: {id: Catatan faktur langganan dikunci}
# The invoice of a subscription bill is found by the tags in its notes. Nobody adds, removes or edits notes that carry
# one by hand (a flow's writes start no flows, so the billing flow is not refused).
on: sales_invoice.updated
if: event.before != null && event.notes != event.before.notes
steps:
  - if: event.before.notes.contains('{langganan:') || event.notes.contains('{langganan:')
    create: subscription_guard
    set:
      reason: "'invoice_tag'"
      document: event.name
