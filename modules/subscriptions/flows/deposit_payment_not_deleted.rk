# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: deposit_payment_not_deleted
label: {id: Pembayaran dari setoran tidak dihapus}
# The payment of a deposited collection (its number in [] in the notes) is cash counted into Kas: it is not
# deleted (the collection would stay deposited with no payment).
on: payment.deleted
if: event.direction == 'receive' && event.notes.startsWith('Setoran ')
steps:
  - {find: field_collection, where: "deposit != '' && event.notes.contains('[' + name + ']')", as: c}
  - if: c != null
    create: subscription_guard
    set:
      reason: "'deposit_payment'"
      document: event.name
