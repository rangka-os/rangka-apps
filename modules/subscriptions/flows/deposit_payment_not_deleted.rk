# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: deposit_payment_not_deleted
label: {id: Pembayaran dari setoran tidak dihapus}
# A draft payment a field collection names is not deleted (the collection would be marked deposited with no payment).
on: payment.deleted
if: event.direction == 'receive'
steps:
  - {find: field_collection, where: payment == event.name, as: c}
  - if: c != null
    create: subscription_guard
    set:
      reason: "'deposit_payment'"
      document: event.name
