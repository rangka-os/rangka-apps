# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: subscription_dunning
label: {id: Status layanan dan rekap langganan}
# Every day at 02:00 (open-isp practice), and by the owner from the flow list. The dunning ladder, per subscription that
# is not finally stopped, from its submitted invoices still unpaid (found once for the run, oldest due date first):
# - stopped: its end date has come; or stop_after_days > 0 and the oldest unpaid invoice is that many days past due,
#   which sets the end date (today, or the end of the periods already billed when that is later);
# - suspended: the oldest unpaid invoice is suspend_after_days or more past due (isolir; the owner is told);
# - late: past due, less than that; active: nothing past due (paying lifts a suspension, also at once through flow
#   subscription_status_on_payment).
# The flow writes the facts (unpaid_amount, overdue_amount, oldest_due, checked_on; prev_status keeps the status before)
# and the subscription computes its status from them; a change of status writes a subscription_status_log row. Reminders are not sent from here: the dashboard lists the invoices due in 3 days and those past due, and
# each invoice has the print *Pesan tagihan WA* (the WhatsApp connector sends them later).
# Then the month recap (subscription_month) of this month and the month before: submitted subscription invoices dated
# in the month, what of them is paid, and (this month) the running subscriptions and MRR.
schedule: '0 2 * * *'
steps:
  - find_all: sales_invoice
    where: docstatus == 1 && outstanding > 0 && notes.contains('{langganan:')
    sort: due_date
    as: allopen
  - find_all: subscription
    where: status != 'stopped' || end_date == '' || end_date > today()
    sort: name
    limit: 2000
    as: subs
  - for_each: subs
    as: s
    do:
      - update: s
        set:
          prev_status: s.status
          unpaid_amount: "allopen.filter(i, i.notes.contains('{langganan:' + s.name + '}')).map(i, i.outstanding).sum()"
          overdue_amount: "allopen.filter(i, i.notes.contains('{langganan:' + s.name + '}')).filter(i, i.due_date < today()).map(i, i.outstanding).sum()"
          oldest_due: "size(allopen.filter(i, i.notes.contains('{langganan:' + s.name + '}'))) > 0 ? allopen.filter(i, i.notes.contains('{langganan:' + s.name + '}'))[0].due_date : ''"
          checked_on: today()
      - update: s
        if: s.stop_due
        set:
          end_date: "today() >= add_months(s.anchor_date, s.billed_months) ? today() : add_months(s.anchor_date, s.billed_months)"
      - create: subscription_status_log
        if: s.status != s.prev_status
        set:
          subscription: s.name
          changed_on: today()
          from_status: s.prev_status
          to_status: s.status
          overdue_since: s.overdue_since
          overdue_amount: s.overdue_amount
      - notify: owner
        if: s.status == 'suspended' && s.prev_status != 'suspended'
        channel: email
        template: {id: 'Layanan {s.customer_name} ({s.name} {s.service_id}) ditangguhkan: telat {s.late_days} hari, Rp {s.overdue_amount}. Isolir bila perlu.'}
  - find_all: subscription
    where: status != 'stopped'
    as: live
  - for_each: "[truncate(today(), 7), truncate(add_months(truncate(today(), 7) + '-01', -1), 7)]"
    as: m
    do:
      - {find: subscription_month, where: month == m, as: rec}
      - create: subscription_month
        if: rec == null
        set: {month: m}
        as: rec
      - find_all: sales_invoice
        where: docstatus == 1 && notes.contains('{langganan:') && truncate(posting_date, 7) == m
        as: invs
      - update: rec
        set:
          billed: invs.map(i, i.amount_due).sum()
          collected: invs.map(i, i.amount_due - i.outstanding).sum()
          invoices: size(invs)
          active_count: "m == truncate(today(), 7) ? size(live) : rec.active_count"
          mrr: "m == truncate(today(), 7) ? live.map(x, x.monthly_net).sum() : rec.mrr"
          refreshed_on: today()
