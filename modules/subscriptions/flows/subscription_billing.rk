# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: subscription_billing
label: {id: Tagihan langganan otomatis}
# Every day at 00:05 (scheduler.timezone of system.rk), and by the owner from the flow list: each subscription whose
# next bill date has come (before its end date; a period the end date cuts is billed up to the day before it,
# pro-rated) gets its next period billed. One run bills one period per
# subscription (the oldest unbilled); a subscription behind by several periods catches up one period per run. Per
# subscription, in the run's one transaction (contract 0031 for_each):
# 1. the active extras overlapping the period (one-off ones not billed before); an extra every period is pro-rated on
#    a bill shorter than a full cycle (pro-rated start, a period an end date cuts, the rest of a cut period) by the same
#    share as the plan line (next_amount over a full cycle at the price of that period: last_cycle_value for the rest of
#    a cut period), so the pieces of one period add up to one extra;
# 2. a subscription_bill (period_key unique: the same period is never billed twice);
# 3. a draft sales invoice dated the period's first day, due due_days after it, one line for the plan and one per extra,
#    notes with {langganan:<subscription>} and [<bill>] (a flow cannot submit: finance checks and submits it, then
#    payment, reminders, aging, PPN and bank matching are the money rail's);
# 4. the extras taken are marked, the subscription moves on (prorata_billed or billed_months) and its start date and
#    anchor and customer are locked; billed_through is the day after the period billed. A period an end date cut short
#    whose end date was then taken away (the client stays) is billed for the rest of it first, pro-rated against the
#    full period (kind remainder), before the next full period.
# At most 500 subscriptions per run (the oldest bill dates first); the next run takes the rest.
schedule: '5 0 * * *'
steps:
  - find_all: subscription
    where: "next_bill_date != '' && next_bill_date <= today() && (end_date == '' || next_bill_date < end_date)"
    sort: next_bill_date
    limit: 500
    as: due
  - for_each: due
    as: s
    do:
      - find_all: subscription_extra
        where: >-
          subscription == s.name && active && from_date <= s.next_period_end
            && (until_date == '' || until_date >= s.next_bill_date) && (repeat == 'every_period' || billed_bill == '')
        sort: name
        as: extras
      - create: subscription_bill
        set:
          subscription: s.name
          customer: s.customer
          kind: "s.next_is_prorata ? 'prorata' : (s.resume ? 'remainder' : 'regular')"
          period_start: s.next_bill_date
          period_end: s.next_period_end
          months: "s.next_is_prorata || s.resume ? 0 : s.cycle_months"
          base_amount: s.next_amount
          extras_total: "extras.map(x, (x.repeat == 'once' ? x.amount : round(x.amount * s.next_amount / (s.resume ? s.last_cycle_value : s.monthly_net * s.cycle_months)))).sum()"
          due_date: s.next_bill_date + duration(s.due_days)
        as: bill
      - create: sales_invoice
        set:
          customer: s.customer
          posting_date: s.next_bill_date
          due_date: bill.due_date
          notes: "'Langganan ' + s.plan_name + ' periode ' + bill.period_start + ' s.d. ' + bill.period_end + ' {langganan:' + s.name + '} [' + bill.name + ']'"
          items: >-
            [{'item': s.item, 'description': s.plan_name + ' ' + bill.period_start + ' s.d. ' + bill.period_end
              + (s.next_is_prorata ? ' (prorata)' : ''), 'qty': 1, 'rate': bill.base_amount}]
              + extras.map(x, {'item': x.item, 'description': x.description, 'qty': 1, 'rate': (x.repeat == 'once' ? x.amount : round(x.amount * s.next_amount / (s.resume ? s.last_cycle_value : s.monthly_net * s.cycle_months)))})
        as: inv
      - for_each: extras
        as: x
        do:
          - update: x
            set:
              last_bill: bill.name
              billed_bill: "x.repeat == 'once' ? bill.name : x.billed_bill"
      - update: s
        set:
          prorata_billed: "s.next_is_prorata ? true : s.prorata_billed"
          billed_months: "s.next_is_prorata || s.resume ? s.billed_months : s.billed_months + s.cycle_months"
          last_period_start: "s.resume ? s.last_period_start : s.next_bill_date"
          last_full_amount: "s.resume ? s.last_full_amount : s.cycle_amount"
          last_cycle_value: "s.resume ? s.last_cycle_value : s.monthly_net * s.cycle_months"
          last_bill: bill.name
          locked_start: s.start_date
          locked_anchor: s.anchor
          locked_customer: s.customer
          billed_through: s.next_period_end + duration(1)
