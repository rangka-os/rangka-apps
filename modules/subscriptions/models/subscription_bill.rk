# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: subscription_bill
label: {id: Tagihan langganan, en: Subscription bill}
icon: invoice
naming: TLG-{YYYY}-{#####}
title_field: customer_name
# One billed period of a subscription, made only by flow subscription_billing (no role creates or edits one; every
# field is read-only). It holds the period and the amounts; the draft invoice the flow made carries this bill's number
# in [] and {langganan:<subscription>} in its notes (found by that tag: a draft is renamed when submitted), and can be
# submitted only for exactly this bill's total, to its customer, once (flow invoice_subscription_once); the last live
# invoice of a bill is not deleted (flow invoice_subscription_kept). period_key is unique: a period is billed once whatever
# runs the flow. A wrong invoice is cancelled and amended (the amended copy keeps the tags); the bill stays as the
# record that the period was billed.
permissions:
  - {role: finance_manager, read: true, export: true, print: true}
  # flow invoice_subscription_once reads bills as whoever submits an invoice
  - {role: sales_manager, read: true}
fields:
  - {name: subscription, type: link, to: subscription, label: {id: Langganan}, required: true, read_only: true, in_list: true}
  - {name: customer, type: link, to: customer, label: {id: Pelanggan}, required: true, read_only: true}
  - {name: customer_name, type: data, label: {id: Nama pelanggan}, compute: customer.customer_name, in_list: true}
  - name: kind
    type: select
    label: {id: Jenis}
    read_only: true
    in_list: true
    options:
      - {value: regular, label: {id: Periode penuh}}
      - {value: prorata, label: {id: Prorata}}
      - {value: remainder, label: {id: Sisa periode}}
  - {name: period_start, type: date, label: {id: Periode mulai}, required: true, read_only: true, in_list: true}
  - {name: period_end, type: date, label: {id: Periode sampai}, required: true, read_only: true, in_list: true}
  - {name: months, type: int, label: {id: Bulan}, read_only: true}
  - {name: base_amount, type: currency, label: {id: Nilai paket}, read_only: true}
  - {name: extras_total, type: currency, label: {id: Tambahan}, read_only: true}
  - {name: total, type: currency, label: {id: Total sebelum PPN}, compute: base_amount + extras_total, in_list: true}
  - {name: due_date, type: date, label: {id: Jatuh tempo}, read_only: true}
  - {name: period_key, type: data, label: {id: Kunci periode}, hidden: true, unique: true, compute: "subscription + '|' + period_start"}
rules:
  - name: period_valid
    on: save
    check: period_end >= period_start && base_amount >= 0 && extras_total >= 0 && base_amount + extras_total > 0
    message: {id: 'Periode atau nilai tagihan tidak sah'}
views:
  list:
    columns: [name, customer_name, kind, period_start, period_end, total]
    filters: [subscription, kind]
    sort: -period_start
