# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: item
label: {id: Barang}
icon: stock
naming: BRG-{####}
title_field: item_name
permissions:
  - {role: sales_manager, read: true, create: true, write: true, print: true}
  - {role: finance_manager, read: true, create: true, write: true, print: true}
  - {role: purchasing_manager, read: true, create: true, write: true, print: true}
  - {role: project_admin, read: true, create: true, write: true, print: true}
  - {role: head_office, read: true, create: true, write: true, import: true, print: true}
  - {role: outlet_staff, read: true}
  - {role: sales_rep, read: true}
  - {role: field_sales, read: true}
  # course schools: the program's line on the invoice
  - {role: course_admin, read: true}
  - {role: cashier, read: true}
fields:
  - name: item_name
    type: data
    label: {id: Nama barang}
    required: true
    in_list: true
  - name: sku
    type: data
    label: {id: SKU}
    in_list: true
    unique: true
  # A shop scans or types the barcode (EAN-13 / PLU) printed on the pack; a POS export usually carries it as the SKU.
  - name: barcode
    type: data
    label: {id: Barcode}
    unique: true
  - name: category
    type: link
    to: item_category
    label: {id: Kategori}
    in_list: true
  # Variants are separate items (every Indonesian POS exports a variant as its own SKU). Items of one product share
  # variant_group (e.g. KAOS-POLOS) and differ in variant_label (e.g. "M / Hitam"); no size x colour generator.
  - name: variant_group
    type: data
    label: {id: Grup varian}
    help: {id: 'Kode yang sama untuk semua varian satu produk, misalnya KAOS-POLOS'}
  - name: variant_label
    type: data
    label: {id: Varian}
    help: {id: 'Misalnya "M / Hitam" atau "600 ml"'}
  - name: kind
    type: select
    label: {id: Jenis}
    required: true
    in_list: true
    default: "'good'"
    options:
      - {value: service, label: {id: Jasa}}
      - {value: good, label: {id: Barang}}
      - {value: material, label: {id: Bahan baku}}
      - {value: product, label: {id: Produk jadi}}
  - name: stock_uom
    type: link
    to: uom
    label: {id: Satuan stok}
    required: true
    in_list: true
  - name: sales_uom
    type: link
    to: uom
    label: {id: Satuan jual}
  - name: rate
    type: currency
    label: {id: Harga jual}
    in_list: true
  # Tier prices of a distributor (module distribution): a customer's price_tier picks rate, rate_wholesale or
  # rate_agent on its orders. Empty (0) falls back to rate.
  - name: rate_wholesale
    type: currency
    label: {id: Harga grosir}
    depends_on: app_installed('distribution')
  - name: rate_agent
    type: currency
    label: {id: Harga agen}
    depends_on: app_installed('distribution')
  # Production (module production): the BOM this item is made with (also how a semi-finished line costs in a
  # multi-level BOM) and its shelf life, which sets the expiry date of a batch.
  - name: default_bom
    type: link
    to: bom
    label: {id: Resep produksi}
    depends_on: app_installed('production')
  - name: shelf_life_days
    type: int
    label: {id: Umur simpan (hari)}
    depends_on: app_installed('production')
  - name: standard_cost
    type: currency
    label: {id: Harga pokok standar}
    hidden_for: [outlet_staff, cashier, field_sales, sales_rep]
  - name: stock
    type: float
    label: {id: Stok}
    in_list: true
  # Consignment in (barang titipan): the consignor still owns the goods; the shop pays consignment_cost per unit sold
  # in the monthly settlement (module consignment). Empty consignor = the shop's own goods.
  - name: consignor
    type: link
    to: vendor
    label: {id: Penitip}
    help: {id: 'Isi kalau barang ini titipan. Kosongkan untuk barang milik sendiri'}
    depends_on: app_installed('consignment')
  - name: consignment_cost
    type: currency
    label: {id: Harga setor titipan}
    help: {id: 'Yang dibayar ke penitip per barang terjual'}
    depends_on: app_installed('consignment') && consignor != ''
    hidden_for: [outlet_staff, cashier, field_sales, sales_rep]
  - name: notes
    type: text
    label: {id: Catatan}
  # e-Faktur (module coretax): the 6-digit Coretax goods/services code; empty = 000000 (no specific code).
  - name: coretax_code
    type: data
    label: {id: Kode barang/jasa Coretax}
    help: {id: '6 angka dari referensi kode barang/jasa Coretax. Kosongkan bila tidak tahu (000000)'}
    depends_on: app_installed('coretax')
  # Records already linked by documents cannot be deleted (kernel: 409 linked); one no longer used is switched off
  # instead and kept for its history. Hiding it from link pickers is a kernel follow-up (web).
  - name: active
    type: check
    label: {id: Aktif}
    help: {id: 'Matikan bila barang tidak dijual atau dibeli lagi. Barang yang sudah dipakai transaksi tidak bisa dihapus'}
    default: 'true'
    in_list: true
    in_filter: true
rules:
  - name: coretax_code_6
    on: save
    check: "coretax_code == '' || coretax_code.matches('^[0-9]{6}$')"
    message: {id: Kode barang/jasa Coretax harus 6 angka}
