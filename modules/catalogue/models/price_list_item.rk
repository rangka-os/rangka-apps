# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: price_list_item
is_child: true
fields:
  - name: item
    type: link
    to: item
    label: {id: Barang}
    required: true
  - name: uom
    type: link
    to: uom
    label: {id: Satuan}
  - name: rate
    type: currency
    label: {id: Harga}
    required: true
