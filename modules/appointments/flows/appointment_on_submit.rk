# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: appointment_on_submit
label: {id: 'Janji temu diajukan: cek jadwal, buat jadwal janji dan faktur uang muka'}
description: {id: 'Saat janji diajukan, jam itu dicek: staf atau tempat yang sudah dipesan, jam buka, dan libur. Kalau aman, jadwal janji dibuat dan, bila ada uang muka, draf fakturnya disiapkan.'}
# Runs inside the appointment's submit, as the person submitting it. Reading appointment_slot takes the flow read lock
# of contract 0025 (org + model), so two appointments submitted at the same moment run one after the other and the
# second one sees the first one's slot. Busy = a booked or arrived slot on the same date whose minutes overlap
# [start_min, end_min) with the same staff member or the same resource (a finished, billed or paid one has freed its
# time). Opening hours: a resource with hours must have a window for the weekday (its hours_<day> text, "HH:MM-HH:MM";
# a flow find reads no child rows) that covers the whole appointment.
# Time off: a row on the date for the staff member or the resource whose times overlap. Each failure creates an
# appointment_guard whose rule refuses the whole submit. Then the deposit's draft invoice (a flow cannot submit; its
# notes carry the appointment number in ()) and the slot.
on: appointment.submitted
steps:
  - find_all: appointment_slot
    where: >-
      date == event.date && state in ['booked', 'arrived'] && start_min < event.end_min && end_min > event.start_min
      && ((event.staff != '' && staff == event.staff) || (event.resource != '' && resource == event.resource))
    as: busy
  - create: appointment_guard
    if: "event.staff != '' && busy.exists(s, s.staff == event.staff)"
    set: {reason: "'staff_busy'", document: event.name}
  - create: appointment_guard
    if: "event.resource != '' && busy.exists(s, s.resource == event.resource)"
    set: {reason: "'resource_busy'", document: event.name}
  - {find: booking_resource, if: "event.resource != ''", where: name == event.resource, as: res}
  - create: appointment_guard
    if: >-
      event.resource != '' && res != null && res.has_hours
      && !({'mon': res.hours_mon, 'tue': res.hours_tue, 'wed': res.hours_wed, 'thu': res.hours_thu, 'fri': res.hours_fri, 'sat': res.hours_sat, 'sun': res.hours_sun}[event.weekday] != ''
      && truncate({'mon': res.hours_mon, 'tue': res.hours_tue, 'wed': res.hours_wed, 'thu': res.hours_thu, 'fri': res.hours_fri, 'sat': res.hours_sat, 'sun': res.hours_sun}[event.weekday], 5) <= event.start_time
      && {'mon': res.hours_mon, 'tue': res.hours_tue, 'wed': res.hours_wed, 'thu': res.hours_thu, 'fri': res.hours_fri, 'sat': res.hours_sat, 'sun': res.hours_sun}[event.weekday].replace(truncate({'mon': res.hours_mon, 'tue': res.hours_tue, 'wed': res.hours_wed, 'thu': res.hours_thu, 'fri': res.hours_fri, 'sat': res.hours_sat, 'sun': res.hours_sun}[event.weekday], 6), '') >= event.end_time)
    set: {reason: "'closed'", document: event.name}
  - find_all: resource_time_off
    where: >-
      date == event.date && from_time < event.end_time && to_time > event.start_time
      && ((event.staff != '' && staff == event.staff) || (event.resource != '' && resource == event.resource))
    as: away
  - create: appointment_guard
    if: away.size() > 0
    set: {reason: "'time_off'", document: event.name}
  - create: sales_invoice
    if: event.deposit > 0
    set:
      customer: event.customer
      posting_date: today()
      notes: "'Uang muka janji ' + event.date + ' ' + event.start_time + ' (' + event.name + ')'"
      items: >-
        [{'item': event.lines[0].item, 'description': 'Uang muka janji ' + event.date + ' ' + event.start_time + ': ' + event.services_text, 'qty': 1, 'rate': event.deposit}]
    as: inv
  - create: appointment_slot
    set:
      appointment: event.name
      customer: event.customer
      kind: event.kind
      outlet: "app_installed('outlets') ? event.outlet : ''"
      date: event.date
      start_time: event.start_time
      end_time: event.end_time
      start_min: event.start_min
      end_min: event.end_min
      staff: event.staff
      resource: event.resource
      party_size: event.party_size
      services: "event.kind == 'table' ? 'Reservasi meja' : event.services_text"
      lines: "event.lines.map(l, {'service': l.service, 'item': l.item})"
      service_total: event.service_total
      deposit: event.deposit
      deposit_state: "event.deposit > 0 ? 'draft' : 'none'"
      deposit_invoice: "event.deposit > 0 ? inv.name : ''"
      state: "'booked'"
