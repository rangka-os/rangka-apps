# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: appointment_invoice_on_cancel
label: {id: Faktur uang muka janji dibatalkan}
description: {id: 'Faktur uang muka yang sudah dipotong di transaksi kasir tidak bisa dibatalkan sebelum transaksinya dibatalkan.'}
# Cancelling the deposit invoice is its refund. While a live receipt (billed or paid) took the deposit off, the
# cancel is refused: the customer would get the deposit back twice. Otherwise the slot records it as cancelled.
on: sales_invoice.cancelled
if: event.notes.contains('JNJ-')
steps:
  - {find: appointment_slot, where: deposit_invoice == event.name, as: s}
  - create: appointment_guard
    if: s != null && s.deposit_applied > 0 && (s.state == 'billed' || s.state == 'paid')
    set: {reason: "'deposit_used'", document: event.name}
  - update: s
    if: s != null
    set: {deposit_state: "'cancelled'"}
