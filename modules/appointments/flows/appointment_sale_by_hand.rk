# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: appointment_sale_by_hand
label: {id: Tagihan janji hanya dibuat dari Pesanan terbuka}
# An appointment's bill is drafted by flow appointment_slot_on_update ("Buat tagihan"); writes by flows start no flow,
# so every pos_sale created with "JNJ-" in its buyer is made by a person, by hand: refused (audit 2026-11-20 F2). An
# amendment does not raise a created event; the amended copy of a voided bill is refused at its submit
# (appointment_sale_on_submit, F1), and the bill is drafted again from Pesanan terbuka, where the slot is back to
# Selesai.
on: pos_sale.created
if: event.buyer.contains('JNJ-')
steps:
  - create: appointment_guard
    set: {reason: "'sale_tag'", document: event.name}
