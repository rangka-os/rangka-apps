# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: appointment_sale_on_submit
label: {id: 'Tagihan janji dibayar: janji lunas'}
description: {id: 'Hanya tagihan kasir yang dibuat dari janji (dan masih berlaku) yang bisa dibayar. Setelah dibayar janjinya lunas.'}
# A pos_sale whose buyer carries "(JNJ-...)" is an appointment's bill. The draft's number (DRAFT-...) becomes the
# receipt number at submit, so the slot is found by the tag, and the receipt is paid only while that slot is billed:
# a second draft carrying the same tag (an amendment of a voided bill) is refused once the slot is paid or back to
# done. Then the slot is paid and keeps the receipt number. Runs as the cashier paying it.
on: pos_sale.submitted
if: event.buyer.contains('JNJ-')
steps:
  - {find: appointment_slot, where: "state == 'billed' && event.buyer.contains('(' + appointment + ')')", as: s}
  - create: appointment_guard
    if: s == null
    set: {reason: "'sale_stale'", document: event.name}
  - update: s
    if: s != null
    set: {state: "'paid'", sale: event.name}
