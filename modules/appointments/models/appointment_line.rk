# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# One service of an appointment: the service, its minutes (changeable for this customer, a long-hair cut) and its
# catalogue price. Only these three are fields, because the form's grid shows every field of a line; the submit's flow
# reads the rest (title, item, active, needs a resource) from booking_service.
name: appointment_line
is_child: true
fields:
  - {name: service, type: link, to: booking_service, label: {id: Layanan}, required: true}
  - {name: duration_min, type: int, label: {id: Lama (menit)}, default: service.duration_min}
  - {name: price, type: currency, label: {id: Harga katalog}, read_only: true, compute: service.price}
