# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: resource_time_off
label: {id: Libur atau tutup, en: Time off}
icon: calendar-close-line
naming: LBR-{#####}
title_field: reason
# A staff member (a user) or a resource is not available on a date between two times ("HH:MM"; the whole day by
# default). An appointment that overlaps it is refused at submit (flow appointment_on_submit); appointments already
# booked are not moved (the screen shows them, the front desk calls the customer).
permissions:
  - {role: head_office, read: true, create: true, write: true, delete: true, export: true}
  - {role: sales_manager, read: true, create: true, write: true, delete: true, export: true}
  - {role: finance_manager, read: true}
  - {role: cashier, read: true}
  - {role: service_staff, read: true}
fields:
  - {name: staff, type: link, to: user, label: {id: Staf}, in_list: true}
  - {name: resource, type: link, to: booking_resource, label: {id: Tempat}, in_list: true}
  - {name: date, type: date, label: {id: Tanggal}, required: true, in_list: true}
  - {name: from_time, type: data, label: {id: Dari jam}, required: true, default: "'00:00'", in_list: true}
  - {name: to_time, type: data, label: {id: Sampai jam}, required: true, default: "'24:00'", in_list: true}
  - {name: reason, type: data, label: {id: Alasan}, required: true, default: "'Libur'", in_list: true}
rules:
  - name: staff_or_resource
    on: save
    check: (staff != '') != (resource != '')
    message: {id: 'Pilih satu: staf atau tempat'}
  - name: times
    on: save
    check: "from_time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') && (to_time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$') || to_time == '24:00') && to_time > from_time"
    message: {id: 'Jam ditulis JJ:MM, misalnya 13:00, dan jam selesai sesudah jam mulai'}
views:
  list:
    columns: [date, staff, resource, from_time, to_time, reason]
    filters: [staff, resource]
    sort: -date
