# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: sales_return_item
is_child: true
fields:
  - {name: item, type: link, to: item, label: {id: Barang}, required: true}
  - {name: description, type: text, label: {id: Uraian}, default: item.item_name}
  - {name: qty, type: float, label: {id: Qty retur}, default: '1'}
  - {name: uom, type: link, to: uom, label: {id: Satuan}, default: item.stock_uom}
  - name: condition
    type: select
    label: {id: Kondisi}
    default: "'good'"
    required: true
    options:
      - {value: good, label: {id: Baik (bisa dijual lagi)}}
      - {value: damaged, label: {id: Rusak}}
