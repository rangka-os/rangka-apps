# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Keeps order_fulfilment current on sales_return.cancelled: one line per item of the order, summed over the event lines of that item.
name: fulfilment_on_return_cancelled
label: {id: Perbarui pemenuhan pesanan}
on: sales_return.cancelled
if: "event.fulfilment != ''"
steps:
  - {find: order_fulfilment, where: name == event.fulfilment, as: f}
  # a find returns the record without its table rows: an update that changes nothing returns it whole
  - update: f
    if: f != null
    set: {customer: f.customer}
  - update: f
    if: f != null
    set:
      items: "f.items.map(b, {'name': b.name, 'item': b.item, 'ordered_qty': b.ordered_qty, 'rate': b.rate, 'delivered_qty': b.delivered_qty, 'returned_qty': b.returned_qty - event.items.map(l, l.item == b.item ? l.qty : 0).sum(), 'invoiced_qty': b.invoiced_qty})"
