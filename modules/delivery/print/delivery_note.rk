# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/print.json
# Surat jalan for the driver and the customer: what goes out, from where, to whom, with three signatures. No prices
# (the invoice carries them) and no total qty across lines, since the lines can be in different units.
name: delivery_note
model: delivery_note
label: {id: Surat jalan, en: Delivery note}
paper: A4
template: delivery_note.html
default: true
related:
  # unit names for the lines (a related list needs a match; uom is not submittable, so docstatus 0 loads every unit)
  uoms:
    model: uom
    match: {docstatus: docstatus}
    limit: 1000
