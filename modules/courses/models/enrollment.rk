# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: enrollment
label: {id: Pendaftaran, en: Enrollment}
icon: check
naming: DFT-{YYYY}-{#####}
title_field: student
# A student in a batch. Registered and active enrollments take a seat (flows enrollment_seats_on_*). The price and the
# way it is paid are copied from the program when the enrollment is made; once a charge of the enrollment is submitted
# they are locked (locked_* copies, written by the charge flows), so the instalments of an enrollment always add up to
# its total. One enrollment per student and batch (seat_key). Not deleted by the course admin: a student who stops is
# set to Keluar, which frees the seat and keeps the history.
permissions:
  - {role: course_admin, read: true, create: true, write: true, export: true, print: true}
  # finance writes only through the charge flows that lock the billing terms
  - {role: finance_manager, read: true, write: true, export: true, print: true}
  - {role: instructor, read: true}
fields:
  - name: student
    type: link
    to: student
    label: {id: Peserta}
    required: true
    in_list: true
  - name: batch
    type: link
    to: course_batch
    label: {id: Angkatan}
    required: true
    in_list: true
  - {name: program, type: link, to: course_program, label: {id: Program}, compute: batch.program}
  - {name: instructor, type: link, to: user, label: {id: Akun pengajar}, compute: batch.instructor}
  - name: enrolled_on
    type: date
    label: {id: Tanggal daftar}
    default: today()
    required: true
  - name: status
    type: select
    label: {id: Status}
    required: true
    default: "'registered'"
    in_list: true
    chip: true
    options:
      - {value: registered, label: {id: Daftar}}
      - {value: active, label: {id: Aktif}}
      - {value: completed, label: {id: Selesai}}
      - {value: withdrawn, label: {id: Keluar}}
  - name: left_on
    type: date
    label: {id: Tanggal keluar}
    depends_on: status == 'withdrawn'
  - name: bill_to
    type: link
    to: customer
    label: {id: Tagihan dikirim ke}
    default: student.bill_to
    hidden_for: [instructor]
  - name: billing_plan
    type: select
    label: {id: Cara bayar}
    required: true
    default: batch.program.billing_plan
    hidden_for: [instructor]
    options:
      - {value: full, label: {id: Bayar penuh}}
      - {value: installment, label: {id: Cicilan}}
      - {value: monthly, label: {id: Per bulan (SPP)}}
  - {name: price, type: currency, label: {id: Harga program}, default: batch.program.price, hidden_for: [instructor]}
  - {name: discount, type: currency, label: {id: Potongan harga}, default: '0', hidden_for: [instructor]}
  - {name: total, type: currency, label: {id: Total biaya}, compute: price - discount, in_list: true, hidden_for: [instructor]}
  - name: installments
    type: int
    label: {id: Berapa kali cicilan}
    default: batch.program.installments
    depends_on: billing_plan == 'installment'
    hidden_for: [instructor]
  - name: monthly_fee
    type: currency
    label: {id: Biaya per bulan}
    default: batch.program.monthly_fee
    depends_on: billing_plan == 'monthly'
    hidden_for: [instructor]
  # Written by the charge flows: how many charges are submitted and the terms they were made on.
  - {name: billed_count, type: int, label: {id: Tagihan diajukan}, default: '0', read_only: true, hidden_for: [instructor]}
  - {name: locked_plan, type: data, label: {id: Cara bayar terkunci}, read_only: true, hidden: true, hidden_for: [instructor]}
  - {name: locked_total, type: currency, label: {id: Total terkunci}, default: '0', read_only: true, hidden: true, hidden_for: [instructor]}
  - {name: locked_installments, type: int, label: {id: Cicilan terkunci}, default: '0', read_only: true, hidden: true, hidden_for: [instructor]}
  - {name: locked_monthly_fee, type: currency, label: {id: Biaya per bulan terkunci}, default: '0', read_only: true, hidden: true, hidden_for: [instructor]}
  - name: seat_key
    type: data
    label: {id: Kunci pendaftaran}
    hidden: true
    unique: true
    compute: "student + '|' + batch"
  - {name: notes, type: text, label: {id: Catatan}}
rules:
  - name: discount_range
    on: save
    check: price >= 0 && discount >= 0 && discount <= price
    message: {id: 'Potongan tidak boleh minus atau lebih besar dari harga'}
  - name: installments_range
    on: save
    check: billing_plan != 'installment' || (installments >= 2 && installments <= 12)
    message: {id: 'Cicilan 2 sampai 12 kali'}
  - name: monthly_needs_fee
    on: save
    check: billing_plan != 'monthly' || monthly_fee > 0
    message: {id: 'Isi biaya per bulan'}
  - name: withdrawn_needs_date
    on: save
    check: status != 'withdrawn' || left_on != ''
    message: {id: 'Isi tanggal keluar'}
  - name: terms_locked
    on: save
    check: >-
      billed_count == 0 || (billing_plan == locked_plan && total == locked_total && installments == locked_installments
        && monthly_fee == locked_monthly_fee)
    message: {id: 'Sudah ada tagihan yang diajukan: harga, potongan dan cara bayar tidak bisa diubah lagi'}
views:
  list:
    columns: [name, student, batch, status, total]
    filters: [batch, status]
    sort: -enrolled_on
  form:
    layout:
      - section: {id: Pendaftaran}
        columns:
          - [student, batch, program]
          - [enrolled_on, status, left_on]
      - section: {id: Biaya}
        columns:
          - [bill_to, billing_plan, installments, monthly_fee]
          - [price, discount, total, billed_count]
      - section: {id: Catatan}
        fields: [notes]
