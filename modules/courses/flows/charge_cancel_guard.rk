# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: charge_cancel_guard
label: {id: Tagihan kursus dibatalkan}
# Refused while its invoice is submitted (cancel the invoice first). Otherwise the enrollment's count of submitted
# charges drops; at zero its price and payment terms can be changed again. A draft invoice it left cannot be submitted
# (invoice_course_once). Reads in the order of charge_invoice_on_submit (enrollment, course_charge, sales_invoice).
on: course_charge.cancelled
steps:
  - {find: enrollment, where: name == event.enrollment, as: enr}
  - find_all: course_charge
    where: enrollment == event.enrollment && docstatus == 1
    as: billed
  - find: sales_invoice
    where: docstatus == 1 && notes.contains('[' + event.name + ']')
    as: inv
  - if: inv != null
    create: course_guard
    set:
      reason: "'charge_invoiced'"
      document: inv.name
  - update: enr
    set:
      billed_count: size(billed)
