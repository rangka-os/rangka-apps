# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: invoice_course_once
label: {id: Satu faktur per tagihan kursus}
# An invoice carrying a course charge's number ([TGK-...]) is submitted only while that charge is submitted, to its
# payer, for exactly its amount, and when no other submitted invoice carries the number. So a period is never invoiced
# twice, and the invoices of an enrollment's instalments add up to its total.
on: sales_invoice.submitted
if: event.notes.contains('[TGK-')
steps:
  - find: course_charge
    where: docstatus == 1 && event.notes.contains('[' + name + ']')
    as: chg
  - find: sales_invoice
    where: chg != null && name != event.name && docstatus == 1 && notes.contains('[' + chg.name + ']')
    as: twin
  - if: chg == null || twin != null || chg.customer != event.customer || chg.amount != event.dpp
    create: course_guard
    set:
      reason: "'invoice_twice'"
      document: event.name
