# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: enrollment_seats_on_update
label: {id: Status pendaftaran mengubah kursi angkatan}
# A student set to Keluar or Selesai frees a seat; set back to Daftar or Aktif takes one again, refused by the batch
# rule when the batch is full. Moving an enrollment to another batch is refused: it would leave the old count stale
# and carry its charges along.
on: enrollment.updated
steps:
  - if: event.before != null && event.before.batch != event.batch
    create: course_guard
    set:
      reason: "'batch_change'"
      document: event.name
  - find_all: enrollment
    where: batch == event.batch && (status == 'registered' || status == 'active')
    as: taken
  - {find: course_batch, where: name == event.batch, as: b}
  - update: b
    if: b != null && b.seats_taken != size(taken)
    set:
      seats_taken: size(taken)
  # The price and payment terms are locked once a charge is submitted. The rule terms_locked runs before the flow read
  # lock (contract 0025 §5), so a change racing a charge submit is checked again here, after enrollment's lock and
  # with course_charge read under its own (audit 2026-11-07 M3).
  - find: course_charge
    where: >-
      event.before != null && (event.billing_plan != event.before.billing_plan || event.total != event.before.total
        || event.installments != event.before.installments || event.monthly_fee != event.before.monthly_fee)
        && enrollment == event.name && docstatus == 1
    as: billed
  - if: billed != null
    create: course_guard
    set:
      reason: "'terms_locked'"
      document: event.name
