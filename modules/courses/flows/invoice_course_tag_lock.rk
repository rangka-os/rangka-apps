# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: invoice_course_tag_lock
label: {id: Catatan faktur kursus dikunci}
# The invoice of a course charge is found by the charge's number in its notes. Nobody edits notes that carry one by
# hand; the charge's own flow rewrites them (a flow's writes start no flows, so this does not refuse it).
on: sales_invoice.updated
if: event.before != null && event.notes != event.before.notes
steps:
  - find_all: course_charge
    where: event.before.notes.contains('[' + name + ']') || event.notes.contains('[' + name + ']')
    as: tags
  - if: size(tags) > 0
    create: course_guard
    set:
      reason: "'invoice_tag'"
      document: event.name
