# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Every afternoon: each submitted rental booking that starts tomorrow reminds its customer once (key
# <booking>:appointment:1). Skipped, with the reason on the row: no WhatsApp number that reads as one, or opted out.
name: whatsapp_booking_tomorrow
label: {id: 'Sewa mulai besok: ingatkan pelanggan lewat WhatsApp'}
schedule: '0 16 * * *'
steps:
  - find_all: rental_booking
    where: "docstatus == 1 && start_date != '' && days_between(today(), start_date) == 1"
    limit: 300
    as: tomorrow
  - for_each: tomorrow
    as: b
    do:
      - {find: customer, where: name == b.customer, as: c}
      - {find: rental_item, where: name == b.rental_item, as: it}
      - {find: whatsapp_message, where: "key == b.name + ':appointment:1'", as: done}
      - find: whatsapp_opt_out
        where: "c != null && c.wa_number != '' && number == c.wa_number"
        as: out
      - create: whatsapp_message
        if: done == null && c != null
        set:
          key: b.name + ':appointment:1'
          message_type: "'appointment'"
          template: "'pengingat_janji'"
          document: b.name
          customer: c.name
          number_tail: "c.wa_number != '' ? '…' + c.wa_number.replace(truncate(c.wa_number, size(c.wa_number) - 4), '') : ''"
          status: "c.wa_number == '' || c.wa_opt_out || out != null ? 'skipped' : 'queued'"
          error: "c.wa_number == '' ? 'no_number' : (c.wa_opt_out || out != null ? 'opted_out' : '')"
          status_at: now()
        as: msg
      - call: rangka_whatsapp.send_template
        if: done == null && c != null && msg.status == 'queued'
        with:
          to: "'+' + c.wa_number"
          template: "'pengingat_janji'"
          type: "'appointment'"
          idempotency_key: msg.key
          components: >-
            [{'type': 'body', 'parameters': [
              {'type': 'text', 'text': c.customer_name},
              {'type': 'text', 'text': 'mulai sewa ' + (it != null ? it.title : 'barang')},
              {'type': 'text', 'text': 'tempat kami'},
              {'type': 'text', 'text': string(int(b.start_date.replace(truncate(b.start_date, 8), ''))) + ' ' +
                ['Januari', 'Februari', 'Maret', 'April', 'Mei', 'Juni', 'Juli', 'Agustus', 'September', 'Oktober', 'November', 'Desember'][int(truncate(b.start_date, 7).replace(truncate(b.start_date, 5), '')) - 1] +
                ' ' + truncate(b.start_date, 4)}]}]
