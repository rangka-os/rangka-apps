# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Every five minutes (and by hand: POST /api/v1/flows/canvas_sale_drafts/run as the owner): every open work order
# (canvas_sale_job, made when the sale was submitted) of a sale that is still submitted becomes
# 1. a new draft sales invoice to the customer, one line per sale line at the price of the sale, this sale's number in
#    [] in its notes (a flow cannot submit; finance checks and submits it). The invoice never moves stock: the stock
#    left the van with the sale. The invoice's own checks (credit, tax) run when finance submits it.
# 2. for the cash taken at the door, a draft cash payment of the customer, reference = this sale, number in [] in its
#    notes. It is not allocated: the invoice is still a draft, finance allocates it when it submits both.
# 3. the work order is marked done, which is also what stops the next run from making them again.
# It is a scheduled flow, so it runs as the system: the salesman who submits the sale cannot create invoices or
# payments (role field_sales reads and prints them), and a flow never does more than its actor could by hand. A sale
# cancelled before the run is not submitted any more, so it gets no drafts. Reads lock canvas_sale (contract 0025).
# A salesman may create a work order, so nothing on it is trusted: the sale is found by the work order's number AND must
# match it (customer, salesman, date, cash, total qty, subtotal); a work order that does not match is only marked done.
# The invoice carries the sale's number in po_number and in its notes (the cancel guard looks for either).
# 4. the customer's uninvoiced_canvas (credit of canvas sales whose invoice is still a draft, so the credit limit sees
#    them) is recomputed. Sales made in the five minutes before their drafts exist are not counted yet.
name: canvas_sale_drafts
label: {id: Penjualan kanvas jadi draf faktur dan pembayaran}
schedule: '*/5 * * * *'
steps:
  - find_all: canvas_sale_job
    where: "done == false"
    sort: sale_date
    limit: 100
    as: jobs
  - for_each: jobs
    as: j
    do:
      # a find returns the record without its table rows: an update that changes nothing returns it whole
      - update: j
        set: {customer: j.customer}
      - find: canvas_sale
        where: "name == j.sale && docstatus == 1 && customer == j.customer && salesman == j.salesman && sale_date == j.sale_date && cash_received == j.cash_received && total_qty == j.items.map(i, i.qty).sum() && subtotal == j.items.map(i, i.amount).sum()"
        as: s
      - find: sales_invoice
        where: "po_number == j.sale || notes.contains('[' + j.sale + ']')"
        as: have
      - create: sales_invoice
        if: s != null && have == null
        set:
          customer: s.customer
          salesman: s.salesman
          posting_date: s.sale_date
          po_number: s.name
          notes: "'Penjualan kanvas ' + s.name + ' [' + s.name + ']'"
          items: "j.items.map(i, {'item': i.item, 'description': i.description, 'qty': i.qty, 'uom': i.uom, 'rate': i.rate})"
      - create: payment
        if: s != null && have == null && s.cash_received > 0
        set:
          direction: "'receive'"
          customer: s.customer
          salesman: s.salesman
          payment_date: s.sale_date
          amount: s.cash_received
          method: "'cash'"
          reference: s.name
          notes: "'Tunai penjualan kanvas ' + s.name + ' [' + s.name + ']'"
      - update: j
        set: {done: true}
      - find_all: sales_invoice
        where: "docstatus == 0 && customer == j.customer && notes.startsWith('Penjualan kanvas ')"
        as: draft_invs
      - find_all: payment
        where: "docstatus == 0 && customer == j.customer && notes.startsWith('Tunai penjualan kanvas ')"
        as: draft_pays
      - find: customer
        where: "name == j.customer"
        as: cust
      - update: cust
        if: cust != null
        set:
          uninvoiced_canvas: "draft_invs.map(x, x.grand_total).sum() - draft_pays.map(x, x.amount).sum() > 0 ? draft_invs.map(x, x.grand_total).sum() - draft_pays.map(x, x.amount).sum() : 0"
