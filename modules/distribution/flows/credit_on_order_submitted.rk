# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Keeps the customer's credit figures current for the credit approvals on customer_order: the earliest due date of
# its open invoices and what its submitted, not fully invoiced orders will cost (with PPN). The same steps run on
# every event that changes them (flows cannot call each other). A salesman cannot write customers, so his own order
# submit does not run it; the order is counted at the next staff event (see plans/tahap-4-grosir.md).
name: credit_on_order_submitted
label: {id: Perbarui kredit pelanggan (customer_order.submitted)}
on: customer_order.submitted
if: "event.customer != '' && !('field_sales' in user.roles)"
steps:
  - {find_all: sales_invoice, where: "docstatus == 1 && outstanding > 0 && customer == event.customer", as: open}
  - {find_all: customer_order, where: "docstatus == 1 && customer == event.customer && invoiced_amount < subtotal", as: orders}
  - {find: customer, where: name == event.customer, as: cust}
  # t_561e44ec: approval over_credit_limit was evaluated before this flow's locks. Read under them, the customer's
  # figures include every order and invoice committed meanwhile; an order over the limit that did not match the policy
  # went through only because another one ran at the same moment, so it is refused (submitted again, it is held).
  - create: credit_guard
    if: "cust != null && !event.credit_over_seen && cust.credit_limit > 0 && cust.outstanding + cust.open_orders + event.estimated_total > cust.credit_limit"
    set:
      reason: "'order_over_limit'"
      document: event.name
  - update: cust
    set:
      oldest_open_due: "size(open) > 0 ? min(open.map(i, i.due_date)) : ''"
      open_orders: "orders.map(o, o.subtotal > 0 ? round((o.subtotal - o.invoiced_amount) * o.estimated_total / o.subtotal) : 0).sum()"
