# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Runs in the canvas sale's submit (the stock has left the van in the same transaction, contract 0021), as the person
# submitting. Refused when the van's day for this salesman is already settled (a submitted canvas_settlement): a sale
# after the cash was counted would not be in the settlement. Reads take the flow read lock of canvas_settlement
# (contract 0025), so a sale and a settlement of the same day run one after the other. The invoice and the cash payment
# are not made here: a salesman cannot create them (flow canvas_sale_drafts makes them).
name: canvas_sale_day_closed
label: {id: Penjualan kanvas diajukan - periksa hari mobil, en: Canvas sale submitted - check the van day}
on: canvas_sale.submitted
steps:
  - {find: canvas_settlement, where: "docstatus == 1 && salesman == event.salesman && outlet == event.outlet && settle_date == event.sale_date", as: closed}
  - if: closed != null
    create: canvas_guard
    set: {reason: "'day_settled'", document: event.name}
