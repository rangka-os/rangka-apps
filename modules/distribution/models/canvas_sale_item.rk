# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: canvas_sale_item
is_child: true
fields:
  - {name: item, type: link, to: item, label: {id: Barang}, required: true}
  - {name: description, type: text, label: {id: Uraian}, default: item.item_name}
  - {name: qty, type: float, label: {id: Qty}, default: '1'}
  - {name: uom, type: link, to: uom, label: {id: Satuan}, default: item.stock_uom}
  # Tier pricing: price_tier is copied from the sale by the flow canvas_sale_tier_pricing, which then sets rate to
  # list_rate once per tier (tier_applied), so a price typed by hand afterwards stays (the same as customer_order_item).
  - {name: price_tier, type: data, label: {id: Tier harga}, default: "'retail'", read_only: true}
  - {name: tier_applied, type: data, label: {id: Tier yang sudah dipakai}, default: "'retail'", read_only: true}
  - {name: list_rate, type: currency, label: {id: Harga daftar}, compute: "price_tier == 'agent' && item.rate_agent > 0 ? item.rate_agent : (price_tier == 'wholesale' && item.rate_wholesale > 0 ? item.rate_wholesale : item.rate)"}
  - {name: rate, type: currency, label: {id: Harga}, default: item.rate}
  - {name: amount, type: currency, label: {id: Jumlah}, compute: round(qty * rate)}
  - {name: cogs, type: currency, label: {id: Harga pokok}, read_only: true, hidden_for: [field_sales]}
  - {name: lot, type: link, to: stock_lot, label: {id: Lot}, depends_on: "item.tracking in ['lot', 'lot_expiry']", help: {id: 'Kosongkan: lot yang paling dulu kedaluwarsa keluar'}}
