# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# One line of a WhatsApp order: what the customer wrote, and the item it was matched to (flow whatsapp_order_intake).
# The price is the item's own rate, computed here, never a number from the text. A line without an item is a note:
# kept and flagged (match unknown), or a choice the staff make (match ambiguous: the candidates in choices). Staff may
# pick or change the item on any line before confirming; a line still without an item is left out of the order.
name: whatsapp_order_line
is_child: true
fields:
  - {name: text, type: data, label: {id: Tulisan pelanggan}, read_only: true}
  - name: item
    type: link
    to: item
    label: {id: Barang/layanan}
  - {name: qty, type: int, label: {id: Qty}, default: '1'}
  # what staff must look at, in words; empty when the line is plain
  - name: flag
    type: data
    label: {id: Perlu dicek}
    compute: >-
      item == '' && match == 'ambiguous' ? 'Pilih salah satu: ' + choices :
      item == '' ? 'Tidak dikenali, jadi catatan: ' + text :
      match == 'typo' ? 'Dibaca dari "' + text + '"' :
      quoted_rate > 0 && quoted_rate != rate ? 'Harga di pesan beda dengan harga barang; dipakai harga barang' : ''
  - {name: note, type: data, label: {id: Catatan}}
  - {name: amount, type: currency, label: {id: Jumlah}, compute: round(qty * rate)}
  - {name: rate, type: currency, label: {id: Harga}, compute: "item != '' ? item.rate : 0"}
  # a price the message itself carried (a catalogue cart does): kept only to compare, never charged
  - {name: quoted_rate, type: currency, label: {id: Harga di pesan}, read_only: true, default: '0'}
  - name: match
    type: select
    label: {id: Cara dibaca}
    read_only: true
    default: "'manual'"
    options:
      - {value: exact, label: {id: Nama sama}}
      - {value: partial, label: {id: Sebagian nama}}
      - {value: typo, label: {id: Dari ejaan mirip}}
      - {value: ambiguous, label: {id: Perlu dipilih}}
      - {value: unknown, label: {id: Tidak dikenali}}
      - {value: manual, label: {id: Diisi staf}}
  # the candidates of an ambiguous line, "Es Kopi Susu Regular / Es Kopi Susu Large"
  - {name: choices, type: data, label: {id: Pilihan}, read_only: true}
  - {name: unit, type: data, label: {id: Satuan ditulis}, read_only: true, hidden: true}
  - {name: item_name, type: data, label: {id: Nama barang}, hidden: true, compute: "item != '' ? item.item_name : ''"}
