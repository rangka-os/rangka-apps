# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# stock_balance.variant_group is a compute through item, stored when the balance is written (rangka-os#267). An item
# grouped (or regrouped) after its balances exist would keep the old value until its next move, so the "Stok per produk"
# roll-up would miss it. When an item's variant_group changes, rewrite its balances (up to 200 outlets) with nothing
# changed, which recomputes the field. Stock moves already posted keep the group they had when posted.
name: stock_balance_variant_group
label: {id: Perbarui grup varian di saldo stok}
description: {id: 'Saat grup varian sebuah barang berubah, saldo stoknya ikut diperbarui supaya jumlah stok per produk benar.'}
on: item.updated
if: "event.before != null && event.before.variant_group != event.variant_group"
steps:
  - find_all: stock_balance
    where: "item == event.name"
    limit: 200
    as: bals
  - for_each: bals
    as: b
    do:
      - update: b
        set: {last_move: b.last_move}
