# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: stock_negative_alert
label: {id: Peringatan stok minus}
description: {id: 'Kalau stok sebuah barang di outlet jadi minus, pemilik dan kantor pusat langsung dikabari.'}
# The kernel passes the stock_move record as `event` (name, outlet, item, qty, balance_qty, negative, ...).
# The find steps turn the record names into item and outlet names for the message; when a record cannot be found
# (deleted, or outside the actor's scope) the text falls back to the plain names. The notice (stock_negative, contract
# 0066) is about the balance: it links there, people limited to other outlets are left out, and one balance tells
# its people once per day (id), however many moves keep it below zero that day.
on: stock_move.created
if: event.negative == true
steps:
  - {find: item, where: name == event.item, as: it}
  - {find: outlet, where: name == event.outlet, as: ou}
  - {find: stock_balance, where: outlet == event.outlet && item == event.item, as: bal}
  - notify: head_office
    notice: stock_negative
    channel: email
    record: bal
    outlet: event.outlet
    id: "'neg:' + event.outlet + ':' + event.item + ':' + string(today())"
    title: {id: 'Stok {it != null ? it.item_name : event.item} minus'}
    template: {id: 'Stok {it != null ? it.item_name : event.item} di {ou != null ? ou.outlet_name : event.outlet} minus ({event.balance_qty})'}
