# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/module.json
name: stock
version: 1.6.0
title: {id: Stok, en: Stock}
summary:
  id: Saldo dan mutasi stok per toko dan gudang, permintaan barang ke gudang, transfer, opname dan penyesuaian.
  en: Stock balances and moves per store and warehouse, stock requests, transfers, counts and adjustments.
category: stock
icon: archive-line
# contacts: stock_reorder.vendor links a vendor. catalogue already requires contacts, so no site gains a module.
requires: {rangka: '>=0.5', users: ^1.2, contacts: ^1.0, catalogue: ^1.6, outlets: ^1.7}
# catalogue 1.6: item.tracking and expiry_warning_days (rangka-os contract 0070, lots and serials; rangka-os#260).
# outlets 1.7: location_type and supply_from (rangka-apps#104: warehouses apart from stores, stock_request).
# Semantics fixed in docs/kernel-hooks.md (section stock). stock.post_moves is a core hook on the on_submit of
# goods_receipt, stock_transfer, stock_transfer_receipt, stock_count, stock_adjustment and outlet_sales; stock.reverse_moves is declared here.
hooks: [stock.reverse_moves]
# What this module tells people (contract 0066 §1.1). stock_negative: flow stock_negative_alert, the moment a balance
# goes below zero. stock_low: flow stock_low_alert, once per item and outlet when the balance falls below the item's
# reorder level (item.reorder_level). A person switches the mail of a kind off in Pengaturan › Notifikasi.
notices:
  - name: stock_negative
    label: {id: Stok minus, en: Negative stock}
    description: {id: 'Stok sebuah barang di outlet jadi di bawah nol.'}
    severity: high
    to: [owner, head_office]
  - name: stock_low
    label: {id: Stok di bawah batas minimum, en: Stock below reorder level}
    description: {id: 'Stok sebuah barang turun di bawah batas minimum yang kamu isi di data barang.'}
    severity: warn
    to: [owner, head_office, purchasing_manager]
  # flow stock_request_on_create: a store asks its warehouse for goods (rangka-apps#104)
  - name: stock_request
    label: {id: Permintaan barang ke gudang, en: Stock request}
    description: {id: 'Toko meminta barang ke gudang; gudang memproses atau menolak.'}
    severity: info
    to: [warehouse_staff, head_office]
  # flow lot_expiry_digest: every morning, lots with stock that newly entered the item's expiry window (rangka-os#260)
  - name: stock_expiry
    label: {id: Stok hampir kedaluwarsa, en: Expiring stock}
    description: {id: 'Ada lot barang yang masih punya stok dan akan atau sudah lewat tanggal kedaluwarsanya.'}
    severity: warn
    to: [owner, head_office, warehouse_staff]
