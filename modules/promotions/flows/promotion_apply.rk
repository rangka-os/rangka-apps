# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_promotion_flows.py (do not edit by hand). Every 5 minutes: promos start and end on their dates, days and hours (happy hour precision 5 minutes).
name: promotion_apply
label: {id: 'Promo: perbarui yang sedang berlaku'}
schedule: '*/5 * * * *'
steps:
  # 1. live: active, in its dates, days and hours now
  - find_all: promotion
    as: all
  - for_each: all
    as: p
    do:
      - update: p
        if: "p.live != (p.active && p.valid_from <= today() && p.valid_until >= today() && (p.days == '' || p.days.contains(string(days_between('2024-01-01', today()) % 7 + 1))) && (p.time_from == '' || clock() >= p.time_from && clock() < p.time_until))"
        set:
          live: "p.active && p.valid_from <= today() && p.valid_until >= today() && (p.days == '' || p.days.contains(string(days_between('2024-01-01', today()) % 7 + 1))) && (p.time_from == '' || clock() >= p.time_from && clock() < p.time_until)"
  # 2. the live item promos for the counter, all outlets (kg) and one outlet (ko), and for invoices (vs)
  - find_all: promotion
    where: "live && !is_bill && channel != 'invoice' && only_outlet == ''"
    as: kg
  - find_all: promotion
    where: "live && !is_bill && channel != 'invoice' && only_outlet != ''"
    as: ko
  - find_all: promotion
    where: "live && kind == 'item_pct' && channel != 'kasir' && only_outlet == ''"
    as: vs
  # items that carry a promo now (it may have ended) ...
  - find_all: item
    where: "promo != '' || promo_o != '' || promo_invoice_pct != 0"
    as: had
  - for_each: had
    as: it
    do:
      - for_each: "[kg.filter(p, (p.scope == 'item' && p.item == it.name || p.scope == 'category' && p.category != '' && p.category == it.category) && kg.filter(q, (q.scope == 'item' && q.item == it.name || q.scope == 'category' && q.category != '' && q.category == it.category) && (q.priority > p.priority || q.priority == p.priority && q.name < p.name)).size() == 0)]"
        as: w
        do:
          - for_each: "[vs.filter(p, (p.scope == 'item' && p.item == it.name || p.scope == 'category' && p.category != '' && p.category == it.category) && vs.filter(q, (q.scope == 'item' && q.item == it.name || q.scope == 'category' && q.category != '' && q.category == it.category) && (q.priority > p.priority || q.priority == p.priority && q.name < p.name)).size() == 0)]"
            as: v
            do:
              - for_each: "[ko.filter(p, (p.scope == 'item' && p.item == it.name || p.scope == 'category' && p.category != '' && p.category == it.category) && ko.filter(q, (q.scope == 'item' && q.item == it.name || q.scope == 'category' && q.category != '' && q.category == it.category) && (q.priority > p.priority || q.priority == p.priority && q.name < p.name)).size() == 0).filter(x, w.size() == 0 || x.priority >= w[0].priority)]"
                as: o
                do:
                  - update: it
                    if: "it.promo != (w.size() > 0 ? w[0].name : '') || it.promo_name != (w.size() > 0 ? w[0].promo_name : '') || it.promo_kind != (w.size() == 0 ? '' : (w[0].kind == 'item_pct' ? 'pct' : (w[0].kind == 'item_off' ? 'off' : 'buy_get'))) || it.promo_pct != (w.size() > 0 && w[0].kind == 'item_pct' ? w[0].pct : 0) || it.promo_off != (w.size() > 0 && w[0].kind == 'item_off' ? w[0].amount_off : 0) || it.promo_buy != (w.size() > 0 && w[0].kind == 'buy_get' ? w[0].buy_qty : 0) || it.promo_get != (w.size() > 0 && w[0].kind == 'buy_get' ? w[0].get_qty : 0) || it.promo_until != (w.size() > 0 ? w[0].valid_until : null) || it.promo_invoice_pct != (v.size() > 0 ? v[0].pct : 0) || it.promo_outlet != ('') || it.promo_o != (o.size() > 0 ? o[0].name : '') || it.promo_o_name != (o.size() > 0 ? o[0].promo_name : '') || it.promo_o_kind != (o.size() == 0 ? '' : (o[0].kind == 'item_pct' ? 'pct' : (o[0].kind == 'item_off' ? 'off' : 'buy_get'))) || it.promo_o_pct != (o.size() > 0 && o[0].kind == 'item_pct' ? o[0].pct : 0) || it.promo_o_off != (o.size() > 0 && o[0].kind == 'item_off' ? o[0].amount_off : 0) || it.promo_o_buy != (o.size() > 0 && o[0].kind == 'buy_get' ? o[0].buy_qty : 0) || it.promo_o_get != (o.size() > 0 && o[0].kind == 'buy_get' ? o[0].get_qty : 0) || it.promo_o_outlet != (o.size() > 0 ? o[0].only_outlet : '') || it.promo_o_until != (o.size() > 0 ? o[0].valid_until : null)"
                    set:
                      promo: "w.size() > 0 ? w[0].name : ''"
                      promo_name: "w.size() > 0 ? w[0].promo_name : ''"
                      promo_kind: "w.size() == 0 ? '' : (w[0].kind == 'item_pct' ? 'pct' : (w[0].kind == 'item_off' ? 'off' : 'buy_get'))"
                      promo_pct: "w.size() > 0 && w[0].kind == 'item_pct' ? w[0].pct : 0"
                      promo_off: "w.size() > 0 && w[0].kind == 'item_off' ? w[0].amount_off : 0"
                      promo_buy: "w.size() > 0 && w[0].kind == 'buy_get' ? w[0].buy_qty : 0"
                      promo_get: "w.size() > 0 && w[0].kind == 'buy_get' ? w[0].get_qty : 0"
                      promo_until: "w.size() > 0 ? w[0].valid_until : null"
                      promo_invoice_pct: "v.size() > 0 ? v[0].pct : 0"
                      promo_outlet: "''"
                      promo_o: "o.size() > 0 ? o[0].name : ''"
                      promo_o_name: "o.size() > 0 ? o[0].promo_name : ''"
                      promo_o_kind: "o.size() == 0 ? '' : (o[0].kind == 'item_pct' ? 'pct' : (o[0].kind == 'item_off' ? 'off' : 'buy_get'))"
                      promo_o_pct: "o.size() > 0 && o[0].kind == 'item_pct' ? o[0].pct : 0"
                      promo_o_off: "o.size() > 0 && o[0].kind == 'item_off' ? o[0].amount_off : 0"
                      promo_o_buy: "o.size() > 0 && o[0].kind == 'buy_get' ? o[0].buy_qty : 0"
                      promo_o_get: "o.size() > 0 && o[0].kind == 'buy_get' ? o[0].get_qty : 0"
                      promo_o_outlet: "o.size() > 0 ? o[0].only_outlet : ''"
                      promo_o_until: "o.size() > 0 ? o[0].valid_until : null"
  # ... and the items each live item promo covers
  - for_each: kg + ko + vs
    as: pr
    do:
      - find_all: item
        if: "pr.scope == 'item'"
        where: name == pr.item
        as: one
      - find_all: item
        if: "pr.scope == 'category'"
        where: category == pr.category
        as: cat
      - for_each: "pr.scope == 'item' ? one : cat"
        as: it
        do:
          - for_each: "[kg.filter(p, (p.scope == 'item' && p.item == it.name || p.scope == 'category' && p.category != '' && p.category == it.category) && kg.filter(q, (q.scope == 'item' && q.item == it.name || q.scope == 'category' && q.category != '' && q.category == it.category) && (q.priority > p.priority || q.priority == p.priority && q.name < p.name)).size() == 0)]"
            as: w
            do:
              - for_each: "[vs.filter(p, (p.scope == 'item' && p.item == it.name || p.scope == 'category' && p.category != '' && p.category == it.category) && vs.filter(q, (q.scope == 'item' && q.item == it.name || q.scope == 'category' && q.category != '' && q.category == it.category) && (q.priority > p.priority || q.priority == p.priority && q.name < p.name)).size() == 0)]"
                as: v
                do:
                  - for_each: "[ko.filter(p, (p.scope == 'item' && p.item == it.name || p.scope == 'category' && p.category != '' && p.category == it.category) && ko.filter(q, (q.scope == 'item' && q.item == it.name || q.scope == 'category' && q.category != '' && q.category == it.category) && (q.priority > p.priority || q.priority == p.priority && q.name < p.name)).size() == 0).filter(x, w.size() == 0 || x.priority >= w[0].priority)]"
                    as: o
                    do:
                      - update: it
                        if: "it.promo != (w.size() > 0 ? w[0].name : '') || it.promo_name != (w.size() > 0 ? w[0].promo_name : '') || it.promo_kind != (w.size() == 0 ? '' : (w[0].kind == 'item_pct' ? 'pct' : (w[0].kind == 'item_off' ? 'off' : 'buy_get'))) || it.promo_pct != (w.size() > 0 && w[0].kind == 'item_pct' ? w[0].pct : 0) || it.promo_off != (w.size() > 0 && w[0].kind == 'item_off' ? w[0].amount_off : 0) || it.promo_buy != (w.size() > 0 && w[0].kind == 'buy_get' ? w[0].buy_qty : 0) || it.promo_get != (w.size() > 0 && w[0].kind == 'buy_get' ? w[0].get_qty : 0) || it.promo_until != (w.size() > 0 ? w[0].valid_until : null) || it.promo_invoice_pct != (v.size() > 0 ? v[0].pct : 0) || it.promo_outlet != ('') || it.promo_o != (o.size() > 0 ? o[0].name : '') || it.promo_o_name != (o.size() > 0 ? o[0].promo_name : '') || it.promo_o_kind != (o.size() == 0 ? '' : (o[0].kind == 'item_pct' ? 'pct' : (o[0].kind == 'item_off' ? 'off' : 'buy_get'))) || it.promo_o_pct != (o.size() > 0 && o[0].kind == 'item_pct' ? o[0].pct : 0) || it.promo_o_off != (o.size() > 0 && o[0].kind == 'item_off' ? o[0].amount_off : 0) || it.promo_o_buy != (o.size() > 0 && o[0].kind == 'buy_get' ? o[0].buy_qty : 0) || it.promo_o_get != (o.size() > 0 && o[0].kind == 'buy_get' ? o[0].get_qty : 0) || it.promo_o_outlet != (o.size() > 0 ? o[0].only_outlet : '') || it.promo_o_until != (o.size() > 0 ? o[0].valid_until : null)"
                        set:
                          promo: "w.size() > 0 ? w[0].name : ''"
                          promo_name: "w.size() > 0 ? w[0].promo_name : ''"
                          promo_kind: "w.size() == 0 ? '' : (w[0].kind == 'item_pct' ? 'pct' : (w[0].kind == 'item_off' ? 'off' : 'buy_get'))"
                          promo_pct: "w.size() > 0 && w[0].kind == 'item_pct' ? w[0].pct : 0"
                          promo_off: "w.size() > 0 && w[0].kind == 'item_off' ? w[0].amount_off : 0"
                          promo_buy: "w.size() > 0 && w[0].kind == 'buy_get' ? w[0].buy_qty : 0"
                          promo_get: "w.size() > 0 && w[0].kind == 'buy_get' ? w[0].get_qty : 0"
                          promo_until: "w.size() > 0 ? w[0].valid_until : null"
                          promo_invoice_pct: "v.size() > 0 ? v[0].pct : 0"
                          promo_outlet: "''"
                          promo_o: "o.size() > 0 ? o[0].name : ''"
                          promo_o_name: "o.size() > 0 ? o[0].promo_name : ''"
                          promo_o_kind: "o.size() == 0 ? '' : (o[0].kind == 'item_pct' ? 'pct' : (o[0].kind == 'item_off' ? 'off' : 'buy_get'))"
                          promo_o_pct: "o.size() > 0 && o[0].kind == 'item_pct' ? o[0].pct : 0"
                          promo_o_off: "o.size() > 0 && o[0].kind == 'item_off' ? o[0].amount_off : 0"
                          promo_o_buy: "o.size() > 0 && o[0].kind == 'buy_get' ? o[0].buy_qty : 0"
                          promo_o_get: "o.size() > 0 && o[0].kind == 'buy_get' ? o[0].get_qty : 0"
                          promo_o_outlet: "o.size() > 0 ? o[0].only_outlet : ''"
                          promo_o_until: "o.size() > 0 ? o[0].valid_until : null"
