# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: project_ledger
label: {id: Buku untung proyek, en: Project ledger}
icon: chart
naming: PL-{YYYY}-{######}
title_field: project
# append_only (contract 0026): rows are created only by the flows the kernel starts on the source document's events (and
# the schedule); nobody, the owner included, creates, edits or deletes one through the API, an import or a flow run by
# hand. A correction is the reversing row written when the source document is cancelled.
append_only: true
# One signed row per submitted document that changes a project's result: revenue + (invoice dpp, retention releases
# excluded), costs - (timesheet cost, project expense not on a vendor bill, vendor bill dpp). Cancelling the document
# writes the opposite row on the document's own date, so the sum per project (and per period) is its margin. Rows are
# written by flows inside the document's submit or cancel. A flow runs as the person submitting, so those roles hold
# create, and a rule cannot tell a flow from a person; the rules therefore make every row true to its document:
# - a post row links its source document, on the same project, submitted, with exactly the document's amount and
#   date; one per document (entry_key = source:post);
# - a reverse row links the post row it reverses (reverses, unique) for the same document, now cancelled, with the
#   opposite amount; one per post row (entry_key = source:reverse).
# So each cancelled document has exactly one reversal, and only if it had a post row: a document submitted before
# this model existed has none, and none can be reversed by hand. The only row a person could add by hand is a true
# post row for such an old, still submitted document.
permissions:
  - {role: project_admin, read: true, create: true, export: true}
  - {role: finance_manager, read: true, create: true, export: true}
  # Sales and purchasing read (and their flows write) only the rows of their own documents: labour rows carry pay and
  # cost rows the firm's margin (audit L1). Read stays because the cancel flows find the row they reverse as the person
  # cancelling. No export for sales.
  - {role: sales_manager, read: true, create: true, if: kind == 'revenue'}
  - {role: purchasing_manager, read: true, create: true, if: kind == 'vendor'}
fields:
  - name: project
    type: link
    to: project
    label: {id: Proyek}
    required: true
    in_list: true
  - name: posting_date
    type: date
    label: {id: Tanggal}
    required: true
    in_list: true
  - name: kind
    type: select
    label: {id: Jenis}
    required: true
    in_list: true
    chip: true
    options:
      - {value: revenue, label: {id: Pendapatan}}
      - {value: labor, label: {id: Biaya tenaga kerja}}
      - {value: expense, label: {id: Biaya proyek}}
      - {value: vendor, label: {id: Biaya pemasok}}
  - name: source_model
    type: data
    label: {id: Dokumen}
    required: true
  - name: source_name
    type: data
    label: {id: No. dokumen}
    required: true
    in_list: true
  - name: sales_invoice
    type: link
    to: sales_invoice
    label: {id: Faktur}
  - name: timesheet
    type: link
    to: timesheet
    label: {id: Timesheet}
  - name: project_expense
    type: link
    to: project_expense
    label: {id: Biaya proyek}
  - name: vendor_bill
    type: link
    to: vendor_bill
    label: {id: Tagihan pemasok}
  - name: entry
    type: select
    label: {id: Baris}
    default: "'post'"
    options:
      - {value: post, label: {id: Diajukan}}
      - {value: reverse, label: {id: Pembalik}}
  - name: reverses
    type: link
    to: project_ledger
    label: {id: Membalik baris}
    unique: true
  - name: source_status
    type: int
    label: {id: Status dokumen}
    hidden: true
    compute: "kind == 'revenue' ? sales_invoice.docstatus : (kind == 'labor' ? timesheet.docstatus : (kind == 'expense' ? project_expense.docstatus : vendor_bill.docstatus))"
  - name: source_amount
    type: currency
    label: {id: Nilai dokumen}
    hidden: true
    compute: "kind == 'revenue' ? sales_invoice.dpp : (kind == 'labor' ? 0 - timesheet.cost_amount : (kind == 'expense' ? 0 - project_expense.amount : 0 - vendor_bill.dpp))"
  - name: source_date
    type: date
    label: {id: Tanggal dokumen}
    hidden: true
    compute: "kind == 'revenue' ? sales_invoice.posting_date : (kind == 'labor' ? timesheet.work_date : (kind == 'expense' ? project_expense.expense_date : vendor_bill.bill_date))"
  - name: entry_key
    type: data
    label: {id: Kunci baris}
    hidden: true
    unique: true
    compute: "source_name + ':' + entry"
  - name: amount
    type: currency
    label: {id: 'Nilai (+ pendapatan, - biaya)'}
    in_list: true
rules:
  - name: source_matches
    on: save
    check: >-
      (kind == 'revenue' && sales_invoice != '' && source_name == sales_invoice && sales_invoice.project == project && sales_invoice.kind != 'retention')
      || (kind == 'labor' && timesheet != '' && source_name == timesheet && timesheet.project == project)
      || (kind == 'expense' && project_expense != '' && source_name == project_expense && project_expense.project == project)
      || (kind == 'vendor' && vendor_bill != '' && source_name == vendor_bill && vendor_bill.project == project)
    message: {id: Baris buku untung proyek harus menunjuk dokumen sumbernya di proyek yang sama}
  - name: post_matches_document
    on: save
    check: entry != 'post' || (reverses == '' && source_status == 1 && amount == source_amount && posting_date == source_date)
    message: {id: Baris diajukan hanya untuk dokumen yang diajukan dengan nilai yang sama}
  - name: reverse_matches_post
    on: save
    check: >-
      entry != 'reverse' || (reverses != '' && source_status == 2 && reverses.entry == 'post' && reverses.source_name == source_name
        && reverses.kind == kind && reverses.project == project && amount == 0 - reverses.amount && posting_date == reverses.posting_date)
    message: {id: Baris pembalik hanya untuk dokumen yang dibatalkan dan harus menunjuk baris aslinya}
views:
  list:
    columns: [name, project, posting_date, kind, entry, source_name, amount]
    filters: [project, kind]
    sort: -posting_date
