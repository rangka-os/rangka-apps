# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: assignment
label: {id: Penugasan, en: Assignment}
icon: user
naming: ASG-{#####}
title_field: worker
permissions:
  - {role: project_admin, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, export: true, print: true}
  # No sales_manager: an assignment carries the cost rates (audit L1).
  - {role: finance_manager, read: true}
  # A worker reads their own assignments and a supervisor those of their sites (row scopes); rates are hidden from both.
  - {role: field_worker, read: true}
  - {role: site_supervisor, read: true}
fields:
  - name: project
    type: link
    to: project
    label: {id: Proyek}
    required: true
    in_list: true
  - name: worker
    type: link
    to: worker
    label: {id: Tenaga kerja}
    required: true
    in_list: true
    peek: [role_title, day_rate]
  - name: site
    type: data
    label: {id: Lokasi}
    default: project.site
  # Where the worker clocks in (attendance_log): point and radius of the work site.
  - name: work_site
    type: link
    to: work_site
    label: {id: Lokasi absen}
    in_list: true
  # The site's point and radius as the worker's phone reads them for its message (the worker cannot read work_site, so
  # the firm's other client sites stay private). Refreshed when the assignment is saved; the kernel's check in
  # attendance_log reads the site itself.
  - {name: site_lat, type: float, label: {id: Lintang lokasi absen}, read_only: true, compute: "work_site != '' ? work_site.lat : 0"}
  - {name: site_lng, type: float, label: {id: Bujur lokasi absen}, read_only: true, compute: "work_site != '' ? work_site.lng : 0"}
  - {name: site_radius_m, type: int, label: {id: Radius absen (m)}, read_only: true, compute: "work_site != '' ? work_site.radius_m : 0"}
  - name: start_date
    type: date
    label: {id: Mulai}
    required: true
    in_list: true
  - name: end_date
    type: date
    label: {id: Selesai}
    required: true
    in_list: true
  - name: day_rate
    type: currency
    label: {id: Tarif per hari}
    hidden_for: [field_worker, site_supervisor]
    default: worker.day_rate
    in_list: true
  # Billed per day (manpower, the default) or per hour (consultants); the rates default from the worker.
  - name: rate_basis
    type: select
    label: {id: Satuan tarif}
    default: "'day'"
    options:
      - {value: day, label: {id: Per hari}}
      - {value: hour, label: {id: Per jam}}
  - name: hour_rate
    type: currency
    label: {id: Tarif per jam}
    hidden_for: [field_worker, site_supervisor]
    default: worker.hour_rate
  - name: cost_rate
    type: currency
    label: {id: Biaya per satuan}
    hidden_for: [sales_manager, purchasing_manager, head_office, outlet_staff, sales_rep, field_worker, site_supervisor]
    default: "rate_basis == 'hour' ? worker.cost_hour_rate : worker.cost_day_rate"
  # Overtime per hour on this project, from the worker unless the client agreed another rate.
  - name: overtime_rate
    type: currency
    label: {id: Tarif jual lembur per jam}
    hidden_for: [field_worker, site_supervisor]
    default: worker.overtime_rate
  - name: overtime_cost_rate
    type: currency
    label: {id: Upah lembur per jam}
    hidden_for: [sales_manager, purchasing_manager, head_office, outlet_staff, sales_rep, field_worker, site_supervisor]
    default: worker.overtime_cost_rate
  - name: notes
    type: text
    label: {id: Catatan}
rules:
  - name: rates_not_negative
    on: save
    check: day_rate >= 0 && hour_rate >= 0 && cost_rate >= 0 && overtime_rate >= 0 && overtime_cost_rate >= 0
    message: {id: 'Tarif dan upah tidak boleh negatif'}
  - name: end_after_start
    on: save
    check: end_date >= start_date
    message: {id: Tanggal selesai tidak boleh sebelum tanggal mulai}
views:
  list:
    columns: [name, project, worker, start_date, end_date, day_rate]
    sort: -start_date
  form:
    layout:
      - section: {id: Penugasan}
        columns:
          - [project, worker, site, work_site]
          - [start_date, end_date]
      - section: {id: Tarif}
        columns:
          - [rate_basis, day_rate, hour_rate, overtime_rate]
          - [cost_rate, overtime_cost_rate]
      - section: {id: Catatan}
        fields: [notes]
