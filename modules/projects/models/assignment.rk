# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: assignment
label: {id: Penugasan, en: Assignment}
icon: user
naming: ASG-{#####}
title_field: worker
permissions:
  - {role: project_admin, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, export: true, print: true}
  - {role: sales_manager, read: true}
  - {role: finance_manager, read: true}
fields:
  - name: project
    type: link
    to: project
    label: {id: Proyek}
    required: true
    in_list: true
  - name: worker
    type: link
    to: worker
    label: {id: Tenaga kerja}
    required: true
    in_list: true
    peek: [role_title, day_rate]
  - name: site
    type: data
    label: {id: Lokasi}
    default: project.site
  - name: start_date
    type: date
    label: {id: Mulai}
    required: true
    in_list: true
  - name: end_date
    type: date
    label: {id: Selesai}
    required: true
    in_list: true
  - name: day_rate
    type: currency
    label: {id: Tarif per hari}
    default: worker.day_rate
    in_list: true
  # Billed per day (manpower, the default) or per hour (consultants); the rates default from the worker.
  - name: rate_basis
    type: select
    label: {id: Satuan tarif}
    default: "'day'"
    options:
      - {value: day, label: {id: Per hari}}
      - {value: hour, label: {id: Per jam}}
  - name: hour_rate
    type: currency
    label: {id: Tarif per jam}
    default: worker.hour_rate
  - name: cost_rate
    type: currency
    label: {id: Biaya per satuan}
    default: "rate_basis == 'hour' ? worker.cost_hour_rate : worker.cost_day_rate"
  # Overtime per hour on this project, from the worker unless the client agreed another rate.
  - name: overtime_rate
    type: currency
    label: {id: Tarif jual lembur per jam}
    default: worker.overtime_rate
  - name: overtime_cost_rate
    type: currency
    label: {id: Upah lembur per jam}
    default: worker.overtime_cost_rate
  - name: notes
    type: text
    label: {id: Catatan}
rules:
  - name: rates_not_negative
    on: save
    check: day_rate >= 0 && hour_rate >= 0 && cost_rate >= 0 && overtime_rate >= 0 && overtime_cost_rate >= 0
    message: {id: 'Tarif dan upah tidak boleh negatif'}
  - name: end_after_start
    on: save
    check: end_date >= start_date
    message: {id: Tanggal selesai tidak boleh sebelum tanggal mulai}
views:
  list:
    columns: [name, project, worker, start_date, end_date, day_rate]
    sort: -start_date
  form:
    layout:
      - section: {id: Penugasan}
        columns:
          - [project, worker, site]
          - [start_date, end_date]
      - section: {id: Tarif}
        columns:
          - [rate_basis, day_rate, hour_rate, overtime_rate]
          - [cost_rate, overtime_cost_rate]
      - section: {id: Catatan}
        fields: [notes]
