# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: timesheet
label: {id: Absensi, en: Timesheet}
icon: calendar
is_submittable: true
naming: TS-{YYYY}-{#####}
title_field: worker
permissions:
  - {role: project_admin, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, export: true, import: true, print: true}
  # No sales_manager: a timesheet carries pay and cost (audit L1).
  - {role: finance_manager, read: true}
fields:
  - name: project
    type: link
    to: project
    label: {id: Proyek}
    required: true
    in_list: true
  - name: worker
    type: link
    to: worker
    label: {id: Tenaga kerja}
    required: true
    in_list: true
  - name: assignment
    type: link
    to: assignment
    label: {id: Penugasan}
  - name: work_date
    type: date
    label: {id: Tanggal kerja}
    required: true
    in_list: true
  # A monthly recap (G7): work_date is the first day of the cut-off period and period_to its last (21 Oct to 20 Nov,
  # or a calendar month), days the days present in it. Empty period_to = one day, as before.
  - name: period_to
    type: date
    label: {id: Sampai tanggal (rekap)}
    in_list: true
  - name: days
    type: float
    label: {id: Hari kerja}
    default: '1'
    in_list: true
  - name: overtime_hours
    type: float
    label: {id: Jam lembur}
    default: '0'
  - name: hours
    type: float
    label: {id: Jam}
  - name: description
    type: text
    label: {id: Uraian pekerjaan}
    required: true
  - name: evidence
    type: attach
    label: {id: Bukti kerja}
  - name: billable
    type: check
    label: {id: Dapat ditagih}
    default: 'true'
  - name: day_rate
    type: currency
    label: {id: Tarif per hari}
    default: "assignment != '' ? assignment.day_rate : worker.day_rate"
  # Per hour when the assignment bills per hour (consultants); per day otherwise, as before.
  - name: rate_basis
    type: select
    label: {id: Satuan tarif}
    default: "assignment != '' ? assignment.rate_basis : 'day'"
    options:
      - {value: day, label: {id: Per hari}}
      - {value: hour, label: {id: Per jam}}
  - name: hour_rate
    type: currency
    label: {id: Tarif per jam}
    default: "assignment != '' ? assignment.hour_rate : worker.hour_rate"
  - name: cost_rate
    type: currency
    label: {id: Biaya per satuan}
    default: "assignment != '' ? assignment.cost_rate : (rate_basis == 'hour' ? worker.cost_hour_rate : worker.cost_day_rate)"
  - name: overtime_rate
    type: currency
    label: {id: Tarif jual lembur per jam}
    default: "assignment != '' ? assignment.overtime_rate : worker.overtime_rate"
  - name: overtime_cost_rate
    type: currency
    label: {id: Upah lembur per jam}
    default: "assignment != '' ? assignment.overtime_cost_rate : worker.overtime_cost_rate"
  - name: amount
    type: currency
    label: {id: Jumlah}
    compute: "(rate_basis == 'hour' ? round(hours * hour_rate) : round(days * day_rate)) + round(overtime_hours * overtime_rate)"
    in_list: true
  - name: cost_amount
    type: currency
    label: {id: Biaya}
    compute: "round((rate_basis == 'hour' ? hours : days) * cost_rate) + round(overtime_hours * overtime_cost_rate)"
  # No pay entered for this work (G5): the cost is not 0, it is unknown. The project margin dashboard counts these so
  # a margin without labour cost is read as incomplete; fix the pay on the worker, then cancel and amend.
  - name: cost_missing
    type: check
    label: {id: Upah belum diisi}
    compute: "cost_rate == 0 || (overtime_hours > 0 && overtime_cost_rate == 0)"
  - name: billable_amount
    type: currency
    label: {id: Jumlah dapat ditagih}
    compute: "billable ? amount : 0"
rules:
  - name: rates_not_negative
    on: save
    check: day_rate >= 0 && hour_rate >= 0 && cost_rate >= 0 && overtime_rate >= 0 && overtime_cost_rate >= 0
    message: {id: 'Tarif dan upah tidak boleh negatif'}
  - name: days_range
    on: save
    check: rate_basis == 'hour' || period_to != '' || (days > 0 && days <= 1.5)
    message: {id: 'Hari kerja harus lebih dari 0 dan paling banyak 1,5'}
  # A recap covers at most 31 days, never runs backwards, and cannot hold more days present than days in the period.
  # date + duration drops a fraction of a day, so days are rounded up first (round(x + 0.49): 1,5 -> 2, 1,9 -> 2).
  - name: recap_period
    on: save
    check: period_to == '' || (period_to >= work_date && period_to < work_date + duration(31))
    message: {id: 'Periode rekap: sampai tanggal tidak boleh sebelum tanggal mulai, paling lama 31 hari'}
  - name: recap_days
    on: save
    check: >-
      period_to == '' || rate_basis == 'hour'
      || (days >= 0 && (days > 0 || overtime_hours > 0) && work_date + duration(round(days + 0.49) - 1) <= period_to)
    message: {id: 'Hari hadir rekap harus lebih dari 0 dan tidak melebihi jumlah hari di periodenya'}
  - name: overtime_range
    on: save
    check: "overtime_hours >= 0 && (period_to == '' ? overtime_hours <= 24 : work_date + duration(round(overtime_hours / 24 + 0.49) - 1) <= period_to)"
    message: {id: 'Jam lembur tidak boleh negatif atau melebihi jam di periodenya'}
  - name: hour_rate_for_billable_hours
    on: save
    check: rate_basis != 'hour' || !billable || hour_rate > 0
    message: {id: 'Timesheet per jam yang ditagih butuh tarif per jam (isi di tenaga kerja atau penugasan)'}
  - name: hours_range
    on: save
    check: "rate_basis != 'hour' || (hours > 0 && hours <= (period_to == '' ? 24 : 744))"
    message: {id: 'Jam kerja harus lebih dari 0 dan paling banyak 24 per hari'}
views:
  list:
    columns: [name, project, worker, work_date, period_to, days, status, amount]
    sort: -work_date
  form:
    layout:
      - section: {id: Timesheet}
        columns:
          - [project, worker, assignment]
          - [work_date, period_to, days, hours, overtime_hours]
      - section: {id: Pekerjaan}
        columns:
          - [description, evidence]
      - section: {id: Tagihan}
        columns:
          - [billable, rate_basis, day_rate, hour_rate, overtime_rate, amount]
      - section: {id: Upah (biaya internal)}
        columns:
          - [cost_rate, overtime_cost_rate, cost_amount, cost_missing]
