# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: attendance_log
label: {id: Absen harian, en: Attendance log}
icon: clock
is_submittable: true
naming: ABS-{YYYY}{MM}-{#####}
title_field: worker_name
# One worker, one day at one work site: clocked in and out with the phone's position and a photo (A2, plans/layar-kerja.md
# §4.1; the record of the `clock` screen in contract 0030 §2 and §9, built later as WS9a). The worker creates it at clock-in
# (draft), fills the clock-out and submits it. A submitted log is one day present; attendance_close turns the days of a
# period into the monthly recap timesheet that payroll already reads (payslip_from_recap).
#
# Every log needs a clock-in photo. Inside the radius it submits at once. Outside the radius, with no position, entered
# late or with overtime, the submit waits for the site supervisor (contract 0007 approvals below), who sees the reason,
# the distance and the photo; a rejected log stays a draft and is not counted. Nothing is refused for being far away
# (contract 0030 §4, as Talenta and Gadjian do).
#
# Distance: the phone sends its position as a `geo` value {lat, lng, accuracy_m, at} (contract 0030 §4, WS6) and the
# kernel measures it against the site's point with distance_m (haversine). What the phone shows is only an estimate; the
# computes below decide. A faked position (fake GPS) is not detected; the supervisor checks the photo (contract 0030 §4).
#
# Photos are attachments of the record (contract 0011); in_photo and out_photo (type image) hold the attachment id, and
# the kernel accepts only an image attachment of this same log (contract 0030 §4). The clock screen (screens/absen.rk)
# creates the log with the position, attaches the photo, then sets the photo and the clock-in time together.
#
# The clock-in and clock-out time, position and photo are set_once (contract 0030 §4): a worker fills them once and can
# never move a clock-in the kernel measured as outside. A wrong value is corrected by the project admin cancelling the
# log and entering the day again (attendance_close counts only submitted logs).
#
# Not linked to by any record while it is a draft (contract 0030 §10), so it can be submittable.
permissions:
  # A worker sees and writes only their own logs (row scope worker = their worker record, roles/field_worker.rk). No cancel,
  # no delete: a submitted day is corrected by the project admin.
  - {role: field_worker, read: true, create: true, write: true, submit: true}
  # The supervisor reads the logs of their sites and decides the held submits (approvals); writes nothing.
  - {role: site_supervisor, read: true, print: true}
  - {role: project_admin, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, export: true, print: true}
  - {role: finance_manager, read: true, export: true}
fields:
  - name: worker
    type: link
    to: worker
    label: {id: Tenaga kerja}
    required: true
    in_list: true
  # The name, for the worker and the supervisor, who may not read worker records (they carry pay).
  - name: worker_name
    type: data
    label: {id: Nama}
    read_only: true
    in_list: true
    compute: "worker != '' ? worker.worker_name : ''"
  - name: assignment
    type: link
    to: assignment
    label: {id: Penugasan}
    required: true
  - name: project
    type: link
    to: project
    label: {id: Proyek}
    default: assignment.project
    in_list: true
  - name: work_site
    type: link
    to: work_site
    label: {id: Lokasi kerja}
    default: assignment.work_site
    in_list: true
  - name: work_date
    type: date
    label: {id: Tanggal}
    required: true
    default: today()
    in_list: true
  # Clock-in
  # Set by the clock screen together with the photo (a default would block that write: set_once). Required at submit.
  - name: clock_in
    type: datetime
    label: {id: Jam masuk}
    set_once: true
    in_list: true
  - {name: in_pos, type: geo, label: {id: Posisi masuk}, set_once: true}
  - {name: in_photo, type: image, label: {id: Foto masuk}, set_once: true}
  # Clock-out
  - name: clock_out
    type: datetime
    label: {id: Jam keluar}
    set_once: true
    in_list: true
  - {name: out_pos, type: geo, label: {id: Posisi keluar}, set_once: true}
  - {name: out_photo, type: image, label: {id: Foto keluar}, set_once: true}
  - name: overtime_hours
    type: float
    label: {id: Jam lembur}
    default: '0'
  # Why the worker is outside the site, has no position, enters a past day or claims overtime.
  - name: reason
    type: text
    label: {id: Alasan}
  # The site's point and radius at the time of the log (frozen at submit with the rest of the record).
  - {name: site_lat, type: float, label: {id: Lintang lokasi}, read_only: true, compute: "work_site != '' ? work_site.lat : 0"}
  - {name: site_lng, type: float, label: {id: Bujur lokasi}, read_only: true, compute: "work_site != '' ? work_site.lng : 0"}
  - {name: site_radius_m, type: int, label: {id: Radius lokasi (m)}, read_only: true, compute: "work_site != '' ? work_site.radius_m : 0"}
  - {name: site_point, type: geo, label: {id: Titik lokasi}, hidden: true, read_only: true, compute: "work_site != '' ? {'lat': site_lat, 'lng': site_lng} : ''"}
  # distance_m is 1e9 without a position (contract 0030 §4): "no position" counts as far.
  - {name: in_m, type: float, label: {id: Jarak masuk dari titik (m)}, hidden: true, read_only: true, compute: "distance_m(in_pos, site_point)"}
  - {name: in_located, type: check, label: {id: Lokasi masuk ada}, read_only: true, compute: "in_m < 100000000.0"}
  - name: in_inside
    type: check
    label: {id: Masuk di dalam radius}
    read_only: true
    compute: "in_located && work_site != '' && in_m <= site_radius_m"
  # Distance in metres for people to read (0 without a position).
  - name: in_site_m
    type: int
    label: {id: Jarak masuk dari lokasi (m)}
    read_only: true
    compute: "!in_located || work_site == '' ? 0 : round(in_m)"
  - {name: out_m, type: float, label: {id: Jarak keluar dari titik (m)}, hidden: true, read_only: true, compute: "distance_m(out_pos, site_point)"}
  - {name: out_located, type: check, label: {id: Lokasi keluar ada}, read_only: true, compute: "out_m < 100000000.0"}
  - name: out_inside
    type: check
    label: {id: Keluar di dalam radius}
    read_only: true
    compute: "out_located && work_site != '' && out_m <= site_radius_m"
  - name: out_site_m
    type: int
    label: {id: Jarak keluar dari lokasi (m)}
    read_only: true
    compute: "!out_located || work_site == '' ? 0 : round(out_m)"
  # Outside: clock-in not inside the radius (or no position), or a clock-out entered and not inside.
  - name: outside_site
    type: check
    label: {id: Di luar radius}
    read_only: true
    in_list: true
    chip: true
    compute: "!in_inside || (clock_out != '' && !out_inside)"
  # One live log per worker per day (flow attendance_log_guard_*: a cancelled one frees the day for its amendment).
  - name: day_key
    type: data
    label: {id: Kunci hari}
    hidden: true
    read_only: true
    compute: "worker + ':' + work_date"
rules:
  - name: assignment_of_worker
    on: save
    check: assignment == '' || assignment.worker == worker
    message: {id: 'Penugasan ini bukan milik tenaga kerja ini'}
  - name: within_assignment
    on: save
    check: assignment == '' || (work_date >= assignment.start_date && work_date <= assignment.end_date)
    message: {id: 'Tanggal absen di luar masa penugasan'}
  - name: same_project_and_site
    on: save
    check: assignment == '' || (project == assignment.project && work_site == assignment.work_site)
    message: {id: 'Proyek dan lokasi kerja mengikuti penugasan'}
  - name: has_site
    on: save
    check: work_site != ''
    message: {id: 'Penugasan ini belum punya lokasi kerja; minta admin proyek mengisinya'}
  - name: not_future
    on: save
    check: work_date <= today()
    message: {id: 'Tidak bisa absen untuk tanggal yang belum datang'}
  # The clock-in falls on the day being paid (audit 8 Nov L9). A clock-in with a local offset (+07:00) starts with the
  # local date. A UTC one (Z or +00:00, how the store keeps it) falls between 00:00 WIT and 24:00 WIB of that date:
  # 15:00 UTC the day before up to 17:00 UTC (audit apps-low F3). The org timezone is not readable in CEL.
  - name: clock_in_on_work_date
    on: save
    check: >-
      clock_in == '' || ((clock_in.endsWith('Z') || clock_in.endsWith('+00:00'))
        ? ((clock_in.startsWith(work_date) && clock_in < work_date + 'T17:00:00')
           || (clock_in.startsWith(work_date - duration(1)) && clock_in >= (work_date - duration(1)) + 'T15:00:00'))
        : clock_in.startsWith(work_date))
    message: {id: 'Jam masuk harus di tanggal absen'}
  - name: out_after_in
    on: save
    check: clock_out == '' || (clock_in != '' && clock_out > clock_in)
    message: {id: 'Jam keluar harus sesudah jam masuk'}
  - name: overtime_range
    on: save
    check: overtime_hours >= 0 && overtime_hours <= 12
    message: {id: 'Jam lembur 0 sampai 12 jam per hari'}
  # The reason is asked at the clock-in (the clock screen shows the box only then, contract 0030 §2 clock). A clock-out
  # outside the radius needs none: it still marks the log outside_site, so the submit waits for the supervisor, who
  # sees the distance and the photo.
  - name: reason_when_outside
    on: save
    check: "in_inside || size(reason) >= 5"
    message: {id: 'Kamu di luar radius lokasi kerja (atau lokasi tidak terbaca): tulis alasannya'}
  - name: reason_when_overtime
    on: save
    check: overtime_hours == 0 || size(reason) >= 5
    message: {id: 'Tulis alasan atau pekerjaan lemburnya'}
  - name: clocked_in
    on: submit
    check: clock_in != ''
    message: {id: 'Isi jam masuk dulu (absen masuk) sebelum diajukan'}
  - name: clocked_out
    on: submit
    check: clock_out != ''
    message: {id: 'Isi jam keluar dulu (absen pulang) sebelum diajukan'}
  # Every clock-in carries a photo (audit 8 Nov H2): a log inside the radius is counted without anyone deciding it, and a
  # worker knows the site's point, so the photo is the evidence the supervisor and the admin can check afterwards.
  - name: photo_required
    on: submit
    check: in_photo != ''
    message: {id: 'Absen butuh foto masuk'}
# Held for the site supervisor (contract 0007); the owner may always approve. The verb then runs as the worker.
approvals:
  - name: outside_site
    on: submit
    when: outside_site
    approvers: [site_supervisor]
    label: {id: Absen di luar radius lokasi kerja, en: Clock-in outside the site radius}
  - name: late_entry
    on: submit
    when: days_between(work_date, today()) > 1
    approvers: [site_supervisor]
    label: {id: Absen diisi lebih dari sehari kemudian, en: Attendance entered more than a day late}
  - name: overtime
    on: submit
    when: overtime_hours > 0
    approvers: [site_supervisor]
    label: {id: Lembur, en: Overtime}
views:
  list:
    columns: [name, worker_name, work_site, work_date, clock_in, clock_out, outside_site, status]
    sort: -work_date
  form:
    layout:
      - section: {id: Absen}
        columns:
          - [worker, assignment, project, work_site]
          - [work_date, overtime_hours, outside_site]
      - section: {id: Masuk}
        columns:
          - [clock_in, in_photo]
          - [in_pos, in_site_m, in_inside]
      - section: {id: Keluar}
        columns:
          - [clock_out, out_photo]
          - [out_pos, out_site_m, out_inside]
      - section: {id: Alasan}
        fields: [reason]
      - section: {id: Lokasi kerja}
        columns:
          - [site_lat, site_lng, site_radius_m]
