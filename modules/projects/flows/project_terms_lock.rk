# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: project_terms_lock
label: {id: Syarat komersial proyek terkunci}
# Inside a person's edit of a project: once it has invoices, its contract value and billing model are frozen; once it
# has a schedule, the contract cannot go to 0 (no limit) and the billing model cannot change. Contract 0 stays "no
# limit" for projects billed without a contract value (manpower), but cannot be reached after the fact.
on: project.updated
if: >-
  (event.before.billed_amount > 0 && (event.contract_value != event.before.contract_value || event.billing_model != event.before.billing_model))
  || (event.before.scheduled_amount > 0 && ((event.contract_value == 0 && event.before.contract_value != 0) || event.billing_model != event.before.billing_model))
steps:
  - {find: project, where: name == event.name, as: prj}
  - update: prj
    set:
      locked_terms: 'true'
