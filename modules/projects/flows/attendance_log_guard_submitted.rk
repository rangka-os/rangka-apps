# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: attendance_log_guard_submitted
label: {id: 'Absen yang diajukan tidak dobel, tidak masuk periode yang sudah direkap, fotonya tidak dipakai ulang'}
# Runs again at submit (also the submit an approval runs as the worker): one counted log per worker and day, and no new
# day inside a period whose close is submitted (its recap timesheets are already made). Reads attendance_close before
# attendance_log, the order of attendance_close_on_submit (contract 0025).
on: attendance_log.submitted
steps:
  - find: attendance_close
    where: project == event.project && docstatus == 1 && period_from <= event.work_date && period_to >= event.work_date
    as: closed
  - if: closed != null
    create: attendance_guard
    set:
      reason: "'period_closed'"
      document: closed.name
  - find: attendance_log
    where: day_key == event.day_key && name != event.name && docstatus != 2
    as: other
  - if: other != null
    create: attendance_guard
    set:
      reason: "'second_log'"
      document: other.name
  # One photo, one day (audit r2 R2-3, r3 R3-2): a photo of this log already used as the clock-in or clock-out photo of
  # another live log is refused. That the photo was uploaded to this very log is checked by the kernel only from WS6
  # (image fields).
  - find: attendance_log
    where: >-
      name != event.name && docstatus != 2 && (
        in_photo == event.in_photo || out_photo == event.in_photo
        || (event.out_photo != '' && (in_photo == event.out_photo || out_photo == event.out_photo)))
    as: same_photo
  - if: same_photo != null
    create: attendance_guard
    set:
      reason: "'photo_reused'"
      document: same_photo.name
