# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: work_site_supervisor_changed
label: {id: Pengawas lokasi berganti}
# assignment.supervisor and attendance_log.supervisor are computed on save. When a site gets (or changes) its supervisor,
# the assignments still running there and the logs still in draft (a held clock-in waits for the supervisor) are saved
# again, so the new supervisor sees and decides them and the old one no longer does. Submitted logs are history.
on: work_site.updated
if: event.supervisor != event.before.supervisor
steps:
  - find_all: assignment
    where: work_site == event.name && end_date >= today()
    limit: 500
    as: open
  - for_each: open
    as: a
    do:
      - update: a
        set:
          work_site: a.work_site
  - find_all: attendance_log
    where: work_site == event.name && docstatus == 0
    limit: 500
    as: drafts
  - for_each: drafts
    as: l
    do:
      - update: l
        set:
          work_site: l.work_site
