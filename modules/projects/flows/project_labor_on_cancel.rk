# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: project_labor_on_cancel
label: {id: Biaya tenaga kerja proyek batal}
# Project ledger row (projects): the sum of a project's rows is its margin; a cancel writes the opposite row.
on: timesheet.cancelled
if: event.cost_amount != 0
steps:
  - create: project_ledger
    set:
      project: event.project
      posting_date: today()
      kind: "'labor'"
      source_model: event.model
      source_name: event.name
      amount: "event.cost_amount"
