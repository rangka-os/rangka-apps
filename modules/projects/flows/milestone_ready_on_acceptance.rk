# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: milestone_ready_on_acceptance
label: {id: Termin siap ditagih setelah berita acara}
# Runs inside the acceptance report's submit, as the project admin submitting it: the project's next planned
# milestone that waits for an acceptance (lowest seq) becomes ready, carries the report, and finance is told in-app.
# The invoice itself is made by finance (project admins may not invoice, docs/permissions.md).
on: acceptance.submitted
steps:
  - find_all: billing_milestone
    where: project == event.project && trigger == 'acceptance' && state == 'planned'
    sort: seq
    limit: 1
    as: next
  - if: size(next) > 0
    find: billing_milestone
    where: name == next[0].name
    as: ms
  - if: size(next) > 0
    update: ms
    set:
      state: "'ready'"
      acceptance: event.name
  - if: size(next) > 0
    notify: finance_manager
    channel: in_app
    template: {id: 'Termin {ms.title} proyek {event.project} siap ditagih (Rp {ms.amount})'}
