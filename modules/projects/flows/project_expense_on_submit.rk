# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: project_expense_on_submit
label: {id: Biaya proyek tercatat}
# Project ledger row (projects): the sum of a project's rows is its margin.
on: project_expense.submitted
if: event.vendor_bill == ''
steps:
  - create: project_ledger
    set:
      project: event.project
      posting_date: event.expense_date
      entry: "'post'"
      kind: "'expense'"
      source_model: event.model
      source_name: event.name
      project_expense: event.name
      amount: "0 - event.amount"
