# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: attendance_close_on_submit
label: {id: Rekap absen lapangan jadi timesheet bulanan}
# For each worker assigned to the project during the period: the submitted daily logs of the period become one draft
# monthly recap timesheet (days present, overtime hours), with the rates of the assignment. Only submitted logs count:
# drafts, logs waiting for the supervisor and rejected ones do not. A worker who already has a live recap of this project
# starting the same day (an attendance_recap import, or a second assignment of the same person) gets no second one.
# Reads in the order attendance_close, assignment, attendance_log, timesheet (contract 0025 locks).
on: attendance_close.submitted
steps:
  - find: attendance_close
    where: project == event.project && name != event.name && docstatus == 1 && period_from <= event.period_to && period_to >= event.period_from
    as: other
  - if: other != null
    create: attendance_guard
    set:
      reason: "'close_overlap'"
      document: other.name
  - find_all: assignment
    where: project == event.project && start_date <= event.period_to && end_date >= event.period_from
    sort: start_date
    as: asgs
  - find_all: attendance_log
    where: project == event.project && docstatus == 1 && work_date >= event.period_from && work_date <= event.period_to
    as: logs
  - for_each: asgs
    as: a
    do:
      - find: timesheet
        where: project == event.project && worker == a.worker && work_date == event.period_from && period_to != '' && docstatus != 2
        as: ts
      - if: "ts == null && logs.map(l, l.worker == a.worker ? 1 : 0).sum() > 0"
        create: timesheet
        set:
          project: event.project
          worker: a.worker
          assignment: a.name
          work_date: event.period_from
          period_to: event.period_to
          days: "logs.map(l, l.worker == a.worker ? 1 : 0).sum()"
          overtime_hours: "logs.map(l, l.worker == a.worker ? l.overtime_hours : 0.0).sum()"
          description: "'Rekap absen lapangan ' + event.name"
          attendance_close: event.name
