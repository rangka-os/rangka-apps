# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/role.json
name: field_worker
label: {id: Pekerja lapangan}
description: {id: 'Absen masuk dan pulang di lokasi kerja, dan melihat absennya sendiri'}
# Works from the phone: the clock screen full screen (work shell, contract 0030 §3), no sidebar.
desk: false
# Contract 0010 §5: records whose `employee` is the member's own employee record (user.name, a users.user record since
# contract 0056), so a worker sees only their own logs and assignments. The worker record links to it (worker.employee);
# assignments and logs copy it. Pay and selling rates of an assignment are hidden (contract 0027).
scope: {field: employee, from: '[user.name]'}
