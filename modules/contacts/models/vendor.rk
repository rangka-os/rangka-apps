# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: vendor
label: {id: Pemasok}
icon: store
naming: VND-{####}
title_field: vendor_name
permissions:
  - {role: sales_manager, read: true, create: true, write: true, print: true}
  - {role: finance_manager, read: true, create: true, write: true, print: true}
  - {role: purchasing_manager, read: true, create: true, write: true, print: true}
  - {role: project_admin, read: true, create: true, write: true, print: true}
  - {role: head_office, read: true, create: true, write: true, print: true}
  - {role: outlet_staff, read: true}
# pkp opens PPN masukan on the vendor's bills and pph23_object_code is the default tax object of its bills: tax
# decisions of finance (and the owner), read_only_for every other role that writes vendors, so the person who records
# a bill cannot also make its vendor PKP (rangka-os contract 0027 §6; card t_d8afe122)
fields:
  - name: vendor_name
    type: data
    label: {id: Nama pemasok}
    required: true
    in_list: true
  - name: city
    type: data
    label: {id: Kota}
    in_list: true
  - name: address
    type: text
    label: {id: Alamat}
  - name: phone
    type: phone
    label: {id: Telepon}
  - name: email
    type: data
    label: {id: Email}
  - name: npwp
    type: npwp
    label: {id: NPWP}
  # Withholding (module coretax, BPPU): the income recipient is identified by NPWP or NIK (16 digits) and its NITKU;
  # pph23_object_code is the Coretax tax object (24-104-xx for services) the bills of this vendor default to.
  - name: nitku
    type: data
    label: {id: NITKU}
    help: {id: 'ID TKU 22 digit. Kosongkan bila pusat (NPWP/NIK + 000000)'}
    depends_on: app_installed('coretax')
  - name: nik
    type: data
    label: {id: NIK}
    help: {id: 'Untuk pemasok orang pribadi tanpa NPWP'}
    depends_on: app_installed('coretax')
  - name: pph23_object_code
    type: data
    label: {id: Kode objek PPh 23}
    help: {id: 'Kode objek pajak Coretax, misalnya 24-104-17 jasa penyedia tenaga kerja, 24-104-36 kebersihan, 24-100-02 sewa'}
    depends_on: app_installed('coretax')
    read_only_for: [sales_manager, purchasing_manager, project_admin, head_office]
  - name: pkp
    type: check
    label: {id: Pemasok PKP}
    help: {id: 'PPN pembelian dari pemasok ini dihitung bila PKP. Diatur pemilik atau bagian keuangan setelah memeriksa SPPKP pemasok'}
    default: 'false'
    read_only_for: [sales_manager, purchasing_manager, project_admin, head_office]
  - name: payment_days
    type: int
    label: {id: Tempo (hari)}
    default: '30'
    hidden_for: [outlet_staff]
  - name: outstanding
    type: currency
    label: {id: Utang}
    read_only: true
    in_list: true
    hidden_for: [outlet_staff]
  - name: contacts
    type: table
    of: contact_person
    label: {id: Kontak person}
  # Records already linked by documents cannot be deleted (kernel: 409 linked); one no longer used is switched off
  # instead and kept for its history. Hiding it from link pickers is a kernel follow-up (web).
  - name: active
    type: check
    label: {id: Aktif}
    help: {id: 'Matikan bila pemasok tidak dipakai lagi. Pemasok yang sudah punya transaksi tidak bisa dihapus'}
    default: 'true'
    in_list: true
    in_filter: true
rules:
  - name: npwp_16
    on: save
    check: npwp == '' || size(npwp) == 16
    message: {id: NPWP harus 16 angka}
  - name: nitku_22
    on: save
    check: "nitku == '' || (size(nitku) == 22 && nitku.matches('^[0-9]+$') && (npwp != '' ? nitku.startsWith(npwp) : nitku.startsWith(nik)))"
    message: {id: NITKU harus 22 angka dan diawali NPWP atau NIK}
  - name: nik_16
    on: save
    check: "nik == '' || (size(nik) == 16 && nik.matches('^[0-9]+$'))"
    message: {id: NIK harus 16 angka}
  - name: pph23_object_code_format
    on: save
    check: "pph23_object_code == '' || pph23_object_code.matches('^24-10[0-6]-[0-9]{2}$')"
    message: {id: 'Kode objek PPh 23 berbentuk 24-1xx-xx (lihat daftar objek pajak Coretax)'}
views:
  form:
    layout:
      - section: {id: Identitas}
        columns:
          - [vendor_name, city, address, active]
          - [npwp, phone, email]
      - section: {id: Data pajak (bukti potong)}
        columns:
          - [nitku, nik]
          - [pph23_object_code]
      - section: {id: Pembayaran}
        columns:
          - [payment_days]
          - [outstanding]
      - section: {id: Kontak person}
        fields: [contacts]
