# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: customer
label: {id: Pelanggan}
icon: user
naming: CUST-{####}
title_field: customer_name
permissions:
  - {role: sales_manager, read: true, create: true, write: true, print: true}
  - {role: finance_manager, read: true, create: true, write: true, print: true}
  - {role: purchasing_manager, read: true, create: true, write: true, print: true}
  - {role: project_admin, read: true, create: true, write: true, print: true}
  - {role: head_office, read: true, create: true, write: true, print: true}
  # outlet staff pick customers (POS, outlet sales, returns) but never see their money, credit or tax identity: the
  # money and identity fields are hidden_for outlet_staff (contract 0027; card t_5ba74e22)
  - {role: outlet_staff, read: true}
  - {role: sales_rep, read: true, create: true, write: true}
  # credit_limit, credit_hold and credit_hold_reason are decided by the sales and finance managers (and the owner):
  # they are read_only_for every other role that writes customers (rangka-os contract 0027 §6; card t_6c114aa0)
  # a salesman sees his own customers (role scope salesman) and cannot change their credit
  - {role: field_sales, read: true}
  # course schools: the payer of a student (student_billing_on_create makes one for a person on their own)
  - {role: course_admin, read: true, create: true, write: true}
fields:
  - name: customer_name
    type: data
    label: {id: Nama pelanggan}
    required: true
    in_list: true
  - name: city
    type: data
    label: {id: Kota}
    in_list: true
  - name: address
    type: text
    label: {id: Alamat}
  - name: phone
    type: phone
    label: {id: Nomor WhatsApp}
  - name: email
    type: data
    label: {id: Email}
  - name: payment_days
    type: int
    label: {id: Tempo (hari)}
    default: '30'
    in_list: true
  - name: credit_limit
    type: currency
    label: {id: Batas kredit}
    default: '25000000'
    hidden_for: [outlet_staff]
    read_only_for: [purchasing_manager, project_admin, head_office, sales_rep, course_admin]
  - name: outstanding
    type: currency
    label: {id: Piutang}
    read_only: true
    in_list: true
    hidden_for: [outlet_staff]
  # Distributor sales (module distribution): the salesman who visits the customer, the route, the price tier, and
  # the credit control that holds its orders (customer_order approvals). oldest_open_due is the earliest due date of
  # its open invoices, kept by the distribution flows; an order is held while it is before today.
  - name: salesman
    type: link
    to: user
    label: {id: Salesman}
    in_list: true
    depends_on: app_installed('distribution')
  - name: route_day
    type: select
    label: {id: Hari kunjungan}
    depends_on: app_installed('distribution')
    options:
      - {value: mon_thu, label: {id: Senin dan Kamis}}
      - {value: tue_fri, label: {id: Selasa dan Jumat}}
      - {value: wed_sat, label: {id: Rabu dan Sabtu}}
      - {value: daily, label: {id: Setiap hari}}
  - name: price_tier
    type: select
    label: {id: Tier harga}
    default: "'retail'"
    depends_on: app_installed('distribution')
    options:
      - {value: retail, label: {id: Eceran}}
      - {value: wholesale, label: {id: Grosir}}
      - {value: agent, label: {id: Agen}}
  - name: credit_hold
    type: check
    label: {id: Tahan kredit}
    help: {id: Semua pesanan pelanggan ini butuh persetujuan sampai dicentang lagi}
    depends_on: app_installed('distribution')
    read_only_for: [purchasing_manager, project_admin, head_office, sales_rep, course_admin]
  - name: credit_hold_reason
    type: data
    label: {id: Alasan tahan kredit}
    depends_on: app_installed('distribution')
    hidden_for: [outlet_staff]
    read_only_for: [purchasing_manager, project_admin, head_office, sales_rep, course_admin]
  - name: oldest_open_due
    type: date
    label: {id: Jatuh tempo tertua yang belum lunas}
    read_only: true
    depends_on: app_installed('distribution')
    hidden_for: [outlet_staff]
  - name: open_orders
    type: currency
    label: {id: Pesanan belum ditagih (dengan PPN)}
    read_only: true
    depends_on: app_installed('distribution')
    hidden_for: [outlet_staff]
  - name: uninvoiced_deliveries
    type: currency
    label: {id: Terkirim belum ditagih (dengan PPN)}
    read_only: true
    depends_on: app_installed('delivery')
    hidden_for: [outlet_staff]
  - name: npwp
    type: npwp
    label: {id: NPWP}
    hidden_for: [outlet_staff]
  # Tax identity for e-Faktur (module coretax, contract 0029): a buyer is identified by NPWP 16 digits plus its NITKU
  # (22 digits, NPWP + 000000 for the head office), else NIK, else a passport. vat_collector sets the transaction
  # code (02 government, 03 other collectors such as BUMN).
  - name: nitku
    type: data
    label: {id: NITKU}
    help: {id: 'ID TKU 22 digit dari Coretax. Kosongkan bila pusat (NPWP + 000000)'}
    depends_on: app_installed('coretax')
    hidden_for: [outlet_staff]
  - name: nik
    type: data
    label: {id: NIK}
    help: {id: 'Untuk pembeli orang pribadi tanpa NPWP'}
    depends_on: app_installed('coretax')
    hidden_for: [outlet_staff]
  - name: passport_no
    type: data
    label: {id: No. paspor}
    help: {id: 'Untuk pembeli warga negara asing tanpa NPWP/NIK'}
    depends_on: app_installed('coretax')
    hidden_for: [outlet_staff]
  - name: country
    type: data
    label: {id: Kode negara}
    help: {id: 'Kode 3 huruf, IDN untuk Indonesia'}
    default: "'IDN'"
    depends_on: app_installed('coretax')
  - name: vat_collector
    type: select
    label: {id: Pemungut PPN}
    default: "'none'"
    depends_on: app_installed('coretax')
    options:
      - {value: none, label: {id: Bukan pemungut}}
      - {value: government, label: {id: Instansi pemerintah}}
      - {value: other, label: {id: Pemungut lain (BUMN dsb.)}}
  - name: contacts
    type: table
    of: contact_person
    label: {id: Kontak person}
  # Records already linked by documents cannot be deleted (kernel: 409 linked); one no longer used is switched off
  # instead and kept for its history. Hiding it from link pickers is a kernel follow-up (web).
  - name: active
    type: check
    label: {id: Aktif}
    help: {id: 'Matikan bila pelanggan tidak aktif lagi. Pelanggan yang sudah punya transaksi tidak bisa dihapus'}
    default: 'true'
    in_list: true
    in_filter: true
rules:
  - name: npwp_16
    on: save
    check: npwp == '' || size(npwp) == 16
    message: {id: NPWP harus 16 angka}
  - name: nitku_22
    on: save
    check: "nitku == '' || (size(nitku) == 22 && nitku.matches('^[0-9]+$') && npwp != '' && nitku.startsWith(npwp))"
    message: {id: NITKU harus 22 angka dan diawali NPWP}
  - name: nik_16
    on: save
    check: "nik == '' || (size(nik) == 16 && nik.matches('^[0-9]+$'))"
    message: {id: NIK harus 16 angka}
  - name: country_code
    on: save
    check: "country == '' || country.matches('^[A-Z]{3}$')"
    message: {id: 'Kode negara 3 huruf besar, misalnya IDN'}
views:
  form:
    layout:
      - section: {id: Identitas}
        columns:
          - [customer_name, city, address, active]
          - [npwp, phone, email]
      - section: {id: Data pajak (e-Faktur)}
        columns:
          - [nitku, nik, passport_no]
          - [country, vat_collector]
      - section: {id: Pembayaran}
        columns:
          - [payment_days, price_tier]
          - [credit_limit, outstanding]
      - section: {id: Kredit dan salesman}
        columns:
          - [salesman, route_day, credit_hold, credit_hold_reason]
          - [open_orders, uninvoiced_deliveries, oldest_open_due]
      - section: {id: Kontak person}
        fields: [contacts]
