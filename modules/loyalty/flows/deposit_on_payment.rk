# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# An invoice paid from the deposit (payment method deposit, module payments): the customer's member pays it, never
# more than the balance read under the member's flow lock. The payment's journal takes it out of 2-1400 instead of
# cash or bank (accounting). Runs as whoever submits the payment.
name: deposit_on_payment
label: {id: 'Pembayaran dari deposit: kurangi saldo member'}
on: payment.submitted
if: app_installed('payments')
steps:
  - if: "event.method == 'deposit'"
    then:
      - find_all: loyalty_account
        where: customer == event.customer && active
        limit: 1
        as: acc
      - if: event.direction != 'receive' || acc.size() == 0
        create: loyalty_guard
        set: {reason: "'not_member'", document: event.name}
      - find: loyalty_account
        where: name == acc[0].name
        as: a
      - if: event.amount > a.deposit_balance
        create: loyalty_guard
        set: {reason: "'deposit_short'", document: event.name}
      - create: deposit_entry
        set:
          account: a.name
          kind: "'spend'"
          amount: 0 - event.amount
          balance_after: a.deposit_balance - event.amount
          date: event.payment_date
          source_type: "'payment'"
          source: event.name
          entry_key: "event.name + '|spend'"
      - update: a
        set: {deposit_balance: a.deposit_balance - event.amount}
