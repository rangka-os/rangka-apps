# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# One active base tier (min_spend 0): the tier every new member starts in. A second one is refused when it is saved.
name: member_tier_guard_updated
label: {id: 'Tier member diubah: satu tier dasar'}
on: member_tier.updated
steps:
  - find_all: member_tier
    where: active && min_spend == 0 && name != event.name
    limit: 1
    as: other
  - if: event.active && event.min_spend == 0 && other.size() > 0
    create: loyalty_guard
    set: {reason: "'base_tier'", document: event.name}
