# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Runs inside a sale's submit (the payment), as the cashier, also for a sale a paired device sends later (contract
# 0058 §10 turns the sale's own rules into exceptions there; a record this flow writes still refuses). Reading the
# member takes the flow read lock of contract 0025, so two sales spending the same balance run one after the other and
# the second sees what the first left: points or deposit short is refused (loyalty_guard) and the payment rolls back.
# Then the ledgers (redeem, earn, deposit spend), the balances, the year's spend and the last purchase; the member moves
# up a tier as soon as its spend this year (or last year) reaches a higher active tier, never down here (loyalty_yearly).
name: loyalty_on_sale
label: {id: 'Transaksi kasir dibayar: poin dan deposit member'}
on: pos_sale.submitted
if: app_installed('pos')
steps:
  - if: "event.member != ''"
    then:
      - find: loyalty_account
        where: name == event.member
        as: a
      - if: a == null || !a.active
        create: loyalty_guard
        set: {reason: "'not_member'", document: event.name}
      - if: event.points_redeemed < 0 || event.points_redeemed > a.points_balance
        create: loyalty_guard
        set: {reason: "'points_short'", document: event.name}
      - if: event.points_discount > event.points_cap
        create: loyalty_guard
        set: {reason: "'points_cap'", document: event.name}
      - if: event.deposit_used < 0 || event.deposit_used > a.deposit_balance
        create: loyalty_guard
        set: {reason: "'deposit_short'", document: event.name}
      - create: loyalty_entry
        if: event.points_redeemed > 0
        set:
          account: a.name
          kind: "'redeem'"
          points: 0 - event.points_redeemed
          balance_after: a.points_balance - event.points_redeemed
          date: event.date
          source_type: "'pos_sale'"
          source: event.name
          outlet: event.outlet
          entry_key: "event.name + '|redeem'"
      - create: loyalty_entry
        if: event.points_earned > 0
        set:
          account: a.name
          kind: "'earn'"
          points: event.points_earned
          balance_after: a.points_balance - event.points_redeemed + event.points_earned
          date: event.date
          source_type: "'pos_sale'"
          source: event.name
          outlet: event.outlet
          entry_key: "event.name + '|earn'"
      - create: deposit_entry
        if: event.deposit_used > 0
        set:
          account: a.name
          kind: "'spend'"
          amount: 0 - event.deposit_used
          balance_after: a.deposit_balance - event.deposit_used
          date: event.date
          source_type: "'pos_sale'"
          source: event.name
          outlet: event.outlet
          entry_key: "event.name + '|spend'"
      # the highest active tier the spend reaches; a move up only
      - find_all: member_tier
        where: active
        sort: -min_spend
        as: tiers
      - find: member_tier
        where: name == a.tier
        as: cur
      - for_each: "tiers.filter(t, t.min_spend <= max(a.spend_this_year + event.grand_total, a.spend_last_year)).size() > 0 && (cur == null || tiers.filter(t, t.min_spend <= max(a.spend_this_year + event.grand_total, a.spend_last_year))[0].min_spend > cur.min_spend) ? [tiers.filter(t, t.min_spend <= max(a.spend_this_year + event.grand_total, a.spend_last_year))[0]] : []"
        as: up
        do:
          - update: a
            set:
              tier: up.name
              tier_name: up.tier_name
              earn_spend: up.earn_spend
              earn_multiplier_pct: up.earn_multiplier_pct
              point_value: up.point_value
              max_redeem_pct: up.max_redeem_pct
              member_discount_pct: up.member_discount_pct
              expiry_months: up.expiry_months
      - update: a
        set:
          points_balance: a.points_balance - event.points_redeemed + event.points_earned
          deposit_balance: a.deposit_balance - event.deposit_used
          spend_this_year: a.spend_this_year + event.grand_total
          last_activity: event.date
