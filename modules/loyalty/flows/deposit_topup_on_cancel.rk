# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# A top-up voided: only on its own day, and at the counter only while its shift is open (the close counted its cash),
# like a sale's void; the money goes back to the member out of the drawer or the QRIS. Refused when the member already
# spent it (the balance would go below 0).
name: deposit_topup_on_cancel
label: {id: 'Isi deposit dibatalkan: kurangi saldo member'}
on: deposit_topup.cancelled
steps:
  - if: event.date != today()
    create: loyalty_guard
    set: {reason: "'void_other_day'", document: event.name}
  - {find: loyalty_account, where: name == event.account, as: a}
  - if: a == null || a.deposit_balance < event.amount
    create: loyalty_guard
    set: {reason: "'balance_negative'", document: event.name}
  - if: app_installed('pos') && event.shift != ''
    then:
      - {find: pos_shift, where: name == event.shift && state == 'open', as: s}
      - if: s == null
        create: loyalty_guard
        set: {reason: "'void_other_day'", document: event.name}
      # only the shift's own cashier (or head office, the owner) voids its top-ups: the cash leaves that drawer (audit F7)
      - if: "s.cashier != user.email && !('head_office' in user.roles) && !('owner' in user.roles)"
        create: loyalty_guard
        set: {reason: "'void_not_own'", document: event.name}
      - update: s
        set:
          topup_cash_total: "s.topup_cash_total - (event.method == 'cash' ? event.amount : 0)"
          topup_qris_total: "s.topup_qris_total - (event.method == 'qris' ? event.amount : 0)"
  - create: deposit_entry
    set:
      account: a.name
      kind: "'reverse'"
      amount: 0 - event.amount
      balance_after: a.deposit_balance - event.amount
      date: event.date
      source_type: "'deposit_topup'"
      source: event.name
      outlet: event.outlet
      entry_key: "event.name + '|reverse'"
  - update: a
    set: {deposit_balance: a.deposit_balance - event.amount}
