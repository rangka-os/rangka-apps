# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# A correction by head office: the points move, never below 0.
name: points_adjustment_on_submit
label: {id: 'Koreksi poin diajukan: ubah poin member'}
on: points_adjustment.submitted
steps:
  - {find: loyalty_account, where: name == event.account, as: a}
  - if: a == null || a.points_balance + event.points < 0
    create: loyalty_guard
    set: {reason: "'balance_negative'", document: event.name}
  - create: loyalty_entry
    set:
      account: a.name
      kind: "'adjust'"
      points: event.points
      balance_after: a.points_balance + event.points
      date: event.date
      source_type: "'points_adjustment'"
      source: event.name
      entry_key: "event.name + '|adjust'"
  - update: a
    set: {points_balance: a.points_balance + event.points}
