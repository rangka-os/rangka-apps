# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# A refund cancelled (the money did not leave after all): the amount is the member's again.
name: deposit_refund_on_cancel
label: {id: 'Pengembalian deposit dibatalkan: saldo member kembali'}
on: deposit_refund.cancelled
steps:
  - {find: loyalty_account, where: name == event.account, as: a}
  - create: deposit_entry
    if: a != null
    set:
      account: a.name
      kind: "'reverse'"
      amount: event.amount
      balance_after: a.deposit_balance + event.amount
      date: today()
      source_type: "'deposit_refund'"
      source: event.name
      entry_key: "event.name + '|reverse'"
  - update: a
    if: a != null
    set: {deposit_balance: a.deposit_balance + event.amount}
