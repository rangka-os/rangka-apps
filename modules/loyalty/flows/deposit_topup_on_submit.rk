# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# A top-up paid: the member's balance grows (under the member's flow lock, contract 0025) and, taken at the counter, the
# shift's top-up totals grow under the shift's lock, the same lock the sales and the close take: a shift closed
# meanwhile refuses the top-up, and a close whose figures went stale is refused (pos_shift_close_on_submit).
name: deposit_topup_on_submit
label: {id: 'Isi deposit diajukan: tambah saldo member'}
on: deposit_topup.submitted
steps:
  - {find: loyalty_account, where: name == event.account, as: a}
  - if: a == null || !a.active
    create: loyalty_guard
    set: {reason: "'not_member'", document: event.name}
  - if: app_installed('pos') && event.shift != ''
    then:
      - {find: pos_shift, where: name == event.shift && state == 'open', as: s}
      - if: s == null
        create: loyalty_guard
        set: {reason: "'shift_closed'", document: event.name}
      - update: s
        set:
          topup_cash_total: "s.topup_cash_total + (event.method == 'cash' ? event.amount : 0)"
          topup_qris_total: "s.topup_qris_total + (event.method == 'qris' ? event.amount : 0)"
  - create: deposit_entry
    set:
      account: a.name
      kind: "'top_up'"
      amount: event.amount
      balance_after: a.deposit_balance + event.amount
      date: event.date
      source_type: "'deposit_topup'"
      source: event.name
      outlet: event.outlet
      entry_key: "event.name + '|top_up'"
  - update: a
    set: {deposit_balance: a.deposit_balance + event.amount}
