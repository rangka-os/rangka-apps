# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# Pengembalian deposit: head office pays a member's deposit back (all or part), in cash or by transfer. Above
# Rp 1.000.000 it waits for the owner or finance (contract 0007: approvers finance_manager, the owner always may; head
# office, who asks, does not hold the role, so it never approves its own). Flow deposit_refund_on_submit takes the amount off the balance
# under the flow read lock (contract 0025) and refuses more than the balance. Journal: 2-1400 against Kas or Bank.
# No cooling period in v1; the reason is asked so the owner sees why money left.
name: deposit_refund
label: {id: Pengembalian deposit, en: Deposit refund}
icon: wallet-3-line
is_submittable: true
naming: DRF-{YYYY}-{#####}
title_field: account
permissions:
  - {role: head_office, read: true, create: true, write: true, delete: true, submit: true, cancel: true, export: true, print: true}
  # finance approves a refund above Rp 1.000.000 (with the owner, contract 0007), so it does not ask for one itself
  - {role: finance_manager, read: true, export: true, print: true}
fields:
  - {name: account, type: link, to: loyalty_account, label: {id: Member}, required: true, in_list: true, peek: [phone, deposit_balance]}
  - {name: date, type: date, label: {id: Tanggal}, default: today(), in_list: true}
  - {name: amount, type: currency, label: {id: Jumlah dikembalikan}, required: true, in_list: true}
  - name: method
    type: select
    label: {id: Cara bayar}
    required: true
    default: "'transfer'"
    options:
      - {value: transfer, label: {id: Transfer}}
      - {value: cash, label: {id: Tunai}}
  - {name: ref, type: data, label: {id: Ref transfer}}
  - name: reason
    type: select
    label: {id: Alasan}
    required: true
    options:
      - {value: closing, label: {id: Berhenti jadi member}}
      - {value: request, label: {id: Diminta pelanggan}}
      - {value: wrong_topup, label: {id: Salah isi deposit}}
      - {value: other, label: {id: Lainnya}}
  - {name: note, type: data, label: {id: Catatan}}
rules:
  - name: amount_positive
    on: save
    check: amount > 0
    message: {id: Jumlah pengembalian harus lebih dari 0}
  - name: within_balance
    on: save
    check: amount <= account.deposit_balance
    message: {id: 'Melebihi saldo deposit member'}
  - name: note_for_other
    on: save
    check: reason != 'other' || note.trim() != ''
    message: {id: 'Tulis alasannya di Catatan'}
approvals:
  - name: big_refund
    on: submit
    when: "amount > 1000000 && !('owner' in user.roles)"
    approvers: [finance_manager]
    label: {id: Persetujuan pemilik untuk pengembalian deposit di atas Rp 1.000.000, en: Owner approves a deposit refund above Rp 1.000.000}
views:
  list:
    columns: [name, date, account, amount, method, reason, status]
    filters: [account, reason]
    sort: -name
  form:
    layout:
      - section: {id: Pengembalian}
        columns:
          - [account, amount, method, ref]
          - [date, reason, note]
