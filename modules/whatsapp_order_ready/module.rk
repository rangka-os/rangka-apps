# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/module.json
name: whatsapp_order_ready
version: 1.0.0
title: {id: Kabar pesanan siap lewat WhatsApp, en: WhatsApp order-ready messages}
summary:
  id: Saat dapur menandai pesanan siap, pembeli yang memberi nomor WhatsApp di kasir dikabari untuk mengambilnya.
  en: When the kitchen marks an order ready, a buyer who gave a WhatsApp number at the kasir is told to pick it up.
category: sales
icon: send-plane-line
# One message type of the WhatsApp service (module whatsapp): installing this module is switching "Kabar pesanan siap"
# on. The buyer's yes is the one asked at the kasir (pos_sale.wa_receipt, "Kirim struk ke WhatsApp"), so it needs
# whatsapp_receipt for the number and the tick.
requires: {rangka: '>=0.5', users: ^1.2, outlets: ^1.2, pos: ^1.3, kitchen: ^1.0, whatsapp: ^1.0, whatsapp_receipt: ^1.0}
