# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Staff take or turn down what a guest sent (one tap on the work screen pesanan_masuk), or the guest cancels a round
# within 2 minutes (the kernel's portal route). Runs inside that write, as the person or the link's actor. What the
# guest sent (kind, table, name, note, lines, options) never changes. Moves:
# - a round: new -> accepted (Terima: the cashier's open shift at the table's outlet, else for head office or the owner
#   an open shift there; every item still sold; then the table's open bill, or a new one, and the kitchen, as in
#   self_order_on_create), new -> rejected (Tolak), new -> cancelled (the guest only);
# - a request: new -> done (Sudah ditangani). Minta diantar done also sends the held lines of the order it names to
#   the kitchen and clears their "Antar nanti";
# - the kitchen's progress (accepted -> cooking -> ready -> served) is written by flow self_order_kitchen_progress
#   only (writes by flows start no flow).
name: self_order_on_update
label: {id: 'Pesanan dari meja diterima: masuk tagihan meja dan dapur'}
description: {id: 'Saat kasir menerima pesanan dari QR meja, menunya masuk ke tagihan meja itu (atau tagihan baru) dan dikirim ke dapur; permintaan antar menu yang ditahan mengirim menu itu ke dapur.'}
on: self_order.updated
if: event.before != null
steps:
  - create: self_order_guard
    if: >-
      event.kind != event.before.kind || event.table != event.before.table || event.guest_name != event.before.guest_name
      || event.note != event.before.note || event.about != event.before.about
      || event.items.map(l, l.line_key + '|' + l.item + '|' + string(l.qty) + '|' + l.note + '|' + string(l.later)) != event.before.items.map(l, l.line_key + '|' + l.item + '|' + string(l.qty) + '|' + l.note + '|' + string(l.later))
      || event.options.map(o, o.line + '|' + o.option) != event.before.options.map(o, o.line + '|' + o.option)
    set: {reason: "'locked'", document: event.name}
  - create: self_order_guard
    if: >-
      event.before.status != event.status && !((event.kind == 'order' && (event.before.status + '>' + event.status) in ['new>accepted', 'new>rejected', 'new>cancelled'])
      || (event.kind != 'order' && (event.before.status + '>' + event.status) in ['new>done', 'new>cancelled']))
    set: {reason: "'bad_step'", document: event.name}
  # Terima, Tolak and Sudah ditangani are the staff's (cashier, head office, owner); the guest's cancel comes as the
  # link's actor (portal:<link id>), the only one who cancels
  - create: self_order_guard
    if: >-
      event.before.status != event.status && event.status in ['accepted', 'rejected', 'done']
      && !('cashier' in user.roles || 'head_office' in user.roles || 'owner' in user.roles)
    set: {reason: "'bad_step'", document: event.name}
  - create: self_order_guard
    if: "event.before.status != event.status && event.status == 'cancelled' && !user.email.startsWith('portal:')"
    set: {reason: "'bad_step'", document: event.name}
  - create: self_order_guard
    if: "event.before.status == event.status && event.reject_reason != event.before.reject_reason && event.status != 'new'"
    set: {reason: "'locked'", document: event.name}
  # Terima: the shift
  - find: pos_shift
    if: event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted'
    where: "cashier == user.email && state == 'open' && outlet == event.outlet"
    as: own
  - find_all: pos_shift
    if: event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted'
    where: "state == 'open' && outlet == event.outlet"
    sort: -opening_date
    limit: 1
    as: open_shifts
  - create: self_order_guard
    if: >-
      event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted' && own == null
      && (open_shifts.size() == 0 || !('head_office' in user.roles || 'owner' in user.roles))
    set: {reason: "'no_shift'", document: event.name}
  # every item still on sale (it may have stopped since the guest loaded the menu)
  - find_all: item
    if: event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted'
    where: "name in event.items.map(l, l.item) && (active == false || kind == 'material')"
    limit: 1
    as: stopped
  - create: self_order_guard
    if: event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted' && stopped.size() > 0
    set: {reason: "'item_off'", document: event.name}
  # the table's open bill takes the round after its own lines (keys <order>:<row>, options by the same keys); rev goes
  # up so a counter holding an older copy gets a conflict instead of dropping them. No open bill: a new dine-in bill.
  # the table's open bill: the main one, else a part left open after the main one was paid (never a second bill beside
  # it: writes by flows start no flow, so pos_table_guard would not stop one)
  - find_all: pos_sale
    if: "event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted'"
    where: "table == event.table && docstatus == 0 && !merged && amended_from == ''"
    sort: split_of
    limit: 1
    as: open_bill_open
  - find: pos_sale
    if: "event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted'"
    where: "open_bill_open.size() > 0 && name == open_bill_open[0].name"
    as: open_bill
  - find: dining_table
    if: "event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted'"
    where: name == event.table
    as: tbl
  - update: open_bill
    if: "event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted' && open_bill != null"
    set:
      items: >-
        open_bill.items.map(l, {'item': l.item, 'packing': l.packing, 'qty': l.qty, 'discount_pct': l.discount_pct, 'description': l.description, 'note': l.note, 'is_gift': l.is_gift, 'line_key': l.line_key})
        + event.items.map(l, {'item': l.item, 'packing': '', 'qty': l.qty, 'discount_pct': 0, 'description': l.description, 'note': l.note, 'is_gift': false, 'line_key': event.name + ':' + l.line_key})
      options: "open_bill.options.map(o, {'line': o.line, 'option': o.option}) + event.options.map(o, {'line': event.name + ':' + o.line, 'option': o.option})"
      bill_asked: "false"
      rev: open_bill.rev + 1
  - create: pos_sale
    if: "event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted' && open_bill == null"
    set:
      shift: "own != null ? own.name : open_shifts[0].name"
      table: event.table
      buyer: tbl.table_name
      order_type: "'dine_in'"
      guests: "1"
      items: "event.items.map(l, {'item': l.item, 'packing': '', 'qty': l.qty, 'discount_pct': 0, 'description': l.description, 'note': l.note, 'is_gift': false, 'line_key': event.name + ':' + l.line_key})"
      options: "event.options.map(o, {'line': event.name + ':' + o.line, 'option': o.option})"
  # the table's open bill: the main one, else a part left open after the main one was paid (never a second bill beside
  # it: writes by flows start no flow, so pos_table_guard would not stop one)
  - find_all: pos_sale
    if: "event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted'"
    where: "table == event.table && docstatus == 0 && !merged && amended_from == ''"
    sort: split_of
    limit: 1
    as: bill_open
  - find: pos_sale
    if: "event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted'"
    where: "bill_open.size() > 0 && name == bill_open[0].name"
    as: bill
  # the kitchen (module kitchen): writes by flows start no flow, so the station tickets are made here with the routing of
  # kitchen_ticket_on_draft, buyer "<table> · <order>"; lines the guest wants later ("Antar nanti") wait on the bill
  # until staff send them. Sent lines go into the bill's sent_to_kitchen, so payment and "Kirim ke dapur" skip them.
  - find_all: kitchen_station
    if: "event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted' && app_installed('kitchen')"
    where: outlet == event.outlet && active
    as: stations
  - find_all: kitchen_route
    if: "event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted' && app_installed('kitchen')"
    where: outlet == event.outlet
    as: routes
  - for_each: "event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted' && app_installed('kitchen') ? stations : []"
    as: st
    do:
      - if: "event.items.filter(l, !l.later && routes.filter(r, r.station == st.name && r.category == l.category).size() > 0).size() > 0"
        create: kitchen_ticket
        set:
          sale: bill.name
          outlet: event.outlet
          station: st.name
          date: bill.date
          buyer: tbl.table_name + ' · ' + event.name
          items: "event.items.filter(l, !l.later && routes.filter(r, r.station == st.name && r.category == l.category).size() > 0).map(l, {'item': l.item, 'description': l.description, 'qty': l.qty, 'uom': l.uom, 'note': l.note})"
  - update: bill
    if: "event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted' && app_installed('kitchen') && stations.size() > 0"
    set:
      sent_to_kitchen: >-
        (bill.sent_to_kitchen == null ? [] : bill.sent_to_kitchen) + event.items.filter(l, !l.later).map(l, {'key': event.name + ':' + l.line_key,
        'item': l.item, 'packing': '', 'description': l.description, 'qty': l.qty, 'uom': l.uom, 'note': l.note, 'category': l.category})
  # Minta diantar handled: the held lines of the named order go to the kitchen now, from the open bill of the table that
  # holds them (a merge prefixes keys with the source bill, a split moves lines to a part: a line is found by the end of
  # its key, <order>:<row>)
  - find: self_order
    if: "event.kind == 'fire' && event.before.status == 'new' && event.status == 'done' && event.about != ''"
    where: "name == event.about && table == event.table && kind == 'order'"
    as: held
  - find_all: pos_sale
    if: "event.kind == 'fire' && event.before.status == 'new' && event.status == 'done' && event.about != '' && held != null"
    where: "table == event.table && docstatus == 0 && !merged && amended_from == ''"
    as: hopen
  - find: pos_sale
    if: "event.kind == 'fire' && event.before.status == 'new' && event.status == 'done' && event.about != '' && held != null"
    where: "hopen.filter(b, b.items.exists(x, held.items.exists(l, l.later && x.line_key.endsWith(held.name + ':' + l.line_key)))).size() > 0 && name == hopen.filter(b, b.items.exists(x, held.items.exists(l, l.later && x.line_key.endsWith(held.name + ':' + l.line_key))))[0].name"
    as: hbill
  - find: dining_table
    if: "event.kind == 'fire' && event.before.status == 'new' && event.status == 'done' && event.about != '' && held != null && hbill != null"
    where: name == event.table
    as: htbl
  - find_all: kitchen_station
    if: "event.kind == 'fire' && event.before.status == 'new' && event.status == 'done' && event.about != '' && held != null && hbill != null && app_installed('kitchen')"
    where: outlet == event.outlet && active
    as: hstations
  - find_all: kitchen_route
    if: "event.kind == 'fire' && event.before.status == 'new' && event.status == 'done' && event.about != '' && held != null && hbill != null && app_installed('kitchen')"
    where: outlet == event.outlet
    as: hroutes
  - for_each: "event.kind == 'fire' && event.before.status == 'new' && event.status == 'done' && event.about != '' && held != null && hbill != null && app_installed('kitchen') ? hstations : []"
    as: st
    do:
      - if: "hbill.items.filter(b, held.items.exists(l, l.later && b.line_key.endsWith(held.name + ':' + l.line_key)) && !(b.line_key in hbill.sent_to_kitchen.map(s, s.key)) && hroutes.filter(r, r.station == st.name && r.category == b.category).size() > 0).size() > 0"
        create: kitchen_ticket
        set:
          sale: hbill.name
          outlet: event.outlet
          station: st.name
          date: hbill.date
          buyer: htbl.table_name + ' · ' + held.name
          items: "hbill.items.filter(b, held.items.exists(l, l.later && b.line_key.endsWith(held.name + ':' + l.line_key)) && !(b.line_key in hbill.sent_to_kitchen.map(s, s.key)) && hroutes.filter(r, r.station == st.name && r.category == b.category).size() > 0).map(b, {'item': b.item, 'description': b.description, 'qty': b.qty, 'uom': b.uom, 'note': b.note})"
  - update: hbill
    if: "event.kind == 'fire' && event.before.status == 'new' && event.status == 'done' && event.about != '' && held != null && hbill != null && app_installed('kitchen') && hstations.size() > 0"
    set:
      sent_to_kitchen: >-
        hbill.sent_to_kitchen + hbill.items.filter(b, held.items.exists(l, l.later && b.line_key.endsWith(held.name + ':' + l.line_key)) && !(b.line_key in hbill.sent_to_kitchen.map(s, s.key))).map(b, {'key': b.line_key,
        'item': b.item, 'packing': b.packing, 'description': b.description, 'qty': b.qty, 'uom': b.uom, 'note': b.note, 'category': b.category})
  - update: held
    if: "event.kind == 'fire' && event.before.status == 'new' && event.status == 'done' && event.about != '' && held != null && hbill != null"
    set:
      items: "held.items.map(l, {'line_key': l.line_key, 'item': l.item, 'qty': l.qty, 'note': l.note, 'later': false})"
  - {find: self_order, if: "event.before.status != event.status", where: name == event.name, as: me}
  - update: me
    if: event.kind == 'order' && event.before.status == 'new' && event.status == 'accepted'
    set: {sale: bill.name, handled_by: user.name, handled_at: now()}
  - update: me
    if: "event.before.status == 'new' && event.status in ['rejected', 'done']"
    set: {handled_by: user.name, handled_at: now()}
