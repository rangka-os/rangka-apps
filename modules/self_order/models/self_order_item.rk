# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# One line of a table order. The unit price is the item's rate plus the deltas of the options chosen for this line
# (self_order.options rows naming line_key); the page's request never carries a price. later: the guest asked to have
# it brought later ("Antar nanti"): it lands on the bill but is not sent to the kitchen until staff send it.
name: self_order_item
is_child: true
fields:
  # L1, L2…, written by the kernel's portal route; the options of the line name it
  - {name: line_key, type: data, label: {id: Baris}}
  - {name: item, type: link, to: item, label: {id: Menu}, required: true}
  - {name: qty, type: int, label: {id: Qty}, default: '1'}
  - {name: note, type: data, label: {id: Catatan}, help: {id: 'Misalnya tanpa bawang goreng'}}
  - {name: later, type: check, label: {id: Antar nanti}}
  - {name: option_text, type: data, label: {id: Pilihan}, compute: "parent.options.filter(o, o.line == line_key).map(o, o.label).join(', ')"}
  - {name: option_delta, type: currency, label: {id: Tambahan pilihan}, compute: "parent.options.filter(o, o.line == line_key).map(o, o.price_delta).sum()"}
  - {name: description, type: data, label: {id: Uraian}, compute: "item.item_name + (option_text != '' ? ' (' + option_text + ')' : '')"}
  - {name: rate, type: currency, label: {id: Harga}, compute: item.rate + option_delta}
  - {name: amount, type: currency, label: {id: Jumlah}, compute: round(qty * rate)}
  - {name: category, type: link, to: item_category, label: {id: Kategori}, hidden: true, compute: item.category}
  - {name: uom, type: link, to: uom, label: {id: Satuan}, hidden: true, compute: item.stock_uom}
