# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: production_output
is_child: true
fields:
  - {name: item, type: link, to: item, label: {id: Hasil}, required: true}
  - {name: qty, type: float, label: {id: Qty}}
  - {name: uom, type: link, to: uom, label: {id: Satuan}, default: item.stock_uom}
  - {name: cost_share, type: float, label: {id: Porsi biaya bahan (%)}, default: '100'}
