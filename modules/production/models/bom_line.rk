# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: bom_line
is_child: true
fields:
  - {name: item, type: link, to: item, label: {id: Bahan}, required: true}
  - {name: qty, type: float, label: {id: Qty}, default: '1'}
  - {name: uom, type: link, to: uom, label: {id: Satuan}, default: item.stock_uom}
  - {name: semi_finished, type: check, label: {id: Setengah jadi}, compute: "item.default_bom != ''"}
  # a semi-finished item costs what its own BOM says (rolled up); a raw material its standard cost
  - {name: unit_cost, type: currency, label: {id: Biaya per satuan}, compute: "item.default_bom != '' ? item.default_bom.unit_cost : item.standard_cost", hidden_for: [outlet_staff]}
  - {name: cost, type: currency, label: {id: Biaya}, compute: round(qty * unit_cost), hidden_for: [outlet_staff]}
