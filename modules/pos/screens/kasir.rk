# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/screen.json
# The cashier's work screen (contract 0030 §2 counter): the kernel web app renders it from these slots. Money, stock
# and numbering stay in pos_sale (computes, rules, stock: block, journal flows); the screen only fills the sale.
name: kasir
type: counter
label: {id: Kasir, en: Cashier}
description: {id: 'Layani pembeli di sini: pilih barang, terima tunai atau QRIS, lalu cetak struk.'}
icon: wallet
roles: [cashier, head_office]
device: tablet
needs: [print, scan]
offline: queue
counter:
  catalogue:
    model: item
    filter: "kind != 'material' && active != false"
    title: item_name
    search: [item_name, sku, barcode]
    group_by: category
    price: rate
    barcode: barcode
    variants: {group: variant_group, label: variant_label, title: variant_title}
    available: {model: stock_balance, item: item, qty: qty, match: {outlet: outlet}}
  document:
    model: pos_sale
    lines: items
    # amount: the model's line amount shows a promo (struck price) or a free gift; flag: the cashier marks the gift line
    line: {item: item, qty: qty, price: rate, note: note, amount: amount, flag: is_gift, hold: kitchen_hold}
    # amount_due: the total less what the member's deposit pays (module loyalty); without it, the total
    total: amount_due
    change: change_amount
    # at most 12 lines (0034 §2, raised for rangka-apps#121; checkout takes at most 8 fields): the discounts show as one
    # total here, the receipt and the sale keep the breakdown
    summary: [gross_total, promo_total, member_discount, points_discount, manual_discount_total, promo_shortfall, service_charge, pbjt, rounding, deposit_used, amount_due]
    # rangka-os contract 0069: filled before paying; the promo picker lists live bill promos only, the member picker
    # active members. Fields of modules promotions and loyalty are left out when not installed (their depends_on).
    checkout: [order_type, customer, {field: member, filter: "active"}, {field: promotion, filter: "is_bill && live"}, promo_code, points_redeemed, deposit_used]
    set: {date: "today()"}
  payments: {table: payments, method: method, amount: amount, ref: ref, party: party, parties: parties, methods: [cash, qris]}
  session:
    model: pos_shift
    link: shift
    filter: "cashier == user.email"
    state: {field: state, open: open, closed: closed}
    open: [outlet, opening_cash]
    set: {outlet: "user.outlets.size() > 0 ? user.outlets[0] : ''"}
    close: {model: pos_shift_close, link: shift, fields: [counted_cash, closing_note]}
  customer: {field: buyer}
  hold: true
  print: pos_receipt
