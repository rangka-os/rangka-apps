# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Runs inside a sale's submit (the payment), as the cashier. Reading pos_shift takes the flow read lock of contract
# 0025, so the sales of a shift are added one after the other and each sees the totals the previous one left. A shift
# closed meanwhile is not found open: the sale is refused (pos_guard shift_closed) and rolls back with its stock
# moves and its number. Otherwise the shift's totals grow by this receipt.
name: pos_sale_on_submit
label: {id: 'Transaksi kasir dibayar: tambah ke sesi kasir'}
on: pos_sale.submitted
steps:
  - {find: pos_shift, where: name == event.shift && state == 'open', as: s}
  # only a store sells (rangka-apps#104): a device event turns the sale's own rules (sale_at_store) into exceptions,
  # so the store check is repeated here, where a guard still refuses
  - {find: outlet, if: device.event, where: name == event.outlet, as: so}
  - if: device.event && so != null && so.location_type != '' && so.location_type != 'store'
    create: pos_guard
    set: {reason: "'not_a_store'", document: event.name}
  # A device event also turns rules outlet_of_shift (outlet == shift.outlet) and own_shift into exceptions, so a sale
  # could add to another outlet's or another cashier's head-office drawer and book a false shortage at its close. The
  # shift is read whatever its state (a closed one is still not this device's to link). The kernel already refuses a
  # shift made on another device (deviceLinks, shift_other_device); what is left is a shift made without a device.
  - {find: pos_shift, if: device.event, where: name == event.shift, as: ds}
  - if: device.event && ds != null && (ds.outlet != event.outlet || (device.outlet != '' && ds.outlet != device.outlet))
    create: pos_guard
    set: {reason: "'shift_other_outlet'", document: ds.name}
  # Own shift on a device: one this device opened (its name carries the device code, contract 0058 §3; a cashier switch
  # keeps selling on it) or one the same cashier opened.
  - if: >-
      device.event && ds != null && ds.cashier != user.email
      && !(so != null && ds.name.startsWith('SESI-' + so.code + '-' + device.code + '-'))
    create: pos_guard
    set: {reason: "'shift_not_own'", document: ds.name}
  # Jalur A and B never on the same outlet and day: a daily sales record (form, Moka, POS file) of this outlet and day
  # refuses the receipt (and flow pos_daily_form_guard refuses the record after a receipt), whatever sales_source says
  - find_all: outlet_sales
    if: app_installed('outlet_sales')
    where: outlet == event.outlet && date == event.date && docstatus == 1
    limit: 1
    as: forms
  # a site without outlet_sales skips the find above, so forms is never declared: app_installed is checked first
  # (&& stops there); `forms != null` alone read an undeclared name and failed every receipt (host smoke, 13 Nov)
  - if: app_installed('outlet_sales') && forms.size() > 0
    create: pos_guard
    set:
      reason: "'daily_sales_same_day'"
      document: forms[0].name
  # a Setoran harian of this outlet and day was booked outside the cashier: the shift's close would book the cash again
  - find_all: outlet_takings
    if: app_installed('outlet_sales')
    where: outlet == event.outlet && date == event.date && docstatus == 1
    limit: 1
    as: takings
  - if: app_installed('outlet_sales') && takings.size() > 0
    create: pos_guard
    set:
      reason: "'daily_sales_same_day'"
      document: takings[0].name
  # one sales source per outlet and day, kept in outlets (installed with either source): a daily sales record or
  # setoran marked the day 'harian', which holds even after the outlet_sales app is removed (audit #74 L1)
  - {find: outlet_day, where: outlet == event.outlet && date == event.date, as: day}
  - if: day != null && day.source == 'harian'
    create: pos_guard
    set: {reason: "'daily_sales_same_day'", document: day.document}
  - if: day == null
    create: outlet_day
    set: {outlet: event.outlet, date: event.date, source: "'kasir'", document: event.name, day_key: "event.outlet + '|' + string(event.date)"}
  - if: day != null && day.source == ''
    update: day
    set: {source: "'kasir'", document: event.name}
  # A receipt a paired device sends from its queue (device.event) was already paid at the outlet (rangka-os contract
  # 0058 §10): a shift head office closed meanwhile does not refuse it (rule shift_open becomes a rule_overridden exception for head office) and the
  # closed shift's totals stay as counted.
  - if: s == null && !device.event
    create: pos_guard
    set: {reason: "'shift_closed'", document: event.name}
  - update: s
    if: s != null
    set:
      sales_count: s.sales_count + 1
      gross_total: s.gross_total + event.gross_total
      discount_total: s.discount_total + event.discount_total
      net_total: s.net_total + event.grand_total
      cash_total: s.cash_total + event.cash_amount
      qris_total: s.qris_total + event.qris_amount
      deposit_total: s.deposit_total + event.deposit_used
      cogs_total: s.cogs_total + event.cogs_total
