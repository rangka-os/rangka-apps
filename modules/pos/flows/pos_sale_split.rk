# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Split an open bill by line (rangka-apps#122). The cashier lists the line keys to move in split_lines; this flow runs
# inside that write: the new bill (split_of set) takes those lines on the same table, the old bill keeps the rest and
# split_lines is cleared so the flow cannot run twice. The two bills add up to the original: lines move whole, with their
# own discounts, and the lines the kitchen already got stay recorded under their keys on the bill they moved to. At
# least one line must stay, and a bill with a promo, a member or a deposit picked is not split (those amounts belong to
# the whole bill). An amended copy (a return) is not split. Stock moves only at payment, once per paid bill. The new bill
# takes the old bill's order_type, so each bill computes its own service charge, PBJT and rounding (rangka-apps#121).
name: pos_sale_split
label: {id: 'Pisah tagihan meja per barang'}
description: {id: 'Barang yang dipilih pindah ke tagihan baru di meja yang sama; sisanya tetap di tagihan lama'}
on: pos_sale.updated
if: "event.docstatus == 0 && event.split_lines.size() > 0"
steps:
  - {find: pos_sale, where: "name == event.name", as: src}
  - if: "event.table == '' || (has(event.amended_from) && event.amended_from != '') || event.merged || event.items.filter(l, !(l.line_key in event.split_lines)).size() == 0 || event.items.filter(l, l.line_key in event.split_lines).size() == 0 || event.promotion != '' || event.member != '' || event.points_redeemed > 0 || event.deposit_used > 0"
    create: pos_guard
    set: {reason: "'split_invalid'", document: event.name}
  - if: "event.table != '' && (!has(event.amended_from) || event.amended_from == '') && !event.merged && event.items.filter(l, !(l.line_key in event.split_lines)).size() > 0 && event.items.filter(l, l.line_key in event.split_lines).size() > 0 && event.promotion == '' && event.member == '' && event.points_redeemed == 0 && event.deposit_used == 0"
    then:
      - create: pos_sale
        set:
          shift: event.shift
          outlet: event.outlet
          date: event.date
          table: event.table
          order_type: event.order_type
          guests: "1"
          split_of: event.name
          items: "event.items.filter(l, l.line_key in event.split_lines).map(l, {'item': l.item, 'packing': l.packing, 'qty': l.qty, 'discount_pct': l.discount_pct, 'description': l.description, 'note': l.note, 'is_gift': l.is_gift, 'line_key': l.line_key, 'kitchen_hold': l.kitchen_hold})"
          sent_to_kitchen: "event.sent_to_kitchen.filter(s, s.key in event.split_lines)"
          # the options of the moved lines move with them (contract 0048 §1)
          options: "event.options.filter(o, o.line in event.split_lines).map(o, {'line': o.line, 'option': o.option})"
      - update: src
        set:
          items: "event.items.filter(l, !(l.line_key in event.split_lines)).map(l, {'item': l.item, 'packing': l.packing, 'qty': l.qty, 'discount_pct': l.discount_pct, 'description': l.description, 'note': l.note, 'is_gift': l.is_gift, 'line_key': l.line_key, 'kitchen_hold': l.kitchen_hold})"
          sent_to_kitchen: "event.sent_to_kitchen.filter(s, !(s.key in event.split_lines))"
          options: "event.options.filter(o, !(o.line in event.split_lines)).map(o, {'line': o.line, 'option': o.option})"
          split_lines: "[]"
          rev: event.rev + 1
