# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# The create half of pos_table_guard: a new bill on a table that already has an open bill is refused. Every open bill
# counts, a split child included. A bill made by the split flow (split_of set, a read-only field only that flow writes)
# shares its table on purpose and is not guarded. A copy with amended_from (a voided receipt paid again, a partial return)
# is not a table bill any more: its table is cleared. Amend itself runs no created flows, so pos_table_guard_on_update
# clears it on the copy's first write and the table map and the guards never count an amended copy as an open bill;
# this branch covers a copy created with amended_from (a device write that keeps its name).
name: pos_table_guard_on_create
label: {id: 'Satu tagihan terbuka per meja (tagihan baru)'}
description: {id: 'Tagihan baru di meja yang sudah punya tagihan terbuka ditolak'}
on: pos_sale.created
if: "event.docstatus == 0 && event.table != '' && event.split_of == ''"
steps:
  - if: "has(event.amended_from) && event.amended_from != ''"
    then:
      - {find: pos_sale, where: "name == event.name", as: self}
      - update: self
        set: {table: "''", bill_asked: "false", send_kitchen: "false"}
  - if: "!has(event.amended_from) || event.amended_from == ''"
    then:
      - {find_all: pos_sale, where: "table == event.table && docstatus == 0 && !merged && amended_from == '' && name != event.name", limit: 1, as: others}
      - if: others.size() > 0
        create: pos_guard
        set: {reason: "'table_busy'", document: event.name}
