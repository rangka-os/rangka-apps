# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Head office cancels a close (a miscount): the shift opens again, without its counted figures, and is closed with a
# new Tutup sesi. Its selisih kas journal is reversed by gl_pos_shift_close_reverse.
name: pos_shift_close_on_cancel
label: {id: 'Tutup sesi dibatalkan: sesi kasir dibuka lagi'}
on: pos_shift_close.cancelled
steps:
  - {find: pos_shift, where: name == event.shift, as: s}
  # one open shift per cashier per outlet: a shift opened since cannot be joined by the reopened one (audit kasir L6)
  - find_all: pos_shift
    if: s != null
    where: outlet == s.outlet && cashier == s.cashier && state == 'open' && name != s.name
    limit: 1
    as: open
  - if: s != null && open.size() > 0
    create: pos_guard
    set:
      reason: "'shift_already_open'"
      document: open[0].name
  - update: s
    if: s != null && s.closed_by == event.name
    set:
      state: "'open'"
      closed_by: "''"
      counted_cash: '0'
      cash_difference: '0'
