# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# The update half of pos_table_guard: moving an open bill onto a table that already has an open bill is refused. A bill made
# by the split flow (split_of set) shares its table on purpose and is not guarded; a bill that stays on its table finds
# no other bill there.
name: pos_table_guard_on_update
label: {id: 'Satu tagihan terbuka per meja (pindah meja)'}
description: {id: 'Pindah ke meja yang sudah punya tagihan terbuka ditolak'}
on: pos_sale.updated
if: "event.docstatus == 0 && event.table != '' && event.split_of == '' && !event.merged"
steps:
  - {find_all: pos_sale, where: "table == event.table && docstatus == 0 && !merged && split_of == '' && name != event.name", limit: 1, as: others}
  - if: others.size() > 0
    create: pos_guard
    set: {reason: "'table_busy'", document: event.name}
