# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# When head office set one, the shift opens with the outlet's float (an outlet without a code cannot open a shift:
# the kernel refuses its number, 409 numbering). One open shift per cashier per outlet: a second one would split the drawer's cash over two counts. The read lock of
# contract 0025 serializes two opens at the same moment, so the later one sees the first.
name: pos_shift_on_create
label: {id: 'Sesi kasir dibuka: hanya satu sesi terbuka per kasir per outlet'}
on: pos_shift.created
steps:
  - {find: outlet, where: name == event.outlet, as: o}
  # only a store sells (rangka-apps#104, rule shift_at_store): repeated here because a paired device's write turns the
  # shift's own rules into exceptions (rangka-os contract 0058 §10), while a guard a flow writes still refuses
  - if: o != null && o.location_type != '' && o.location_type != 'store'
    create: pos_guard
    set: {reason: "'not_a_store'", document: event.name}
  - if: o != null && o.cash_float > 0 && event.opening_cash != o.cash_float
    create: pos_guard
    set: {reason: "'float_of_outlet'", document: event.name}
  - find_all: pos_shift
    where: outlet == event.outlet && cashier == event.cashier && state == 'open' && name != event.name
    limit: 1
    as: open
  - if: open.size() > 0
    create: pos_guard
    set:
      reason: "'shift_already_open'"
      document: open[0].name
