# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# One open shift per cashier per outlet: a second one would split the drawer's cash over two counts. The read lock of
# contract 0025 serializes two opens at the same moment, so the later one sees the first.
name: pos_shift_on_create
label: {id: 'Sesi kasir dibuka: hanya satu sesi terbuka per kasir per outlet'}
on: pos_shift.created
steps:
  - find_all: pos_shift
    where: outlet == event.outlet && cashier == event.cashier && state == 'open' && name != event.name
    limit: 1
    as: open
  - if: open.size() > 0
    create: pos_guard
    set:
      reason: "'shift_already_open'"
      document: open[0].name
