# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Backfill of outlets/outlet_day for days submitted before it existed (audit rangka-apps#77 F3): the kernel has no
# migrate hook for .rk, so every run marks the days of up to 1000 submitted receipts that have no marker yet.
# One read of the documents per run (audit #79 F2), then per document one indexed lookup of its day_key, so two
# documents of one day give one marker and a day already marked (any source, also one freed by a cancel) is skipped:
# the run is safe to repeat and a day never gets two markers (day_key is unique). A document without an outlet is left
# out so it cannot stall the queue (audit #79 F5). The run that finds nothing left writes outlet_day_backfill
# key kasir done; from then on a run reads only that one row (audit #79 F1: the finished backfill read every document
# each 5 minutes under the payment locks). The documents are read newest first (the kernel's order without sort:, so the
# read stops at limit), so a backfilled marker names a document of its day, not always the first (audit #79 F6).
name: outlet_day_backfill_kasir
label: {id: 'Lengkapi sumber penjualan harian dari struk kasir lama'}
schedule: '*/5 * * * *'
steps:
  - find_all: outlet_day_backfill
    where: "key == 'kasir'"
    limit: 1
    as: st
  - find_all: outlet_day
    if: "size(st) == 0"
    as: marked
  - find_all: pos_sale
    if: "size(st) == 0"
    where: "docstatus == 1 && outlet != null && outlet != '' && !marked.exists(m, m.outlet == outlet && m.date == date)"
    limit: 1000
    as: r
  - for_each: "r"
    if: "size(st) == 0"
    as: d
    do:
      - find_all: outlet_day
        where: "day_key == d.outlet + '|' + string(d.date)"
        limit: 1
        as: k
      - create: outlet_day
        if: "size(k) == 0"
        set:
          outlet: "d.outlet"
          date: "d.date"
          source: "'kasir'"
          document: "d.name"
          day_key: "d.outlet + '|' + string(d.date)"
  - create: outlet_day_backfill
    if: "size(st) == 0 && size(r) == 0"
    set:
      key: "'kasir'"
      done: "true"
