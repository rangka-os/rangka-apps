# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# Sesi kasir: one cashier's drawer at one outlet, from opening to closing. Creating it opens the shift with the float
# (opening_cash) and gives it its number at once (SESI-<outlet code>-<YYMM>-<n>): the sales link it by that name, so
# it is not a submittable document (a draft's DRAFT- name would be renamed at submit and the links would point at
# nothing). Closing is a document of its own, Tutup sesi (pos_shift_close). While the shift is open, every sale paid or
# voided on it updates its totals (flows pos_sale_on_submit / pos_sale_on_cancel); state and the totals are read_only,
# so only the flows write them. Those flows and the close read pos_shift under the flow read lock of contract 0025,
# so the sales of a shift are counted one after the other, and a sale after the close is refused.
name: pos_shift
label: {id: Sesi kasir, en: Cashier shift}
icon: wallet
# A shift opened on a paired device carries the device's number (SESI-BTR-K1-2611-0003, contract 0058 §3), so the
# sales queued offline link it by that name; head office keeps SESI-<outlet code>-<YYMM>-<n>.
naming: SESI-{outlet.code}-{device.code}-{YY}{MM}-{####}
naming_on: device
title_field: outlet
permissions:
  - {role: head_office, read: true, create: true, write: true, export: true, print: true}
  - {role: cashier, read: true, create: true, write: true, print: true}
fields:
  - {name: outlet, type: link, to: outlet, label: {id: Outlet}, required: true, in_list: true}
  - name: opening_date
    type: date
    label: {id: Tanggal buka}
    default: today()
    read_only: true
    in_list: true
  # the person who opened the shift (their sign-in email); set once, from the session
  - name: cashier
    type: data
    label: {id: Kasir}
    default: user.email
    read_only: true
    in_list: true
  # The cashier's employee record (contract 0056) and, with module shifts, their published work shift of the opening day
  # (filled by flow shifts/shift_pos_link). Never required: a cashier covering someone else must still sell
  # (rangka-apps#120); such a session shows the chip "Tanpa jadwal" instead.
  - {name: employee, type: link, to: user, label: {id: Karyawan}, default: user.name, read_only: true}
  - {name: work_shift, type: link, to: shift_assignment, label: {id: Jadwal shift}, read_only: true, depends_on: app_installed('shifts')}
  - name: no_schedule
    type: check
    label: {id: Tanpa jadwal}
    read_only: true
    in_list: true
    chip: true
    depends_on: app_installed('shifts')
    compute: "work_shift == ''"
  - name: opening_cash
    type: currency
    label: {id: Modal kas}
    help: {id: 'Uang tunai di laci saat sesi dibuka (uang kembalian)'}
    required: true
  - name: state
    type: select
    label: {id: Status sesi}
    default: "'open'"
    read_only: true
    in_list: true
    chip: true
    options:
      - {value: open, label: {id: Buka}}
      - {value: closed, label: {id: Tutup}}
  - {name: sales_count, type: int, label: {id: Jumlah transaksi}, read_only: true, in_list: true}
  - {name: gross_total, type: currency, label: {id: Penjualan kotor}, read_only: true, hidden_for: [cashier]}
  - {name: discount_total, type: currency, label: {id: Diskon}, read_only: true, hidden_for: [cashier]}
  - {name: net_total, type: currency, label: {id: Penjualan bersih}, read_only: true, in_list: true, hidden_for: [cashier]}
  # blind count (contract 0027 hidden_for): the cashier counts the drawer without seeing what should be in it
  - {name: cash_total, type: currency, label: {id: Tunai masuk}, help: {id: 'Dibayar tunai setelah kembalian, dikurangi tunai transaksi yang dibatalkan'}, read_only: true, hidden_for: [cashier]}
  - {name: qris_total, type: currency, label: {id: QRIS masuk}, read_only: true, hidden_for: [cashier]}
  # restaurant charges of the shift's receipts (rangka-apps#121), for the daily recap
  - {name: service_total, type: currency, label: {id: Service charge}, read_only: true, hidden_for: [cashier]}
  - {name: pbjt_total, type: currency, label: {id: Pajak restoran (PBJT)}, read_only: true, hidden_for: [cashier]}
  - {name: rounding_total, type: currency, label: {id: Pembulatan}, read_only: true, hidden_for: [cashier]}
  - {name: void_count, type: int, label: {id: Transaksi dibatalkan}, read_only: true}
  # module loyalty: sales paid from a member's deposit (no money moves, 2-1400), and deposit top-ups taken on this
  # shift (cash into the drawer, QRIS into the outlet's QRIS; flow deposit_topup_on_submit)
  - {name: deposit_total, type: currency, label: {id: Dibayar deposit}, read_only: true, hidden_for: [cashier], depends_on: app_installed('loyalty')}
  - {name: topup_cash_total, type: currency, label: {id: Isi deposit tunai}, read_only: true, hidden_for: [cashier], depends_on: app_installed('loyalty')}
  - {name: topup_qris_total, type: currency, label: {id: Isi deposit QRIS}, read_only: true, hidden_for: [cashier], depends_on: app_installed('loyalty')}
  - {name: void_total, type: currency, label: {id: Nilai dibatalkan}, read_only: true, hidden_for: [cashier]}
  - {name: cogs_total, type: currency, label: {id: Harga pokok}, read_only: true, hidden_for: [cashier]}
  - name: expected_cash
    type: currency
    label: {id: Tunai seharusnya}
    help: {id: 'Modal kas ditambah tunai masuk dan isi deposit tunai'}
    compute: opening_cash + cash_total + topup_cash_total
    hidden_for: [cashier]
  # copied from the Tutup sesi that closed the shift
  - {name: closed_by, type: link, to: pos_shift_close, label: {id: Ditutup dengan}, read_only: true}
  - {name: counted_cash, type: currency, label: {id: Hitung fisik}, read_only: true}
  - {name: cash_difference, type: currency, label: {id: Selisih kas}, read_only: true, in_list: true, hidden_for: [cashier]}
# The outlet's float is checked when the shift opens (flow pos_shift_on_create), not as a save rule: a save rule runs
# on every update the sales' flows make, so head office changing the outlet would stop an open shift. An outlet
# without a code cannot open one (its number, SESI-<code>-..., is refused: 409 numbering).
rules:
  # Only a store sells (rangka-apps#104): a warehouse, vehicle, quarantine or production row takes no plan outlet seat
  # (outlets limit_scope is_store), so a shift or sale there would be a free seat. Van sales belong to field_sales (#112).
  - name: shift_at_store
    on: save
    check: "outlet.location_type == '' || outlet.location_type == 'store'"
    message: {id: 'Sesi kasir hanya bisa dibuka di lokasi berjenis Toko'}
  - name: float_not_negative
    on: save
    check: opening_cash >= 0
    message: {id: Modal kas tidak boleh negatif}
views:
  list:
    columns: [name, outlet, opening_date, state, net_total, cash_difference, cashier, sales_count]
    filters: [outlet, state]
    sort: -name
  form:
    layout:
      - section: {id: Sesi}
        columns:
          - [outlet, opening_date, cashier]
          - [opening_cash, state, closed_by]
      - section: {id: Jadwal}
        columns:
          - [employee, work_shift]
          - [no_schedule]
      - section: {id: Penjualan sesi ini}
        columns:
          - [sales_count, gross_total, discount_total, net_total]
          - [cash_total, qris_total, void_count, void_total]
      - section: {id: Biaya restoran}
        columns:
          - [service_total, pbjt_total, rounding_total]
      - section: {id: Deposit member}
        columns:
          - [deposit_total]
          - [topup_cash_total, topup_qris_total]
      - section: {id: Laci}
        columns:
          - [expected_cash, counted_cash, cash_difference]
