# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# A line of a cashier sale. The unit is the item's stock unit, or another unit of the item (packing, a
# uom_conversion: a dus of 24, a pack of 10); stock moves stock_qty (contract 0022 §1). The price per unit is the
# item's price, or the unit's own price when it has one (a dus can be cheaper than 24 bottles), else the item's price
# times the unit's factor. It is computed, so a cashier cannot type another price; the discount is in percent.
name: pos_sale_item
is_child: true
fields:
  - {name: item, type: link, to: item, label: {id: Barang atau menu}, required: true, peek: [rate, stock_uom]}
  # the item's category when the line was saved: the kitchen routes a paid line by it (module kitchen) without reading
  # the whole catalogue during the payment
  - {name: category, type: link, to: item_category, label: {id: Kategori}, hidden: true, compute: item.category}
  - {name: variant_group, type: data, label: {id: Grup varian}, hidden: true, compute: item.variant_group}
  - {name: description, type: text, label: {id: Uraian}, default: item.item_name}
  - name: packing
    type: link
    to: uom_conversion
    label: {id: Satuan lain}
    help: {id: 'Kosongkan untuk satuan stok barang. Pilih misalnya Dus isi 24'}
  # the item of the unit picked (rule unit_of_item: a unit of this line's item)
  - {name: packing_item, type: link, to: item, label: {id: Barang satuan}, hidden: true, compute: "packing != '' ? packing.item : item"}
  - name: uom
    type: link
    to: uom
    label: {id: Satuan}
    compute: "packing != '' ? packing.uom : item.stock_uom"
  - {name: qty, type: float, label: {id: Qty}, default: '1', required: true}
  - name: stock_qty
    type: float
    label: {id: Qty satuan stok}
    compute: "packing == '' ? qty : qty * packing.factor"
    stock: true
  - name: rate
    type: currency
    label: {id: Harga satuan}
    compute: "packing == '' ? item.rate : (packing.rate > 0 ? packing.rate : round(item.rate * packing.factor))"
  - name: gross
    type: currency
    label: {id: Harga}
    compute: round(qty * rate)
  - {name: discount_pct, type: float, label: {id: 'Diskon %'}, default: '0'}
  # Promo (module promotions, rangka-apps#103): the item's live promo (kept on the item by flow promotion_apply): the
  # promo of this sale's outlet (parent.outlet, rangka-os contract 0069 §2) when the item has one, else the all-outlet
  # one; never on a free gift line. Percent off the line; rupiah off per stock unit and buy X get Y per stock unit (a
  # dus of 24 counts 24, free units at the item's unit price, never more than the line). The cashier's manual
  # discount_pct applies after the promo and counts as a manual discount (big_discount).
  - name: promo_slot
    type: data
    label: {id: Sumber promo}
    hidden: true
    depends_on: app_installed('promotions')
    compute: "is_gift ? '' : (item.promo_o != '' && item.promo_o_outlet == parent.outlet ? 'o' : (item.promo != '' && (item.promo_outlet == '' || item.promo_outlet == parent.outlet) ? 'a' : ''))"
  - {name: promotion, type: data, label: {id: Promo}, depends_on: app_installed('promotions'), compute: "promo_slot == 'o' ? item.promo_o : (promo_slot == 'a' ? item.promo : '')"}
  - {name: promo_name, type: data, label: {id: Nama promo}, hidden: true, depends_on: app_installed('promotions'), compute: "promo_slot == 'o' ? item.promo_o_name : (promo_slot == 'a' ? item.promo_name : '')"}
  - {name: promo_kind, type: data, label: {id: Jenis promo}, hidden: true, depends_on: app_installed('promotions'), compute: "promo_slot == 'o' ? item.promo_o_kind : (promo_slot == 'a' ? item.promo_kind : '')"}
  - {name: promo_pct, type: float, label: {id: 'Promo %'}, hidden: true, depends_on: app_installed('promotions'), compute: "promo_slot == 'o' ? item.promo_o_pct : (promo_slot == 'a' ? item.promo_pct : 0)"}
  - {name: promo_off, type: currency, label: {id: Potongan promo per satuan}, hidden: true, depends_on: app_installed('promotions'), compute: "promo_slot == 'o' ? item.promo_o_off : (promo_slot == 'a' ? item.promo_off : 0)"}
  - {name: promo_buy, type: int, label: {id: Promo beli}, hidden: true, depends_on: app_installed('promotions'), compute: "promo_slot == 'o' ? item.promo_o_buy : (promo_slot == 'a' ? item.promo_buy : 0)"}
  - {name: promo_get, type: int, label: {id: Promo gratis}, hidden: true, depends_on: app_installed('promotions'), compute: "promo_slot == 'o' ? item.promo_o_get : (promo_slot == 'a' ? item.promo_get : 0)"}
  # the promo's last day as it was when the line was computed: rule line_promo_live reads it (a rule sees the rows'
  # stored values, not their links)
  - {name: promo_until, type: date, label: {id: Promo sampai}, hidden: true, depends_on: app_installed('promotions'), compute: "promo_slot == 'o' ? item.promo_o_until : (promo_slot == 'a' ? item.promo_until : null)"}
  - name: promo_discount
    type: currency
    label: {id: Potongan promo}
    depends_on: app_installed('promotions')
    compute: "promotion == '' ? 0 : (promo_kind == 'pct' ? round(gross * promo_pct / 100) : (promo_kind == 'off' ? min(gross, round(stock_qty * promo_off)) : (promo_kind == 'buy_get' && promo_buy + promo_get > 0 ? min(gross, round(int(stock_qty / (promo_buy + promo_get)) * promo_get * item.rate)) : 0)))"
  # the free gift of a bill promo (kind free_gift): a line of the gift item at 0, its stock and cost still out
  - name: is_gift
    type: check
    label: {id: Produk gratis promo}
    default: 'false'
    depends_on: app_installed('promotions')
  - name: amount
    type: currency
    label: {id: Jumlah}
    compute: "is_gift ? 0 : (promo_discount == 0 ? round(qty * rate * (100 - discount_pct) / 100) : round((gross - promo_discount) * (100 - discount_pct) / 100))"
  - {name: note, type: data, label: {id: Catatan}, help: {id: 'Misalnya kurang manis, tanpa es'}}
  - {name: cogs, type: currency, label: {id: Harga pokok}, read_only: true, hidden_for: [cashier, outlet_staff]}
