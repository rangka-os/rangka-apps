# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# Transaksi kasir: one receipt. A draft is the open basket; submitting it is the payment: the receipt gets its number
# per outlet and month (STRK-<outlet code>-<YYMM>-<n>, contract 0009 §2a), the goods leave the outlet's stock (a menu
# item through its active recipe), and the shift's totals grow (flow pos_sale_on_submit). Prices come from the item
# (or from the unit picked on the line, uom_conversion.rate); the cashier gives discounts, never a price. Prices
# include PPN for a PKP business, as on outlet_sales, so the journal splits the PPN out the same way.
# Payment is a table (cash with change, QRIS, or both), the shape of the counter work screen (proposal 0030).
# Void: cancel, only on the sale's day while its shift is open (flow pos_sale_on_cancel: the kernel runs no
# `on: cancel` rule, so the checks live in the flow, under the shift's lock); the stock comes back at the cost it
# left with and the shift's totals shrink. A partial return on the same day is a void and an amended receipt without the returned items
# (the amendment keeps the number with -1). Goods that went to waste after the void go out with a stock_adjustment.
name: pos_sale
label: {id: Transaksi kasir, en: Cashier sale}
icon: receipt
is_submittable: true
# No title_field: a receipt's title is its number (STRK-...), so a link to it (a kitchen ticket, a daily sales check)
# shows the number and never the total to a role that may not read the receipt.
naming: STRK-{outlet.code}-{YY}{MM}-{#####}
on_submit: [stock.post_moves]
on_cancel: [stock.reverse_moves]
permissions:
  - {role: head_office, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, export: true, print: true}
  - {role: cashier, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, print: true}
  # flow pos_daily_form_guard reads the receipts of the outlet a daily sales record is submitted for
  - {role: outlet_staff, read: true}
fields:
  - name: shift
    type: link
    to: pos_shift
    label: {id: Sesi kasir}
    required: true
    peek: [outlet, opening_date, cashier]
  # outlet and date are not read_only: an amendment (a partial return) copies only writable values. The rules hold
  # them to the shift's outlet and to the day of payment.
  - name: outlet
    type: link
    to: outlet
    label: {id: Outlet}
    default: shift.outlet
    in_list: true
  - name: date
    type: date
    label: {id: Tanggal}
    index: true # the outlet_day backfill reads one outlet and day at a time (card t_0dba5917)
    default: today()
    in_list: true
  - name: buyer
    type: data
    label: {id: Pembeli atau meja}
    help: {id: 'Boleh kosong. Nama pembeli, nomor meja atau nomor antrean'}
    in_list: true
  # the customer of record (contacts), picked or signed up at the counter's checkout; buyer stays for a name, table or
  # queue number. Shared with module loyalty (rangka-apps#102).
  - {name: customer, type: link, to: customer, label: {id: Pelanggan}, help: {id: 'Boleh kosong. Pilih pelanggan terdaftar'}}
  # Bill promo (module promotions): picked at the checkout with its code; the sale's rules check its window, outlet,
  # code and gift lines, and flow promotion_on_sale checks a voucher's limit and a coupon's single use.
  - name: promotion
    type: link
    to: promotion
    label: {id: Promo nota}
    help: {id: 'Promo untuk seluruh nota, misalnya diskon 10% minimal belanja Rp 50.000'}
    depends_on: app_installed('promotions')
  - name: promo_code
    type: data
    label: {id: Kode voucher atau kupon}
    depends_on: app_installed('promotions')
  # WhatsApp receipt (module whatsapp_receipt): the buyer's number and their yes, asked at the counter ("Kirim struk ke
  # WhatsApp?"). Nothing is sent without the tick. wa_number is the number in one form (digits with the country code).
  - name: wa_phone
    type: phone
    label: {id: Nomor WhatsApp pembeli}
    help: {id: 'Hanya kalau pembeli mau struk dan kabar pesanannya lewat WhatsApp'}
    depends_on: app_installed('whatsapp_receipt')
  - name: wa_receipt
    type: check
    label: {id: Kirim struk ke WhatsApp}
    help: {id: 'Tanya dulu ke pembeli. Struk dikirim setelah dibayar'}
    default: 'false'
    depends_on: app_installed('whatsapp_receipt')
  - name: wa_number
    type: data
    label: {id: Nomor WhatsApp (seragam)}
    hidden: true
    depends_on: app_installed('whatsapp_receipt')
    compute: "(wa_phone.trim().startsWith('+') ? ('x' + wa_phone.replace(' ', '').replace('-', '').replace('.', '').replace('(', '').replace(')', '').replace('+', '')).replace('x620', 'x62').replace('x', '') : ('x' + wa_phone.replace(' ', '').replace('-', '').replace('.', '').replace('(', '').replace(')', '').replace('+', '')).replace('x8', 'x628').replace('x00', 'x').replace('x0', 'x62').replace('x620', 'x62').replace('x', '')).matches('^[1-9][0-9]{7,14}$') ? (wa_phone.trim().startsWith('+') ? ('x' + wa_phone.replace(' ', '').replace('-', '').replace('.', '').replace('(', '').replace(')', '').replace('+', '')).replace('x620', 'x62').replace('x', '') : ('x' + wa_phone.replace(' ', '').replace('-', '').replace('.', '').replace('(', '').replace(')', '').replace('+', '')).replace('x8', 'x628').replace('x00', 'x').replace('x0', 'x62').replace('x620', 'x62').replace('x', '')) : ''"
  - name: items
    type: table
    of: pos_sale_item
    label: {id: Barang}
    min_rows: 1
  - name: gross_total
    type: currency
    label: {id: Harga sebelum diskon}
    compute: "items.map(l, l.gross).sum()"
  - name: subtotal
    type: currency
    label: {id: Subtotal}
    compute: "items.map(l, l.amount).sum()"
  - name: discount_amount
    type: currency
    label: {id: Diskon nota}
    help: {id: 'Potongan rupiah untuk seluruh nota, setelah diskon per barang'}
    default: '0'
  # Promos (module promotions): item promos are inside subtotal already (the lines' amount); a free gift line is at 0;
  # the bill promo comes off the subtotal (after item promos) when it reaches the promo's minimum spend, a percent one
  # up to its cap. Stacking: item promos and one bill promo add up; the cashier's manual discounts come on top and are
  # the only part big_discount looks at (a promo the owner set up never waits for head office).
  - {name: line_promo_total, type: currency, label: {id: Promo per barang}, depends_on: app_installed('promotions'), compute: "items.map(l, l.promo_discount).sum()"}
  - {name: gift_value, type: currency, label: {id: Harga produk gratis}, depends_on: app_installed('promotions'), compute: "items.map(l, l.is_gift ? l.gross : 0).sum()"}
  - name: bill_promo
    type: currency
    label: {id: Promo nota}
    depends_on: app_installed('promotions')
    # nothing off while the promo cannot apply (switched off, outside its dates or outlet, a wrong shared code), so
    # the counter's total never shows a discount the payment would refuse; hours are rule promo_valid's (clock())
    compute: "promotion == '' || subtotal < promotion.min_spend || !promotion.active || promotion.valid_from > date || promotion.valid_until < date || (promotion.only_outlet != '' && promotion.only_outlet != outlet) || (promotion.code_mode == 'shared' && promo_code.trim().upperAscii() != promotion.code) ? 0 : (promotion.kind == 'bill_pct' ? (promotion.max_discount > 0 ? min(promotion.max_discount, round(subtotal * promotion.pct / 100)) : round(subtotal * promotion.pct / 100)) : (promotion.kind == 'bill_off' ? min(subtotal, promotion.amount_off) : 0))"
  # what the cart still lacks for the bill promo's minimum spend: the counter shows it under the order only while it is
  # above 0 (its depends_on), so the cashier can tell the buyer "kurang Rp 2.400"
  - name: promo_shortfall
    type: currency
    label: {id: Kurang belanja untuk promo}
    depends_on: app_installed('promotions') && promo_shortfall > 0
    compute: "promotion == '' ? 0 : max(0, promotion.min_spend - subtotal)"
  - {name: promo_name, type: data, label: {id: Nama promo nota}, hidden: true, depends_on: app_installed('promotions'), compute: "promotion != '' ? promotion.promo_name : ''"}
  - {name: promo_total, type: currency, label: {id: Promo}, depends_on: app_installed('promotions'), compute: line_promo_total + gift_value + bill_promo}
  - name: discount_total
    type: currency
    label: {id: Total diskon}
    compute: gross_total - subtotal + discount_amount + bill_promo
  - name: manual_discount_total
    type: currency
    label: {id: Diskon kasir}
    help: {id: 'Diskon yang diberi kasir, di luar promo'}
    compute: discount_total - promo_total
  - name: grand_total
    type: currency
    label: {id: Total}
    compute: subtotal - bill_promo - discount_amount
    in_list: true
  # Payment (table payments, rows of pos_payment): no row means exact cash; a cash row is what the buyer handed over,
  # a QRIS row is paid exactly. Change comes only out of cash, so QRIS may not exceed the total.
  - {name: payments, type: table, of: pos_payment, label: {id: Pembayaran}}
  - name: qris_amount
    type: currency
    label: {id: Dibayar QRIS}
    compute: "payments.map(p, p.method == 'qris' ? p.amount : 0).sum()"
  - name: cash_received
    type: currency
    label: {id: Uang tunai diterima}
    compute: "payments.size() == 0 ? grand_total : payments.map(p, p.method == 'cash' ? p.amount : 0).sum()"
  - name: cash_amount
    type: currency
    label: {id: Dibayar tunai}
    help: {id: 'Total dikurangi QRIS: uang tunai yang tinggal di laci'}
    compute: grand_total - qris_amount
  - name: change_amount
    type: currency
    label: {id: Kembalian}
    compute: cash_received + qris_amount - grand_total
  - name: method
    type: select
    label: {id: Cara bayar}
    compute: "qris_amount == 0 ? 'cash' : (qris_amount >= grand_total ? 'qris' : 'split')"
    in_list: true
    chip: true
    options:
      - {value: cash, label: {id: Tunai}}
      - {value: qris, label: {id: QRIS}}
      - {value: split, label: {id: Tunai + QRIS}}
  - name: cogs_total
    type: currency
    label: {id: Harga pokok}
    help: {id: 'Diisi sistem saat dibayar: barang atau bahan resep x rata-rata biaya'}
    read_only: true
    hidden_for: [cashier, outlet_staff]
  - name: margin
    type: currency
    label: {id: Margin}
    compute: grand_total - cogs_total
    hidden_for: [cashier, outlet_staff]
  # Same monthly tax recap as outlet_sales: PPN inside a PKP shop's prices, and the 0,5% final PPh of PP 55/2022.
  - name: ppn_in_sales
    type: currency
    label: {id: PPN dalam penjualan}
    compute: "tax.pkp ? round(grand_total * tax.ppn_rate * tax.dpp_num / (100 * tax.dpp_den + tax.ppn_rate * tax.dpp_num)) : 0"
  - name: pph_final
    type: currency
    label: {id: 'PPh final 0,5%'}
    compute: round((grand_total - ppn_in_sales) * 5 / 1000)
# Cashier controls (audit kasir M5): a receipt whose manual discounts exceed 20% of its price after promos waits for head office
# (contract 0007; the owner may always approve). A void is not held: an approved verb runs again as a requester
# without their outlets, so the flow's own-shift check cannot run (kernel card t_7782ebb1 follow-up); voids stay
# same day, open shift, own shift, and are counted on the shift and the dashboard.
approvals:
  - name: big_discount
    on: submit
    when: "manual_discount_total * 100 > (gross_total - promo_total) * 20 && !('head_office' in user.roles) && !('owner' in user.roles)"
    approvers: [head_office]
    label: {id: Persetujuan kantor pusat untuk diskon di atas 20%, en: Head office approves a discount above 20%}
stock:
  date: date
  moves:
    - {lines: items, out: outlet, explode: recipe, reason: sale, cogs: cogs}
  cogs_total: cogs_total
rules:
  # a WhatsApp receipt needs a number that reads as one (module whatsapp_receipt)
  - name: wa_receipt_number
    on: save
    check: "!app_installed('whatsapp_receipt') || !wa_receipt || wa_number != ''"
    message: {id: 'Nomor WhatsApp pembeli belum benar, misalnya 0812 3456 7890'}
  # the receipt number carries the outlet code (STRK-<code>-...); head office could have emptied it since the shift
  # opened: say so when saving, not only at payment (kernel 409 numbering)
  - name: outlet_has_code
    on: save
    check: outlet.code != ''
    message: {id: 'Outlet ini belum punya Kode; minta kantor pusat mengisi Kode outlet (dipakai di nomor struk)'}
  - name: outlet_of_shift
    on: save
    check: outlet == shift.outlet
    message: {id: 'Outlet transaksi harus sama dengan outlet sesi kasirnya'}
  - name: shift_open
    on: save
    check: shift.state == 'open'
    message: {id: 'Sesi kasir ini sudah ditutup; buka sesi baru'}
  - name: own_shift
    on: save
    check: "shift.cashier == user.email || 'head_office' in user.roles || 'owner' in user.roles"
    message: {id: 'Ini sesi kasir orang lain; pakai sesi kasirmu sendiri'}
  # Jalur A or Jalur B per outlet: with outlet_sales installed, only an outlet whose sales source is the cashier.
  - name: outlet_uses_cashier
    on: save
    check: "!app_installed('outlet_sales') || (outlet.moka_name == '' && outlet.sales_source == 'kasir')"
    message: {id: 'Outlet ini mencatat penjualan lewat Moka, file POS atau formulir harian. Ubah Sumber penjualan outlet ke Kasir Juragan dulu'}
  - name: qty_positive
    on: save
    check: "items.map(l, l.qty <= 0 ? 1 : 0).sum() == 0"
    message: {id: Jumlah barang harus lebih dari 0}
  - name: line_discount_range
    on: save
    check: "items.map(l, l.discount_pct < 0 || l.discount_pct > 100 ? 1 : 0).sum() == 0"
    message: {id: Diskon barang harus 0 sampai 100 persen}
  - name: unit_of_item
    on: save
    check: "items.map(l, l.packing_item != l.item ? 1 : 0).sum() == 0"
    message: {id: 'Satuan yang dipilih bukan satuan barang itu'}
  - name: priced
    on: save
    check: "items.map(l, l.rate <= 0 ? 1 : 0).sum() == 0"
    message: {id: 'Ada barang tanpa harga jual; isi Harga jual di data barang'}
  - name: receipt_discount_range
    on: save
    check: discount_amount >= 0 && discount_amount <= subtotal - bill_promo
    message: {id: Diskon nota tidak boleh negatif atau melebihi subtotal}
  # Bill promo (module promotions): a bill kind, active, in its dates, days and hours now (clock(), the site's wall
  # clock; rangka-os contract 0069 §3) and at this outlet. Day 1 is Monday (2024-01-01 was one).
  - name: promo_is_bill
    on: save
    check: "promotion == '' || promotion.is_bill"
    message: {id: 'Promo ini otomatis per barang; untuk nota pilih promo nota'}
  - name: promo_valid
    on: save
    check: >-
      promotion == '' || promotion.active && promotion.valid_from <= date && promotion.valid_until >= date
      && (promotion.only_outlet == '' || promotion.only_outlet == outlet)
      && (promotion.days == '' || promotion.days.contains(string(days_between('2024-01-01', date) % 7 + 1)))
      && (promotion.time_from == '' || clock() >= promotion.time_from && clock() < promotion.time_until)
    message: {id: 'Promo ini tidak berlaku di outlet, tanggal atau jam ini'}
  - name: promo_min_spend
    on: save
    level: warn
    check: "promotion == '' || subtotal >= promotion.min_spend"
    message: {id: 'Belanja belum mencapai minimal promo; promo nota belum dipotong'}
  - name: promo_code_needed
    on: save
    check: "promotion == '' || promotion.code_mode == 'none' || promotion.code_mode == '' || promo_code.trim() != ''"
    message: {id: 'Masukkan kode voucher atau kupon untuk promo ini'}
  - name: promo_code_shared
    on: save
    check: "promotion == '' || promotion.code_mode != 'shared' || promo_code.trim().upperAscii() == promotion.code"
    message: {id: 'Kode voucher tidak cocok dengan promo ini'}
  - name: promo_code_without_promo
    on: save
    check: "promo_code.trim() == '' || promotion != ''"
    message: {id: 'Pilih promo nota untuk kode ini'}
  # a free gift line, told apart so the cashier knows what is missing (promo_shortfall shows how much to spend)
  - name: gift_needs_promo
    on: save
    check: "items.map(l, l.is_gift ? 1 : 0).sum() == 0 || promotion != '' && promotion.kind == 'free_gift'"
    message: {id: 'Produk gratis perlu promo hadiah: pilih promonya di Promo nota, atau matikan Produk gratis promo di barisnya'}
  - name: gift_min_spend
    on: save
    check: "items.map(l, l.is_gift ? 1 : 0).sum() == 0 || promotion == '' || promotion.kind != 'free_gift' || subtotal >= promotion.min_spend"
    message: {id: 'Belanja belum mencapai minimal promo hadiah; kekurangannya tertulis di Kurang belanja untuk promo'}
  - name: gift_item
    on: save
    check: "promotion == '' || promotion.kind != 'free_gift' || items.map(l, l.is_gift && l.item != promotion.gift_item ? 1 : 0).sum() == 0"
    message: {id: 'Barang ini bukan produk gratis promo yang dipilih'}
  - name: gift_qty
    on: save
    check: "promotion == '' || promotion.kind != 'free_gift' || items.map(l, l.is_gift ? l.stock_qty : 0).sum() <= promotion.gift_qty"
    message: {id: 'Jumlah produk gratis melebihi yang diberikan promo'}
  # a gift is given in the item's own unit, never a pack (audit F1: a dus of 24 is 24 gifts)
  - name: gift_no_packing
    on: save
    check: "items.map(l, l.is_gift && l.packing != '' ? 1 : 0).sum() == 0"
    message: {id: 'Produk gratis diberikan per satuan barang; kosongkan Satuan lain di baris hadiah'}
  - name: line_promo_live
    on: submit
    check: "items.map(l, l.promotion != '' && l.promo_until != '' && l.promo_until < date ? 1 : 0).sum() == 0"
    message: {id: 'Promo ini sudah tidak berlaku hari ini; hapus barangnya lalu tambahkan lagi'}
  - name: payment_positive
    on: save
    check: "payments.map(p, p.amount <= 0 ? 1 : 0).sum() == 0"
    message: {id: Jumlah pembayaran harus lebih dari 0}
  - name: qris_not_over
    on: save
    check: qris_amount <= grand_total
    message: {id: 'QRIS tidak boleh melebihi total; kembalian hanya dari uang tunai'}
  - name: paid_enough
    on: save
    check: change_amount >= 0
    message: {id: 'Pembayaran kurang dari total'}
  - name: paid_today
    on: submit
    check: date == today()
    message: {id: 'Draf ini dari hari lain; buat transaksi baru untuk hari ini'}
views:
  list:
    columns: [name, date, outlet, grand_total, method, status, buyer]
    filters: [outlet, method, shift]
    sort: -name
  form:
    layout:
      - section: {id: Transaksi}
        columns:
          - [shift, outlet, date, customer]
          - [buyer, wa_phone, wa_receipt]
      - section: {id: Promo}
        columns:
          - [promotion]
          - [promo_code]
      - section: {id: Barang}
        fields: [items]
      - section: {id: Bayar}
        columns:
          - [subtotal, discount_amount, grand_total]
          - [cash_received, qris_amount, change_amount]
      - section: {id: Pembayaran}
        fields: [payments]
      - section: {id: Ringkasan}
        columns:
          - [gross_total, promo_total, line_promo_total, gift_value, bill_promo]
          - [manual_discount_total, discount_total, promo_shortfall, cogs_total, margin, ppn_in_sales, pph_final]
