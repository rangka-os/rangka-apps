# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Lists the assets of a new monthly depreciation run: every register row still active whose next month to depreciate
# (the month after the last one depreciated, else its first month) is on or before the run's month, with what it is
# owed up to that month: the monthly amount times the months not yet depreciated (one, or more when earlier months had
# no run), never past its residual value, so the last month takes what is left. Months between two first-of-month
# dates are their days / 30.436875 rounded (exact for any span: a calendar month is 28 to 31 days).
name: depreciation_run_fill
label: {id: Isi daftar aset penyusutan}
on: depreciation_run.created
steps:
  - find: depreciation_run
    where: name == event.name
    as: run
  - find_all: asset_book
    where: state == 'active' && depreciation_start <= event.period
    sort: asset
    limit: 2000
    as: books
  - update: run
    set:
      lines: >-
        books.filter(b, b.state == 'active' && (b.depreciated_through == '' ? string(b.depreciation_start) : add_months(string(b.depreciated_through), 1)) <= string(event.period) && (b.book_value - b.residual_value) > 0).map(b, {'asset': b.asset, 'asset_name': b.asset_name,
          'months': (int((double(days_between((b.depreciated_through == '' ? string(b.depreciation_start) : add_months(string(b.depreciated_through), 1)), string(event.period))) + 15.0) / 30.436875) + 1), 'amount': min(b.monthly_depreciation * (int((double(days_between((b.depreciated_through == '' ? string(b.depreciation_start) : add_months(string(b.depreciated_through), 1)), string(event.period))) + 15.0) / 30.436875) + 1), (b.book_value - b.residual_value)),
          'outlet': b.outlet, 'project': b.project, 'prev_through': b.depreciated_through})
