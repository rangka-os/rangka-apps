# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Inside a monthly depreciation run's submit: refused when a run for this month or a later one is already submitted, or
# when a line no longer matches its asset (the asset was cancelled, disposed of or depreciated by another run since
# the draft was made, or its amount, outlet or project was changed): delete the draft and make it again. Then each register row takes its
# line: accumulated depreciation, the month depreciated, the run, and Habis disusutkan once the book value reaches the
# residual. The journal is the accounting module's (gl_depreciation_run_post).
name: depreciation_run_on_submit
label: {id: Penyusutan bulanan masuk daftar aset}
on: depreciation_run.submitted
if: "'docstatus' in event && event.docstatus == 1"
steps:
  - find: depreciation_run
    where: name != event.name && docstatus == 1 && period >= event.period
    as: later
  - if: later != null
    create: asset_guard
    set: {reason: "'run_exists'", document: later.name}
  - find_all: asset_book
    where: asset in event.lines.map(l, l.asset) && state != 'cancelled'
    as: books
  - if: >-
      books.size() != event.lines.size() || !event.lines.all(l, books.exists(b, b.asset == l.asset
        && b.state == 'active' && (b.depreciated_through == '' ? string(b.depreciation_start) : add_months(string(b.depreciated_through), 1)) <= string(event.period) && (b.book_value - b.residual_value) > 0 && b.depreciated_through == l.prev_through && l.outlet == b.outlet && l.project == b.project && l.amount == (2 * ((b.book_value - b.residual_value) - b.monthly_depreciation * (int((double(days_between((b.depreciated_through == '' ? string(b.depreciation_start) : add_months(string(b.depreciated_through), 1)), string(event.period))) + 15.0) / 30.436875) + 1)) < b.monthly_depreciation ? (b.book_value - b.residual_value) : b.monthly_depreciation * (int((double(days_between((b.depreciated_through == '' ? string(b.depreciation_start) : add_months(string(b.depreciated_through), 1)), string(event.period))) + 15.0) / 30.436875) + 1))))
    create: asset_guard
    set: {reason: "'run_stale'", document: event.name}
  - for_each: books
    as: b
    do:
      - update: b
        set:
          accumulated: b.accumulated + event.lines.filter(l, l.asset == b.asset)[0].amount
          depreciated_through: event.period
          last_run: event.name
          state: "b.book_value - event.lines.filter(l, l.asset == b.asset)[0].amount <= b.residual_value ? 'fully_depreciated' : 'active'"
