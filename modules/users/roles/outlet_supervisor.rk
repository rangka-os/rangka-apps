# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/role.json
name: outlet_supervisor
label: {id: Kepala outlet}
description: {id: 'Melihat absen outlet yang dia pegang, menyetujui absen di luar radius atau lembur, menyusun jadwal shift dan menyetujui tukar shift'}
# Contract 0010 §5: only records of the member's outlets (the outlets set in Tim). Added with module attendance
# (rangka-apps#100); leave, reimbursement and shifts (rangka-apps#114, #117, #120) reuse it for their approvals. Shifts:
# writes and publishes the weekly roster of their outlets and submits (approves) shift swaps there.
scope: {field: outlet, from: user.outlets}
