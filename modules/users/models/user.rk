# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: user
label: {id: Karyawan, en: Employee}
icon: user
title_field: full_name
naming: USR-{###}
permissions:
  - {role: sales_manager, read: true}
  - {role: finance_manager, read: true}
  - {role: purchasing_manager, read: true}
  - {role: project_admin, read: true}
  - {role: head_office, read: true}
  - {role: outlet_staff, read: true}
  - {role: sales_rep, read: true}
  - {role: field_sales, read: true}
  - {role: course_admin, read: true}
fields:
  - name: full_name
    type: data
    label: {id: Nama}
    required: true
    in_list: true
  - name: employee_no
    type: data
    label: {id: Nomor karyawan}
  - name: phone
    type: phone
    label: {id: Nomor telepon}
    hidden_for: [cashier, collector, course_admin, field_sales, field_worker, finance_manager, instructor, kitchen, outlet_staff, project_admin, purchasing_manager, rental_staff, sales_manager, sales_rep, site_supervisor]
  - name: email
    type: data
    label: {id: Email}
    read_only: true
    hidden_for: [cashier, collector, course_admin, field_sales, field_worker, finance_manager, instructor, kitchen, outlet_staff, project_admin, purchasing_manager, rental_staff, sales_manager, sales_rep, site_supervisor]
  - name: role
    type: data
    label: {id: Peran}
    read_only: true
    in_list: true
  - {name: outlets, type: table, of: user_outlet, label: {id: Outlet}, read_only: true}
  - name: access
    type: select
    label: {id: Akses}
    help: {id: Akses diatur di Tim.}
    default: "'none'"
    read_only: true
    in_list: true
    chip: true
    options:
      - {value: active, label: {id: Aktif}}
      - {value: pending, label: {id: Menunggu}}
      - {value: removed, label: {id: Dicabut}}
      - {value: none, label: {id: Tanpa akses}}
  - name: account_id
    type: int
    label: {id: ID akun}
    read_only: true
    hidden_for: [cashier, collector, course_admin, field_sales, field_worker, finance_manager, head_office, instructor, kitchen, outlet_staff, project_admin, purchasing_manager, rental_staff, sales_manager, sales_rep, site_supervisor]
