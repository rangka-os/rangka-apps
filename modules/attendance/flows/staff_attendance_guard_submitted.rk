# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: staff_attendance_guard_submitted
label: {id: 'Absen karyawan yang diajukan tidak dobel, tidak masuk periode yang sudah direkap, fotonya tidak dipakai ulang'}
# Runs again at submit (also the submit an approval runs as the employee): no new day inside a submitted period of the
# same outlet or the whole business, one counted log per employee and day, one photo per log. Reads attendance_period
# before staff_attendance, the order of attendance_period_on_submit (contract 0025).
on: staff_attendance.submitted
steps:
  - find: attendance_period
    where: docstatus == 1 && period_from <= event.work_date && period_to >= event.work_date && (only_outlet == '' || only_outlet == event.outlet)
    as: closed
  - if: closed != null
    create: staff_attendance_guard
    set:
      reason: "'period_closed'"
      document: closed.name
  - find: staff_attendance
    where: day_key == event.day_key && name != event.name && docstatus != 2 && (docstatus == 1 || clock_in != '')
    as: other
  - if: other != null
    create: staff_attendance_guard
    set:
      reason: "'second_log'"
      document: other.name
  # A photo already used by another live log of the same employee (the only logs a staff member can read).
  - if: event.in_photo != ''
    find: staff_attendance
    where: >-
      name != event.name && docstatus != 2 && (
        in_photo == event.in_photo || out_photo == event.in_photo
        || (event.out_photo != '' && (in_photo == event.out_photo || out_photo == event.out_photo)))
    as: same_photo
  - if: event.in_photo != '' && same_photo != null
    create: staff_attendance_guard
    set:
      reason: "'photo_reused'"
      document: same_photo.name
