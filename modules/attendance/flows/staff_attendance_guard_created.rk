# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: staff_attendance_guard_created
label: {id: Satu absen karyawan per orang per hari (baru)}
# A second live log of the same employee and day would count the day twice. The read takes the flow lock of contract
# 0025, so two clock-ins sent at the same moment run one after the other and the second is refused. A draft left without
# its clock-in time (the clock screen's second write failed) does not hold the day.
on: staff_attendance.created
steps:
  - find: staff_attendance
    where: day_key == event.day_key && name != event.name && docstatus != 2 && (docstatus == 1 || clock_in != '')
    as: other
  - if: other != null
    create: staff_attendance_guard
    set:
      reason: "'second_log'"
      document: other.name
