# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: attendance_period_on_cancel
label: {id: 'Rekap absen karyawan dibatalkan: ringkasannya ditandai batal'}
# The summaries stay as the trail, marked cancelled (payroll skips cancelled summaries).
on: attendance_period.cancelled
if: "'docstatus' in event && event.docstatus == 2"
steps:
  - find_all: attendance_summary
    where: attendance_period == event.name && !cancelled
    as: sums
  - for_each: sums
    as: s
    do:
      - update: s
        set: {cancelled: true}
