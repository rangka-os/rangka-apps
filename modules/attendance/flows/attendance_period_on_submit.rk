# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: attendance_period_on_submit
label: {id: Rekap absen karyawan jadi ringkasan per karyawan}
# One attendance_summary per employee with access active and not attendance_exempt, from the submitted logs of the period
# (of the period's outlet, or of every outlet). A period of one outlet summarises the employees who clocked in there
# (an employee of another outlet who never came is not that outlet's absence). Logs waiting for approval do not count.
# Refused (the whole submit rolls back) when another submitted period overlaps the days for the same outlet or the whole
# business. Reads in the order attendance_period, user, staff_attendance (contract 0025 locks), like the log guards.
on: attendance_period.submitted
# Only a real submit: a hand run (POST /flows/.../run) carries no submitted period and would summarise twice.
if: "'docstatus' in event && event.docstatus == 1"
steps:
  - find: attendance_summary
    where: attendance_period == event.name && !cancelled
    as: done
  - if: done != null
    create: staff_attendance_guard
    set:
      reason: "'period_summarised'"
      document: event.name
  - find: attendance_period
    where: >-
      name != event.name && docstatus == 1 && period_from <= event.period_to && period_to >= event.period_from
      && (only_outlet == '' || event.only_outlet == '' || only_outlet == event.only_outlet)
    as: other
  - if: other != null
    create: staff_attendance_guard
    set:
      reason: "'period_overlap'"
      document: other.name
  # Approved leave (module leave, rangka-apps#114) overlapping the period, and the public holidays in it: an employee on
  # leave is not absent, and the days of unpaid leave reach the payslip through unpaid_leave_days. Each request is cut to
  # the period; Monday to Friday count (every day for a type counting calendar days) minus public holidays on a weekday.
  # Without the leave module both lists are empty (a find on a model that is not installed fails).
  - if: "app_installed('leave')"
    then:
      - find_all: public_holiday
        where: holiday_date >= event.period_from && holiday_date <= event.period_to
        as: hols
      - find_all: leave_request
        where: >-
          docstatus == 1 && date_from <= event.period_to && date_to >= event.period_from
          && (event.only_outlet == '' || outlet == event.only_outlet)
        as: leaves
    else:
      - find_all: staff_attendance
        where: "name == ''"
        as: hols
      - find_all: staff_attendance
        where: "name == ''"
        as: leaves
  - find_all: user
    where: access == 'active' && !attendance_exempt
    sort: full_name
    as: emps
  - find_all: staff_attendance
    where: >-
      docstatus == 1 && work_date >= event.period_from && work_date <= event.period_to
      && (event.only_outlet == '' || outlet == event.only_outlet)
    sort: work_date
    as: logs
  - for_each: emps
    as: u
    do:
      - if: "event.only_outlet == '' || logs.exists(l, l.employee == u.name) || leaves.exists(r, r.employee == u.name)"
        create: attendance_summary
        set:
          attendance_period: event.name
          employee: u.name
          employee_name: u.full_name
          # the period's outlet, else where they clocked in first; empty for a whole-business period without a log (a flow
          # find does not load table fields, so the member's outlets in Tim cannot be read here: rangka-os follow-up)
          outlet: "event.only_outlet != '' ? event.only_outlet : (logs.exists(l, l.employee == u.name) ? logs.filter(l, l.employee == u.name)[0].outlet : '')"
          period_from: event.period_from
          period_to: event.period_to
          days_present: "logs.map(l, l.employee == u.name ? 1 : 0).sum()"
          late_count: "logs.map(l, l.employee == u.name && l.late_min > 0 ? 1 : 0).sum()"
          late_min_total: "logs.map(l, l.employee == u.name ? l.late_min : 0).sum()"
          early_min_total: "logs.map(l, l.employee == u.name ? l.early_min : 0).sum()"
          overtime_hours: "logs.map(l, l.employee == u.name ? l.overtime_hours : 0.0).sum()"
          worked_min_total: "logs.map(l, l.employee == u.name ? l.worked_min : 0).sum()"
          leave_days: "leaves.filter(r, r.employee == u.name && !r.is_unpaid).map(r, (r.calendar ? (days_between((r.date_from > event.period_from ? r.date_from : event.period_from), (r.date_to < event.period_to ? r.date_to : event.period_to)) + 1) : int(5 * (((days_between((r.date_from > event.period_from ? r.date_from : event.period_from), (r.date_to < event.period_to ? r.date_to : event.period_to)) + 1) - (days_between((r.date_from > event.period_from ? r.date_from : event.period_from), (r.date_to < event.period_to ? r.date_to : event.period_to)) + 1) % 7) / 7) + max(0, min((days_between('2000-01-03', (r.date_from > event.period_from ? r.date_from : event.period_from)) % 7) + (days_between((r.date_from > event.period_from ? r.date_from : event.period_from), (r.date_to < event.period_to ? r.date_to : event.period_to)) + 1) % 7, 5) - (days_between('2000-01-03', (r.date_from > event.period_from ? r.date_from : event.period_from)) % 7)) + max(0, min((days_between('2000-01-03', (r.date_from > event.period_from ? r.date_from : event.period_from)) % 7) + (days_between((r.date_from > event.period_from ? r.date_from : event.period_from), (r.date_to < event.period_to ? r.date_to : event.period_to)) + 1) % 7, 12) - 7)) - hols.filter(h, h.holiday_date >= (r.date_from > event.period_from ? r.date_from : event.period_from) && h.holiday_date <= (r.date_to < event.period_to ? r.date_to : event.period_to) && days_between('2000-01-03', h.holiday_date) % 7 < 5).size())).sum()"
          unpaid_leave_days: "leaves.filter(r, r.employee == u.name && r.is_unpaid).map(r, (r.calendar ? (days_between((r.date_from > event.period_from ? r.date_from : event.period_from), (r.date_to < event.period_to ? r.date_to : event.period_to)) + 1) : int(5 * (((days_between((r.date_from > event.period_from ? r.date_from : event.period_from), (r.date_to < event.period_to ? r.date_to : event.period_to)) + 1) - (days_between((r.date_from > event.period_from ? r.date_from : event.period_from), (r.date_to < event.period_to ? r.date_to : event.period_to)) + 1) % 7) / 7) + max(0, min((days_between('2000-01-03', (r.date_from > event.period_from ? r.date_from : event.period_from)) % 7) + (days_between((r.date_from > event.period_from ? r.date_from : event.period_from), (r.date_to < event.period_to ? r.date_to : event.period_to)) + 1) % 7, 5) - (days_between('2000-01-03', (r.date_from > event.period_from ? r.date_from : event.period_from)) % 7)) + max(0, min((days_between('2000-01-03', (r.date_from > event.period_from ? r.date_from : event.period_from)) % 7) + (days_between((r.date_from > event.period_from ? r.date_from : event.period_from), (r.date_to < event.period_to ? r.date_to : event.period_to)) + 1) % 7, 12) - 7)) - hols.filter(h, h.holiday_date >= (r.date_from > event.period_from ? r.date_from : event.period_from) && h.holiday_date <= (r.date_to < event.period_to ? r.date_to : event.period_to) && days_between('2000-01-03', h.holiday_date) % 7 < 5).size())).sum()"
