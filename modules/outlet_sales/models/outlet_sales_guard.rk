# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# Never stored: a flow that must refuse the verb it runs in creates one of these with a reason, and the matching rule
# fails with that reason's message, which rolls the whole verb back (the flow runs inside it), like delivery_guard.
# Create is granted to the roles whose verbs run such a flow.
name: outlet_sales_guard
label: {id: Penjaga penjualan outlet, en: Outlet sales guard}
icon: check
naming: OSG-{######}
title_field: reason
permissions:
  - {role: head_office, create: true}
  - {role: outlet_staff, create: true}
fields:
  - name: reason
    type: select
    label: {id: Alasan}
    required: true
    options:
      - {value: sales_returned, label: {id: Penjualan sudah dikembalikan ke stok}}
      - {value: over_returned, label: {id: Retur melebihi yang diretur di kasir}}
      - {value: sales_cancelled, label: {id: Penjualan sudah dibatalkan}}
      - {value: cashier_same_day, label: {id: Outlet sudah memakai kasir di tanggal itu}}
  - {name: document, type: data, label: {id: Dokumen}}
rules:
  - name: sales_returned
    on: save
    check: reason != 'sales_returned'
    message: {id: 'Penjualan ini punya retur ke stok yang masih aktif; batalkan retur ke stoknya dulu'}
  - name: over_returned
    on: save
    check: reason != 'over_returned'
    message: {id: 'Jumlah kembali ke stok melebihi barang yang diretur di kasir (ada retur lain yang baru diajukan); cek Retur di kasir'}
  - name: sales_cancelled
    on: save
    check: reason != 'sales_cancelled'
    message: {id: 'Penjualan ini baru saja dibatalkan; retur ke stok dari penjualan yang batal tidak bisa diajukan'}
  - name: cashier_same_day
    on: save
    check: reason != 'cashier_same_day'
    message: {id: 'Outlet ini sudah memakai kasir di tanggal itu: satu sumber penjualan per hari; batalkan struk kasirnya dulu'}
