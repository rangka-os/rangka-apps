# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Keeps the Retur di kasir current on outlet_return.submitted: the returned qty of each item goes on its first row.
# The update locks the record, so two returns submitted at once are counted one after the other; one that would bring
# back more than was refunded is refused (outlet_sales_guard over_returned) and rolls back with its stock moves.
name: refund_on_return_submitted
label: {id: Perbarui retur di kasir}
on: outlet_return.submitted
steps:
  - {find: pos_refund, where: name == event.refund, as: f}
  # a find returns the record without its table rows: an update that changes nothing returns it whole
  - update: f
    if: f != null
    set: {outlet: f.outlet}
  - update: f
    if: f != null
    set:
      items: "f.items.map(b, {'name': b.name, 'item': b.item, 'refunded_qty': b.refunded_qty, 'returned_qty': b.returned_qty + (f.items.filter(x, x.item == b.item)[0].name == b.name ? event.items.map(l, l.item == b.item ? l.qty : 0).sum() : 0)})"
  - if: "f != null && f.items.map(b, f.items.map(x, x.item == b.item ? x.returned_qty - x.refunded_qty : 0).sum() > 0.0005 ? 1 : 0).sum() > 0"
    create: outlet_sales_guard
    set: {reason: "'over_returned'", document: event.name}
