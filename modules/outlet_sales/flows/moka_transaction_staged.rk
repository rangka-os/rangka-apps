# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Moka API (connector moka, poll per outlet every 15 minutes): one transaction becomes a moka_transaction and one
# moka_sale_line per item, plus a refund line per refunded quantity. Nothing touches stock here: flow moka_daily_sales
# makes the outlet's daily sales draft from the lines, and stock moves when head office submits it (as with the export).
# Outlet: Moka's outlet id (outlet.moka_outlet_id), else Moka's outlet name (outlet.moka_name). Item: Moka's SKU = the
# item's sku, else Moka's item name = item_name. A line without outlet or item is unmapped and head office is told; it
# waits in Baris penjualan Moka until someone picks them (flow moka_line_mapped) and goes into the recap after that,
# as its own record for that day if the day was already recapped (an API line is posted exactly once).
# Refunds: a refunded quantity is recorded only if Moka reports it when the transaction is first polled. A refund made
# after that poll is not seen (the poll cursor is the newest created_at and the transaction id is unique); until the
# connector polls refunds, such refunds are booked by head office, or the day comes from the export file instead.
# A transaction delivered twice records nothing: the kernel drops a repeated event, idempotency stops a second run, and
# moka_transaction.transaction_id is unique, so a run racing another rolls back whole.
# The day is the first 10 characters of created_at (Moka answers in the outlet's local time, +07:00).
name: moka_transaction_staged
label: {id: Transaksi Moka masuk jadi baris penjualan}
on: moka.transaction_created
if: "'transaction_id' in event && 'created_at' in event && 'checkouts' in event && 'outlet_id' in event"
idempotency: string(event.transaction_id)
steps:
  - find: outlet
    where: "moka_outlet_id != '' && moka_outlet_id == string(event.outlet_id)"
    as: by_id
  - find: outlet
    where: "moka_name != '' && moka_name == ('outlet_name' in event ? event.outlet_name : '')"
    as: by_name
  - create: moka_transaction
    set:
      transaction_id: string(event.transaction_id)
      receipt_no: "'receipt_no' in event ? event.receipt_no : ''"
      outlet: "by_id != null ? by_id.name : (by_name != null ? by_name.name : '')"
      moka_outlet: "'outlet_name' in event ? event.outlet_name : string(event.outlet_id)"
      sold_at: event.created_at
      date: event.created_at
      payment_type: "'payment_type' in event ? event.payment_type : ''"
      total_collected: "'total_collected' in event ? event.total_collected : 0"
      refunded: "'is_refunded' in event && event.is_refunded == true"
    as: tx
  - for_each: event.checkouts
    as: c
    do:
      - find: item
        where: "sku != '' && sku == ('sku' in c ? c.sku : '')"
        as: by_sku
      - find: item
        where: "item_name == c.item_name"
        as: by_item_name
      # a sale line only for a positive quantity, its discount never above its gross (outlet_sales rules
      # qty_not_negative and discount_within_gross refuse anything else, and one refused line would stop the recap)
      - create: moka_sale_line
        if: c.quantity > 0
        set:
          transaction: tx.name
          outlet: tx.outlet
          date: tx.date
          item: "by_sku != null ? by_sku.name : (by_item_name != null ? by_item_name.name : '')"
          description: "c.item_name + ('item_variant_name' in c && c.item_variant_name != '' ? ' ' + c.item_variant_name : '')"
          sku: "'sku' in c ? c.sku : ''"
          qty: c.quantity
          gross: c.total_price
          discount: "min('discount_amount' in c ? c.discount_amount : 0, c.total_price)"
          refund: "0"
          status: "tx.outlet == '' || (by_sku == null && by_item_name == null) ? 'unmapped' : 'staged'"
      - create: moka_sale_line
        # a refund line only when it returns money: a refund of a free item (100% discount) changes nothing and a line of
        # qty < 0 without refund is refused by outlet_sales
        if: "c.quantity > 0 && 'refunded_quantity' in c && c.refunded_quantity > 0 && round((c.total_price - min('discount_amount' in c ? c.discount_amount : 0, c.total_price)) * c.refunded_quantity / c.quantity) > 0"
        set:
          transaction: tx.name
          outlet: tx.outlet
          date: tx.date
          item: "by_sku != null ? by_sku.name : (by_item_name != null ? by_item_name.name : '')"
          description: "'Retur ' + c.item_name + ('item_variant_name' in c && c.item_variant_name != '' ? ' ' + c.item_variant_name : '')"
          sku: "'sku' in c ? c.sku : ''"
          qty: -c.refunded_quantity
          gross: "0"
          discount: "0"
          refund: "round((c.total_price - min('discount_amount' in c ? c.discount_amount : 0, c.total_price)) * c.refunded_quantity / c.quantity)"
          status: "tx.outlet == '' || (by_sku == null && by_item_name == null) ? 'unmapped' : 'staged'"
  - find_all: moka_sale_line
    where: "transaction == tx.name && status == 'unmapped'"
    as: unmapped
  - notify: head_office
    if: "event.checkouts.map(c, c.quantity > 0 ? 0 : 1).sum() > 0"
    channel: email
    template: {id: 'Moka {tx.receipt_no} ({tx.moka_outlet}, {tx.date}) punya barang dengan qty 0 atau minus, tidak direkap. Cek di Moka'}
  - notify: head_office
    if: size(unmapped) > 0
    channel: email
    template: {id: 'Moka {tx.receipt_no} ({tx.moka_outlet}, {tx.date}): barang atau outlet belum dikenali, petakan di Baris penjualan Moka'}
