# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Moka API (connector moka, poll per outlet every 5 minutes of the transactions CHANGED since two days back): the first
# event of a transaction becomes a moka_transaction and one moka_sale_line per item, plus a refund line per refunded
# quantity. Nothing touches stock here: flow moka_daily_sales makes the outlet's daily sales draft from the lines, and
# stock moves when head office submits it (as with the export).
# Outlet: Moka's outlet id (outlet.moka_outlet_id), else Moka's outlet name (outlet.moka_name). Item: Moka's SKU = the
# item's sku, else Moka's item name = item_name. A line without outlet or item is unmapped and head office is told; it
# waits in Baris penjualan Moka until someone picks them (flow moka_line_mapped) and goes into the recap after that,
# as its own record for that day if the day was already recapped (an API line is posted exactly once).
# A later event of a known transaction (Moka changed it: a refund made after the sale was polled, or anything else) adds
# only refund lines for the quantity refunded since, per Moka checkout (moka_sale_line.checkout: the checkout's uuid,
# else its id), dated the day of the refund (refunded_date), staged for the recap of that day (or unmapped with its
# sale line, and mapped with it, flow moka_line_mapped); a change without a new refund adds nothing. A checkout without
# uuid or id is not matched by name (two lines of one item would share a refund): head office is told to book it.
# A refunded quantity counts at most the line's quantity. A checkout of qty <= 0 or a negative total is not staged:
# head office is told to check it in Moka.
# A transaction delivered twice records nothing: the kernel drops a repeated event and a known transaction only adds the
# refunded quantity not booked yet; moka_transaction.transaction_id is unique, so two runs racing on a new transaction
# roll the second back whole.
# Cost: one moka_transaction scan per event (the kernel reads a model whole for find); no moka_sale_line scan for a
# new transaction (unmapped lines are told about line by line), two per checkout for a refund.
# The day is the first 10 characters of created_at (Moka answers in the outlet's local time, +07:00); a time in UTC
# (ending in Z) is taken as WIB (+7 hours) first. The same for refunded_date. To confirm once API access is granted.
# Idempotency: the transaction and its refunded quantity, so a new refund is a new run and a repeat is not. An event
# without transaction_id (null or "") is not run: the kernel does not dedupe an empty key, so a repeated poll could book
# it twice; flow moka_transaction_without_id tells head office instead.
# Gate (audit sisa-1111 R1): a transaction of a known outlet whose day is before the outlet's moka_api_from (or while
# it is empty) is kept as a moka_transaction only, without lines: the export counts that day. A transaction of an
# unknown outlet stays unmapped as before; mapping its lines to an outlet checks the same gate (moka_sale_line rule
# staged_outlet_api_open). refunded_quantity may be null in a checkout (Moka's spec does not list it): null is 0.
name: moka_transaction_staged
label: {id: Transaksi Moka masuk jadi baris penjualan}
on: moka.transaction_created
if: "'transaction_id' in event && event.transaction_id != null && string(event.transaction_id) != '' && 'created_at' in event && 'checkouts' in event && 'outlet_id' in event"
idempotency: "string(event.transaction_id) + ':' + string(event.checkouts.map(c, 'refunded_quantity' in c && c.refunded_quantity != null ? c.refunded_quantity : 0).sum())"
steps:
  - find: moka_transaction
    where: transaction_id == string(event.transaction_id)
    as: known
  # a new transaction
  - find: outlet
    if: known == null
    where: "moka_outlet_id != '' && moka_outlet_id == string(event.outlet_id)"
    as: by_id
  - find: outlet
    if: known == null
    where: "moka_name != '' && moka_name == ('outlet_name' in event ? event.outlet_name : '')"
    as: by_name
  - create: moka_transaction
    if: known == null
    set:
      transaction_id: string(event.transaction_id)
      receipt_no: "'receipt_no' in event ? event.receipt_no : ''"
      outlet: "by_id != null ? by_id.name : (by_name != null ? by_name.name : '')"
      moka_outlet: "'outlet_name' in event ? event.outlet_name : string(event.outlet_id)"
      sold_at: event.created_at
      date: "string(event.created_at).matches('Z$') ? event.created_at + duration('7h') : event.created_at"
      payment_type: "'payment_type' in event ? event.payment_type : ''"
      total_collected: "'total_collected' in event ? event.total_collected : 0"
      refunded: "'is_refunded' in event && event.is_refunded == true"
    as: tx
  # the outlet's gate: open on and after its moka_api_from
  - find: outlet
    if: known == null
    where: "tx.outlet != '' && name == tx.outlet && moka_api_from != '' && moka_api_from <= tx.date"
    as: api_open
  - for_each: event.checkouts
    if: known == null && (tx.outlet == '' || api_open != null)
    as: c
    do:
      - find: item
        where: "sku != '' && sku == ('sku' in c ? c.sku : '')"
        as: by_sku
      - find: item
        where: "item_name == c.item_name"
        as: by_item_name
      # a sale line only for a positive quantity and total, its discount never above its gross (outlet_sales rules
      # qty_not_negative and discount_within_gross refuse anything else, and one refused line would stop the recap)
      - create: moka_sale_line
        if: "c.quantity > 0 && c.total_price >= 0"
        set:
          transaction: tx.name
          checkout: "('uuid' in c && c.uuid != null && string(c.uuid) != '' ? string(c.uuid) : ('id' in c && c.id != null ? string(c.id) : ''))"
          outlet: tx.outlet
          date: tx.date
          item: "by_sku != null ? by_sku.name : (by_item_name != null ? by_item_name.name : '')"
          description: "c.item_name + ('item_variant_name' in c && c.item_variant_name != '' ? ' ' + c.item_variant_name : '')"
          sku: "'sku' in c ? c.sku : ''"
          qty: c.quantity
          gross: c.total_price
          discount: "min('discount_amount' in c ? c.discount_amount : 0, c.total_price)"
          refund: "0"
          status: "tx.outlet == '' || (by_sku == null && by_item_name == null) ? 'unmapped' : 'staged'"
      - create: moka_sale_line
        # a refund line only when it returns money: a refund of a free item (100% discount) changes nothing and a line of
        # qty < 0 without refund is refused by outlet_sales; never more than the quantity sold
        if: "c.quantity > 0 && c.total_price >= 0 && 'refunded_quantity' in c && c.refunded_quantity != null && c.refunded_quantity > 0 && round((c.total_price - min('discount_amount' in c ? c.discount_amount : 0, c.total_price)) * min(c.refunded_quantity, c.quantity) / c.quantity) > 0"
        set:
          transaction: tx.name
          checkout: "('uuid' in c && c.uuid != null && string(c.uuid) != '' ? string(c.uuid) : ('id' in c && c.id != null ? string(c.id) : ''))"
          outlet: tx.outlet
          date: tx.date
          item: "by_sku != null ? by_sku.name : (by_item_name != null ? by_item_name.name : '')"
          description: "'Retur ' + c.item_name + ('item_variant_name' in c && c.item_variant_name != '' ? ' ' + c.item_variant_name : '')"
          sku: "'sku' in c ? c.sku : ''"
          qty: -min(c.refunded_quantity, c.quantity)
          gross: "0"
          discount: "0"
          refund: "round((c.total_price - min('discount_amount' in c ? c.discount_amount : 0, c.total_price)) * min(c.refunded_quantity, c.quantity) / c.quantity)"
          status: "tx.outlet == '' || (by_sku == null && by_item_name == null) ? 'unmapped' : 'staged'"
      - notify: head_office
        if: "tx.outlet != '' && c.quantity > 0 && c.total_price >= 0 && by_sku == null && by_item_name == null"
        channel: email
        template: {id: 'Moka {tx.receipt_no} ({tx.moka_outlet}, {tx.date}): barang "{c.item_name}" belum dikenali, petakan di Baris penjualan Moka'}
  - notify: head_office
    if: "known == null && (tx.outlet == '' || api_open != null) && event.checkouts.map(c, c.quantity > 0 && c.total_price >= 0 ? 0 : 1).sum() > 0"
    channel: email
    template: {id: 'Moka {tx.receipt_no} ({tx.moka_outlet}, {tx.date}) punya barang dengan qty 0 atau minus, atau total minus, tidak direkap. Cek di Moka'}
  - notify: head_office
    if: "known == null && tx.outlet == ''"
    channel: email
    template: {id: 'Moka {tx.receipt_no} ({tx.moka_outlet}, {tx.date}): outlet belum dikenali, petakan barisnya di Baris penjualan Moka'}
  # a known transaction that changed in Moka: refunds made after the first poll
  - for_each: event.checkouts
    if: known != null
    as: c
    do:
      - find: moka_sale_line
        where: "('uuid' in c && c.uuid != null && string(c.uuid) != '' ? string(c.uuid) : ('id' in c && c.id != null ? string(c.id) : '')) != '' && transaction == known.name && qty > 0 && checkout == ('uuid' in c && c.uuid != null && string(c.uuid) != '' ? string(c.uuid) : ('id' in c && c.id != null ? string(c.id) : ''))"
        as: sold
      - notify: head_office
        if: "('uuid' in c && c.uuid != null && string(c.uuid) != '' ? string(c.uuid) : ('id' in c && c.id != null ? string(c.id) : '')) == '' && 'refunded_quantity' in c && c.refunded_quantity != null && c.refunded_quantity > 0"
        channel: email
        template: {id: 'Moka {known.receipt_no} ({known.moka_outlet}): retur {c.item_name} tanpa ID baris Moka, catat manual'}
      - find_all: moka_sale_line
        if: sold != null
        where: "transaction == known.name && qty < 0 && checkout == sold.checkout && description == 'Retur ' + sold.description"
        as: returned
      - create: moka_sale_line
        if: "sold != null && 'refunded_quantity' in c && c.refunded_quantity != null && min(c.refunded_quantity, sold.qty) + returned.map(l, l.qty).sum() > 0 && round((sold.gross - sold.discount) * (min(c.refunded_quantity, sold.qty) + returned.map(l, l.qty).sum()) / sold.qty) > 0"
        set:
          transaction: known.name
          checkout: sold.checkout
          outlet: sold.outlet
          date: "'refunded_date' in event && event.refunded_date != null && event.refunded_date != '' ? (string(event.refunded_date).matches('Z$') ? event.refunded_date + duration('7h') : event.refunded_date) : today()"
          item: sold.item
          description: "'Retur ' + sold.description"
          sku: sold.sku
          qty: -(min(c.refunded_quantity, sold.qty) + returned.map(l, l.qty).sum())
          gross: "0"
          discount: "0"
          refund: "round((sold.gross - sold.discount) * (min(c.refunded_quantity, sold.qty) + returned.map(l, l.qty).sum()) / sold.qty)"
          status: "sold.status == 'unmapped' || sold.outlet == '' || sold.item == '' ? 'unmapped' : 'staged'"
        as: late
      - notify: head_office
        if: "sold != null && 'refunded_quantity' in c && c.refunded_quantity != null && min(c.refunded_quantity, sold.qty) + returned.map(l, l.qty).sum() > 0 && round((sold.gross - sold.discount) * (min(c.refunded_quantity, sold.qty) + returned.map(l, l.qty).sum()) / sold.qty) > 0"
        channel: email
        template: {id: 'Moka {known.receipt_no} ({known.moka_outlet}): retur susulan {sold.description} dicatat di Baris penjualan Moka'}
  - update: known
    if: "known != null && 'is_refunded' in event && event.is_refunded == true && !known.refunded"
    set:
      refunded: "true"
