# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Every hour at :15 (scheduler.timezone), and from the flow list: per outlet with Moka, the oldest past day that has
# staged Moka lines becomes one DRAFT outlet_sales (source moka), and its lines are marked posted. A run takes one day
# per outlet, so a backlog catches up one day per outlet per run. Today is never taken (Moka still sells).
# A day with an unmapped line waits until head office maps it (the whole day goes in together, so the record is right
# the first time). A day that already has a live Moka record (an export imported earlier, or an API record of lines
# that came in late) gets legacy_key_overlap, and rule legacy_key_reviewed holds the submit until head office has
# removed what is counted twice. key_version 3 marks a record from the API, so an export imported for the same day
# later is flagged the same way by flow moka_legacy_key_overlap.
# Stock moves when the draft is submitted (stock.post_moves through the recipes), never here.
name: moka_daily_sales
label: {id: Rekap harian penjualan Moka per outlet}
schedule: '15 * * * *'
steps:
  - find_all: outlet
    where: "moka_name != ''"
    sort: name
    as: outs
  - for_each: outs
    as: o
    do:
      - find_all: moka_sale_line
        where: "outlet == o.name && status == 'staged' && date < today()"
        sort: date
        limit: 1
        as: first
      - find_all: moka_sale_line
        if: size(first) > 0
        where: "outlet == o.name && date == first[0].date && status == 'staged'"
        sort: name
        limit: 2000
        as: rows
      - find: moka_sale_line
        if: size(first) > 0
        where: "outlet == o.name && date == first[0].date && status == 'unmapped'"
        as: held
      - find: outlet_sales
        if: size(first) > 0
        where: "outlet == o.name && date == first[0].date && source == 'moka' && docstatus != 2"
        as: other
      - create: outlet_sales
        if: size(first) > 0 && held == null
        set:
          outlet: o.name
          date: first[0].date
          source: "'moka'"
          moka_outlet: o.moka_name
          key_version: "3"
          note: "'Dari Moka API'"
          legacy_key_overlap: other != null
          lines: "rows.map(r, {'item': r.item, 'description': r.description, 'qty': r.qty, 'gross': r.gross, 'discount': r.discount, 'refund': r.refund})"
        as: sales
      - for_each: rows
        if: size(first) > 0 && held == null
        as: r
        do:
          - update: r
            set:
              status: "'posted'"
              sales: sales.name
