# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# A Moka transaction flow moka_transaction_staged does not book, told to head office instead of dropped silently:
# - no id (transaction_id missing, null or ""): the kernel does not dedupe an empty idempotency key, so a repeated poll
#   would count the sale twice (audit kernel-gelombang1 Delta 2, t_34922edd);
# - a checkout with quantity or total_price missing or null (audit moka-guard L1): booking a guess is worse than asking.
# Head office checks it in Moka and books it by hand or through the export. The kernel's event dedupe (hash of the
# event, 30 days) keeps one notice per distinct event.
name: moka_transaction_refused
label: {id: Transaksi Moka yang tidak bisa dicatat diberitahukan}
on: moka.transaction_created
if: "!('transaction_id' in event) || event.transaction_id == null || string(event.transaction_id) == '' || ('checkouts' in event && event.checkouts.map(c, 'quantity' in c && c.quantity != null && 'total_price' in c && c.total_price != null ? 0 : 1).sum() > 0)"
steps:
  - notify: head_office
    channel: email
    template: {id: 'Moka {event.receipt_no} ({event.outlet_name}): transaksi tanpa ID atau jumlah/harga dari Moka tidak dicatat, cek di Moka'}
