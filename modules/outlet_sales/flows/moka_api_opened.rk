# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Head office set (or moved earlier) an outlet's moka_api_from: the outlet's held Moka lines dated on or after it become
# staged and go into the next daily recap (flow moka_daily_sales). Held lines are what the API polled before the gate
# opened (audit moka-guard H1): without this they would be counted by neither the API nor the export. Lines dated
# before the date stay held (the export counts those days). A held line without item (head office emptied it) goes back
# to unmapped instead of staged, so saving the outlet is never refused by rule staged_has_outlet_and_item (audit
# moka-guard D2); flow moka_held_release catches held lines this run did not see (D1). Lines of the outlet from the
# date on that are still unmapped (an unknown item polled while the outlet was on the export, which was not told then:
# D3) are told to head office now, so the day is not recapped without them unnoticed (audit held-release A2).
name: moka_api_opened
label: {id: Baris Moka yang ditahan dilepas saat outlet mulai pakai API}
on: outlet.updated
if: "event.moka_api_from != null && event.moka_api_from != ''"
steps:
  - find_all: moka_sale_line
    where: "outlet == event.name && status == 'held' && date >= event.moka_api_from"
    as: held
  - for_each: held
    as: l
    do:
      - update: l
        set:
          status: "l.item != '' ? 'staged' : 'unmapped'"
  - find_all: moka_sale_line
    where: "outlet == event.name && status == 'unmapped' && date >= event.moka_api_from"
    as: waiting
  - notify: head_office
    if: size(waiting) > 0
    channel: email
    template: {id: '{event.outlet_name} mulai pakai API Moka: {size(waiting)} baris Moka belum dipetakan, petakan di Baris penjualan Moka'}
