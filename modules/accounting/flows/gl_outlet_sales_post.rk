# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_outlet_sales_post
label: {id: Jurnal penjualan outlet}
on: outlet_sales.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.net_total) != 0"
    set:
      posting_date: "event.date"
      account: "'11150'"
      amount: "event.net_total"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - (event.net_total - event.ppn_in_sales)) != 0"
    set:
      posting_date: "event.date"
      account: "'41100'"
      amount: "0 - (event.net_total - event.ppn_in_sales)"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.ppn_in_sales) != 0"
    set:
      posting_date: "event.date"
      account: "'21200'"
      amount: "0 - event.ppn_in_sales"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'3'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.pph_final) != 0"
    set:
      posting_date: "event.date"
      account: "'69100'"
      amount: "event.pph_final"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'4'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.pph_final) != 0"
    set:
      posting_date: "event.date"
      account: "'21310'"
      amount: "0 - event.pph_final"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'5'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.cogs_total) != 0"
    set:
      posting_date: "event.date"
      account: "'51100'"
      amount: "event.cogs_total"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'6'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.cogs_total) != 0"
    set:
      posting_date: "event.date"
      account: "'11400'"
      amount: "0 - event.cogs_total"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'7'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
