# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_payroll_close_post
label: {id: Jurnal gaji periode}
on: payroll_close.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.extra_cost) != 0"
    set:
      posting_date: "event.period_to"
      account: "'51300'"
      amount: "event.extra_cost"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.total_timesheet_cost - event.total_net_pay) != 0"
    set:
      posting_date: "event.period_to"
      account: "'21500'"
      amount: "event.total_timesheet_cost - event.total_net_pay"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.total_pph21) != 0"
    set:
      posting_date: "event.period_to"
      account: "'21320'"
      amount: "0 - event.total_pph21"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'3'"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - (event.total_employer_bpjs + event.total_employee_bpjs)) != 0"
    set:
      posting_date: "event.period_to"
      account: "'21600'"
      amount: "0 - (event.total_employer_bpjs + event.total_employee_bpjs)"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'4'"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.total_other_deduction) != 0"
    set:
      posting_date: "event.period_to"
      account: "'11330'"
      amount: "0 - event.total_other_deduction"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'5'"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.billing_mode == 'fee_only' ? event.total_employer_cost : 0) != 0"
    set:
      posting_date: "event.period_to"
      account: "'11340'"
      amount: "event.billing_mode == 'fee_only' ? event.total_employer_cost : 0"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'6'"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
