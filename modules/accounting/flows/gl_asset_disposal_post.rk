# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_asset_disposal_post
label: {id: Jurnal pelepasan aset tetap}
description: {id: 'Saat aset dijual atau dihapus, harga dan penyusutannya keluar dari buku, dan laba atau ruginya tercatat.'}
on: asset_disposal.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.accumulated_total) != 0"
    set:
      posting_date: "event.disposal_date"
      account: "'12900'"
      amount: "event.accumulated_total"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      project: "event.project"
      party: "event.asset"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.proceeds) != 0"
    set:
      posting_date: "event.disposal_date"
      account: "event.received_in == 'bank' ? '11200' : (event.received_in == 'receivable' ? '11300' : '11100')"
      amount: "event.proceeds"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      project: "event.project"
      party: "event.asset"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.cost) != 0"
    set:
      posting_date: "event.disposal_date"
      account: "'12100'"
      amount: "0 - event.cost"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'3'"
      outlet: "event.outlet"
      project: "event.project"
      party: "event.asset"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - (event.proceeds - event.book_value)) != 0"
    set:
      posting_date: "event.disposal_date"
      account: "'49300'"
      amount: "0 - (event.proceeds - event.book_value)"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'4'"
      outlet: "event.outlet"
      project: "event.project"
      party: "event.asset"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
