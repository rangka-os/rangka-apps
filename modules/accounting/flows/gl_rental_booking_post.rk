# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_rental_booking_post
label: {id: Jurnal deposit sewa}
on: rental_booking.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.deposit) != 0"
    set:
      posting_date: "event.booking_date"
      account: "event.deposit_method == 'cash' ? '11100' : '11200'"
      amount: "event.deposit"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.deposit) != 0"
    set:
      posting_date: "event.booking_date"
      account: "'21400'"
      amount: "0 - event.deposit"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
