# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_claim_payment_post
label: {id: Jurnal pembayaran klaim}
on: claim_payment.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.amount) != 0"
    set:
      posting_date: "event.payment_date"
      account: "'21510'"
      amount: "event.amount"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.amount) != 0"
    set:
      posting_date: "event.payment_date"
      account: "event.method == 'cash' ? '11100' : '11200'"
      amount: "0 - event.amount"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
