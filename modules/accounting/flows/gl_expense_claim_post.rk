# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_expense_claim_post
label: {id: Jurnal klaim biaya}
description: {id: 'Saat klaim biaya karyawan disetujui, biayanya masuk beban dan perusahaan berutang ke karyawan sampai dibayar.'}
on: expense_claim.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.amount) != 0"
    set:
      posting_date: "event.claim_date"
      account: "event.expense_account"
      amount: "event.amount"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      project: "event.project"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.amount) != 0"
    set:
      posting_date: "event.claim_date"
      account: "'21510'"
      amount: "0 - event.amount"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      project: "event.project"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
