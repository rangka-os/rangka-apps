# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_pos_shift_close_post
label: {id: Jurnal tutup sesi kasir}
on: pos_shift_close.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.cash_difference) != 0"
    set:
      posting_date: "event.close_date"
      account: "'11150'"
      amount: "event.cash_difference"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.cash_difference) != 0"
    set:
      posting_date: "event.close_date"
      account: "'61300'"
      amount: "0 - event.cash_difference"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
