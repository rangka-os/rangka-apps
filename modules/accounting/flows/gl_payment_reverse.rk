# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
# The opposite of every line the document posted, on the post's own date, so a cancelled document nets to 0
# in its period. A document submitted before the accounting module was installed posted nothing and is not
# reversed. Amending posts the new document again.
name: gl_payment_reverse
label: {id: Jurnal pembayaran dibatalkan}
on: payment.cancelled
steps:
  - find_all: gl_entry
    where: voucher_type == event.model && voucher == event.name && entry == 'post'
    sort: line
    as: posts
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: posts.size() > 0
    set:
      posting_date: posts[0].posting_date
      account: posts[0].account
      amount: 0 - posts[0].amount
      voucher_type: posts[0].voucher_type
      voucher: posts[0].voucher
      entry: "'reverse'"
      line: posts[0].line
      reverses: posts[0].name
      outlet: posts[0].outlet
      project: posts[0].project
      party: posts[0].party
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: posts.size() > 1
    set:
      posting_date: posts[1].posting_date
      account: posts[1].account
      amount: 0 - posts[1].amount
      voucher_type: posts[1].voucher_type
      voucher: posts[1].voucher
      entry: "'reverse'"
      line: posts[1].line
      reverses: posts[1].name
      outlet: posts[1].outlet
      project: posts[1].project
      party: posts[1].party
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: posts.size() > 2
    set:
      posting_date: posts[2].posting_date
      account: posts[2].account
      amount: 0 - posts[2].amount
      voucher_type: posts[2].voucher_type
      voucher: posts[2].voucher
      entry: "'reverse'"
      line: posts[2].line
      reverses: posts[2].name
      outlet: posts[2].outlet
      project: posts[2].project
      party: posts[2].party
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: posts.size() > 3
    set:
      posting_date: posts[3].posting_date
      account: posts[3].account
      amount: 0 - posts[3].amount
      voucher_type: posts[3].voucher_type
