  - create: gl_entry
    if: posts.size() > 9
    set:
      posting_date: posts[9].posting_date
      account: posts[9].account
      amount: 0 - posts[9].amount
      voucher_type: posts[9].voucher_type
      voucher: posts[9].voucher
      entry: "'reverse'"
      line: posts[9].line
      reverses: posts[9].name
      outlet: posts[9].outlet
      project: posts[9].project
      party: posts[9].party
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
