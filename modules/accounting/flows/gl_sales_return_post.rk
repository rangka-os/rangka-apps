# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_sales_return_post
label: {id: Jurnal retur penjualan (stok)}
on: sales_return.submitted
steps:
  - find_all: stock_move
    where: voucher_type == event.model && voucher == event.name
    as: moves
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(moves.map(m, m.value).sum()) != 0"
    set:
      posting_date: "moves.size() > 0 ? moves[0].posting_date : today()"
      account: "'11400'"
      amount: "moves.map(m, m.value).sum()"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - moves.map(m, m.value).sum()) != 0"
    set:
      posting_date: "moves.size() > 0 ? moves[0].posting_date : today()"
      account: "'51100'"
      amount: "0 - moves.map(m, m.value).sum()"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
