# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_timesheet_post
label: {id: Jurnal upah proyek}
on: timesheet.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.cost_amount) != 0"
    set:
      posting_date: "event.work_date"
      account: "'51300'"
      amount: "event.cost_amount"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      project: "event.project"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.cost_amount) != 0"
    set:
      posting_date: "event.work_date"
      account: "'21500'"
      amount: "0 - event.cost_amount"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      project: "event.project"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
