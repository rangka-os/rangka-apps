# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_sales_invoice_post
label: {id: Jurnal faktur penjualan}
on: sales_invoice.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.amount_due) != 0"
    set:
      posting_date: "event.posting_date"
      account: "'11300'"
      amount: "event.amount_due"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.retention_amount) != 0"
    set:
      posting_date: "event.posting_date"
      account: "'11320'"
      amount: "event.retention_amount"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.pph23_amount) != 0"
    set:
      posting_date: "event.posting_date"
      account: "'11510'"
      amount: "event.pph23_amount"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'3'"
      outlet: "event.outlet"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.down_payment) != 0"
    set:
      posting_date: "event.posting_date"
      account: "'21400'"
      amount: "event.down_payment"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'4'"
      outlet: "event.outlet"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - (event.subtotal - event.discount_amount)) != 0"
    set:
      posting_date: "event.posting_date"
      account: "event.kind == 'down_payment' ? '21400' : (event.kind == 'retention' ? '11320' : '41100')"
      amount: "0 - (event.subtotal - event.discount_amount)"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'5'"
      outlet: "event.outlet"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.ppn) != 0"
    set:
      posting_date: "event.posting_date"
      account: "'21200'"
      amount: "0 - event.ppn"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'6'"
      outlet: "event.outlet"
      project: "event.project"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
