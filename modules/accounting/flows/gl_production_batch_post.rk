# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_production_batch_post
label: {id: Jurnal produksi}
on: production_batch.submitted
steps:
  - find_all: stock_move
    where: voucher_type == event.model && voucher == event.name
    as: moves
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(moves.map(m, m.value).sum()) != 0"
    set:
      posting_date: "event.production_date"
      account: "'11400'"
      amount: "moves.map(m, m.value).sum()"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - moves.map(m, m.value).sum()) != 0"
    set:
      posting_date: "event.production_date"
      account: "'51200'"
      amount: "0 - moves.map(m, m.value).sum()"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.labour_cost) != 0"
    set:
      posting_date: "event.production_date"
      account: "'51300'"
      amount: "event.labour_cost"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'3'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.labour_cost) != 0"
    set:
      posting_date: "event.production_date"
      account: "'21500'"
      amount: "0 - event.labour_cost"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'4'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
