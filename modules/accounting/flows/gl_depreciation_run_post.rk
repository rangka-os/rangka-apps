# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_depreciation_run_post
label: {id: Jurnal penyusutan bulanan}
description: {id: 'Saat penyusutan bulanan diajukan, beban penyusutan tiap aset masuk pembukuan di akhir bulan, per cabang.'}
on: depreciation_run.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - for_each: "event.lines"
    as: l
    do:
      - create: gl_entry
        if: "(l.amount) != 0"
        set:
          posting_date: "event.posting_date"
          account: "'61950'"
          amount: "l.amount"
          voucher_type: event.model
          voucher: event.name
          entry: "'post'"
          line: "'1-' + string(l.idx)"
          outlet: "l.outlet"
          project: "l.project"
          party: "l.asset"
          lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
      - create: gl_entry
        if: "(0 - l.amount) != 0"
        set:
          posting_date: "event.posting_date"
          account: "'12900'"
          amount: "0 - l.amount"
          voucher_type: event.model
          voucher: event.name
          entry: "'post'"
          line: "'2-' + string(l.idx)"
          outlet: "l.outlet"
          project: "l.project"
          party: "l.asset"
          lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
