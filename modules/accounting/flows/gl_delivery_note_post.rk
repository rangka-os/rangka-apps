# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_delivery_note_post
label: {id: Jurnal surat jalan}
on: delivery_note.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.cogs_total) != 0"
    set:
      posting_date: "event.delivery_date"
      account: "'51100'"
      amount: "event.cogs_total"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.cogs_total) != 0"
    set:
      posting_date: "event.delivery_date"
      account: "'11400'"
      amount: "0 - event.cogs_total"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      party: "event.customer"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
