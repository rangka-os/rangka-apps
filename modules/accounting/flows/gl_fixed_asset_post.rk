# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_fixed_asset_post
label: {id: Jurnal aset tetap}
on: fixed_asset.submitted
if: "event.source != 'vendor_bill'"
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.cost) != 0"
    set:
      posting_date: "event.book_date"
      account: "'12100'"
      amount: "event.cost"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      project: "event.project"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.opening_accumulated) != 0"
    set:
      posting_date: "event.book_date"
      account: "'12900'"
      amount: "0 - event.opening_accumulated"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      project: "event.project"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - (event.cost - event.opening_accumulated)) != 0"
    set:
      posting_date: "event.book_date"
      account: "event.source == 'opening' ? '31900' : (event.paid_from == 'bank' ? '11200' : '11100')"
      amount: "0 - (event.cost - event.opening_accumulated)"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'3'"
      outlet: "event.outlet"
      project: "event.project"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
