# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_opening_balance_post
label: {id: Jurnal saldo awal}
on: opening_balance.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.cash) != 0"
    set:
      posting_date: "event.opening_date"
      account: "'11100'"
      amount: "event.cash"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.bank) != 0"
    set:
      posting_date: "event.opening_date"
      account: "'11200'"
      amount: "event.bank"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.receivable) != 0"
    set:
      posting_date: "event.opening_date"
      account: "'11300'"
      amount: "event.receivable"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'3'"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.inventory) != 0"
    set:
      posting_date: "event.opening_date"
      account: "'11400'"
      amount: "event.inventory"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'4'"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.fixed_assets) != 0"
    set:
      posting_date: "event.opening_date"
      account: "'12100'"
      amount: "event.fixed_assets"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'5'"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.accumulated_depreciation) != 0"
    set:
      posting_date: "event.opening_date"
      account: "'12900'"
      amount: "0 - event.accumulated_depreciation"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'6'"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.payable) != 0"
    set:
      posting_date: "event.opening_date"
      account: "'21100'"
      amount: "0 - event.payable"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'7'"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.bank_loan) != 0"
    set:
      posting_date: "event.opening_date"
      account: "'22100'"
      amount: "0 - event.bank_loan"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'8'"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.other_liabilities) != 0"
    set:
      posting_date: "event.opening_date"
      account: "'21900'"
      amount: "0 - event.other_liabilities"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'9'"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.paid_in_capital) != 0"
    set:
      posting_date: "event.opening_date"
      account: "'31100'"
      amount: "0 - event.paid_in_capital"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'10'"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - (event.cash + event.bank + event.receivable + event.inventory + event.fixed_assets - event.accumulated_depreciation - event.payable - event.bank_loan - event.other_liabilities - event.paid_in_capital)) != 0"
    set:
      posting_date: "event.opening_date"
      account: "'31900'"
      amount: "0 - (event.cash + event.bank + event.receivable + event.inventory + event.fixed_assets - event.accumulated_depreciation - event.payable - event.bank_loan - event.other_liabilities - event.paid_in_capital)"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'11'"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
