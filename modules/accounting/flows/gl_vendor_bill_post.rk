# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_vendor_bill_post
label: {id: Jurnal tagihan pemasok}
on: vendor_bill.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.dpp) != 0"
    set:
      posting_date: "event.bill_date"
      account: "((event.posting != null ? event.posting : (event.project != '' ? 'project' : ((event.goods_receipt != '' || event.purchase_order != '') && app_installed('stock') ? 'stock' : 'expense')))) == 'project' ? '51400' : (((event.posting != null ? event.posting : (event.project != '' ? 'project' : ((event.goods_receipt != '' || event.purchase_order != '') && app_installed('stock') ? 'stock' : 'expense')))) == 'stock' ? '21150' : (event.expense_account != null ? event.expense_account : '61900'))"
      amount: "event.dpp"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      project: "event.project"
      party: "event.vendor"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.ppn) != 0"
    set:
      posting_date: "event.bill_date"
      account: "tax.pkp ? '11500' : (((event.posting != null ? event.posting : (event.project != '' ? 'project' : ((event.goods_receipt != '' || event.purchase_order != '') && app_installed('stock') ? 'stock' : 'expense')))) == 'stock' ? '51100' : (((event.posting != null ? event.posting : (event.project != '' ? 'project' : ((event.goods_receipt != '' || event.purchase_order != '') && app_installed('stock') ? 'stock' : 'expense')))) == 'project' ? '51400' : (((event.posting != null ? event.posting : (event.project != '' ? 'project' : ((event.goods_receipt != '' || event.purchase_order != '') && app_installed('stock') ? 'stock' : 'expense')))) == 'stock' ? '21150' : (event.expense_account != null ? event.expense_account : '61900'))))"
      amount: "event.ppn"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      project: "event.project"
      party: "event.vendor"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.amount_due) != 0"
    set:
      posting_date: "event.bill_date"
      account: "'21100'"
      amount: "0 - event.amount_due"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'3'"
      project: "event.project"
      party: "event.vendor"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.pph23_amount) != 0"
    set:
      posting_date: "event.bill_date"
      account: "'21300'"
      amount: "0 - event.pph23_amount"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'4'"
      project: "event.project"
      party: "event.vendor"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
