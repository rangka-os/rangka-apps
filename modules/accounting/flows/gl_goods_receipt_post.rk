# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_goods_receipt_post
label: {id: Jurnal terima barang}
on: goods_receipt.submitted
if: "app_installed('stock')"
steps:
  - find: vendor
    where: name == event.vendor
    as: v
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.total_value) != 0"
    set:
      posting_date: "event.received_on"
      account: "'11400'"
      amount: "event.total_value"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      party: "event.vendor"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.total_value) != 0"
    set:
      posting_date: "event.received_on"
      account: "v != null && v.vendor_name == 'Saldo awal' ? '31900' : '21150'"
      amount: "0 - event.total_value"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      party: "event.vendor"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
