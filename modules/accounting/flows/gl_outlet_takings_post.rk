# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
name: gl_outlet_takings_post
label: {id: Jurnal setoran outlet}
on: outlet_takings.submitted
steps:
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - create: gl_entry
    if: "(event.lines.filter(l, l.method == 'cash').map(l, l.received).sum()) != 0"
    set:
      posting_date: "event.date"
      account: "'11100'"
      amount: "event.lines.filter(l, l.method == 'cash').map(l, l.received).sum()"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'1'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.received_total - (event.lines.filter(l, l.method == 'cash').map(l, l.received).sum())) != 0"
    set:
      posting_date: "event.date"
      account: "'11200'"
      amount: "event.received_total - (event.lines.filter(l, l.method == 'cash').map(l, l.received).sum())"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'2'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(event.fee_total) != 0"
    set:
      posting_date: "event.date"
      account: "'61200'"
      amount: "event.fee_total"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'3'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.expected_total) != 0"
    set:
      posting_date: "event.date"
      account: "'11150'"
      amount: "0 - event.expected_total"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'4'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
  - create: gl_entry
    if: "(0 - event.difference_total) != 0"
    set:
      posting_date: "event.date"
      account: "'61300'"
      amount: "0 - event.difference_total"
      voucher_type: event.model
      voucher: event.name
      entry: "'post'"
      line: "'5'"
      outlet: "event.outlet"
      lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
