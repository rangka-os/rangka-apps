# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Generated by scripts/gen_accounting_flows.py; edit POSTINGS there, not this file.
# The opposite of every line the document posted, on the post's own date, so a cancelled document nets to 0
# in its period. A document submitted before the accounting module was installed posted nothing and is not
# reversed. Amending posts the new document again.
name: gl_depreciation_run_reverse
label: {id: Jurnal penyusutan bulanan dibatalkan}
on: depreciation_run.cancelled
steps:
  - find_all: gl_entry
    where: voucher_type == event.model && voucher == event.name && entry == 'post'
    sort: line
    as: posts
  - find_all: period_close
    where: docstatus == 1
    sort: -closed_until
    limit: 1
    as: locks
  - for_each: posts
    as: p
    do:
      - create: gl_entry
        set:
          posting_date: p.posting_date
          account: p.account
          amount: 0 - p.amount
          voucher_type: p.voucher_type
          voucher: p.voucher
          entry: "'reverse'"
          line: p.line
          reverses: p.name
          outlet: p.outlet
          project: p.project
          party: p.party
          against: p.against
          lock_date: "locks.size() > 0 ? locks[0].closed_until : null"
