# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/module.json
name: accounting
version: 1.3.2
title: {id: Akuntansi, en: Accounting}
summary:
  id: Jurnal, saldo awal, tutup buku dan laporan keuangan dari transaksi yang sudah dicatat.
  en: Journals, opening balances, period close and financial reports from recorded transactions.
category: finance
icon: book-2-line
# Books kept from the documents, never typed by hand: every submitted document that moves money, stock or tax writes
# its lines into gl_entry (append-only, contract 0026) through the flows in flows/, generated by
# scripts/gen_accounting_flows.py from one table of postings. A cancel writes the opposite lines on the original
# date. Laporan keuangan (financial_report) sums the lines into a profit and loss, a balance sheet and a cash
# summary (SAK EMKM). Tutup buku (period_close) locks every date up to closed_until.
requires: {rangka: '>=0.5', users: ^1.2}
optional: {contacts: ^1.0, outlets: ^1.0, invoicing: ^1.0, payments: ^1.0, procurement: ^1.0, stock: ^1.0, outlet_sales: ^1.0, projects: ^1.0, delivery: ^1.0, production: ^1.0, consignment: ^1.0, rental: ^1.0, pos: ^1.0}
