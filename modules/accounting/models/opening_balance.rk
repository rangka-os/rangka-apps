# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: opening_balance
label: {id: Saldo awal, en: Opening balance}
icon: book
is_submittable: true
naming: SA-{YYYY}-{####}
title_field: opening_date
# The balance sheet the business starts from, entered once (or imported with opening_balance_sheet). Submitting posts
# each amount to its account; the difference goes to Ekuitas saldo awal (3-1900).
# - A new business: stock comes in through the import opening_stock (a goods receipt from the vendor "Saldo awal",
#   journaled against 3-1900), so leave Persediaan at 0 here.
# - A business already using Juragan before this module was installed: its stock, unpaid invoices and unpaid bills
#   have no journal. Enter, on the day before the module was installed, Persediaan = the stock value then
#   (stock_balance), Piutang = what customers still owed on those invoices, Utang = what is still owed on those bills,
#   so later sales, payments and cancels move these balances from the right starting point.
permissions:
  - {role: finance_manager, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, export: true, print: true, import: true}
  - {role: head_office, read: true, create: true, write: true, delete: true, submit: true, cancel: true, amend: true, export: true, print: true, import: true}
fields:
  - {name: opening_date, type: date, label: {id: Tanggal saldo awal}, required: true, in_list: true}
  - {name: cash, type: currency, label: {id: Kas}, default: '0'}
  - {name: bank, type: currency, label: {id: Bank}, default: '0'}
  - {name: receivable, type: currency, label: {id: Piutang usaha belum dibayar}, default: '0'}
  - {name: inventory, type: currency, label: {id: Persediaan (hanya bila stok sudah ada sebelum pembukuan)}, default: '0'}
  - {name: fixed_assets, type: currency, label: {id: Aset tetap (harga beli)}, default: '0'}
  - {name: accumulated_depreciation, type: currency, label: {id: Akumulasi penyusutan}, default: '0'}
  - {name: payable, type: currency, label: {id: Utang usaha belum dibayar}, default: '0'}
  - {name: bank_loan, type: currency, label: {id: Utang bank}, default: '0'}
  - {name: other_liabilities, type: currency, label: {id: Utang lain-lain}, default: '0'}
  - {name: paid_in_capital, type: currency, label: {id: Modal disetor}, default: '0'}
  - name: opening_equity
    type: currency
    label: {id: Ekuitas saldo awal (selisih)}
    compute: cash + bank + receivable + inventory + fixed_assets - accumulated_depreciation - payable - bank_loan - other_liabilities - paid_in_capital
    in_list: true
  - {name: notes, type: text, label: {id: Catatan}}
rules:
  - name: amounts_not_negative
    on: save
    check: cash >= 0 && bank >= 0 && receivable >= 0 && inventory >= 0 && fixed_assets >= 0 && accumulated_depreciation >= 0 && payable >= 0 && bank_loan >= 0 && other_liabilities >= 0 && paid_in_capital >= 0
    message: {id: Isi saldo sebagai angka positif; arah debit dan kredit diatur otomatis}
  - name: depreciation_within_assets
    on: save
    check: accumulated_depreciation <= fixed_assets
    message: {id: Akumulasi penyusutan tidak boleh melebihi harga beli aset tetap}
views:
  list:
    columns: [name, opening_date, opening_equity, status]
