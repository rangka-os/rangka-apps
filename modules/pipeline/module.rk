# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/module.json
name: pipeline
version: 1.0.0
title: {id: Pipeline penjualan, en: Sales pipeline}
summary:
  id: Lead, peluang dan aktivitas penjualan sampai closing.
  en: Leads, deals and sales activities through to closing.
category: sales
icon: funnel-line
