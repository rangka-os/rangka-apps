# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
# One sales source per outlet and day (Jalur A: a daily sales record or setoran; Jalur B: the cashier). The guards of
# pos and outlet_sales read and write this record, which lives in outlets: it stays installed with either source, so
# the day keeps its source when one of the two apps is removed mid-day (audit rangka-apps#74 L1: removing
# outlet_sales let the cashier record a day that already had a daily sales record). Written by flows only; source ''
# means every document of that day was cancelled, the day is free again.
name: outlet_day
label: {id: Sumber penjualan harian outlet, en: Outlet day sales source}
icon: calendar-check
naming: ODY-{######}
title_field: day_key
permissions:
  - {role: head_office, read: true, create: true, write: true}
  - {role: outlet_staff, read: true, create: true, write: true}
  - {role: cashier, read: true, create: true, write: true}
fields:
  - {name: outlet, type: link, to: outlet, label: {id: Outlet}, required: true}
  - {name: date, type: date, label: {id: Tanggal}, required: true}
  - name: source
    type: select
    label: {id: Sumber}
    options:
      - {value: harian, label: {id: 'Penjualan harian (form, Moka, file) atau setoran'}}
      - {value: kasir, label: {id: Kasir}}
  - {name: document, type: data, label: {id: Dokumen pertama}}
  # outlet|date, once per outlet and day (two sources at the same moment: the second write fails and rolls back)
  - {name: day_key, type: data, label: {id: Kunci hari}, required: true, unique: true}
