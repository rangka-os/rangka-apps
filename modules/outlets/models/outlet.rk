# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: outlet
naming: OUT-{##}
label: {id: Outlet}
icon: store
title_field: outlet_name
permissions:
  - {role: sales_manager, read: true, create: true, write: true, print: true}
  - {role: finance_manager, read: true, create: true, write: true, print: true}
  - {role: purchasing_manager, read: true, create: true, write: true, print: true}
  - {role: project_admin, read: true, create: true, write: true, print: true}
  - {role: head_office, read: true, create: true, write: true, print: true}
  - {role: outlet_staff, read: true}
  - {role: sales_rep, read: true}
  - {role: field_sales, read: true}
  - {role: cashier, read: true}
fields:
  - name: outlet_name
    type: data
    label: {id: Nama outlet}
    required: true
    in_list: true
  - name: code
    type: data
    label: {id: Kode}
    in_list: true
    unique: true
  - name: city
    type: data
    label: {id: Kota}
    in_list: true
  - name: address
    type: text
    label: {id: Alamat}
  - name: is_head_office
    type: check
    label: {id: Kantor pusat}
  - name: active
    type: check
    label: {id: Aktif}
    default: 'true'
  # Moka's Item Details export names the outlet in its Outlet column; outlet_sales checks each Moka file against it.
  - name: moka_name
    type: data
    label: {id: Nama outlet di Moka}
    help: {id: 'Persis seperti kolom Outlet di ekspor Moka, misalnya "Tahu Contoh - Dago". Kosongkan kalau outlet ini tidak pakai Moka'}
    depends_on: app_installed('outlet_sales')
  # The sales source of an outlet without Moka (moka_name empty): the daily form (default when empty), a file from
  # another POS in Juragan's template, a Loyverse export, or Juragan's own cashier (module pos). One source per outlet,
  # so a day is never counted twice.
  - name: sales_source
    type: select
    label: {id: Sumber penjualan}
    help: {id: 'Untuk outlet yang tidak pakai Moka. Kosong berarti formulir harian'}
    depends_on: app_installed('outlet_sales') && moka_name == ''
    options:
      - {value: form, label: {id: Formulir harian}}
      - {value: file, label: {id: File POS (template Juragan)}}
      - {value: loyverse, label: {id: Loyverse}}
      # module pos: the outlet sells through Juragan's own cashier, so no daily form or POS file is taken for it
      - {value: kasir, label: {id: Kasir Juragan}}

rules:
  # The code is part of document numbers (cashier receipts STRK-<code>-..., kernel contract 0009 §2a), which take it
  # as it is: capital letters and digits, parts joined by "-".
  - name: code_shape
    on: save
    check: "code == '' || code.matches('^[A-Z0-9]+(-[A-Z0-9]+)*$')"
    message: {id: 'Kode outlet hanya huruf besar dan angka, boleh dipisah tanda -, misalnya DGO atau BDG-1'}
