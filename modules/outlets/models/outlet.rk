# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: outlet
naming: OUT-{##}
label: {id: Outlet}
icon: store
title_field: outlet_name
permissions:
  - {role: sales_manager, read: true, create: true, write: true, print: true}
  - {role: finance_manager, read: true, create: true, write: true, print: true}
  - {role: purchasing_manager, read: true, create: true, write: true, print: true}
  - {role: project_admin, read: true, create: true, write: true, print: true}
  - {role: head_office, read: true, create: true, write: true, print: true}
  - {role: outlet_staff, read: true}
  - {role: sales_rep, read: true}
  - {role: field_sales, read: true}
  - {role: cashier, read: true}
fields:
  - name: outlet_name
    type: data
    label: {id: Nama outlet}
    required: true
    in_list: true
  - name: code
    type: data
    label: {id: Kode}
    in_list: true
    unique: true
  - name: city
    type: data
    label: {id: Kota}
    in_list: true
  - name: address
    type: text
    label: {id: Alamat}
  - name: is_head_office
    type: check
    label: {id: Kantor pusat}
  - name: active
    type: check
    label: {id: Aktif}
    default: 'true'
  # Moka's Item Details export names the outlet in its Outlet column; outlet_sales checks each Moka file against it.
  - name: moka_name
    type: data
    label: {id: Nama outlet di Moka}
    help: {id: 'Persis seperti kolom Outlet di ekspor Moka, misalnya "Tahu Contoh - Dago". Kosongkan kalau outlet ini tidak pakai Moka'}
    depends_on: app_installed('outlet_sales')
  # Moka's outlet id (connector moka, rangka-connectors): the poll per outlet emits it with every transaction, and flow
  # moka_transaction_staged finds the outlet by it, else by moka_name (Moka's outlet name). While the moka connector is
  # switched on, every outlet whose id or name matches receives its API sales; an outlet that should keep the export
  # only is left out of the connector in Moka (or its moka_name differs from Moka's).
  - name: moka_outlet_id
    type: data
    label: {id: ID outlet di Moka}
    help: {id: 'Diisi saat Moka tersambung lewat API. Selama connector Moka aktif, outlet juga dicocokkan lewat Nama outlet di Moka'}
    depends_on: app_installed('outlet_sales') && moka_name != ''
  # The gate from the export to the API (audit sisa-1111 R1): flow moka_transaction_staged books a transaction of this
  # outlet only when its day is on or after this date; before it (or while empty) the outlet's Moka sales come from
  # the Item Details export alone, so a day is never counted from both. Set it to the first day the API should count,
  # after the last exported day. The kernel follows Moka's next_url since rangka-os t_277ba9bf, so the API reads the
  # whole two-day window of every poll.
  - name: moka_api_from
    type: date
    label: {id: Mulai pakai API Moka}
    help: {id: 'Hari pertama penjualan diambil lewat API Moka (sesudah ekspor terakhir). Kosong = tetap ekspor'}
    depends_on: app_installed('outlet_sales') && moka_name != ''
  # The sales source of an outlet without Moka (moka_name empty): the daily form (default when empty), a file from
  # another POS in Juragan's template, a Loyverse export, or Juragan's own cashier (module pos). One source per outlet,
  # so a day is never counted twice. With module pos installed a new outlet without Moka starts on the cashier (a site
  # built with app kasir next to an outlet_sales app can ring up at once); head office switches it per outlet.
  - name: sales_source
    type: select
    label: {id: Sumber penjualan}
    help: {id: 'Untuk outlet yang tidak pakai Moka. Kosong berarti formulir harian'}
    depends_on: app_installed('outlet_sales') && moka_name == ''
    default: "app_installed('pos') && moka_name == '' ? 'kasir' : ''"
    options:
      - {value: form, label: {id: Formulir harian}}
      - {value: file, label: {id: File POS (template Juragan)}}
      - {value: loyverse, label: {id: Loyverse}}
      # module pos: the outlet sells through Juragan's own cashier, so no daily form or POS file is taken for it
      - {value: kasir, label: {id: Kasir Juragan}}

  # module pos: the float a cashier shift opens with at this outlet, set by head office; 0 = the cashier types it
  - name: cash_float
    type: currency
    label: {id: Modal kas kasir}
    help: {id: 'Uang kembalian di laci tiap sesi kasir dibuka. Kosongkan kalau kasir yang mengisi'}
    depends_on: app_installed('pos')
rules:
  # The code is part of document numbers (cashier receipts STRK-<code>-..., kernel contract 0009 §2a), which take it
  # as it is: capital letters and digits, parts joined by "-".
  - name: code_shape
    on: save
    check: "code == '' || code.matches('^[A-Z0-9]+(-[A-Z0-9]+)*$')"
    message: {id: 'Kode outlet hanya huruf besar dan angka, boleh dipisah tanda -, misalnya DGO atau BDG-1'}
