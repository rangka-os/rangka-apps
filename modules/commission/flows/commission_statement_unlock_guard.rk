# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Unticking "Kunci rekap" after the lines were attached is turned back: a locked statement is released with "Batal", which
# also checks that no submitted payslip of the tax month paid it.
name: commission_statement_unlock_guard
label: {id: Rekap komisi tidak bisa dibuka kuncinya}
on: commission_statement.updated
if: "!event.locked && event.done && !event.cancelled"
steps:
  - find: commission_statement
    where: name == event.name
    as: me
  - update: me
    set: {locked: 'true'}
