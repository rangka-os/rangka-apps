# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: shift_roster_unpublish
label: {id: 'Jadwal mingguan dibatalkan: hari yang belum lewat ditarik dari jadwal karyawan'}
# Today and later days this roster published become unpublished (the employee no longer sees them, a clock-in no longer
# links to them). Past days stay as they were. An amended roster submitted afterwards publishes them again.
on: shift_roster.cancelled
if: "'docstatus' in event && event.docstatus == 2"
steps:
  - find_all: shift_assignment
    where: roster == event.name && work_date >= today() && published
    as: days
  - for_each: days
    as: d
    do:
      - update: d
        set: {published: "false"}
