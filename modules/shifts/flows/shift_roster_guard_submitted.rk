# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: shift_roster_guard_submitted
label: {id: Satu jadwal mingguan terbit per outlet per minggu}
# Two published rosters of the same outlet and week would overwrite each other day by day. An amended roster is
# submitted after its original was cancelled, so it passes. Runs before shift_roster_publish (flows run by name).
on: shift_roster.submitted
if: "'docstatus' in event && event.docstatus == 1"
steps:
  - find: shift_roster
    where: week_key == event.week_key && docstatus == 1 && name != event.name
    as: other
  - if: other != null
    create: shift_guard
    set:
      reason: "'roster_exists'"
      document: other.name
