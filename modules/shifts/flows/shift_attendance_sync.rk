# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: shift_attendance_sync
label: {id: 'Kehadiran jadwal shift: hadir, terlambat, atau tidak hadir'}
# Every hour (scheduler.timezone), and by head office from the flow list: published working shifts of the last three
# days that are still planned or absent get the clock-in linked to them (staff_attendance.work_shift, flow
# shift_attendance_link) and its lateness, as present or late. A shift whose end has passed without a clock-in is
# absent; a clock-in entered later (a manual correction by head office) turns it present on the next run. Leave
# (rangka-apps#114) is not read yet: a day on leave shows absent until leave lands. Runs as the scheduler, so it writes
# the outcome no member can write by hand. At most 500 shifts per run.
schedule: '7 * * * *'
if: "app_installed('attendance')"
steps:
  - find_all: shift_assignment
    where: "published && !day_off && (outcome == 'planned' || outcome == 'absent') && work_date <= today() && days_between(work_date, today()) <= 2"
    sort: work_date
    limit: 500
    as: due
  - for_each: due
    as: a
    do:
      - find: staff_attendance
        where: work_shift == a.name && docstatus != 2 && clock_in != ''
        as: log
      - if: log != null
        update: a
        set:
          attendance: log.name
          clock_in: log.clock_in
          late_min: log.late_min
          outcome: "log.late_min > 0 ? 'late' : 'present'"
      - if: "log == null && a.outcome == 'planned' && a.end_at != '' && epoch(now()) > epoch(a.end_at)"
        update: a
        set:
          outcome: "'absent'"
