# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: customer_order_item
is_child: true
fields:
  - name: item
    type: link
    to: item
    label: {id: Barang/jasa}
    required: true
  - name: description
    type: text
    label: {id: Uraian}
    default: item.item_name
  - name: qty
    type: float
    label: {id: Qty}
    default: '1'
  - name: uom
    type: link
    to: uom
    label: {id: Satuan}
    default: "item.sales_uom != '' ? item.sales_uom : item.stock_uom"
  # Tier pricing (module distribution): price_tier is set from the order by the flow order_tier_pricing, which then
  # sets rate to list_rate once per tier (tier_applied), so a price typed by hand afterwards stays.
  - name: price_tier
    type: data
    label: {id: Tier harga}
    default: "'retail'"
    read_only: true
    depends_on: app_installed('distribution')
  - name: tier_applied
    type: data
    label: {id: Tier yang sudah dipakai}
    default: "'retail'"
    read_only: true
    depends_on: app_installed('distribution')
  - name: list_rate
    type: currency
    label: {id: Harga daftar}
    compute: "price_tier == 'agent' && item.rate_agent > 0 ? item.rate_agent : (price_tier == 'wholesale' && item.rate_wholesale > 0 ? item.rate_wholesale : item.rate)"
    depends_on: app_installed('distribution')
  - name: rate
    type: currency
    label: {id: Harga}
    default: item.rate
  - name: amount
    type: currency
    label: {id: Jumlah}
    compute: round(qty * rate)
  # The workers' wages line, carried from the quotation and on to the invoice by the kernel conversions: outside the
  # PPh 23 base and, with config tax.ppn_fee_only, outside the PPN base (PMK 83/2012).
  - name: pph23_exclude
    type: check
    label: {id: Bukan dasar PPh 23}
    default: 'false'
  - name: ppn_exclude
    type: check
    label: {id: Upah tenaga kerja (di luar dasar PPN)}
    default: 'false'
