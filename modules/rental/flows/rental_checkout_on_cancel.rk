# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: rental_checkout_on_cancel
label: {id: Alat keluar dibatalkan}
# A checkout entered by mistake: the schedule goes back to booked, refused once the equipment is recorded as returned.
# Its units go back to the warehouse (refused for a unit that another document has moved since).
on: rental_checkout.cancelled
steps:
  - {find: rental_schedule, where: booking == event.booking, as: s}
  - create: rental_guard
    if: s == null || s.state != 'out' || s.checkout != event.name
    set: {reason: "'already_returned'", document: event.name}
  - update: s
    if: s != null
    set: {state: "'booked'", out_date: "null", checkout: "''"}
  - for_each: event.units
    as: row
    do:
      - {find: rental_unit, where: name == row.unit, as: u}
      - create: rental_guard
        if: "u == null || u.state != 'out' || u.booking != event.booking || u.last_checkout != event.name"
        set: {reason: "'unit_moved'", document: event.name}
      - update: u
        if: u != null
        set: {state: "'in'", booking: "''", last_checkout: "''"}
