# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: rental_item
label: {id: Alat sewa, en: Rental item}
icon: stock
naming: ALT-{####}
title_field: title
# A catalogue item rented out by the day: how many units there are, the rate per unit per day, the deposit per unit
# and the late fee per unit per day. A booking copies the rate, deposit and late fee when it is made. With track_units
# on, its units are registered one by one (rental_unit) and every checkout and return lists which units, with a
# condition checklist, the customer's signature and a printed BAST (berita acara serah terima).
permissions:
  - {role: finance_manager, read: true, create: true, write: true, export: true, print: true}
  - {role: sales_manager, read: true, export: true}
  - {role: rental_staff, read: true}
  - {role: head_office, read: true, export: true}
fields:
  - name: item
    type: link
    to: item
    label: {id: Barang}
    required: true
    unique: true
    in_list: true
  - name: title
    type: data
    label: {id: Nama alat}
    compute: item.item_name
    in_list: true
  - name: units
    type: int
    label: {id: Jumlah unit}
    required: true
    default: '1'
    in_list: true
  - name: daily_rate
    type: currency
    label: {id: Tarif per hari}
    required: true
    in_list: true
  - name: deposit_per_unit
    type: currency
    label: {id: Deposit per unit}
    default: '0'
    in_list: true
  - name: late_fee_per_day
    type: currency
    label: {id: Denda telat per hari}
    help: {id: Per unit untuk setiap hari lewat dari tanggal kembali}
    default: '0'
  - name: track_units
    type: check
    label: {id: Serah terima per unit}
    help: {id: 'Nyalakan kalau tiap unit punya kode atau nomor seri: alat keluar dan kembali wajib mencatat unit, kondisi, dan nama penyewa'}
    default: 'false'
  - name: active
    type: check
    label: {id: Masih disewakan}
    default: 'true'
  - name: notes
    type: text
    label: {id: Catatan}
rules:
  - name: units_positive
    on: save
    check: units > 0
    message: {id: Jumlah unit minimal 1}
  - name: money_not_negative
    on: save
    check: daily_rate >= 0 && deposit_per_unit >= 0 && late_fee_per_day >= 0
    message: {id: 'Tarif, deposit, dan denda tidak boleh minus'}
views:
  list:
    columns: [name, title, units, daily_rate, deposit_per_unit, late_fee_per_day]
    filters: [active]
    sort: name
  form:
    layout:
      - section: {id: Alat}
        columns:
          - [item, title, units, track_units, active]
          - [daily_rate, deposit_per_unit, late_fee_per_day]
      - section: {id: Catatan}
        fields: [notes]
