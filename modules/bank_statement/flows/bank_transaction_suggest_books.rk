# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# After bank_transaction_suggest (same event, later in name order), when the books are kept (accounting): an invoice
# suggested by the amount alone is taken back when the books show money on the bank that may be this very line. That is
# money a document other than a payment put on 1-1200 (a shop's takings by QRIS or card, a cashier shift closed with
# QRIS, a rental deposit by transfer), posted in the 7 days up to the line's date, not reversed, at least the line's
# amount (a takings entry carries every non-cash channel of the day in one amount, and the bank settles each channel on
# its own). The line stays Belum cocok and the owner decides: pick the invoice, or set it aside (Abaikan) as money
# already on the books. Opening balances are not such money.
# Why not suggest the document itself: a journal line does not say which statement line settles it (one entry for
# several channels, a shift against a daily settlement, an old document against a new transfer), so the owner could be
# offered the wrong one and the customer's transfer would never be booked (audit rel-uang-e2e r3 H4, H5).
# An invoice named in the note stays suggested: the customer said what the transfer is for.
name: bank_transaction_suggest_books
label: {id: Usulan faktur dari nominal ditahan bila ada setoran di bank}
on: bank_transaction.created
if: "app_installed('accounting') && event.amount > 0 && event.status == 'unmatched'"
steps:
  - {find: bank_transaction, where: name == event.name, as: line}
  # takings, closed shifts, deposits on the bank in the 7 days up to the line, at least the line's amount
  - find_all: gl_entry
    where: >-
      account == '11200' && entry == 'post' && amount >= event.amount && voucher_type != 'payment' &&
      voucher_type != 'opening_balance' && posting_date <= event.date && posting_date + duration(7) >= event.date
    as: near
  # their reversals (a cancelled takings): the same window, at least the line's amount back
  - find_all: gl_entry
    where: >-
      account == '11200' && entry == 'reverse' && amount <= 0 - event.amount && voucher_type != 'payment' &&
      voucher_type != 'opening_balance' && posting_date <= event.date && posting_date + duration(7) >= event.date
    as: back
  - find_all: sales_invoice
    where: >-
      docstatus == 1 && (event.description.contains(name) || event.description.upperAscii().replace(' ', '').replace('-', '').replace('/', '').replace('.', '')
      .contains(name.upperAscii().replace(' ', '').replace('-', '').replace('/', '').replace('.', '')))
    as: named
  - update: line
    if: "line != null && line.suggested_invoice != '' && size(near) > size(back) && named.map(i, i.name == line.suggested_invoice ? 1 : 0).sum() == 0"
    set: {suggested_invoice: "''", status: "'unmatched'"}
