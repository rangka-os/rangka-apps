# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# The amend of a payment that a statement line had is submitted while the line has moved on: it already has a
# payment, another live draft (confirmed again, maybe to another invoice), or a newer cancelled payment than the one
# amended (a chain: paid, cancelled, confirmed again, paid, cancelled). The submit is refused, because both would
# record the same transfer; only the amend of the line's latest cancelled payment may match it. The line is found by
# cancelled_payment, or by reference (confirming sets it to the line and amend copies it), which can only refuse more,
# never let more through. The refusal is the line's rule amend_refused, failed inside this run, which rolls the whole
# submit back. Runs before bank_transaction_matched (flows of one event run in name order).
name: bank_transaction_amend_guard
label: {id: Tolak amend pembayaran mutasi yang sudah diganti}
on: payment.submitted
if: event.direction == 'receive' && event.amended_from != ''
steps:
  - find: bank_transaction
    where: "(cancelled_payment != '' && cancelled_payment == event.amended_from) || (event.reference != '' && name == event.reference)"
    as: line
  - find: payment
    where: "line != null && line.draft_payment != '' && name == line.draft_payment && name != event.before.name && docstatus == 0"
    as: other
  - update: line
    if: line != null && (line.payment != '' || other != null || line.cancelled_payment != event.amended_from)
    set: {amend_refused: 'true'}
