# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# The amend of a payment that a statement line had (cancelled_payment) is submitted while the line already has a
# payment, or another live draft (confirmed again, maybe to another invoice): the submit is refused, because both
# would record the same transfer. The refusal is the line's rule amend_refused, failed inside this run, which rolls
# the whole submit back. Runs before bank_transaction_matched (flows of one event run in name order).
name: bank_transaction_amend_guard
label: {id: Tolak amend pembayaran mutasi yang sudah diganti}
on: payment.submitted
if: event.direction == 'receive' && event.amended_from != ''
steps:
  - {find: bank_transaction, where: "cancelled_payment != '' && cancelled_payment == event.amended_from", as: line}
  - find: payment
    where: "line != null && line.draft_payment != '' && name == line.draft_payment && name != event.before.name && docstatus == 0"
    as: other
  - update: line
    if: line != null && (line.payment != '' || other != null)
    set: {amend_refused: 'true'}
