# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# The payment drafted from a statement line is submitted: the line is matched. The draft's name changes on submit,
# so the line is found by the draft's name (event.before.name) in draft_payment, and only while the line is
# "Dikonfirmasi" and not matched yet. reference is free text that any payment can carry (and amend copies), so it
# never picks the line: another payment naming the line cannot take it over.
name: bank_transaction_matched
label: {id: Mutasi cocok saat pembayaran diajukan}
on: payment.submitted
if: event.direction == 'receive' && event.before != null
steps:
  - {find: bank_transaction, where: "draft_payment == event.before.name && status == 'confirmed' && payment == ''", as: line}
  - update: line
    if: line != null
    set: {status: "'matched'", payment: event.name, draft_payment: "''"}
