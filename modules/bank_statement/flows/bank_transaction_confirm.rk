# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# The owner sets a line to "Dikonfirmasi": draft a payment from the customer of the chosen invoice, for the line's
# amount, allocated to that invoice (up to what it still owes; any rest stays unallocated on the payment).
# The draft is submitted by a person (finance), which settles the invoice through payments.allocate.
# The draft goes into draft_payment (payment is only the submitted one, see bank_transaction_matched).
name: bank_transaction_confirm
label: {id: Mutasi dikonfirmasi jadi pembayaran}
on: bank_transaction.updated
if: event.status == 'confirmed' && event.payment == '' && event.suggested_invoice != ''
steps:
  - {find: sales_invoice, where: name == event.suggested_invoice, as: inv}
  - {find: bank_transaction, where: name == event.name, as: line}
  - create: payment
    if: inv != null
    set:
      direction: "'receive'"
      customer: inv.customer
      payment_date: event.date
      method: "'transfer'"
      reference: event.name
      amount: event.amount
      allocations: "[{'sales_invoice': inv.name, 'amount': min(event.amount, inv.outstanding)}]"
      notes: "'Dari mutasi ' + event.name + ': ' + event.description"
    as: pay
  - update: line
    if: inv != null
    set: {draft_payment: pay.name}
