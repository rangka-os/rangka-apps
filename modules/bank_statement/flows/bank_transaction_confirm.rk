# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# The owner sets a line to "Dikonfirmasi": draft a payment from the customer of the chosen invoice, for the line's
# amount, allocated to that invoice (up to what it still owes; any rest stays unallocated on the payment).
# The draft is submitted by a person (finance), which settles the invoice through payments.allocate.
# One line has at most one live draft, kept in draft_payment: confirming again (after going back, or with another
# invoice) updates that draft, or the live amend of a cancelled payment of the line, instead of drafting a second
# payment for the same money. Only when the draft is gone (deleted) is a new one drafted, so the line is never stuck.
name: bank_transaction_confirm
label: {id: Mutasi dikonfirmasi jadi pembayaran}
on: bank_transaction.updated
if: event.status == 'confirmed' && event.payment == '' && event.suggested_invoice != ''
steps:
  - find: payment
    where: "docstatus == 0 && ((event.draft_payment != '' && name == event.draft_payment) || (event.cancelled_payment != '' && amended_from == event.cancelled_payment))"
    as: draft
  - {find: sales_invoice, where: name == event.suggested_invoice, as: inv}
  - {find: bank_transaction, where: name == event.name, as: line}
  - update: draft
    if: inv != null && draft != null
    set:
      customer: inv.customer
      amount: event.amount
      allocations: "[{'sales_invoice': inv.name, 'amount': min(event.amount, inv.outstanding)}]"
  - update: line
    if: inv != null && draft != null && draft.name != event.draft_payment
    set: {draft_payment: draft.name}
  - create: payment
    if: inv != null && draft == null
    set:
      direction: "'receive'"
      customer: inv.customer
      payment_date: event.date
      method: "'transfer'"
      reference: event.name
      amount: event.amount
      allocations: "[{'sales_invoice': inv.name, 'amount': min(event.amount, inv.outstanding)}]"
      notes: "'Dari mutasi ' + event.name + ': ' + event.description"
    as: pay
  - update: line
    if: inv != null && draft == null
    set: {draft_payment: pay.name}
