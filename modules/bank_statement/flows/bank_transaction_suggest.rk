# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# A new statement line with money in looks for what it is. It only suggests; nothing is paid before the owner confirms.
# 1. Money already on the books (booked_payment): a submitted non-cash payment of the same amount that no statement line
#    holds yet, whose reference (giro number, gateway reference) is in the note -> that payment. A giro is booked to the
#    bank when it is received and a QRIS or VA through a gateway when the gateway reports it, so their clearing or
#    settlement line must not pay an invoice again (audit rel-uang-e2e H1: a clearing line of one giro was suggested to
#    another open invoice of the same amount and paid it twice).
# 2. An open invoice whose number is in the transfer note (written loosely, see below).
# 3. Never an invoice by the amount alone (audit rel-uang-e2e r1-r5 H1, H3, H4, H6, H7, M2): money reaches the bank
#    from too many places that carry no invoice (a giro or gateway payment already booked, a shop's takings settled in
#    sums of the bank's own, cash collected and deposited, a transfer between the business's own accounts), and an
#    amount can never tell them from a customer's transfer. A wrong suggestion, once confirmed, pays an invoice nobody
#    paid. The owner picks the invoice of such a line by hand.
# 4. Else exactly one booked payment of that amount waiting for its line -> that payment.
# Anything else: no suggestion (the owner picks). outstanding is already net of PPh 23, so a customer who withheld tax
# still matches.
name: bank_transaction_suggest
label: {id: Usulan cocok mutasi ke faktur}
on: bank_transaction.created
if: event.amount > 0 && event.status == 'unmatched'
steps:
  # The invoice number is the payment reference (payment_instruction.reference). Customers type it as they like:
  # "INV-2026-00012", "inv 2026 00012", "INV202600012", "INV/2026/00012" all match, compared without case, spaces,
  # dashes, slashes and dots on both sides. The number decides only when the line fits what the invoice still owes
  # (a part payment fits, an overpayment does not): "0004 2" typed for invoice 00042 must not pull a larger line
  # to invoice 0004; such a line falls back to the amount match.
  - find_all: sales_invoice
    where: >-
      docstatus == 1 && outstanding >= event.amount && (event.description.contains(name) ||
      event.description.upperAscii().replace(' ', '').replace('-', '').replace('/', '').replace('.', '')
      .contains(name.upperAscii().replace(' ', '').replace('-', '').replace('/', '').replace('.', '')))
    as: by_number
  - {find_all: bank_transaction, where: "booked_payment != ''", as: held}
  - find_all: payment
    where: >-
      docstatus == 1 && direction == 'receive' && method != 'cash' && method != 'sales_return' && amount == event.amount &&
      bank_transaction == '' && !(name in held.map(l, l.booked_payment))
    as: booked
  - find_all: payment
    where: >-
      docstatus == 1 && direction == 'receive' && method != 'cash' && method != 'sales_return' && amount == event.amount &&
      bank_transaction == '' && !(name in held.map(l, l.booked_payment)) && reference != '' &&
      event.description.upperAscii().contains(reference.upperAscii())
    as: booked_ref
  - {find: bank_transaction, where: name == event.name, as: line}
  - update: line
    if: size(booked_ref) == 1
    set: {booked_payment: "booked_ref[0].name", status: "'suggested'"}
  - update: line
    if: "size(booked_ref) != 1 && size(by_number) == 1"
    set: {suggested_invoice: "by_number[0].name", status: "'suggested'"}
  - update: line
    if: "size(booked_ref) != 1 && size(by_number) != 1 && size(booked) == 1"
    set: {booked_payment: "booked[0].name", status: "'suggested'"}
