# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: goods_receipt_item
is_child: true
fields:
  - name: item
    type: link
    to: item
    label: {id: Barang}
    required: true
  - name: description
    type: text
    label: {id: Uraian}
    default: item.item_name
  - name: qty
    type: float
    label: {id: Qty}
    required: true
  - name: uom
    type: link
    to: uom
    label: {id: Satuan}
    default: "packing != '' ? packing.uom : item.stock_uom"
  - name: packing
    type: link
    to: uom_conversion
    label: {id: Kemasan}
  - name: stock_qty
    type: float
    label: {id: Qty stok}
    compute: "packing == '' ? qty : qty * packing.factor"
  - name: rate
    type: currency
    label: {id: Harga satuan}
    required: true
  - name: amount
    type: currency
    label: {id: Jumlah}
    compute: round(qty * rate)
  - name: unit_cost
    type: currency
    label: {id: Biaya per satuan stok}
    compute: "stock_qty > 0 ? round(amount / stock_qty) : 0"
  # rangka-os contract 0070 §7 (goods_receipt stays on the kernel's Go rule, which reads these line fields): the lot
  # number and dates printed on the pack, and for a serial item one serial per line. Empty lot number on a lot item puts
  # the quantity in the no-lot bucket; a lot item with expiry needs it (409 lot_required at submit).
  - name: lot_no
    type: data
    label: {id: Nomor lot / batch}
    depends_on: "item.tracking in ['lot', 'lot_expiry']"
  - name: expiry_date
    type: date
    label: {id: Kedaluwarsa}
    help: {id: 'Wajib untuk lot baru. Lot yang sudah tercatat memakai tanggalnya sendiri'}
    depends_on: "item.tracking == 'lot_expiry'"
  - name: made_date
    type: date
    label: {id: Tanggal produksi}
    depends_on: "item.tracking in ['lot', 'lot_expiry']"
  - name: serial_nos
    type: text
    label: {id: Nomor seri}
    help: {id: 'Satu nomor seri per baris; jumlahnya sama dengan qty'}
    depends_on: "item.tracking == 'serial'"
