# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: vendor_bill
label: {id: Tagihan pemasok, en: Vendor bill}
icon: invoice
is_submittable: true
naming: BILL-{YYYY}-{#####}
title_field: bill_no
on_submit: [procurement.post_payable]
on_cancel: [procurement.reverse_payable]
fields:
  - name: vendor
    type: link
    to: vendor
    label: {id: Pemasok}
    required: true
    in_list: true
    peek: [outstanding, payment_days, npwp]
  - name: purchase_order
    type: link
    to: purchase_order
    label: {id: Pesanan pembelian}
  - name: goods_receipt
    type: link
    to: goods_receipt
    label: {id: Penerimaan barang}
  - name: bill_no
    type: data
    label: {id: No. faktur pemasok}
    required: true
    in_list: true
  - name: bill_date
    type: date
    label: {id: Tanggal faktur}
    required: true
    in_list: true
  - name: due_date
    type: date
    label: {id: Jatuh tempo}
    default: bill_date + duration(vendor.payment_days)
    relative_to: bill_date
    in_list: true
  - name: items
    type: table
    of: vendor_bill_item
    label: {id: Barang/jasa}
    min_rows: 1
  - name: subtotal
    type: currency
    label: {id: Subtotal}
    # Foreign-currency document (currency is not IDR): the rupiah subtotal is the IDR twin of subtotal_fx (contract 0013),
    # so dpp_base, PPN (assessed in rupiah), grand_total, retention, PPh 23 and amount_due stay IDR computes from it.
    # Lines are entered with rate_fx; the IDR line `amount` (qty x rate) cannot see the parent's currency, so the header ignores it.
    compute: "currency != '' && currency != 'IDR' ? subtotal_fx_idr : items.map(i, i.amount).sum()"
  - name: ppn_applies
    type: check
    label: {id: Kena PPN}
    default: 'false'
  - name: ppn
    type: currency
    label: {id: PPN (tarif 12% x DPP nilai lain 11/12)}
    compute: "ppn_applies ? round(subtotal * 11 / 12 * 12 / 100) : 0"
  - name: grand_total
    type: currency
    label: {id: Total}
    compute: subtotal + ppn
    in_list: true
  - name: pph23_amount
    type: currency
    label: {id: PPh 23 yang kami potong}
    help: {id: 'Dipotong dari pembayaran ke pemasok jasa; bukti potong kami terbitkan'}
    default: '0'
  - name: amount_due
    type: currency
    label: {id: Tagihan bersih}
    compute: grand_total - pph23_amount
    in_list: true
  - name: paid_amount
    type: currency
    label: {id: Sudah dibayar}
    read_only: true
  - name: outstanding
    type: currency
    label: {id: Sisa tagihan}
    compute: amount_due - paid_amount
    in_list: true
  - name: notes
    type: text
    label: {id: Catatan}
  - {name: currency, type: data, label: {id: Mata uang}, default: "'IDR'"}
  - {name: exchange_rate, type: float, label: {id: Kurs}, default: '1'}   # IDR per 1 unit of the foreign currency
  - {name: subtotal_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Subtotal (valas)}, compute: "sum(items.map(i, i.amount_fx))"}
  - {name: ppn_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: PPN (valas)}, compute: "ppn_applies ? round(subtotal_fx * 11 / 12 * 12 / 100, 2) : 0"}
  - {name: grand_total_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Total (valas)}, compute: "subtotal_fx + ppn_fx"}
  - {name: pph23_amount_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: PPh 23 dipotong (valas)}, default: '0'}
  - {name: amount_due_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Tagihan bersih (valas)}, compute: "grand_total_fx - pph23_amount_fx"}
rules:
  - name: due_after_bill
    on: save
    check: due_date == '' || due_date >= bill_date
    message: {id: Jatuh tempo tidak boleh sebelum tanggal faktur}
  - name: pph23_within_total
    on: save
    check: pph23_amount >= 0 && pph23_amount <= grand_total
    message: {id: PPh 23 tidak boleh negatif atau melebihi total}
  - name: qty_positive
    on: save
    check: "items.map(i, i.qty <= 0 ? 1 : 0).sum() == 0"
    message: {id: Jumlah barang harus lebih dari 0}
views:
  list:
    columns: [name, vendor, bill_no, bill_date, due_date, status, amount_due, outstanding]
    sort: -bill_date
  form:
    layout:
      - section: {id: Pemasok}
        columns:
          - [vendor, bill_no, purchase_order, goods_receipt]
          - [bill_date, due_date]
      - section: {id: Barang/jasa}
        fields: [items]
      - section: {id: Pajak & potongan}
        columns:
          - [subtotal, ppn_applies, ppn, grand_total]
          - [pph23_amount, amount_due, paid_amount, outstanding]
      - section: {id: Catatan}
        fields: [notes]
      - section: {id: Mata uang asing}
        columns:
          - [currency, exchange_rate, subtotal_fx]
          - [grand_total_fx, amount_due_fx]
