# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: project_vendor_cost_on_cancel
label: {id: Biaya pemasok proyek batal}
# Project ledger row (projects): a cancel writes the opposite row on the document's date, only when the document has a + row (documents submitted before the ledger existed have none).
on: vendor_bill.cancelled
if: event.project != ''
steps:
  - find: project_ledger
    where: source_name == event.name && kind == 'vendor' && entry == 'post'
    as: orig
  - if: orig != null
    create: project_ledger
    set:
      project: event.project
      posting_date: orig.posting_date
      entry: "'reverse'"
      reverses: orig.name
      kind: "'vendor'"
      source_model: event.model
      source_name: event.name
      vendor_bill: event.name
      amount: "0 - orig.amount"
