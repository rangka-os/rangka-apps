# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/module.json
name: procurement
version: 1.3.0
title: {id: Pembelian, en: Procurement}
summary:
  id: Permintaan dan pesanan pembelian, barang datang dan tagihan pemasok.
  en: Purchase requests and orders, goods received and supplier bills.
category: purchasing
icon: shopping-bag-line
requires: {rangka: '>=0.5', users: ^1.0, contacts: ^1.0, catalogue: ^1.0}
optional: {outlets: ^1.0, currency: ^1.0, stock: ^1.4, projects: ^1.0}
# Semantics fixed in docs/kernel-hooks.md (section procurement). stock.post_moves is a core hook (goods_receipt.on_submit);
# stock.reverse_moves (goods_receipt.on_cancel) is declared here too, since stock is optional for procurement (a no-op without it).
hooks: [procurement.make_po, procurement.receive, procurement.post_payable, procurement.reverse_payable, stock.reverse_moves]
# What this module tells people (contract 0066 §1.1). reorder_draft: flow reorder_draft_po made a draft purchase order
# for items below their reorder level; only roles that may read purchase orders are told.
notices:
  - name: reorder_draft
    label: {id: Draft pesanan pembelian stok menipis, en: Draft purchase order for low stock}
    description: {id: 'Draft pesanan pembelian dibuat untuk barang di bawah batas stok minimum. Draft menunggu kamu periksa dan ajukan.'}
    severity: warn
    to: [owner, purchasing_manager, head_office]
    can: {model: purchase_order, action: read}
