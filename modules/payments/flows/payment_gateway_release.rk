# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# A payment with a gateway id is cancelled: its claim gives the id back, so the payment can be amended or the
# gateway callback recorded again as a new payment.
name: payment_gateway_release
label: {id: Lepas ID gateway saat pembayaran dibatalkan}
on: payment.cancelled
if: event.gateway_ref != ''
steps:
  - {find: gateway_ref_claim, where: gateway_ref == event.gateway_ref && payment == event.name, as: held}
  - update: held
    if: held != null
    set: {gateway_ref: "''", released_ref: event.gateway_ref}
