# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
# Rel uang U13/U17 (ready, not active): A QR callback (qr.payment SUCCEEDED is paid; a refund or a failed QR is not). Xendit's external_id is
# the invoice number. The callback becomes a DRAFT payment allocated to that invoice (a flow cannot submit; finance
# submits it, which settles the invoice), carrying gateway xendit and the gateway id.
# Not active yet: the kernel has no connector runtime (no /hooks), so nothing fires this flow except
# POST /api/v1/flows/<name>/run with the callback as event (how day_one tests it). It is written against the xendit
# connector's trigger, not a payment.* port, because ports are not in the kernel yet (contract 0002 §B, proposal
# 0023); the three payment_from_xendit_* flows hold the same steps, one per trigger.
# Guards: a callback without gateway_ref, external_id, paid or paid_amount is skipped; only a completed payment of a
# positive amount records money. The gateway id is claimed BEFORE the payment is made: a new claim is an insert into
# gateway_ref_claim's unique index, so of two callbacks racing in parallel the second waits for the first and is
# refused (its whole run rolls back, nothing recorded); a later repeat finds the live payment or its claim and records
# nothing. A claim left by a deleted draft is released first (gateway_ref emptied, as payment_gateway_release does)
# and a new claim inserted, so racing repeats after a delete are refused the same way. Only a
# submitted invoice is paid (a cancelled one, or an unknown number, records nothing and tells the owner, since the
# money did arrive at Xendit); the allocation never exceeds what the invoice still owes after open drafts, the rest
# stays unallocated. A method outside payment's options is recorded as 'other'.
name: payment_from_xendit_qr
label: {id: QRIS Xendit dibayar jadi pembayaran}
on: xendit.qr_paid
if: >-
  'gateway_ref' in event && 'external_id' in event && 'paid' in event && 'paid_amount' in event &&
  event.gateway_ref != '' && event.paid == true && event.paid_amount > 0
idempotency: event.gateway_ref
steps:
  - {find: payment, where: "gateway_ref == event.gateway_ref && docstatus != 2", as: done}
  - {find: sales_invoice, where: "name == event.external_id && docstatus == 1", as: inv}
  - {find_all: payment, where: "docstatus == 0 && reference == event.external_id", as: drafts}
  - {find: gateway_ref_claim, where: gateway_ref == event.gateway_ref, as: held}
  # the payment the claim names, if it is still alive (a deleted draft is gone; a renamed draft is re-pointed on submit)
  - {find: payment, where: "held != null && name == held.payment && docstatus != 2", as: holder}
  - update: held
    if: done == null && inv != null && held != null && holder == null
    set: {gateway_ref: "''", released_ref: event.gateway_ref}
  - create: gateway_ref_claim
    if: done == null && inv != null && (held == null || holder == null)
    set: {gateway_ref: event.gateway_ref, payment: "''"}
    as: claim
  - create: payment
    if: done == null && inv != null && (held == null || holder == null)
    set:
      direction: "'receive'"
      customer: inv.customer
      payment_date: today()
      amount: event.paid_amount
      method: "'method' in event && event.method in ['va', 'qris', 'ewallet', 'transfer'] ? event.method : 'other'"
      gateway: "'xendit'"
      gateway_ref: event.gateway_ref
      reference: inv.name
      notes: "'Dari Xendit ' + event.gateway_ref"
      allocations: "min(event.paid_amount, inv.outstanding - drafts.map(p, p.allocated_total).sum()) > 0 ? [{'sales_invoice': inv.name, 'amount': min(event.paid_amount, inv.outstanding - drafts.map(p, p.allocated_total).sum())}] : []"
    as: pay
  - update: claim
    if: done == null && inv != null && (held == null || holder == null)
    set: {payment: pay.name}
  - notify: owner
    if: done == null && inv == null
    channel: email
    template: {id: 'Xendit {event.gateway_ref}: Rp {event.paid_amount} untuk {event.external_id}, faktur tidak ada/terbuka. Catat manual.'}
