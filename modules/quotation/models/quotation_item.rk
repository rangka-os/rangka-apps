# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: quotation_item
is_child: true
fields:
  - name: item
    type: link
    to: item
    label: {id: Barang/jasa}
    required: true
  - name: description
    type: text
    label: {id: Uraian}
    default: item.item_name
  - name: qty
    type: float
    label: {id: Qty}
    default: '1'
  - name: uom
    type: link
    to: uom
    label: {id: Satuan}
    default: "item.sales_uom != '' ? item.sales_uom : item.stock_uom"
  - name: rate
    type: currency
    label: {id: Harga}
    default: item.rate
  - name: discount
    type: percent
    label: {id: Diskon %}
    default: '0'
  - name: amount
    type: currency
    label: {id: Jumlah}
    compute: round(qty * rate * (1 - discount / 100))
  # The workers' wages quoted on their own line: outside the PPN base when the org charges PPN on its fee only
  # (config tax.ppn_fee_only, PMK 83/2012), as on the invoice (sales_invoice_item.ppn_exclude).
  - name: ppn_exclude
    type: check
    label: {id: Upah tenaga kerja (di luar dasar PPN)}
    help: {id: 'Centang untuk baris upah pekerja yang dirinci terpisah; hanya berlaku bila usaha memakai PPN atas fee'}
    default: 'false'

  - {name: rate_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Harga (valas)}, default: '0'}
  - {name: amount_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Jumlah (valas)}, compute: "round(qty * rate_fx * (1 - discount / 100), 2)"}
