# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: quotation
label: {id: Penawaran harga, en: Quotation}
icon: invoice
is_submittable: true
naming: {series: quotation, pattern: "QUO-{YYYY}-{#####}"}
title_field: subject
fields:
  - name: customer
    type: link
    to: customer
    label: {id: Pelanggan}
    required: true
    in_list: true
    peek: [npwp, payment_days]
  - name: contact_person
    type: data
    label: {id: Up. (PIC pelanggan)}
  - name: subject
    type: data
    label: {id: Perihal}
    required: true
  - name: rfq_ref
    type: data
    label: {id: No. RFQ}
  - name: rfq_date
    type: date
    label: {id: Tanggal RFQ}
  - name: quotation_date
    type: date
    label: {id: Tanggal penawaran}
    default: today()
    required: true
    in_list: true
  - name: valid_until
    type: date
    label: {id: Berlaku sampai}
    default: quotation_date + duration(30)
    relative_to: quotation_date
  - name: revision
    type: int
    label: {id: Revisi}
    default: '0'
    read_only: true
    in_list: true
  - name: items
    type: table
    of: quotation_item
    label: {id: Barang/jasa}
    min_rows: 1
  - name: subtotal
    type: currency
    label: {id: Subtotal}
    # Foreign-currency document (currency is not IDR): the rupiah subtotal is the IDR twin of subtotal_fx (contract 0013),
    # so dpp_base, PPN (assessed in rupiah), grand_total, retention, PPh 23 and amount_due stay IDR computes from it.
    # Lines are entered with rate_fx; the IDR line `amount` (qty x rate) cannot see the parent's currency, so the header ignores it.
    compute: "currency != '' && currency != 'IDR' ? subtotal_fx_idr : items.map(i, i.amount).sum()"
  - name: discount_amount
    type: currency
    label: {id: Diskon}
    default: '0'
  - name: dpp_base
    type: currency
    label: {id: DPP}
    compute: subtotal - discount_amount
  - name: ppn_applies
    type: check
    label: {id: Kena PPN}
    default: 'true'
  - name: tax_rate
    type: percent
    label: {id: Tarif PPN}
    default: '12'
  - name: ppn
    type: currency
    label: {id: PPN (tarif x DPP nilai lain 11/12)}
    compute: "ppn_applies ? round(dpp_base * 11 / 12 * tax_rate / 100) : 0"
  - name: grand_total
    type: currency
    label: {id: Total}
    compute: dpp_base + ppn
    in_list: true
  - name: payment_terms
    type: text
    label: {id: Syarat pembayaran}
  - name: delivery_terms
    type: text
    label: {id: Waktu pelaksanaan}
  - name: outcome
    type: select
    label: {id: Hasil penawaran}
    default: "'open'"
    read_only: true
    in_list: true
    chip: true
    options:
      - {value: open, label: {id: Menunggu}}
      - {value: accepted, label: {id: Diterima}}
      - {value: lost, label: {id: Kalah}}
  - name: lost_reason
    type: text
    label: {id: Alasan kalah}
    read_only: true
    depends_on: outcome == 'lost'
  - name: notes
    type: text
    label: {id: Catatan}
  - {name: currency, type: data, label: {id: Mata uang}, default: "'IDR'"}
  - {name: exchange_rate, type: float, label: {id: Kurs}, default: '1'}
  - {name: subtotal_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Subtotal (valas)}, compute: "sum(items.map(i, i.amount_fx))"}
  - {name: discount_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Diskon (valas)}, default: '0'}
  - {name: dpp_base_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: DPP (valas)}, compute: "subtotal_fx - discount_fx"}
  - {name: ppn_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: PPN (valas)}, compute: "ppn_applies ? round(dpp_base_fx * 11 / 12 * tax_rate / 100, 2) : 0"}
  - {name: grand_total_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Total (valas)}, compute: "dpp_base_fx + ppn_fx"}
rules:
  - name: valid_after_date
    on: save
    check: valid_until >= quotation_date
    message: {id: Masa berlaku tidak boleh sebelum tanggal penawaran}
  - name: draft_outcome_open
    on: save
    check: docstatus != 0 || outcome == 'open' || outcome == ''
    message: {id: Penawaran yang belum disubmit harus berstatus menunggu}
  - name: discount_within_subtotal
    on: save
    check: discount_amount <= subtotal
    message: {id: Diskon tidak boleh melebihi subtotal}
actions:
  - name: new_revision
    label: {id: Buat revisi, en: New revision}
    icon: edit
    hook: quotation.revise
    if: (docstatus == 1 || docstatus == 2) && (outcome == 'open' || outcome == '')
  # Args come from the call body: {outcome: accepted|lost, lost_reason}. Needed because a submitted document
  # cannot be edited, so `outcome` is changed only through this hook (docs/kernel-hooks.md).
  - name: mark_outcome
    label: {id: Catat hasil penawaran, en: Record outcome}
    icon: check
    hook: quotation.mark_outcome
    if: docstatus == 1 && (outcome == 'open' || outcome == '')
  - name: make_order
    label: {id: Buat pesanan pelanggan, en: Create customer order}
    icon: check
    primary: true
    hook: orders.from_quotation
    if: docstatus == 1 && outcome == 'accepted'
approvals:
  - name: manager_approval
    on: submit
    approvers: [sales_manager]
    label: {id: Persetujuan manajer, en: Manager approval}

views:
  list:
    columns: [name, customer, subject, quotation_date, revision, status, grand_total, outcome]
    sort: -quotation_date
  form:
    layout:
      - section: {id: Penawaran}
        columns:
          - [customer, contact_person, subject, revision]
          - [rfq_ref, rfq_date, quotation_date, valid_until]
      - section: {id: Barang/jasa}
        fields: [items]
      - section: {id: Harga}
        columns:
          - [subtotal, discount_amount, dpp_base]
          - [ppn_applies, tax_rate, ppn, grand_total]
      - section: {id: Syarat}
        columns:
          - [payment_terms, delivery_terms]
      - section: {id: Hasil}
        columns:
          - [outcome, lost_reason]
      - section: {id: Catatan}
        fields: [notes]
      - section: {id: Mata uang asing}
        columns:
          - [currency, exchange_rate, subtotal_fx]
          - [grand_total_fx]
