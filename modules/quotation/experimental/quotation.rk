# Sidecar for quotation: keys the kernel does not read yet (checked by scripts/check_experimental.py).
model: quotation
stream: [S2, S4, S5, S8a]   # S2 approvals, S4 number series, S5 org settings in CEL, S8a money

# S2, contract 0007: a quotation is submitted only after a sales_manager approves it. The approval binds to the
# snapshot hash, so a quotation changed after it was sent for approval must go through a new revision.
approvals:
  - name: manager_approval
    on: submit
    approvers: [sales_manager]
    label: {id: Persetujuan manajer, en: Manager approval}

# S4, contract 0009: the "quotation" series. `revision` counts amendments of the same quotation; the number stays
# QUO-YYYY-NNNNN and the print shows "Rev. n" next to it.
naming: {series: quotation, pattern: "QUO-{YYYY}-{#####}"}

defaults:
  # S5: CEL cannot read the org's settings yet; config.rk `orgs.<id>.pkp` decides. Until then the model's own
  # default is the constant 'true' and a non-PKP org unticks the box.
  ppn_applies: org.pkp

fields:
  # S8a, contract 0013: foreign-currency quotations. `*_fx` fields are the source of truth for a foreign quotation;
  # IDR quotations leave currency at 'IDR' and never use them.
  - {name: currency, type: data, label: {id: Mata uang}, default: "'IDR'"}
  - {name: exchange_rate, type: float, label: {id: Kurs}, default: '1'}
  - {name: subtotal_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Subtotal (valas)}, compute: "sum(items.map(i, i.amount_fx))"}
  - {name: discount_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Diskon (valas)}, default: '0'}
  - {name: dpp_base_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: DPP (valas)}, compute: "subtotal_fx - discount_fx"}
  - {name: ppn_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: PPN (valas)}, compute: "ppn_applies ? round(dpp_base_fx * 11 / 12 * 12 / 100, 2) : 0"}
  - {name: grand_total_fx, type: money, currency_field: currency, rate_field: exchange_rate, label: {id: Total (valas)}, compute: "dpp_base_fx + ppn_fx"}
