# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: payroll_guard
label: {id: Penjaga penggajian, en: Payroll guard}
icon: check
naming: PGD-{######}
title_field: reason
# Never stored (the pattern of projects.project_guard): a flow that must refuse the action it runs in creates one, and
# the rule of its reason fails with that message, which rolls the whole action back.
permissions:
  - {role: finance_manager, create: true}
  # The recap guard runs inside a timesheet cancel, which the project admin does.
  - {role: project_admin, create: true}
fields:
  - name: reason
    type: select
    label: {id: Alasan}
    required: true
    options:
      - {value: run_closed, label: {id: Periode gaji sudah ditutup}}
      - {value: invoice_submitted, label: {id: Faktur klien sudah diajukan}}
      - {value: ytd_stale, label: {id: Penghasilan sebelumnya berubah}}
      - {value: recap_has_slip, label: {id: Rekap dipakai slip gaji}}
      - {value: second_slip, label: {id: Slip kedua di bulan pajak yang sama}}
  - name: document
    type: data
    label: {id: Dokumen}
rules:
  - name: run_closed
    on: save
    check: reason != 'run_closed'
    message: {id: 'Periode gaji slip ini sudah ditutup; batalkan dokumen tutup periodenya dulu'}
  - name: invoice_submitted
    on: save
    check: reason != 'invoice_submitted'
    message: {id: 'Faktur klien periode gaji ini sudah diajukan; batalkan fakturnya dulu'}
  - name: ytd_stale
    on: save
    check: reason != 'ytd_stale'
    message: {id: 'Penghasilan bulan sebelumnya berubah sejak slip ini dibuat; hapus draf slip ini lalu buat lagi'}
  - name: recap_has_slip
    on: save
    check: reason != 'recap_has_slip'
    message: {id: 'Rekap absensi ini dipakai slip gaji yang sudah diajukan; batalkan slip gajinya dulu (selama periode gajinya belum ditutup)'}
  - name: second_slip
    on: save
    check: reason != 'second_slip'
    message: {id: 'Pekerja ini sudah punya slip gaji di bulan pajak ini (satu slip per pekerja per bulan pajak)'}
