# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: payslip_order_guard_submitted
label: {id: Slip gaji diajukan urut bulan pajak}
# A later month's slip of this worker and year is already submitted: its year to date (and a December recomputation)
# would miss this one. Cancel the later slip first, then submit in month order.
on: payslip.submitted
steps:
  - find: payslip
    where: worker == event.worker && tax_year == event.tax_year && tax_month > event.tax_month && docstatus == 1
    as: later
  - if: later != null
    create: payroll_guard
    set:
      reason: "'later_slip'"
      document: later.name
