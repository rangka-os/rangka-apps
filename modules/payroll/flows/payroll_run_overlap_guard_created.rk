# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: payroll_run_overlap_guard_created
label: {id: Periode gaji satu proyek atau outlet tidak tumpang tindih}
# Two runs of one project over the same days would pay the same attendance twice. Internal runs (payroll 2.0) overlap
# only with internal runs of the same outlet (or both of every outlet); a worker paid twice is refused per slip
# (payslip_pay_overlap_guard).
on: payroll_run.created
steps:
  - find: payroll_run
    where: ((event.run_kind == 'internal' && run_kind == 'internal' && outlet == event.outlet) || (event.run_kind != 'internal' && run_kind != 'internal' && project == event.project)) && name != event.name && period_from <= event.period_to && period_to >= event.period_from
    as: other
  - if: other != null
    create: payroll_guard
    set:
      reason: "'overlap'"
      document: other.name
