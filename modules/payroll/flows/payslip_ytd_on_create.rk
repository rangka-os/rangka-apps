# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: payslip_ytd_on_create
label: {id: Slip gaji membaca penghasilan sebelumnya tahun ini}
# Year to date for the December (last) recomputation: the sums of this worker's submitted slips of the same tax year in
# earlier tax months (submitted = paid, whether or not the run is closed yet). Filled on every slip made by hand; the
# slips a recap makes get them from payslip_from_recap (a flow's writes start no flows).
# Slips under the daily TER (casual, paid per day) are not part of the year: the December recomputation covers the
# months as a permanent employee only (PMK 168/2023; audit gelombang 3 F1).
on: payslip.created
steps:
  - find_all: payslip
    where: worker == event.worker && tax_year == event.tax_year && tax_month < event.tax_month && docstatus == 1 && !(employment == 'casual' && pay_basis == 'daily')
    as: prev
  - find: payslip
    where: name == event.name
    as: me
  - update: me
    set:
      ytd_gross: "prev.map(p, p.gross_taxable).sum()"
      ytd_pph21: "prev.map(p, p.pph21).sum()"
      ytd_pension: "prev.map(p, p.jht_employee + p.jp_employee).sum()"
      ytd_months: "size(prev)"
