# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: payslip_ytd_on_create
label: {id: Slip gaji membaca penghasilan sebelumnya tahun ini}
# Year to date for the December (last) recomputation: the sums of this worker's submitted slips of the same tax year in
# earlier tax months (submitted = paid, whether or not the run is closed yet). Filled on every slip made by hand; the
# slips a recap makes get them from payslip_from_recap (a flow's writes start no flows).
# Slips under the daily TER (casual, paid per day) are not part of the year: the December recomputation covers the
# months as a permanent employee only (PMK 168/2023; audit gelombang 3 F1).
on: payslip.created
# It also notes a kasbon of the worker not yet repaid in full (open_advance; warned at submit when the deduction does not
# link it). Reads cash_advance before payslip, like payslip_advance_guard.
steps:
  - find_all: cash_advance
    where: worker == event.worker && docstatus == 1
    sort: advance_date
    as: kas
  # A permanent employment ended earlier this year (a submitted last_month slip, then for example casual months) starts a
  # new period of work: only the slips after it count (audit gelombang 3 r2 R2).
  - find_all: payslip
    where: worker == event.worker && tax_year == event.tax_year && tax_month < event.tax_month && docstatus == 1 && last_month && !(employment == 'casual' && pay_basis == 'daily')
    sort: -tax_month
    limit: 1
    as: ended
  - find_all: payslip
    where: >-
      worker == event.worker && tax_year == event.tax_year && tax_month < event.tax_month && docstatus == 1 && !(employment == 'casual' && pay_basis == 'daily')
      && tax_month > (size(ended) > 0 ? ended[0].tax_month : 0)
    as: prev
  - find_all: payslip
    where: worker == event.worker && cash_advance != '' && docstatus == 1
    as: repaid
  - find: payslip
    where: name == event.name
    as: me
  - update: me
    set:
      ytd_gross: "prev.map(p, p.gross_taxable).sum()"
      ytd_pph21: "prev.map(p, p.pph21).sum()"
      ytd_pension: "prev.map(p, p.jht_employee + p.jp_employee).sum()"
      ytd_months: "size(prev)"
      open_advance: "kas.exists(k, repaid.map(p, p.cash_advance == k.name ? p.other_deduction : 0).sum() < k.amount) ? kas.filter(k, repaid.map(p, p.cash_advance == k.name ? p.other_deduction : 0).sum() < k.amount)[0].name : ''"
