# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/module.json
name: payroll
version: 2.2.0
title: {id: Penggajian, en: Payroll}
summary:
  id: Data gaji pekerja, periode gaji, slip gaji dan tutup periode.
  en: Worker pay data, pay periods, payslips and period close.
category: people
icon: money-dollar-box-line
# Monthly pay with BPJS and PPh 21 TER and the deposits of the month, in two kinds of payroll run (2.0):
# - client: outsourced workers of one client contract, from the attendance recap (projects.timesheet with period_to);
#   the close books the extra employer cost on the project margin and drafts the client invoice (wages + BPJS + fee, or
#   fee only). Needs projects, invoicing, contacts and catalogue, which jasa_proyek installs.
# - internal: the firm's own staff, no project, no client invoice. Needs none of the optional modules.
# 2.0 moved projects, invoicing, contacts and catalogue from requires to optional (breaking only for what they pulled
# in). 2.2 (rangka-apps#117): staff request a kasbon, repaid by a monthly installment the slips fill in (one open kasbon
# per worker, cash_advance_balance), and slips pay approved expense claims (module reimbursement) untaxed. Rules and
# sources: docs/payroll.md.
requires: {rangka: '>=0.5', users: ^1.0, workforce: ^1.0}
optional: {projects: ^1.0, invoicing: ^1.7, contacts: ^1.0, catalogue: ^1.0, outlets: ^1.0, attendance: ^1.0, reimbursement: ^1.0}
# What this module tells people (contract 0066 §1.1), both from flow payroll_reminder. Nothing here runs payroll.
notices:
  - name: payroll_ready
    label: {id: Periode gaji siap diproses, en: Payroll period ready}
    description: {id: 'Periode gaji sudah lewat dan rekap absennya lengkap. Slip gaji menunggu diperiksa.'}
    severity: info
    to: [owner, finance_manager]
  - name: payroll_due
    label: {id: Tanggal bayar gaji sudah dekat, en: Pay date is near}
    description: {id: 'Tanggal bayar gaji tinggal tiga hari atau kurang dan periode gajinya belum ditutup.'}
    severity: warn
    to: [owner, finance_manager]
