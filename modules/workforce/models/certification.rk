# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/model.json
name: certification
is_child: true
fields:
  - name: cert_name
    type: data
    label: {id: Nama sertifikat}
    required: true
  - name: cert_no
    type: data
    label: {id: No. sertifikat}
  - name: issuer
    type: data
    label: {id: Penerbit}
  - name: issued_on
    type: date
    label: {id: Terbit}
  - name: expires_on
    type: date
    label: {id: Berlaku sampai}
  # Reads today(), so the kernel recomputes it on every read: it turns true once expires_on passes, without a save.
  - name: expired
    type: check
    label: {id: Kedaluwarsa}
    compute: "expires_on != '' && expires_on < today()"
