# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/flow.json
name: claim_cancel_guard
label: {id: Klaim yang sudah dibayar tidak bisa dibatalkan}
# Inside an expense_claim cancel (head office or finance): refused while a submitted claim_payment or payslip paid it,
# since the books would then owe the employee less than was paid. Otherwise its settlement is marked cancelled, so no
# slip or payment takes it any more. The find takes the flow read lock of claim_settlement (contract 0025), so a cancel
# and a payment of the same claim at the same moment run one after the other.
on: expense_claim.cancelled
steps:
  - find: claim_settlement
    where: claim == event.name
    as: s
  - if: s != null && s.paid
    create: reimbursement_guard
    set:
      reason: "'claim_paid'"
      document: s.paid_by
  - if: s != null && !s.paid
    update: s
    set:
      cancelled: 'true'
