# Synthetic demo data for CV Contoh Warung Rasa, a fictional shop and coffee kiosk. No real people, businesses or
# brands. Opening stock, shifts and sales are made by the scenarios (tests/day_one_pos.py), not seeded.
uom:
  - {name: UOM-001, uom_name: Pcs}
  - {name: UOM-002, uom_name: Dus}
  - {name: UOM-003, uom_name: Kg}
  - {name: UOM-004, uom_name: Liter}
  - {name: UOM-005, uom_name: Porsi}
  - {name: UOM-006, uom_name: Pak}
outlet:
  - {name: OUT-01, outlet_name: Gudang pusat Warung Rasa, code: HO, location_type: warehouse, city: Bandung, is_head_office: true, active: true}
  - {name: OUT-02, outlet_name: Toko Contoh Dago, code: DGO, location_type: store, supply_from: OUT-01, city: Bandung, address: Jl. Contoh Dago No. 9, sales_source: kasir, active: true}
  - {name: OUT-03, outlet_name: Kedai Contoh Riau, code: RIU, location_type: store, supply_from: OUT-01, city: Bandung, address: Jl. Contoh Riau No. 3, sales_source: kasir, active: true}
  - {name: OUT-04, outlet_name: Toko Contoh Cimahi, code: CMH, location_type: store, supply_from: OUT-01, city: Cimahi, address: Jl. Contoh Cimahi No. 4, sales_source: form, active: true}
  # restaurant charges (rangka-apps#121): dine-in service 5%, PBJT 10%, total rounded to the nearest Rp 100; a cafe with none
  - {name: OUT-05, outlet_name: Restoran Contoh Braga, code: BRG, location_type: store, supply_from: OUT-01, city: Bandung, address: Jl. Contoh Braga No. 5, sales_source: kasir, service_pct: 5, pbjt_pct: 10, rounding_unit: '100', rounding_mode: nearest, active: true}
  - {name: OUT-06, outlet_name: Kafe Contoh Setiabudi, code: STB, location_type: store, supply_from: OUT-01, city: Bandung, address: Jl. Contoh Setiabudi No. 6, sales_source: kasir, service_pct: 0, pbjt_pct: 0, rounding_unit: '0', rounding_mode: nearest, active: true}
item_category:
  - {name: KTG-001, category_name: Minuman kopi}
  - {name: KTG-002, category_name: Makanan}
  - {name: KTG-003, category_name: Barang toko}
item:
  # retail goods, sold per piece or per dus / pak
  - {name: BRG-0001, category: KTG-003, item_name: Air mineral 600 ml, kind: good, stock_uom: UOM-001, sku: AIR-600, barcode: '8990000000011', rate: 4000, standard_cost: 2500}
  - {name: BRG-0002, category: KTG-003, item_name: Mi instan goreng, kind: good, stock_uom: UOM-001, sku: MI-GRG, barcode: '8990000000028', rate: 3500, standard_cost: 2600}
  - {name: BRG-0003, category: KTG-003, item_name: Gula pasir 1 kg, kind: good, stock_uom: UOM-001, sku: GULA-1K, rate: 18000, standard_cost: 15000}
  - {name: BRG-0004, item_name: Pulsa listrik (jasa bayar), kind: service, stock_uom: UOM-001, rate: 3000}
  # coffee kiosk: materials and menu items with a recipe
  # services at round prices for the charge scenarios (no stock moves)
  - {name: BRG-0031, item_name: Paket makan malam, kind: service, stock_uom: UOM-005, rate: 100000}
  - {name: BRG-0032, item_name: Paket makan ganjil, kind: service, stock_uom: UOM-005, rate: 100001}
  - {name: BRG-0033, item_name: Paket makan pembulatan, kind: service, stock_uom: UOM-005, rate: 100060}
  - {name: BRG-0011, item_name: Kopi bubuk, kind: material, stock_uom: UOM-003, sku: MAT-KOPI, standard_cost: 120000}
  - {name: BRG-0012, item_name: Susu segar, kind: material, stock_uom: UOM-004, sku: MAT-SUSU, standard_cost: 20000}
  - {name: BRG-0013, item_name: Gula aren cair, kind: material, stock_uom: UOM-004, sku: MAT-AREN, standard_cost: 40000}
  - {name: BRG-0014, item_name: Gelas plastik, kind: material, stock_uom: UOM-001, sku: MAT-GELAS, standard_cost: 600}
  - {name: BRG-0015, category: KTG-002, item_name: Roti bakar cokelat, kind: good, stock_uom: UOM-001, sku: RTI-CKL, rate: 15000, standard_cost: 6000}
  - {name: BRG-0021, category: KTG-001, item_name: Kopi susu aren, kind: product, stock_uom: UOM-005, sales_uom: UOM-005, sku: KSA, rate: 22000}
  - {name: BRG-0022, category: KTG-001, item_name: Kopi hitam, kind: product, stock_uom: UOM-005, sales_uom: UOM-005, sku: KHT, rate: 15000}
uom_conversion:
  - {name: KONV-0001, item: BRG-0001, uom: UOM-002, factor: 24, rate: 84000}
  - {name: KONV-0002, item: BRG-0002, uom: UOM-002, factor: 40}
  - {name: KONV-0003, item: BRG-0002, uom: UOM-006, factor: 5, rate: 16500}
recipe:
  - name: RSP-0001
    product: BRG-0021
    recipe_name: Kopi susu aren
    yield_qty: 1
    lines:
      - {material: BRG-0011, qty: 0.018}
      - {material: BRG-0012, qty: 0.15}
      - {material: BRG-0013, qty: 0.025}
      - {material: BRG-0014, qty: 1}
  - name: RSP-0002
    product: BRG-0022
    recipe_name: Kopi hitam
    yield_qty: 1
    lines:
      - {material: BRG-0011, qty: 0.015}
      - {material: BRG-0014, qty: 1}
# promos (module promotions): samples for the walkthrough, switched off so the day-one scenarios (tests/day_one_pos.py)
# keep their prices; head office switches one on (Aktif) and the counter has it within 5 minutes. The scenarios of
# tests/day_one_promotions.py make their own. Valid through 2030 so a demo years later still has them.
promotion:
  - {name: PRM-0001, promo_name: Happy hour kopi, kind: item_pct, scope: category, category: KTG-001, pct: 20, only_outlet: OUT-03, valid_from: '2026-01-01', valid_until: '2030-12-31', time_from: '14:00', time_until: '16:00', priority: 10, channel: kasir, active: false}
  - {name: PRM-0002, promo_name: Beli 2 gratis 1 roti, kind: buy_get, scope: item, item: BRG-0015, buy_qty: 2, get_qty: 1, valid_from: '2026-01-01', valid_until: '2030-12-31', channel: kasir, active: false}
  - {name: PRM-0003, promo_name: Hemat 10 persen, kind: bill_pct, pct: 10, max_discount: 15000, min_spend: 50000, code_mode: shared, code: HEMAT10, max_uses: 100, valid_from: '2026-01-01', valid_until: '2030-12-31', channel: kasir, active: false}
  - {name: PRM-0004, promo_name: Gratis air mineral, kind: free_gift, gift_item: BRG-0001, gift_qty: 1, min_spend: 50000, code_mode: none, valid_from: '2026-01-01', valid_until: '2030-12-31', channel: kasir, active: false}
  - {name: PRM-0005, promo_name: Kupon ulang tahun, kind: bill_off, amount_off: 15000, min_spend: 60000, code_mode: unique, valid_from: '2026-01-01', valid_until: '2030-12-31', channel: kasir, active: false}
# members (module loyalty): three tiers (the base one at Rp 0) and two members with no points or deposit yet; the
# scenarios of tests/day_one_loyalty.py sign up their own. Phone numbers are in the 0000 range, never a real line.
member_tier:
  - {name: TIER-01, tier_name: Member, tier_code: MEMBER, min_spend: 0, earn_spend: 10000, earn_multiplier_pct: 100, point_value: 100, max_redeem_pct: 50, member_discount_pct: 0, expiry_months: 12, active: true}
  - {name: TIER-02, tier_name: Silver, tier_code: SILVER, min_spend: 1000000, earn_spend: 10000, earn_multiplier_pct: 125, point_value: 100, max_redeem_pct: 50, member_discount_pct: 5, expiry_months: 12, active: true}
  - {name: TIER-03, tier_name: Gold, tier_code: GOLD, min_spend: 5000000, earn_spend: 10000, earn_multiplier_pct: 150, point_value: 100, max_redeem_pct: 50, member_discount_pct: 10, expiry_months: 12, active: true}
customer:
  - {name: CUST-0001, customer_name: Ibu Laras Contoh, city: Bandung, phone: '081200000301'}
  - {name: CUST-0002, customer_name: Bapak Yoga Contoh, city: Bandung, phone: '081200000302'}
loyalty_account:
  - {name: MBR-00001, member_name: Ibu Laras Contoh, phone: '081200000301', customer: CUST-0001, joined_outlet: OUT-02, tier: TIER-01, tier_name: Member, earn_spend: 10000, earn_multiplier_pct: 100, point_value: 100, max_redeem_pct: 50, member_discount_pct: 0, expiry_months: 12, active: true}
  - {name: MBR-00002, member_name: Bapak Yoga Contoh, phone: '081200000302', customer: CUST-0002, joined_outlet: OUT-03, tier: TIER-01, tier_name: Member, earn_spend: 10000, earn_multiplier_pct: 100, point_value: 100, max_redeem_pct: 50, member_discount_pct: 0, expiry_months: 12, active: true}
# kitchen tickets (module kitchen): Kedai Riau has a bar for the coffees and a kitchen for the food; the shops have no
# station, so their receipts make no ticket
kitchen_station:
  - {name: STD-001, station_name: Bar, outlet: OUT-03, active: true}
  - {name: STD-002, station_name: Dapur, outlet: OUT-03, active: true}
kitchen_route:
  - {name: RTD-0001, station: STD-001, category: KTG-001}
  - {name: RTD-0002, station: STD-002, category: KTG-002}
# tables of Kedai Riau (rangka-apps#122): two areas, ten tables, and three at Restoran Braga; the table scenarios of tests/day_one_pos.py open bills on them
dining_area:
  - {name: ARM-001, area_name: Dalam, outlet: OUT-03, sort: 1}
  - {name: ARM-002, area_name: Teras, outlet: OUT-03, sort: 2}
  # Restoran Braga (service charge, PBJT, rounding): the charges on table bills (rangka-apps#121, #122)
  - {name: ARM-003, area_name: Ruang makan, outlet: OUT-05, sort: 1}
dining_table:
  - {name: MJA-RIU-001, table_name: A1, area: ARM-001, seats: 2, outlet: OUT-03, active: true, time_limit_min: 90}
  - {name: MJA-RIU-002, table_name: A2, area: ARM-001, seats: 4, outlet: OUT-03, active: true}
  - {name: MJA-RIU-003, table_name: A3, area: ARM-001, seats: 2, outlet: OUT-03, active: true}
  - {name: MJA-RIU-004, table_name: A4, area: ARM-001, seats: 4, outlet: OUT-03, active: true}
  - {name: MJA-RIU-005, table_name: A5, area: ARM-001, seats: 2, outlet: OUT-03, active: true}
  - {name: MJA-RIU-006, table_name: A6, area: ARM-001, seats: 4, outlet: OUT-03, active: true}
  - {name: MJA-RIU-007, table_name: B1, area: ARM-002, seats: 2, outlet: OUT-03, active: true}
  - {name: MJA-RIU-008, table_name: B2, area: ARM-002, seats: 4, outlet: OUT-03, active: true}
  - {name: MJA-RIU-009, table_name: B3, area: ARM-002, seats: 2, outlet: OUT-03, active: true}
  - {name: MJA-RIU-010, table_name: B4, area: ARM-002, seats: 4, outlet: OUT-03, active: true}
  - {name: MJA-BRG-001, table_name: '1', area: ARM-003, seats: 4, outlet: OUT-05, active: true}
  - {name: MJA-BRG-002, table_name: '2', area: ARM-003, seats: 4, outlet: OUT-05, active: true}
  - {name: MJA-BRG-003, table_name: '3', area: ARM-003, seats: 6, outlet: OUT-05, active: true}
user:
  - {name: USR-001, full_name: Rina Contoh, role: head_office, email: rina@contohwarung.test}
  - {name: USR-002, full_name: Dika Contoh, role: cashier, email: dika.dago@contohwarung.test}
  - {name: USR-003, full_name: Sari Contoh, role: cashier, email: sari.riau@contohwarung.test}
  - {name: USR-004, full_name: Tono Contoh, role: kitchen, email: tono.riau@contohwarung.test}
  - {name: USR-005, full_name: Wati Contoh, role: outlet_staff, email: wati.riau@contohwarung.test}
