# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/config.json
# Demo site for the project-services pilot: two fictional PTs under one installation (contract 0010).
# `orgs:` holds each PT's own settings; an org's key replaces the site's key wholesale (no deep merge), so each org
# repeats every subkey it needs. Document numbers use `{ORG}`, the org's code (contract 0009).
locale: id-ID
currency: IDR
timezone: Asia/Jakarta
# Site defaults, used by any org created later in the database that has no entry below.
org: {legal_name: PT Contoh Jasa Teknik, npwp: '00.000.000.0-000.000', pkp: true}
tax: {ppn_rate: 12, dpp_ratio: 11/12, pkp: true}
numbering:
  invoice: {pattern: "INV/{ORG}/{YY}/{####}", reset: yearly}
  purchase_order: {pattern: "PO/{ORG}/{YY}{MM}/{###}", reset: monthly}
orgs:
  pt_contoh_inspeksi:
    name: PT Contoh Inspeksi
    code: CIN
    config:
      org: {legal_name: PT Contoh Inspeksi, npwp: '00.000.000.0-000.001', pkp: true}
      tax: {ppn_rate: 12, dpp_ratio: 11/12, pkp: true}
      numbering:
        invoice: {pattern: "INV/{ORG}/{YY}/{####}", reset: yearly}
        purchase_order: {pattern: "PO/{ORG}/{YY}{MM}/{###}", reset: monthly}
  cv_contoh_pelatihan:
    name: CV Contoh Pelatihan
    code: CPL
    config:
      org: {legal_name: CV Contoh Pelatihan, npwp: '00.000.000.0-000.002', pkp: false}
      tax: {ppn_rate: 12, dpp_ratio: 11/12, pkp: false}
      numbering:
        invoice: {pattern: "KW-{ORG}-{YY}{MM}-{###}", reset: monthly}
        purchase_order: {pattern: "PO-{ORG}-{YY}-{###}", reset: yearly}
apps: [jasa_proyek]
plan: tumbuh
sso: {domains: [contohjasa.test], required: false}
ai: {enabled: true, auto_apply: never, approvers: [owner, sales_manager]}
