# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/system.json
# Layer 2: one file per installation. App files say what they need; this file decides how.
db: {driver: postgres, url: '${DATABASE_URL}', pool: 10, isolation: shared}
cache: {driver: memory, max_mb: 64}
queue: {driver: postgres, workers: 4, retries: 3, dead_letter_after: 24h}
scheduler: {driver: internal, timezone: Asia/Jakarta}
realtime: {driver: postgres, transports: [sse]}
files: {driver: local, path: ./data/files, max_upload_mb: 25}
search: {driver: postgres, vectors: false}
notify:
  email: {driver: log, from: Toko Contoh <halo@tokocontoh.test>}
  push: {enabled: false, driver: log}
  whatsapp: {enabled: false}
auth:
  issuer: http://localhost:8080
  session_ttl: 24h
  two_factor: owners
  clients:
    - id: omilo
      label: Omilo
      redirect_uris: [http://localhost:3000/auth/callback]
      public: true
      scopes: [openid, profile, email, rangka.mcp]
secrets: {driver: env}
# Payment gateway keys through the env driver (contract 0017 §2); an unset variable leaves that connector without keys
# (its webhooks answer 401). Local demos set them to the dummy keys of the mocks (rangka-connectors doku/mock).
connector_auth:
  doku: {client_id: '${DOKU_CLIENT_ID}', secret_key: '${DOKU_SECRET_KEY}', api_host: '${DOKU_API_HOST}'}
  xendit: {secret_key: '${XENDIT_SECRET_KEY}', callback_token: '${XENDIT_CALLBACK_TOKEN}'}
audit: {enabled: true, retention_days: 365}
observability: {log_level: info, metrics: true}
