# yaml-language-server: $schema=https://rangka-os.github.io/rangka-os/schema/0.5/features.json
plans:
  - name: tumbuh
    label: {id: Tumbuh, en: Growth}
    apps: [kasir, stok_outlet, dapur, pembukuan, faktur_piutang, sewa_alat]
    modules: [whatsapp, whatsapp_receipt, whatsapp_reminder, whatsapp_order_ready, whatsapp_booking]
    capabilities: [realtime, queue, scheduler, files, search, notify_email, notify_whatsapp, api, mcp, ai]
    limits: {users: 15, outlets: 5, storage_mb: 10240, ai_credits_month: 2000}
